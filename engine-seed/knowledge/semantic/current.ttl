<urn:pxai:semi:validation:gate:critical-anomaly-release-round1> ns1:confidence "low" ;
    ns1:decisionUseText "阻止将缺少可核查现场证据的关键异常覆盖结论作为已验证事实发布。" ;
    ns1:gateDecisionCode "BLOCK" ;
    ns1:hasValidationFinding <urn:pxai:semi:validation:finding:equipment-down-evidence-gap-round1>,
        <urn:pxai:semi:validation:finding:quality-excursion-evidence-gap-round1> ;
