    skos:definition "固定晶圆的黏性膜，黏着力须兼顾切割固定与取片剥离两个矛盾需求。"@zh ;
    skos:notation "ap.material.dicing_tape" ;
    skos:prefLabel "Dicing Tape"@en,
        "切割膜"@zh ;
    ns1:legacyId "ap.material.dicing_tape" .

<urn:pxai:semi:catalog:ap.metric.wafer_thickness_var> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "减薄后总厚度变异。变异过大致切割深度不一与后续贴装应力不均。"@zh ;
    skos:notation "ap.metric.wafer_thickness_var" ;
    skos:prefLabel "Wafer Thickness Variation (TTV)"@en,
        "晶圆厚度变异"@zh ;
    ns1:legacyId "ap.metric.wafer_thickness_var" ;
    ns1:unitCode "μm" .

<urn:pxai:semi:catalog:core.param.cleanroom_temp> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition """环境温湿度稳定性。影响光阻涂布均匀性、量测机台热漂移、 塑封料吸湿状态。属于典型的"环境控制"类节点。
"""@zh ;
    skos:notation "core.param.cleanroom_temp" ;
    skos:prefLabel "Cleanroom Temperature & Humidity"@en,
        "洁净室温湿度"@zh ;
    ns1:analogousTo <urn:pxai:semi:external:ext.param.greenhouse_env_temp> ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.photo_coat> ;
    ns1:legacyId "core.param.cleanroom_temp" ;
    ns1:unitCode "℃ / %RH" .

<urn:pxai:semi:catalog:core.risknode.bottleneck_station> a ns1:CatalogConcept,
        ns1:RiskNode ;
    skos:definition """产能最紧、决定整线节拍的工序位置。瓶颈前必然形成 WIP 缓冲， 瓶颈的稼动损失无法被后续工序补偿。
"""@zh ;
    skos:notation "core.risknode.bottleneck_station" ;
    skos:prefLabel "Bottleneck Station"@en,
        "瓶颈站点"@zh ;
    ns1:analogousTo <urn:pxai:semi:external:ext.risknode.capacity_choke> ;
    ns1:legacyId "core.risknode.bottleneck_station" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:core.metric.oee>,
        <urn:pxai:semi:catalog:core.metric.throughput>,
        <urn:pxai:semi:catalog:core.metric.wip> .

