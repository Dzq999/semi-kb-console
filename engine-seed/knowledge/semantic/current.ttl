<urn:pxai:semi:catalog:ap.action.clean_placement_fixture> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition """对植球治具/掩膜孔位做清洁除残渣，或用清洁替代件换上、对换下件排程 深度清洁。换后须跑首件确认缺球消失。与 reball_rework 不同：本动作 作用于治具（生产工具），纠正的是缺球的上游成因；reball_rework 作用于 已缺球的成品，是产品级返工。两者一因一果，处置对象不同。
"""@zh ;
    skos:notation "ap.action.clean_placement_fixture" ;
    skos:prefLabel "Clean or Replace Ball Placement Fixture"@en,
        "清洁/更换植球治具"@zh ;
    ns1:legacyId "ap.action.clean_placement_fixture" .

<urn:pxai:semi:catalog:ap.material.bonding_wire> a ns1:CatalogConcept,
        ns1:MaterialType ;
    skos:definition """金线、铜线或银合金线。铜线成本低但硬度高需更精细的工艺窗口， 线材批号切换是键合参数需重新验证的触发点。
"""@zh ;
    skos:notation "ap.material.bonding_wire" ;
    skos:prefLabel "Bonding Wire"@en,
        "键合线"@zh ;
    ns1:legacyId "ap.material.bonding_wire" .

<urn:pxai:semi:catalog:ap.material.dicing_tape> a ns1:CatalogConcept,
