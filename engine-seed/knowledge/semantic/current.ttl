<urn:pxai:semi:capability:wat_analysis> a ns1:L1Capability ;
    rdfs:label "WAT Analysis" .

<urn:pxai:semi:catalog:ap.cause.placement_fixture_clog> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """植球治具/掩膜孔位被助焊剂残渣、错位或卡滞的锡球、或治具内壁积累物 堵塞，导致锡球无法落位而出现缺球。判别要点：缺球位置与治具孔位呈 固定一一对应（同一孔位反复缺、且批次间位置不漂移），而非跟印刷版面 或炉内温区走。堵塞通常随使用次数累积渐进恶化，清洁或更换治具后 立即恢复。与助焊剂印刷不良的关键区分：前者是*涂布环节*涂得对不对， 本成因是*植球环节*孔位通不通——两者都作用于植球前，但失效部位与 处置手段不同，不能合并。
"""@zh ;
    skos:notation "ap.cause.placement_fixture_clog" ;
    skos:prefLabel "Ball Placement Fixture Aperture Clogging"@en,
        "植球治具孔位堵塞"@zh ;
    ns1:legacyId "ap.cause.placement_fixture_clog" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.missing_ball> .

<urn:pxai:semi:catalog:ap.equip.aoi> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """影像比对检测外观缺陷。判定门槛决定误杀(Overkill)与 漏检(Escape)的平衡，门槛设定本身是经营决策： 误杀损失内部良品，漏检损失客户信任。
"""@zh ;
    skos:notation "ap.equip.aoi" ;
    skos:prefLabel "AOI System"@en,
        "自动光学检测机"@zh ;
    ns1:legacyId "ap.equip.aoi" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.aoi> .

<urn:pxai:semi:catalog:ap.equip.ball_mounter> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """锡球植入并回流形成 BGA 外部端子。缺球、连球、共面度超规 是主要缺陷。共面度不良在客户端 SMT 才暴露，属于 高逃逸风险项。
"""@zh ;
    skos:notation "ap.equip.ball_mounter" ;
    skos:prefLabel "Ball Mounter"@en,
        "植球机"@zh ;
    ns1:legacyId "ap.equip.ball_mounter" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.missing_ball> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.ball_mount> .

<urn:pxai:semi:catalog:ap.equip.bumping_line> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """电镀或植球形成晶圆级凸块，含光刻、电镀、回流多步。 本质是前段式产线放在后段厂，工艺复杂度与设备投资远高于 传统后段单元设备，产能规划需按线而非按机台。
"""@zh ;
    skos:notation "ap.equip.bumping_line" ;
    skos:prefLabel "Bumping Line"@en,
        "凸块制造线"@zh ;
    ns1:legacyId "ap.equip.bumping_line" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.bumping> .

<urn:pxai:semi:catalog:ap.equip.burn_in_oven> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """高温加电应力筛选早期失效。按小时计的固定时长无法压缩， 是周期时间的刚性组成。老化板(Burn-in Board)专用且数量有限， 板数常比炉子容量更早成为约束。
"""@zh ;
    skos:notation "ap.equip.burn_in_oven" ;
    skos:prefLabel "Burn-in Oven"@en,
        "老化炉"@zh ;
    ns1:legacyId "ap.equip.burn_in_oven" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.burn_in> .

<urn:pxai:semi:catalog:ap.equip.cure_oven> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """批式烘烤固化黏晶胶或底填胶。温度曲线(Ramp/Soak)决定固化度， 固化不足在后续高温步骤才显现为分层。批式加长周期使其 成为在制品排队点，且异常回溯困难 —— 一炉多批同时受影响。
"""@zh ;
    skos:notation "ap.equip.cure_oven" ;
    skos:prefLabel "Cure Oven"@en,
        "固化炉"@zh ;
    ns1:legacyId "ap.equip.cure_oven" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.delamination> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.epoxy_cure> .

<urn:pxai:semi:catalog:ap.equip.dicing_saw> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """刀片切割分离晶粒。刀片磨耗与冷却水状态决定崩边(Chipping)大小， 切割道宽度直接影响每片可得晶粒数。切割速度与崩边质量成反比， 是良率与产能的直接权衡。
"""@zh ;
    skos:notation "ap.equip.dicing_saw" ;
    skos:prefLabel "Dicing Saw"@en,
        "晶圆切割机"@zh ;
    ns1:legacyId "ap.equip.dicing_saw" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.dicing_chipping> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.dicing> .

<urn:pxai:semi:catalog:ap.equip.die_bonder> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """取放晶粒到基板并点胶固定。UPH(每小时产出)按颗计， 是后段最直接的产能计量单位。取放精度决定后续打线可行性， 换封装型体需更换治具与吸嘴，换型时间进入有效产能损失。
"""@zh ;
    skos:notation "ap.equip.die_bonder" ;
    skos:prefLabel "Die Bonder"@en,
        "黏晶机"@zh ;
    ns1:legacyId "ap.equip.die_bonder" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.die_crack> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.die_attach> .

<urn:pxai:semi:catalog:ap.equip.fc_bonder> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """晶粒翻转对位后热压接合凸块。对位精度要求高于黏晶机一个量级， 热压曲线决定凸块塌陷量与接合强度。设备单价与换型成本均高， 通常按产品族专机专用。
"""@zh ;
    skos:notation "ap.equip.fc_bonder" ;
    skos:prefLabel "Flip Chip Bonder"@en,
        "覆晶接合机"@zh ;
    ns1:legacyId "ap.equip.fc_bonder" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.flip_chip_bond> .

<urn:pxai:semi:catalog:ap.equip.final_tester> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """测试机配分选机做成品电性与温度条件测试。测试时间乘以 测试项数决定机时消耗，多站并测(Multi-site)是主要产能杠杆。 测试程式版本管理是误判的常见根源。
"""@zh ;
    skos:notation "ap.equip.final_tester" ;
    skos:prefLabel "Final Tester + Handler"@en,
        "成品测试机"@zh ;
    ns1:legacyId "ap.equip.final_tester" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.ft_yield_drop> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.final_test> .

<urn:pxai:semi:catalog:ap.equip.grinder> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """粗磨加精磨减薄晶圆背面。砂轮磨耗改变去除速率与表面粗糙度， 背面微裂纹是后续 die crack 的潜伏源。减薄越薄翘曲越大， 薄片处理能力是封装型体的准入条件。
"""@zh ;
    skos:notation "ap.equip.grinder" ;
    skos:prefLabel "Backgrinder"@en,
        "晶圆研磨机"@zh ;
    ns1:legacyId "ap.equip.grinder" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.die_crack> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.backgrind> .

<urn:pxai:semi:catalog:ap.equip.laser_marker> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """激光刻蚀封装表面标识。打标内容错误属于可追溯性事故 —— 产品本身良好但标识错误需全数重工或报废， 是"非工艺性"损失的典型来源。
"""@zh ;
    skos:notation "ap.equip.laser_marker" ;
    skos:prefLabel "Laser Marker"@en,
        "激光打标机"@zh ;
    ns1:legacyId "ap.equip.laser_marker" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.laser_mark> .

<urn:pxai:semi:catalog:ap.equip.mold_press> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """转移成型将塑封料压入模腔包封。模具按封装型体专用， 换模是主要换型损失。模具磨耗导致溢料(Flash)与填充不全， 模具寿命管理是后段最重要的资产管理项之一。
"""@zh ;
    skos:notation "ap.equip.mold_press" ;
    skos:prefLabel "Molding Press"@en,
        "塑封成型机"@zh ;
    ns1:legacyId "ap.equip.mold_press" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.mold_void> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.molding> .

<urn:pxai:semi:catalog:ap.equip.plasma_cleaner> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """等离子活化表面并去除有机污染，提升后续接合与塑封附着力。 是"预防性"设备 —— 其效果只在下游失效率上体现， 因此容易被当作可省略步骤，省略的代价延后暴露。
"""@zh ;
    skos:notation "ap.equip.plasma_cleaner" ;
    skos:prefLabel "Plasma Cleaner"@en,
        "等离子清洗机"@zh ;
    ns1:legacyId "ap.equip.plasma_cleaner" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.plasma_clean> .

<urn:pxai:semi:catalog:ap.equip.pmc_oven> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """长时间(数小时)高温完成塑封料交联。周期长且批量大， 是后段最长的单工序周期。固化度不足直接对应分层与 可靠性失效，且此时价值已接近成品，损失最大。
"""@zh ;
    skos:notation "ap.equip.pmc_oven" ;
    skos:prefLabel "Post Mold Cure Oven"@en,
        "后固化炉"@zh ;
    ns1:legacyId "ap.equip.pmc_oven" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.pmc> .

<urn:pxai:semi:catalog:ap.equip.singulation_saw> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """切割成型后的连片(Strip)为单颗封装体。切割毛边与分层是 主要缺陷，此时单位价值已含全部前后段成本， 崩损的经济损失是切割晶圆阶段的数倍。
"""@zh ;
    skos:notation "ap.equip.singulation_saw" ;
    skos:prefLabel "Singulation Saw"@en,
        "封装切单机"@zh ;
    ns1:legacyId "ap.equip.singulation_saw" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.singulation> .

<urn:pxai:semi:catalog:ap.equip.tape_mounter> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """将晶圆贴到切割胶带与钢圈上。贴膜气泡导致切割时晶粒位移， 胶带黏性过强则顶出困难。胶带型号与减薄厚度需匹配， 属于低成本但影响下游多道工序的前置动作。
"""@zh ;
    skos:notation "ap.equip.tape_mounter" ;
    skos:prefLabel "Wafer Mounter"@en,
        "贴膜机"@zh ;
    ns1:legacyId "ap.equip.tape_mounter" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.wafer_mount> .

<urn:pxai:semi:catalog:ap.equip.taping_machine> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """装入卷带或托盘并做防潮包装。干燥包装(Dry Pack)执行不到位 直接违背 MSL 楼面寿命要求，使前面所有防潮控制失效。 是流程最后一道，也是最容易被视为纯物流而放松管控的一道。
"""@zh ;
    skos:notation "ap.equip.taping_machine" ;
    skos:prefLabel "Taping / Packing Machine"@en,
        "编带包装机"@zh ;
    ns1:legacyId "ap.equip.taping_machine" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.packing> .

<urn:pxai:semi:catalog:ap.equip.underfill_dispenser> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """毛细流动填充晶粒与基板间隙。流动时间随间隙缩小而变长， 是覆晶路径的周期时间瓶颈之一。填充不完全形成空洞， 空洞在温度循环下成为裂纹起点。
"""@zh ;
    skos:notation "ap.equip.underfill_dispenser" ;
    skos:prefLabel "Underfill Dispenser"@en,
        "底填胶点胶机"@zh ;
    ns1:legacyId "ap.equip.underfill_dispenser" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.underfill> .

<urn:pxai:semi:catalog:ap.equip.wire_bonder> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """超声波加热压焊形成金属线连接。按线数计时，引脚数越多单颗越慢， 因此产能与产品引脚数强相关。金线是直接材料成本主项， 线弧形状与线长同时影响成本与电性。
"""@zh ;
    skos:notation "ap.equip.wire_bonder" ;
    skos:prefLabel "Wire Bonder"@en,
        "打线机"@zh ;
    ns1:legacyId "ap.equip.wire_bonder" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.process.wire_bond> .

<urn:pxai:semi:catalog:ap.param.bond_force> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "瓷嘴压向焊垫的力，与超声功率交互决定焊球形变量。"@zh ;
    skos:notation "ap.param.bond_force" ;
    skos:prefLabel "Bond Force"@en,
        "键合压力"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.wire_bond> ;
    ns1:legacyId "ap.param.bond_force" ;
    ns1:unitCode "gf" .

<urn:pxai:semi:catalog:ap.param.bond_stage_temp> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "加热台温度，提升金属塑性以助键合。温度不足显著抬升不粘率。"@zh ;
    skos:notation "ap.param.bond_stage_temp" ;
    skos:prefLabel "Bond Stage Temperature"@en,
        "键合台温度"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.wire_bond> ;
    ns1:legacyId "ap.param.bond_stage_temp" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> ;
    ns1:unitCode "℃" .

<urn:pxai:semi:catalog:ap.param.bond_time> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "单点键合作用时长。延长可补偿功率不足，但压低 UPH。"@zh ;
    skos:notation "ap.param.bond_time" ;
    skos:prefLabel "Bond Time"@en,
        "键合时间"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.wire_bond> ;
    ns1:legacyId "ap.param.bond_time" ;
    ns1:unitCode "ms" .

<urn:pxai:semi:catalog:ap.param.burn_in_temp> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "加速老化温度，依 Arrhenius 模型折算等效使用时长。"@zh ;
    skos:notation "ap.param.burn_in_temp" ;
    skos:prefLabel "Burn-in Temperature"@en,
        "烧机温度"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.burn_in> ;
    ns1:legacyId "ap.param.burn_in_temp" ;
    ns1:unitCode "℃" .

<urn:pxai:semi:catalog:ap.param.epoxy_dispense_volume> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition """单颗装片胶量。过多溢胶污染焊垫致键合不粘，过少空洞率上升。 针头堵塞与胶体黏度随温度变化是主要波动源。
"""@zh ;
    skos:notation "ap.param.epoxy_dispense_volume" ;
    skos:prefLabel "Epoxy Dispense Volume"@en,
        "点胶量"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.die_attach> ;
    ns1:legacyId "ap.param.epoxy_dispense_volume" ;
    ns1:unitCode "mg" .

<urn:pxai:semi:catalog:ap.route.bga_flipchip_main> a ns1:CatalogConcept,
        ns1:Route ;
    skos:definition """基板类封装路径，以晶圆级凸块加倒装互连，适用高脚数高频产品。 与 QFN 路径共享前处理与测试段，在互连与成型段分叉。
"""@zh ;
    skos:notation "ap.route.bga_flipchip_main" ;
    skos:prefLabel "BGA Flip Chip Main Flow"@en,
        "BGA 倒装封装主流程"@zh ;
    ns1:legacyId "ap.route.bga_flipchip_main" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.ft_yield>,
        <urn:pxai:semi:catalog:core.metric.cycle_time> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.lot>,
        <urn:pxai:semi:catalog:core.material.wafer> .

<urn:pxai:semi:catalog:core.param.cleanroom_particle> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition """单位体积空气中粒径超标颗粒数。前段光刻与薄膜区要求最严， 粒子失控直接转化为缺陷密度上升。
"""@zh ;
    skos:notation "core.param.cleanroom_particle" ;
    skos:prefLabel "Cleanroom Particle Class"@en,
        "洁净室悬浮粒子等级"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.wafer_clean> ;
    ns1:legacyId "core.param.cleanroom_particle" ;
    ns1:unitCode "ISO Class / Class(FS209E)" .

<urn:pxai:semi:catalog:core.state.rework> a ns1:CatalogConcept,
        ns1:Status ;
    skos:definition """批次返回已完成工序重新加工。可挽回良率但消耗额外产能，且部分工序 重工次数有上限（如光刻重工受膜层损伤限制）。
"""@zh ;
    skos:notation "core.state.rework" ;
    skos:prefLabel "Rework"@en,
        "重工"@zh ;
    ns1:analogousTo <urn:pxai:semi:external:ext.state.retreatment> ;
    ns1:legacyId "core.state.rework" .

<urn:pxai:semi:catalog:core.state.scrap> a ns1:CatalogConcept,
        ns1:Status ;
    skos:definition "批次或部分片/颗判定无法挽回，退出生产流程并计入损失。"@zh ;
    skos:notation "core.state.scrap" ;
    skos:prefLabel "Scrap"@en,
        "报废"@zh ;
    ns1:analogousTo <urn:pxai:semi:external:ext.state.cull> ;
    ns1:legacyId "core.state.scrap" .

<urn:pxai:semi:catalog:core.state.wip_queue> a ns1:CatalogConcept,
        ns1:Status ;
    skos:definition "批次已到站但未上机，处于队列中。是 WIP 堆积的直接观测状态。"@zh ;
    skos:notation "core.state.wip_queue" ;
    skos:prefLabel "WIP Queue"@en,
        "在制等待"@zh ;
    ns1:legacyId "core.state.wip_queue" ;
    ns1:mayCause <urn:pxai:semi:catalog:core.anomaly.wip_bubble> ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:core.metric.wip> .

<urn:pxai:semi:catalog:erp.asset.litho_scanner> a ns1:CatalogConcept,
        ns1:FixedAsset ;
    skos:definition "折旧计提对象（skill：折旧计提，自检累计折旧<原值）。"@zh ;
    skos:notation "erp.asset.litho_scanner" ;
    skos:prefLabel "Fixed Asset Litho Scanner"@en,
        "固定资产—光刻机"@zh ;
    ns1:legacyId "erp.asset.litho_scanner" ;
    ns1:partOf <urn:pxai:semi:catalog:erp.company.cc1000> .

<urn:pxai:semi:catalog:erp.billing.vf2026_0001> a ns1:BillingDocument,
        ns1:CatalogConcept ;
    skos:definition "依发货单开票，确认主营业务收入并计提销项税。"@zh ;
    skos:notation "erp.billing.vf2026_0001" ;
    skos:prefLabel "Billing VF-2026-0001"@en,
        "发票 VF-2026-0001（标准发票）"@zh ;
    ns1:billingForDelivery <urn:pxai:semi:catalog:erp.delivery.dn2026_0001> ;
    ns1:billingInPeriod <urn:pxai:semi:catalog:erp.period.2026_09> ;
    ns1:billingUsesTax <urn:pxai:semi:catalog:erp.tax.v17> ;
    ns1:generatesReceivable <urn:pxai:semi:catalog:erp.ar.ar2026_0001> ;
    ns1:legacyId "erp.billing.vf2026_0001" .

<urn:pxai:semi:catalog:erp.contract.capacity_reserve_a> a ns1:CatalogConcept,
        ns1:QuantityContract ;
    skos:definition "含 Take-or-Pay 与预付产能保证金条款（长期协议律）。"@zh ;
    skos:notation "erp.contract.capacity_reserve_a" ;
    skos:prefLabel "Quantity Contract Capacity-A"@en,
        "数量合同—客户A 年度产能预约"@zh ;
    ns1:legacyId "erp.contract.capacity_reserve_a" ;
    ns1:orderForCustomer <urn:pxai:semi:catalog:erp.bp.customer_fabless_a> .

<urn:pxai:semi:catalog:erp.contractliab.cl2026_a> a ns1:CatalogConcept,
        ns1:ContractLiability ;
    skos:definition "预收产能保证金余额，按 wafer 实际提货转收入。"@zh ;
    skos:notation "erp.contractliab.cl2026_a" ;
    skos:prefLabel "Contract Liability Customer-A"@en,
        "合同负债—客户A 产能保证金"@zh ;
    ns1:contractLiabilityPostsTo <urn:pxai:semi:catalog:erp.gl.2203_contract_liab> ;
    ns1:legacyId "erp.contractliab.cl2026_a" .

<urn:pxai:semi:catalog:erp.costcenter.fab_etch> a ns1:CatalogConcept,
        ns1:CostCenter ;
    skos:definition "蚀刻区制造费用归集。"@zh ;
    skos:notation "erp.costcenter.fab_etch" ;
    skos:prefLabel "Cost Center Etch Bay"@en,
        "成本中心—蚀刻区"@zh ;
    ns1:costCenterInProfitCenter <urn:pxai:semi:catalog:erp.profitcenter.foundry> ;
    ns1:legacyId "erp.costcenter.fab_etch" .

<urn:pxai:semi:catalog:erp.costcenter.fab_photo> a ns1:CatalogConcept,
        ns1:CostCenter ;
    skos:definition "费用归集载体（成本归集律：费用→成本中心→成本对象）。"@zh ;
    skos:notation "erp.costcenter.fab_photo" ;
    skos:prefLabel "Cost Center Photo Bay"@en,
        "成本中心—黄光区"@zh ;
    ns1:costCenterInProfitCenter <urn:pxai:semi:catalog:erp.profitcenter.foundry> ;
    ns1:legacyId "erp.costcenter.fab_photo" .

<urn:pxai:semi:catalog:erp.gl.1001_cash> a ns1:CatalogConcept,
        ns1:GLAccount ;
    skos:definition "资产类科目，借增贷减（科目方向律）。"@zh ;
    skos:notation "erp.gl.1001_cash" ;
    skos:prefLabel "Cash on Hand"@en,
        "库存现金（资产类）"@zh ;
    ns1:accountInChart <urn:pxai:semi:catalog:erp.coa.ykint> ;
    ns1:legacyId "erp.gl.1001_cash" .

<urn:pxai:semi:catalog:erp.gl.1122_ar> a ns1:CatalogConcept,
        ns1:GLAccount ;
    skos:definition "资产类科目，承接 O2C 开票生成的客户未清项。"@zh ;
    skos:notation "erp.gl.1122_ar" ;
    skos:prefLabel "Accounts Receivable"@en,
        "应收账款（资产类）"@zh ;
    ns1:accountInChart <urn:pxai:semi:catalog:erp.coa.ykint> ;
    ns1:legacyId "erp.gl.1122_ar" .

<urn:pxai:semi:catalog:erp.gl.1405_inventory> a ns1:CatalogConcept,
        ns1:GLAccount ;
    skos:definition "发货过账(PGI)时贷记本科目、借记销售成本。"@zh ;
    skos:notation "erp.gl.1405_inventory" ;
    skos:prefLabel "Finished Goods Inventory"@en,
        "库存商品（资产类）"@zh ;
    ns1:accountInChart <urn:pxai:semi:catalog:erp.coa.ykint> ;
    ns1:legacyId "erp.gl.1405_inventory" .

<urn:pxai:semi:catalog:erp.gl.2221_output_tax> a ns1:CatalogConcept,
        ns1:GLAccount ;
    skos:definition "负债类科目，贷增借减；开票时计提销项税。"@zh ;
    skos:notation "erp.gl.2221_output_tax" ;
    skos:prefLabel "Output VAT Payable"@en,
        "应交税费—销项税额（负债类）"@zh ;
    ns1:accountInChart <urn:pxai:semi:catalog:erp.coa.ykint> ;
    ns1:legacyId "erp.gl.2221_output_tax" .

<urn:pxai:semi:catalog:erp.gl.6001_revenue> a ns1:CatalogConcept,
        ns1:GLAccount ;
    skos:definition "收入类科目，损益类期末结转本年利润（结转律）。"@zh ;
    skos:notation "erp.gl.6001_revenue" ;
    skos:prefLabel "Sales Revenue"@en,
        "主营业务收入（收入类）"@zh ;
    ns1:accountInChart <urn:pxai:semi:catalog:erp.coa.ykint> ;
    ns1:carriesForwardTo <urn:pxai:semi:catalog:erp.gl.6401_cogs> ;
    ns1:legacyId "erp.gl.6001_revenue" .

<urn:pxai:semi:catalog:fab.equip.ald> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """自限制反应逐层沉积，厚度控制精度最高但速率最低。 用于高深宽比结构的阻挡层与高 k 介质。速率低使其在需要 厚膜时不具经济性，选用边界由膜厚需求决定。
"""@zh ;
    skos:notation "fab.equip.ald" ;
    skos:prefLabel "ALD Tool"@en,
        "原子层沉积机"@zh ;
    ns1:legacyId "fab.equip.ald" ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.ald_barrier> .

<urn:pxai:semi:catalog:fab.equip.cd_sem> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """非破坏量测线宽的电子显微设备。量测本身不增值但决定是否放行， 抽样率是"检出速度"与"量测机台产能"的权衡。量测排队会延后 重工决策窗口，把可挽回的偏移变成不可挽回。
"""@zh ;
    skos:notation "fab.equip.cd_sem" ;
    skos:prefLabel "CD-SEM"@en,
        "关键尺寸扫描电镜"@zh ;
    ns1:legacyId "fab.equip.cd_sem" ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.cd_measure> .

<urn:pxai:semi:catalog:fab.equip.cmp> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """研磨垫加抛光液的平坦化设备。研磨垫随抛光片数磨耗， 去除速率随之衰减，需按片数修整(Conditioning)或换垫。 碟形凹陷与刮伤是主要缺陷模式，抛光后清洗能力同样关键。
"""@zh ;
    skos:notation "fab.equip.cmp" ;
    skos:prefLabel "CMP Polisher"@en,
        "化学机械抛光机"@zh ;
    ns1:legacyId "fab.equip.cmp" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.cmp_scratch> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.cmp_metal>,
        <urn:pxai:semi:catalog:fab.process.cmp_oxide> .

<urn:pxai:semi:catalog:fab.equip.cvd> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """介质膜沉积设备。腔体壁沉积物累积是颗粒主要来源，需定期 腔体清洗(Chamber Clean)与预镀(Pre-coat)。膜厚均匀性受 喷淋头状态影响，是缓变型漂移。
"""@zh ;
    skos:notation "fab.equip.cvd" ;
    skos:prefLabel "CVD Tool"@en,
        "化学气相沉积机"@zh ;
    ns1:legacyId "fab.equip.cvd" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.cvd_ild> .

<urn:pxai:semi:catalog:fab.equip.defect_scanner> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """光学或电子束扫描全片缺陷并分类。灵敏度与吞吐量成反比， 检测配方(Recipe)决定能看见什么。缺陷空间分布形态是定位 责任机台的核心线索，因此检测点布置决定问题可诊断性。
"""@zh ;
    skos:notation "fab.equip.defect_scanner" ;
    skos:prefLabel "Defect Inspection Tool"@en,
        "缺陷检测机"@zh ;
    ns1:legacyId "fab.equip.defect_scanner" ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.defect_scan> .

<urn:pxai:semi:catalog:fab.equip.etcher_plasma> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """多腔体(Cluster)配置，各腔体独立漂移。聚合物累积改变蚀刻速率与形貌， 需按 RF 累积时数排 PM 与 Seasoning。腔体是有效调度单元， 同机不同腔的产出需分开做 SPC。
"""@zh ;
    skos:notation "fab.equip.etcher_plasma" ;
    skos:prefLabel "Plasma Etcher"@en,
        "等离子蚀刻机"@zh ;
    ns1:legacyId "fab.equip.etcher_plasma" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.etch_residue>,
        <urn:pxai:semi:catalog:fab.anomaly.particle_excursion> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.dry_etch>,
        <urn:pxai:semi:catalog:fab.process.pr_strip> .

<urn:pxai:semi:catalog:fab.equip.furnace> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """一次装载多舟(100+ 片)的批式热处理设备。升降温加保温的周期长达数小时， 是前段最长的单工序周期时间。批量大意味着排程上倾向凑满批， 因此常成为 WIP 堆积点 —— 等批比等机台更常见。
"""@zh ;
    skos:notation "fab.equip.furnace" ;
    skos:prefLabel "Vertical Furnace"@en,
        "立式扩散炉"@zh ;
    ns1:legacyId "fab.equip.furnace" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.furnace_anneal>,
        <urn:pxai:semi:catalog:fab.process.gate_oxidation>,
        <urn:pxai:semi:catalog:fab.process.lpcvd_nitride>,
        <urn:pxai:semi:catalog:fab.process.poly_deposition>,
        <urn:pxai:semi:catalog:fab.process.thermal_oxidation> .

<urn:pxai:semi:catalog:fab.equip.implanter> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """按能量段分中束流/高电流/高能三类机型，机型间不可互换。 束流稳定性决定剂量精度，换 species 需长时间清洗与调机， 因此排程强烈偏好同 species 连做 —— 换机成本体现为设置时间而非停机。
"""@zh ;
    skos:notation "fab.equip.implanter" ;
    skos:prefLabel "Ion Implanter"@en,
        "离子植入机"@zh ;
    ns1:legacyId "fab.equip.implanter" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.implant_dose_drift> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.ion_implant> .

<urn:pxai:semi:catalog:fab.equip.overlay_metro> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """量测层间对位偏差并回馈修正量给 Scanner(APC 回路)。 其数据质量直接决定回馈修正是否有效，量测精度不足会把 噪声当信号回馈，反而放大 Overlay 波动。
"""@zh ;
    skos:notation "fab.equip.overlay_metro" ;
    skos:prefLabel "Overlay Metrology Tool"@en,
        "套刻量测机"@zh ;
    ns1:legacyId "fab.equip.overlay_metro" ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.overlay_measure> .

<urn:pxai:semi:catalog:fab.equip.prober> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """探针卡接触焊垫做电性测试，与测试机(Tester)配对使用。 测试时间由测试项数决定，是前段最后一道也是最贵的量测。 探针卡磨耗导致接触不良会误判为良率下降，需与真实失效区分。
"""@zh ;
    skos:notation "fab.equip.prober" ;
    skos:prefLabel "Wafer Prober / Tester"@en,
        "晶圆测试机"@zh ;
    ns1:legacyId "fab.equip.prober" ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.cp_test>,
        <urn:pxai:semi:catalog:fab.process.wat> .

<urn:pxai:semi:catalog:fab.equip.pvd> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """溅镀金属膜的多腔体设备。靶材随消耗改变沉积速率，靶材寿命末期 颗粒污染风险上升。换靶是计划性停机，靶材成本进入单位成本。
"""@zh ;
    skos:notation "fab.equip.pvd" ;
    skos:prefLabel "PVD / Sputter"@en,
        "物理气相沉积机"@zh ;
    ns1:legacyId "fab.equip.pvd" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.pvd_metal> .

<urn:pxai:semi:catalog:fab.equip.rtp> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """灯管加热的单片式热处理设备，秒级升温。相较扩散炉热预算低得多， 用于浅接面激活。单片式使其无凑批延迟，但产能受限于单片处理时间。
"""@zh ;
    skos:notation "fab.equip.rtp" ;
    skos:prefLabel "Rapid Thermal Processor (RTP)"@en,
        "快速热处理机"@zh ;
    ns1:legacyId "fab.equip.rtp" ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.rta_anneal> .

<urn:pxai:semi:catalog:fab.equip.track> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """涂布、烤板、显影一体的轨道式设备，通常与 Scanner 联机(In-line)。 热板温度均匀性是 CD 均匀性的直接来源。联机意味着 Track 故障会连带 锁死 Scanner，其可用性影响被放大。
"""@zh ;
    skos:notation "fab.equip.track" ;
    skos:prefLabel "Coater / Developer Track"@en,
        "涂布显影机"@zh ;
    ns1:legacyId "fab.equip.track" ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.photo_coat>,
        <urn:pxai:semi:catalog:fab.process.photo_develop> .

<urn:pxai:semi:catalog:fab.equip.wafer_sorter> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """读取晶圆 ID 并在片盒间搬运重组批次。是批次拆分合并的执行点， 也是 WIP 追溯的数据来源。分片错误导致的批次混料是追溯性事故， 影响面按后续所有工序展开。
"""@zh ;
    skos:notation "fab.equip.wafer_sorter" ;
    skos:prefLabel "Wafer Sorter"@en,
        "晶圆分片机"@zh ;
    ns1:legacyId "fab.equip.wafer_sorter" ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.wafer_start> .

<urn:pxai:semi:catalog:fab.equip.wet_bench> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """多槽化学处理设备，一次处理整批(通常 25~50 片)。槽液随累积用量衰减， 按 batch count 换槽形成周期性能力波动。批式处理使其单位成本低， 但一次异常影响整批，损失粒度大。
"""@zh ;
    skos:notation "fab.equip.wet_bench" ;
    skos:prefLabel "Wet Bench"@en,
        "湿式工作台"@zh ;
    ns1:legacyId "fab.equip.wet_bench" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.particle_excursion> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.pr_strip>,
        <urn:pxai:semi:catalog:fab.process.wafer_clean>,
        <urn:pxai:semi:catalog:fab.process.wet_etch> .

<urn:pxai:semi:catalog:fab.param.cmp_platen_speed> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "研磨盘转速，影响去除率与研磨液分布均匀性。"@zh ;
    skos:notation "fab.param.cmp_platen_speed" ;
    skos:prefLabel "CMP Platen Speed"@en,
        "CMP 转盘转速"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.cmp_metal>,
        <urn:pxai:semi:catalog:fab.process.cmp_oxide> ;
    ns1:legacyId "fab.param.cmp_platen_speed" ;
    ns1:unitCode "rpm" .

<urn:pxai:semi:catalog:fab.param.cmp_slurry_flow> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition """研磨液供给速率，不足会导致局部干磨与划伤。研磨液粒径团聚 是划伤类缺陷的主要来源之一。
"""@zh ;
    skos:notation "fab.param.cmp_slurry_flow" ;
    skos:prefLabel "CMP Slurry Flow Rate"@en,
        "研磨液流量"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.cmp_metal>,
        <urn:pxai:semi:catalog:fab.process.cmp_oxide> ;
    ns1:legacyId "fab.param.cmp_slurry_flow" ;
    ns1:unitCode "ml/min" .

<urn:pxai:semi:catalog:fab.param.develop_time> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "显影液作用时间，CD 微调的次级旋钮。"@zh ;
    skos:notation "fab.param.develop_time" ;
    skos:prefLabel "Development Time"@en,
        "显影时间"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.photo_develop> ;
    ns1:legacyId "fab.param.develop_time" ;
    ns1:unitCode "s" .

<urn:pxai:semi:catalog:fab.param.etch_gas_flow> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "反应气体与稀释气体配比，决定化学选择比与聚合物生成量。"@zh ;
    skos:notation "fab.param.etch_gas_flow" ;
    skos:prefLabel "Etch Gas Flow"@en,
        "蚀刻气体流量"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.dry_etch> ;
    ns1:legacyId "fab.param.etch_gas_flow" ;
    ns1:unitCode "sccm" .

<urn:pxai:semi:catalog:fab.param.etch_rf_power> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "等离子体激发功率，决定离子能量与蚀刻速率、各向异性程度。"@zh ;
    skos:notation "fab.param.etch_rf_power" ;
    skos:prefLabel "Etch RF Power"@en,
        "蚀刻射频功率"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.dry_etch>,
        <urn:pxai:semi:catalog:fab.process.pr_strip> ;
    ns1:legacyId "fab.param.etch_rf_power" ;
    ns1:unitCode "W" .

<urn:pxai:semi:catalog:fab.param.etchant_concentration> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "湿制程槽液有效成分浓度，随使用衰减，需按累积批次数补液或换槽。"@zh ;
    skos:notation "fab.param.etchant_concentration" ;
    skos:prefLabel "Etchant Concentration"@en,
        "蚀刻液浓度"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.wafer_clean>,
        <urn:pxai:semi:catalog:fab.process.wet_etch> ;
    ns1:legacyId "fab.param.etchant_concentration" ;
    ns1:unitCode "% / ratio" .

<urn:pxai:semi:catalog:fab.param.furnace_temp> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:broader <urn:pxai:semi:catalog:core.param.cleanroom_temp> ;
    skos:definition "炉管温区设定值。温区平衡直接决定片间(Wafer-to-Wafer)均匀性。"@zh ;
    skos:notation "fab.param.furnace_temp" ;
    skos:prefLabel "Furnace Temperature"@en,
        "炉温"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.ald_barrier>,
        <urn:pxai:semi:catalog:fab.process.cvd_ild>,
        <urn:pxai:semi:catalog:fab.process.furnace_anneal>,
        <urn:pxai:semi:catalog:fab.process.gate_oxidation>,
        <urn:pxai:semi:catalog:fab.process.lpcvd_nitride>,
        <urn:pxai:semi:catalog:fab.process.poly_deposition>,
        <urn:pxai:semi:catalog:fab.process.rta_anneal>,
        <urn:pxai:semi:catalog:fab.process.thermal_oxidation> ;
    ns1:legacyId "fab.param.furnace_temp" ;
    ns1:unitCode "℃" .

<urn:pxai:semi:catalog:fab.param.furnace_time> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "高温保持时间。与温度共同构成热预算，是膜厚/结深的主控量。"@zh ;
    skos:notation "fab.param.furnace_time" ;
    skos:prefLabel "Furnace Time"@en,
        "炉管时间"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.furnace_anneal>,
        <urn:pxai:semi:catalog:fab.process.gate_oxidation>,
        <urn:pxai:semi:catalog:fab.process.thermal_oxidation> ;
    ns1:legacyId "fab.param.furnace_time" ;
    ns1:unitCode "min" .

<urn:pxai:semi:catalog:fab.param.hardbake_temp> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "显影后固化光阻，提升抗蚀刻能力。过高导致图形流动变形。"@zh ;
    skos:notation "fab.param.hardbake_temp" ;
    skos:prefLabel "Hard Bake Temperature"@en,
        "硬烤温度"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.photo_develop> ;
    ns1:legacyId "fab.param.hardbake_temp" ;
    ns1:unitCode "℃" .

<urn:pxai:semi:catalog:fab.param.implant_energy> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "加速电压决定的离子能量，控制投影射程即结深。"@zh ;
    skos:notation "fab.param.implant_energy" ;
    skos:prefLabel "Implant Energy"@en,
        "注入能量"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.ion_implant> ;
    ns1:legacyId "fab.param.implant_energy" ;
    ns1:unitCode "keV" .

<urn:pxai:semi:catalog:fab.param.implant_tilt> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "束流与晶圆法线夹角。控制沟道效应(Channeling)与阴影效应。"@zh ;
    skos:notation "fab.param.implant_tilt" ;
    skos:prefLabel "Implant Tilt Angle"@en,
        "注入倾角"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.ion_implant> ;
    ns1:legacyId "fab.param.implant_tilt" ;
    ns1:unitCode "degree" .

<urn:pxai:semi:catalog:fab.param.pvd_power> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "靶材溅射功率，决定沉积速率。功率与靶材侵蚀形貌共同影响均匀性。"@zh ;
    skos:notation "fab.param.pvd_power" ;
    skos:prefLabel "PVD Sputtering Power"@en,
        "溅镀功率"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.pvd_metal> ;
    ns1:legacyId "fab.param.pvd_power" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev> ;
    ns1:unitCode "kW" .

<urn:pxai:semi:catalog:fab.param.rta_ramp_rate> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "快速升温斜率。过快引起片内热应力与滑移线缺陷。"@zh ;
    skos:notation "fab.param.rta_ramp_rate" ;
    skos:prefLabel "RTA Ramp Rate"@en,
        "RTA 升温速率"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.rta_anneal> ;
    ns1:legacyId "fab.param.rta_ramp_rate" ;
    ns1:unitCode "℃/s" .

<urn:pxai:semi:catalog:fab.param.softbake_temp> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "涂布后去除溶剂的烘烤温度。影响光阻感光度与显影对比度。"@zh ;
    skos:notation "fab.param.softbake_temp" ;
    skos:prefLabel "Soft Bake Temperature"@en,
        "软烤温度"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.photo_coat> ;
    ns1:legacyId "fab.param.softbake_temp" ;
    ns1:unitCode "℃" .

<urn:pxai:semi:catalog:fab.param.spin_speed> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "旋涂转速，与光阻黏度共同决定膜厚（近似正比于转速平方根倒数）。"@zh ;
    skos:notation "fab.param.spin_speed" ;
    skos:prefLabel "Spin Speed"@en,
        "涂布转速"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.photo_coat> ;
    ns1:legacyId "fab.param.spin_speed" ;
    ns1:unitCode "rpm" .

ns1:current-knowledge a owl:Ontology ;
    owl:imports ns1:common .

ns1:eqp.capability.ai_fault_detection_rca ns1:supportsPredictiveMaintenance ns1:eqp.plan.predictive_maintenance .

<urn:pxai:semi:ext:web:springer:telemetry_causal_integration_pattern_02> a ns1:RCAEvidenceIntegrationPattern ;
    rdfs:label "遥测与因果分析集成模式02"@zh ;
    ns1:description "将图像或传感器分析、设备时间序列、模式识别和因果建模组织为故障检测与根因分析证据链的行业模式，同时保留数据质量与可解释性限制。" ;
    ns1:modelingLimitationText "公开综述支持行业层面的能力模式，但不能据此声明特定工厂的检测准确率、停机减少量、良率提升或收益。" ;
    ns1:nameZh "遥测与因果分析集成模式02" ;
    ns1:sourceRef "https://link.springer.com/article/10.1007/s00170-026-18777-0" ;
    ns1:sourceType "web" .

<urn:pxai:semi:fac:digital_twin:facility_repair_r2> a ns1:FacilityDigitalTwin ;
    rdfs:label "设施级数字孪生门禁修复实体"@zh ;
    ns1:hasEvent <urn:pxai:semi:fac:event:infrastructure_repair_r2> ;
    ns1:hasSubsystem <urn:pxai:semi:fac:utility:multi_system_repair_r2> ;
    ns1:sourceRef "https://semiconductorx.com/fab-ops-facility-management.html" ;
    ns1:sourceType "web" .

<urn:pxai:semi:fac:fms:utility_integration_repair_r2> a ns1:FacilityManagementSystem ;
    rdfs:label "公用系统集成型厂务管理系统门禁修复实体"@zh ;
    ns1:aggregatesUtilityData <urn:pxai:semi:fac:utility:multi_system_repair_r2> ;
    ns1:sourceRef "https://semiconductorx.com/fab-ops-facility-management.html" ;
    ns1:sourceType "web" .

<urn:pxai:semi:playbook:kb.ap.bonder_down_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "键合机停机排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.bonder_down> ;
    ns1:economicImpactText """键合是 QFN 主流程的瓶颈工序之一，停机损失近似等于停机时长 × 瓶颈产出率，且不可通过后续赶工完全回补。可控旋钮有两个： 按计数的电极/瓷嘴预防性更换（把非计划停机换成短时计划停机）， 以及关键备件本地备货水位。轴系类停机的时长方差远大于耗材类， 估算停机影响时应按成因分类而非用单一平均值。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A3>,
        <urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A4> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A3>,
        <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A4>,
        <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A5> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.bonder_down_triage%3A1>,
        <urn:pxai:semi:detection:kb.ap.bonder_down_triage%3A2>,
        <urn:pxai:semi:detection:kb.ap.bonder_down_triage%3A3> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.wire_pull_strength>,
        <urn:pxai:semi:catalog:core.metric.oee>,
        <urn:pxai:semi:catalog:core.metric.wip> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.wire_bond> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.clean_efo_electrode>,
        <urn:pxai:semi:catalog:ap.action.hold_lot>,
        <urn:pxai:semi:catalog:ap.action.reallocate_fixture>,
        <urn:pxai:semi:catalog:ap.action.replace_capillary> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:ap.cause.bond_head_servo_fault>,
        <urn:pxai:semi:catalog:ap.cause.capillary_wear>,
        <urn:pxai:semi:catalog:ap.cause.efo_electrode_fouling>,
        <urn:pxai:semi:catalog:ap.cause.fixture_shortage>,
        <urn:pxai:semi:catalog:ap.cause.wire_feed_jam> ;
    ns1:legacyId "kb.ap.bonder_down_triage" ;
    ns1:symptomText "OEE 可用率跌落；若为卡线类则表现为频繁短停而非一次长停"@zh,
        "打线机报警停机，键合工序在制批次停止流动"@zh,
        "键合区 WIP 累积，下游塑封出现待料"@zh .

<urn:pxai:semi:playbook:kb.ap.delamination_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "界面分层排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.delamination> ;
    ns1:economicImpactText """分层是可靠性失效前兆，漏出至客户端的代价远高于内部拦截： 客户端失效触发退货、批次追溯与信誉损失，量级远超本批报废。 塑封料的时效管理成本极低，属预防远优于处置的典型场景。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.delamination_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.ap.delamination_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.ap.delamination_triage%3A3> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.delamination_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.ap.delamination_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.ap.delamination_triage%3A3> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.delamination_triage%3A1>,
        <urn:pxai:semi:detection:kb.ap.delamination_triage%3A2> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.die_shear_strength>,
        <urn:pxai:semi:catalog:ap.metric.void_ratio> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.aoi> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.bake_emc>,
        <urn:pxai:semi:catalog:ap.action.hold_lot>,
        <urn:pxai:semi:catalog:ap.action.plasma_clean_rerun> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:ap.cause.emc_moisture>,
        <urn:pxai:semi:catalog:ap.cause.pad_contamination>,
        <urn:pxai:semi:catalog:ap.param.cure_temp> ;
    ns1:legacyId "kb.ap.delamination_triage" ;
    ns1:symptomText "C-SAM 超声扫描检出塑封料与芯粒、基板或引线框架界面剥离"@zh,
        "严重时后续回流焊出现爆米花效应（popcorn cracking）"@zh,
        "分层面积或位置超出允收标准，常见于芯粒边角与引线框架指部"@zh,
        "可能不伴随任何电性异常——分层是可靠性失效前兆，非即时功能失效"@zh .

<urn:pxai:semi:playbook:kb.ap.dicing_chipping_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "切割崩边超规排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.dicing_chipping> ;
    ns1:economicImpactText """崩边侵入电路区即判废。更重要的是它会转化为下游裂片， 因此换刀周期的决策不能只看崩边直接判废率，还须计入裂片连带损失。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.dicing_chipping_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.ap.dicing_chipping_triage%3A2> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.dicing_chipping_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.ap.dicing_chipping_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.ap.dicing_chipping_triage%3A3> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.dicing_chipping_triage%3A1> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.chipping_size> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.dicing> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.hold_lot>,
        <urn:pxai:semi:catalog:ap.action.replace_blade> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:ap.cause.blade_wear>,
        <urn:pxai:semi:catalog:ap.param.blade_rpm>,
        <urn:pxai:semi:catalog:ap.param.cut_feed_speed> ;
    ns1:legacyId "kb.ap.dicing_chipping_triage" ;
    ns1:symptomText "严重时伴随芯粒边缘缺口"@zh,
        "崩边尺寸量测超出 Scribe Line 余量"@zh,
        "崩边集中于晶圆特定区域或特定切割方向"@zh .

<urn:pxai:semi:playbook:kb.ap.die_crack_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "芯粒裂纹排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.die_crack> ;
    ns1:economicImpactText """成因工序与检出工序相隔远，圈定范围大是主要成本。改善方向在于 缩短暴露路径：在减薄或切割后增设抽检，把检出前移到成本累积较少的位置。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.die_crack_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.ap.die_crack_triage%3A2> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A3>,
        <urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A4> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.die_crack_triage%3A1> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.die_shear_strength> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.aoi> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.hold_lot>,
        <urn:pxai:semi:catalog:ap.action.replace_blade> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:ap.anomaly.dicing_chipping>,
        <urn:pxai:semi:catalog:ap.cause.grind_wheel_clog>,
        <urn:pxai:semi:catalog:ap.param.die_bond_force>,
        <urn:pxai:semi:catalog:ap.param.grind_feed_rate> ;
    ns1:legacyId "kb.ap.die_crack_triage" ;
    ns1:symptomText "外观或超声扫描发现芯粒开裂"@zh,
        "终测出现无规律功能失效"@zh,
        "裂纹常起始于芯粒边缘或背面"@zh .

<urn:pxai:semi:playbook:kb.ap.ft_yield_drop_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "终测良率下滑排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.ft_yield_drop> ;
    ns1:economicImpactText """双向损失：真实失效直接减少可交付数量；伪失效则造成良品过杀， 损失被错记为品质问题并误导改善方向。先分清两者是本异常处置的 经济关键，而非急于追查工艺。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.ft_yield_drop_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.ap.ft_yield_drop_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.ap.ft_yield_drop_triage%3A3> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A3>,
        <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A4>,
        <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A5> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.ft_yield_drop_triage%3A1>,
        <urn:pxai:semi:detection:kb.ap.ft_yield_drop_triage%3A2> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.ft_yield>,
        <urn:pxai:semi:catalog:core.metric.yield> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.final_test> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.hold_lot>,
        <urn:pxai:semi:catalog:ap.action.replace_probe_card>,
        <urn:pxai:semi:catalog:ap.action.retest> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:ap.anomaly.delamination>,
        <urn:pxai:semi:catalog:ap.anomaly.die_crack>,
        <urn:pxai:semi:catalog:ap.anomaly.wire_nsop>,
        <urn:pxai:semi:catalog:ap.cause.probe_card_wear>,
        <urn:pxai:semi:catalog:ap.param.test_time> ;
    ns1:legacyId "kb.ap.ft_yield_drop_triage" ;
    ns1:symptomText "可能伴随特定测试 Site 失效率显著偏高"@zh,
        "失效 Bin 分布出现异常集中"@zh,
        "终测良率跌破管制下限"@zh .

<urn:pxai:semi:playbook:kb.ap.missing_ball_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "缺球/连球排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.missing_ball> ;
    ns1:economicImpactText """与多数后段不良相反，本异常的缺球分支可返工挽回，因此经济关键不在 止损而在分流准确性：把可返工的缺球误判为连球等于多报废， 把连球混进返工流则把不可靠品送出厂。 成因侧的杠杆在印刷条件——它是可调工艺窗口，纠正成本低于换料或 改炉温曲线，这也是把 flux_print_defect 排在首位排除的经济理由。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.missing_ball_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.ap.missing_ball_triage%3A2> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.missing_ball_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.ap.missing_ball_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.ap.missing_ball_triage%3A3> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.missing_ball_triage%3A1>,
        <urn:pxai:semi:detection:kb.ap.missing_ball_triage%3A2> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.coplanarity>,
        <urn:pxai:semi:catalog:core.metric.yield> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.aoi> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.hold_lot>,
        <urn:pxai:semi:catalog:ap.action.reball_rework> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:ap.cause.flux_print_defect>,
        <urn:pxai:semi:catalog:ap.cause.reflow_profile_drift>,
        <urn:pxai:semi:catalog:ap.param.reflow_peak_temp> ;
    ns1:legacyId "kb.ap.missing_ball_triage" ;
    ns1:symptomText "AOI 检出接点缺球，或相邻锡球桥连"@zh,
        "共面性量测超规，此时须与缺球分开判定"@zh,
        "可能伴随锡球表面起皱（助焊剂活性不足或回流中流失致氧化）"@zh,
        "缺球位置与印刷版面或植球治具孔位呈固定对应"@zh,
        "连球多出现在间距最小的接点区域"@zh .

<urn:pxai:semi:playbook:kb.ap.mold_void_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "塑封空洞排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.mold_void> ;
    ns1:economicImpactText """塑封后空洞不可返工，直接判废，且此时前段与后段大部分成本已投入。 塑封料的时效管理成本远低于一次批量空洞报废，是典型的预防优于处置场景。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.mold_void_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.ap.mold_void_triage%3A2> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A3>,
        <urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A4> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.mold_void_triage%3A1> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.void_ratio> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.aoi> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.bake_emc>,
        <urn:pxai:semi:catalog:ap.action.hold_lot> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:ap.cause.emc_moisture>,
        <urn:pxai:semi:catalog:ap.param.mold_pressure>,
        <urn:pxai:semi:catalog:ap.param.mold_temp>,
        <urn:pxai:semi:catalog:ap.param.transfer_speed> ;
    ns1:legacyId "kb.ap.mold_void_triage" ;
    ns1:symptomText "X-Ray 抽检发现塑封体内部气泡"@zh,
        "严重时伴随包封不全或金线冲丝"@zh,
        "空洞多集中于特定模腔位置或芯粒边缘"@zh .

<urn:pxai:semi:playbook:kb.ap.wire_bond_wip_bubble> a ns1:DiagnosticPlaybook ;
    rdfs:label "Wire Bond 站点 WIP 堆积排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:core.anomaly.wip_bubble> ;
    ns1:economicImpactText """键合站常为后段瓶颈，其堆积同时造成交期延长（前段等待）与 下游稼动损失（塑封饥饿）。按 Little's Law，WIP 上升而产出率不变时 CT 等比恶化。若为治具短缺型，治具投资的回收周期通常远短于产能损失。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.wire_bond_wip_bubble%3A1>,
        <urn:pxai:semi:action-instruction:kb.ap.wire_bond_wip_bubble%3A2>,
        <urn:pxai:semi:action-instruction:kb.ap.wire_bond_wip_bubble%3A3> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A1>,
        <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A2>,
        <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A3>,
        <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A4>,
        <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A5> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.wire_bond_wip_bubble%3A1>,
        <urn:pxai:semi:detection:kb.ap.wire_bond_wip_bubble%3A2>,
        <urn:pxai:semi:detection:kb.ap.wire_bond_wip_bubble%3A3> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:core.metric.cycle_time>,
        <urn:pxai:semi:catalog:core.metric.oee>,
        <urn:pxai:semi:catalog:core.metric.wip> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.wire_bond> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.bond_param_doe>,
        <urn:pxai:semi:catalog:ap.action.hold_lot>,
        <urn:pxai:semi:catalog:ap.action.reallocate_fixture> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:ap.anomaly.bonder_down>,
        <urn:pxai:semi:catalog:ap.anomaly.wire_nsop>,
        <urn:pxai:semi:catalog:ap.cause.fixture_shortage>,
        <urn:pxai:semi:catalog:ap.process.wafer_receive>,
        <urn:pxai:semi:catalog:core.state.hold> ;
    ns1:legacyId "kb.ap.wire_bond_wip_bubble" ;
    ns1:symptomText "下游塑封站出现断料饥饿"@zh,
        "该站 CT 贡献占比上升，X-Factor 恶化"@zh,
        "键合站在制量显著高于正常水位，队列批次数持续增长"@zh .

<urn:pxai:semi:playbook:kb.ap.wire_nsop_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "金线不粘 NSOP 排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> ;
    ns1:economicImpactText """塑封前检出可重新键合挽回，损失限于键合工时；塑封后暴露则整颗判废， 且可能在终测才发现（表现为开路）。molding 是本异常的经济分界点。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A3>,
        <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A4>,
        <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A5> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A3>,
        <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A4>,
        <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A5> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.wire_nsop_triage%3A1>,
        <urn:pxai:semi:detection:kb.ap.wire_nsop_triage%3A2> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.ball_shear_strength>,
        <urn:pxai:semi:catalog:ap.metric.wire_pull_strength> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.wire_bond> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.adjust_dispense>,
        <urn:pxai:semi:catalog:ap.action.bond_param_doe>,
        <urn:pxai:semi:catalog:ap.action.hold_lot>,
        <urn:pxai:semi:catalog:ap.action.plasma_clean_rerun>,
        <urn:pxai:semi:catalog:ap.action.replace_capillary> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:ap.cause.bond_param_drift>,
        <urn:pxai:semi:catalog:ap.cause.capillary_wear>,
        <urn:pxai:semi:catalog:ap.cause.epoxy_bleed>,
        <urn:pxai:semi:catalog:ap.cause.pad_contamination>,
        <urn:pxai:semi:catalog:ap.param.bond_power> ;
    ns1:legacyId "kb.ap.wire_nsop_triage" ;
    ns1:symptomText "拉力测试值偏低，失效模式为球脱而非线断"@zh,
        "机台不粘报警频次上升"@zh,
        "目检可见焊球未完全接合或有位移"@zh .

<urn:pxai:semi:playbook:kb.erp.billing_block_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "开票冻结/信用超限排查与释放"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:erp.anomaly.billing_block> ;
    ns1:economicImpactText """开票受阻推迟收入确认与回款，直接拉长 DSO、占用营运资金。信用冻结型若无条件放行会累积 坏账风险，交货未过账型则是物流与开票流程脱节。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.erp.billing_block_triage%3A1> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.erp.billing_block_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.erp.billing_block_triage%3A2> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.erp.billing_block_triage%3A1> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:erp.metric.credit_exposure> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:erp.action.credit_review_release> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:erp.cause.credit_limit_exceeded>,
        <urn:pxai:semi:catalog:erp.cause.delivery_not_posted> ;
    ns1:legacyId "kb.erp.billing_block_triage" ;
    ns1:symptomText "或交货尚未过账（PGI 未做）"@zh,
        "订单带信用冻结或开票冻结标记"@zh,
        "销售订单无法开票放行"@zh .

<urn:pxai:semi:playbook:kb.erp.cost_variance_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "成本差异超标排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:erp.anomaly.cost_variance_excursion> ;
    ns1:economicImpactText """差异越晚识别，错误的标准成本沉淀进期末存货估值的金额越大，且会误导定价与产品盈利分析。 价差量差型影响当期毛利，分摊失真型则在成本对象间交叉补贴、扭曲单品盈利判断。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.erp.cost_variance_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.erp.cost_variance_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.erp.cost_variance_triage%3A3> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.erp.cost_variance_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.erp.cost_variance_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.erp.cost_variance_triage%3A3> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.erp.cost_variance_triage%3A1> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:erp.metric.cost_variance_rate> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:erp.action.recalc_allocation_rate>,
        <urn:pxai:semi:catalog:erp.action.revalue_standard_cost>,
        <urn:pxai:semi:catalog:erp.action.variance_analysis> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:erp.cause.overhead_allocation_drift>,
        <urn:pxai:semi:catalog:erp.cause.purchase_price_swing>,
        <urn:pxai:semi:catalog:erp.cause.standard_cost_outdated> ;
    ns1:legacyId "kb.erp.cost_variance_triage" ;
    ns1:symptomText "实际成本对标准成本差异率超出管控界限"@zh,
        "差异集中于料成本、制造费用或效率某一类"@zh,
        "或差异分布在特定成本中心而非全线"@zh .

<urn:pxai:semi:playbook:kb.erp.depreciation_error_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "折旧计提异常排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:erp.anomaly.depreciation_error> ;
    ns1:economicImpactText """折旧错误直接影响当期费用与资产账面价值。累计折旧超原值会触发 SHACL 自检回滚， 是资产主数据错误的强信号——半导体设备原值高，年限设错的期间费用偏差可观。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.erp.depreciation_error_triage%3A1> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.erp.depreciation_error_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.erp.depreciation_error_triage%3A2> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.erp.depreciation_error_triage%3A1> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:erp.metric.net_book_value> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:erp.action.correct_asset_master> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:erp.cause.asset_master_error>,
        <urn:pxai:semi:catalog:erp.cause.capitalization_delay> ;
    ns1:legacyId "kb.erp.depreciation_error_triage" ;
    ns1:symptomText "偏差集中于某资产类或某单项资产"@zh,
        "或累计折旧逼近/超过资产原值（净值将破残值线）"@zh,
        "折旧计提金额偏离预期"@zh .

<urn:pxai:semi:playbook:kb.erp.gr_ir_mismatch_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "GR/IR 暂估对账失败排查与清理"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:erp.anomaly.gr_ir_mismatch> ;
    ns1:economicImpactText """GR/IR 未清直接卡住月结，是期末结账最常见的对账阻塞点。长期挂账还会虚增或虚减应付、 扭曲负债准确性，掩盖采购与应付流程的断点。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.erp.gr_ir_mismatch_triage%3A1> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.erp.gr_ir_mismatch_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.erp.gr_ir_mismatch_triage%3A2> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.erp.gr_ir_mismatch_triage%3A1> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:erp.metric.gr_ir_balance> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:erp.action.clear_gr_ir> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:erp.cause.invoice_not_received>,
        <urn:pxai:semi:catalog:erp.cause.po_invoice_discrepancy> ;
    ns1:legacyId "kb.erp.gr_ir_mismatch_triage" ;
    ns1:symptomText "存在已收货未开票或已开票未收货的挂账项"@zh,
        "或价格/数量差异导致自动清账失败"@zh,
        "月结时 GR/IR 暂估科目余额无法清零"@zh .

<urn:pxai:semi:playbook:kb.erp.inventory_writedown_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "存货跌价识别与计提"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:erp.anomaly.inventory_writedown> ;
    ns1:economicImpactText """半导体存货受制程迭代快速减值，呆滞识别越晚跌价缺口越大。计提直接冲减当期毛利， 且大额跌价往往暴露前端投料计划与需求脱节的更深问题。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.erp.inventory_writedown_triage%3A1> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.erp.inventory_writedown_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.erp.inventory_writedown_triage%3A2> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.erp.inventory_writedown_triage%3A1> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:erp.metric.inventory_turnover> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:erp.action.provision_writedown> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:erp.cause.inventory_obsolescence>,
        <urn:pxai:semi:catalog:erp.cause.purchase_price_swing> ;
    ns1:legacyId "kb.erp.inventory_writedown_triage" ;
    ns1:symptomText "存货可变现净值（NRV）低于账面成本"@zh,
        "或伴随产线大额报废冲减"@zh,
        "特定料号积压、周转率持续下滑"@zh .

<urn:pxai:semi:playbook:kb.erp.yield_cost_impact_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "良率下降致单位成本上升排查（制造→财务跨域）"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:erp.anomaly.yield_cost_impact> ;
    ns1:economicImpactText """良率每降一档，固定制造费用摊到更少良品上，单位成本非线性上升。这是连接产线质量与 财务毛利的关键链路——纯从财务侧看只见成本升，须回溯到产线良率才能根治。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.erp.yield_cost_impact_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.erp.yield_cost_impact_triage%3A2> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.erp.yield_cost_impact_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.erp.yield_cost_impact_triage%3A2> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.erp.yield_cost_impact_triage%3A1>,
        <urn:pxai:semi:detection:kb.erp.yield_cost_impact_triage%3A2> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:core.metric.yield>,
        <urn:pxai:semi:catalog:erp.metric.cost_variance_rate> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:erp.action.revalue_standard_cost>,
        <urn:pxai:semi:catalog:erp.action.variance_analysis> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:core.anomaly.quality_excursion>,
        <urn:pxai:semi:catalog:erp.cause.overhead_allocation_drift> ;
    ns1:legacyId "kb.erp.yield_cost_impact_triage" ;
    ns1:symptomText "升幅与产线良率降幅同步"@zh,
        "单位成本上升但料价与工时标准未变"@zh,
        "良品产量下降、固定制造费用摊薄不足"@zh .

<urn:pxai:semi:playbook:kb.fab.cd_out_of_spec_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "CD 超规排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.cd_out_of_spec> ;
    ns1:economicImpactText """蚀刻前检出可重工挽回，损失约等于一次光刻的产能占用（含瓶颈机台工时）； 蚀刻后检出则整批面临判废，前段累计投入沉没。检出时点决定损失量级。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A3>,
        <urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A4> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A3>,
        <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A4>,
        <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A5>,
        <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A6> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.cd_out_of_spec_triage%3A1> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:fab.metric.cd_uniformity> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.cd_measure> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.expand_sampling>,
        <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.photo_rework>,
        <urn:pxai:semi:catalog:fab.action.recipe_adjust> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.hotplate_nonuniform>,
        <urn:pxai:semi:catalog:fab.cause.lens_contamination>,
        <urn:pxai:semi:catalog:fab.cause.recipe_misload>,
        <urn:pxai:semi:catalog:fab.cause.resist_lot_change>,
        <urn:pxai:semi:catalog:fab.param.exposure_dose>,
        <urn:pxai:semi:catalog:fab.param.exposure_focus> ;
    ns1:legacyId "kb.fab.cd_out_of_spec_triage" ;
    ns1:symptomText "CD-SEM 量测值偏离目标超出管制界限"@zh,
        "或均值整体偏移而分布宽度正常（偏移型）"@zh,
        "片内 3σ 恶化但均值仍在中心（均匀性型）"@zh .

<urn:pxai:semi:playbook:kb.fab.cmp_scratch_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "CMP 划伤排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.cmp_scratch> ;
    ns1:economicImpactText """金属层划伤致短路通常不可挽回。研磨垫换用周期是良率与耗材成本的 直接权衡点，也是这类异常最可控的经营旋钮。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.cmp_scratch_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.fab.cmp_scratch_triage%3A2> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.cmp_scratch_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.fab.cmp_scratch_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.fab.cmp_scratch_triage%3A3> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.cmp_scratch_triage%3A1>,
        <urn:pxai:semi:detection:kb.fab.cmp_scratch_triage%3A2> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:fab.metric.defect_density>,
        <urn:pxai:semi:catalog:fab.metric.film_thickness> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.defect_scan> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.replace_consumable> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.pad_end_of_life>,
        <urn:pxai:semi:catalog:fab.cause.slurry_agglomeration>,
        <urn:pxai:semi:catalog:fab.param.cmp_pressure> ;
    ns1:legacyId "kb.fab.cmp_scratch_triage" ;
    ns1:symptomText "划伤多呈弧形或直线，方向与研磨运动一致"@zh,
        "缺陷分类中线状划伤计数上升"@zh,
        "金属层划伤在电测阶段表现为短路"@zh .

<urn:pxai:semi:playbook:kb.fab.equipment_down_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "设备非计划停机通用排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:core.anomaly.equipment_down> ;
    ns1:economicImpactText """停机损失近似等于停机时长 × 该站产出率；瓶颈站不可通过后续赶工回补， 非瓶颈站在有缓冲时可部分吸收。两个可控旋钮：PM 依从性（用计划停机换 非计划停机，决定"是否发生"）与关键备件本地备货水位（用资金占用换 MTTR， 决定"停多久"）。若修复方案已明确却仍在等，瓶颈在备件调运或工程师到场， 不要继续往设备本体查。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.equipment_down_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.fab.equipment_down_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.fab.equipment_down_triage%3A3> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A3>,
        <urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A4> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.equipment_down_triage%3A1>,
        <urn:pxai:semi:detection:kb.fab.equipment_down_triage%3A2>,
        <urn:pxai:semi:detection:kb.fab.equipment_down_triage%3A3> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:core.metric.oee>,
        <urn:pxai:semi:catalog:core.metric.throughput>,
        <urn:pxai:semi:catalog:core.metric.wip> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.dispatch_field_service>,
        <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.skip_ahead> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.env_excursion>,
        <urn:pxai:semi:catalog:fab.cause.light_source_degradation>,
        <urn:pxai:semi:catalog:fab.cause.pm_overdue>,
        <urn:pxai:semi:catalog:fab.cause.reticle_stage_error> ;
    ns1:legacyId "kb.fab.equipment_down_triage" ;
    ns1:symptomText "OEE 可用率跌落；若停机点为瓶颈站，主流程 CT 同步拉长"@zh,
        "机台状态跳转为非计划停机(Down)，在机批次冻结在当前站点无法继续流动"@zh,
        "该站点 WIP 在数小时内累积，下游逐步出现供料饥饿"@zh .

<urn:pxai:semi:playbook:kb.fab.etch_residue_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "蚀刻残留排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.etch_residue> ;
    ns1:economicImpactText """残留若被后续金属层覆盖固化则完全不可挽回，且在 WAT 才暴露为短路， 届时前段投入已全部沉没。此处的拦截价值远高于处置成本。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.etch_residue_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.fab.etch_residue_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.fab.etch_residue_triage%3A3> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.etch_residue_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.fab.etch_residue_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.fab.etch_residue_triage%3A3> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.etch_residue_triage%3A1>,
        <urn:pxai:semi:detection:kb.fab.etch_residue_triage%3A2> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:fab.metric.defect_density>,
        <urn:pxai:semi:catalog:fab.metric.etch_depth> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.defect_scan> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.chamber_clean>,
        <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.recipe_adjust> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.chamber_polymer_buildup>,
        <urn:pxai:semi:catalog:fab.cause.epd_failure>,
        <urn:pxai:semi:catalog:fab.param.etch_time> ;
    ns1:legacyId "kb.fab.etch_residue_triage" ;
    ns1:symptomText "接触孔未开通或相邻图形桥连"@zh,
        "缺陷扫描出现应去除区域的材料残留"@zh,
        "蚀刻深度量测值低于目标"@zh .

<urn:pxai:semi:playbook:kb.fab.film_thickness_dev_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "薄膜膜厚偏移/均匀性超规排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev> ;
    ns1:economicImpactText """损失结构与突增类异常一致：检出前已连续加工的片数决定波及面， 所以真正的旋钮是量测抽样频次而不是事后处置速度。膜厚不足不可 回补，过厚仅少数层可靠 CMP 修正，多数情况只能判废。 介电层偏移的代价还有一层延迟——改变的是层间电容与击穿裕度， 要到 WAT/CP 才充分暴露，届时受影响批次已流过多道工序。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A3>,
        <urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A4> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A3>,
        <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A4>,
        <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A5> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.film_thickness_dev_triage%3A1>,
        <urn:pxai:semi:detection:kb.fab.film_thickness_dev_triage%3A2>,
        <urn:pxai:semi:detection:kb.fab.film_thickness_dev_triage%3A3> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:fab.metric.defect_density>,
        <urn:pxai:semi:catalog:fab.metric.film_thickness>,
        <urn:pxai:semi:catalog:fab.metric.sheet_resistance> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.pvd_metal> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.chamber_season>,
        <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.recipe_adjust>,
        <urn:pxai:semi:catalog:fab.action.replace_consumable> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.chamber_wall_condition>,
        <urn:pxai:semi:catalog:fab.cause.recipe_misload>,
        <urn:pxai:semi:catalog:fab.cause.target_end_of_life>,
        <urn:pxai:semi:catalog:fab.cause.target_erosion_profile>,
        <urn:pxai:semi:catalog:fab.param.chamber_pressure> ;
    ns1:legacyId "kb.fab.film_thickness_dev_triage" ;
    ns1:symptomText "片内径向剖面形状改变：中心与边缘的高低关系发生翻转"@zh,
        "腔体清洗或长时间待机后的首片明显偏离，随后逐片回稳"@zh,
        "金属层方阻与膜厚同向偏移（膜薄则方阻升高），可作为交叉确认"@zh,
        "随线膜厚量测超出上下规格，或片内均匀性指标超标"@zh .

<urn:pxai:semi:playbook:kb.fab.implant_dose_drift_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "注入剂量漂移排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.implant_dose_drift> ;
    ns1:economicImpactText """检出滞后是主要损失来源。WAT 暴露时批次已完成前段绝大部分工序， 累计加工成本全部沉没。增设中段方阻抽测的成本远低于一次批量失效。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.implant_dose_drift_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.fab.implant_dose_drift_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.fab.implant_dose_drift_triage%3A3> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.implant_dose_drift_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.fab.implant_dose_drift_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.fab.implant_dose_drift_triage%3A3> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.implant_dose_drift_triage%3A1>,
        <urn:pxai:semi:detection:kb.fab.implant_dose_drift_triage%3A2> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:fab.metric.sheet_resistance>,
        <urn:pxai:semi:catalog:fab.metric.wat_vt> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.wat> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.expand_sampling>,
        <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.recipe_adjust> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.beam_current_drift>,
        <urn:pxai:semi:catalog:fab.cause.recipe_misload>,
        <urn:pxai:semi:catalog:fab.param.implant_dose> ;
    ns1:legacyId "kb.fab.implant_dose_drift_triage" ;
    ns1:symptomText "WAT Vt 或方阻整批偏移，超出管制界限"@zh,
        "偏移集中于特定注入机台的批次"@zh,
        "前段各站点量测记录均正常（图形与膜厚无异常）"@zh .

<urn:pxai:semi:playbook:kb.fab.overlay_shift_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "套刻偏移排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.overlay_shift> ;
    ns1:economicImpactText """套刻偏移的代价高度依赖发现时机：在量测站拦下只是重工或报废单批， 漏到后续层则可能整批失效且已投入更多工序成本。 可返工层与不可返工层的处置逻辑完全不同，前者权衡重工成本， 后者直接是报废。若根因在机台侧，还要叠加该机台后续批次的 连带风险——这也是不建议根因未明就先重工的原因。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A3>,
        <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A4>,
        <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A5> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A3>,
        <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A4>,
        <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A5>,
        <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A6> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.overlay_shift_triage%3A1>,
