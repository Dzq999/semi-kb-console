        <urn:pxai:semi:detection:kb.fab.overlay_shift_triage%3A3> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:core.metric.yield>,
        <urn:pxai:semi:catalog:fab.metric.cd_uniformity>,
        <urn:pxai:semi:catalog:fab.metric.overlay_error> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.overlay_measure> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.clean_chuck>,
        <urn:pxai:semi:catalog:fab.action.dispatch_field_service>,
        <urn:pxai:semi:catalog:fab.action.hold_lot>,
