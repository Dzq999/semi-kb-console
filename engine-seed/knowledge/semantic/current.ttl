        <urn:pxai:semi:business-variable:business.fac.general_baseline%3Aprocess_yield>,
        <urn:pxai:semi:business-variable:business.fac.general_baseline%3Aselling_price>,
        <urn:pxai:semi:business-variable:business.fac.general_baseline%3Avariable_unit_cost> ;
    ns1:sourceRef "business/models/fac-baseline.yaml" .

