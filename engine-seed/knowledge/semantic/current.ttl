    rdf:subject <urn:pxai:semi:fac:digital_twin:facility_repair_r2> ;
    semi:confidence "medium" ;
    semi:sourceRef "https://semiconductorx.com/fab-ops-facility-management.html" ;
    semi:sourceType "web" .

