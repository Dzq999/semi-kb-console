@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix semi: <urn:pxai:semi:> .

semi:current-knowledge a owl:Ontology ;
    owl:imports semi:common .

semi:eqp.capability.ai_fault_detection_rca semi:supportsPredictiveMaintenance semi:eqp.plan.predictive_maintenance .

<urn:pxai:semi:ext:web:springer:telemetry_causal_integration_pattern_02> a semi:RCAEvidenceIntegrationPattern ;
    rdfs:label "遥测与因果分析集成模式02"@zh ;
    semi:description "将图像或传感器分析、设备时间序列、模式识别和因果建模组织为故障检测与根因分析证据链的行业模式，同时保留数据质量与可解释性限制。" ;
    semi:modelingLimitationText "公开综述支持行业层面的能力模式，但不能据此声明特定工厂的检测准确率、停机减少量、良率提升或收益。" ;
    semi:nameZh "遥测与因果分析集成模式02" ;
    semi:sourceRef "https://link.springer.com/article/10.1007/s00170-026-18777-0" ;
    semi:sourceType "web" .

<urn:pxai:semi:fac:digital_twin:facility_repair_r2> a semi:FacilityDigitalTwin ;
    rdfs:label "设施级数字孪生门禁修复实体"@zh ;
    semi:hasEvent <urn:pxai:semi:fac:event:infrastructure_repair_r2> ;
    semi:hasSubsystem <urn:pxai:semi:fac:utility:multi_system_repair_r2> ;
    semi:sourceRef "https://semiconductorx.com/fab-ops-facility-management.html" ;
    semi:sourceType "web" .

<urn:pxai:semi:fac:fms:utility_integration_repair_r2> a semi:FacilityManagementSystem ;
    rdfs:label "公用系统集成型厂务管理系统门禁修复实体"@zh ;
    semi:aggregatesUtilityData <urn:pxai:semi:fac:utility:multi_system_repair_r2> ;
    semi:sourceRef "https://semiconductorx.com/fab-ops-facility-management.html" ;
    semi:sourceType "web" .

<urn:pxai:semi:scenario:fab_quality_excursion_capacity_recovery_whatif_repair> a semi:SimulationScenario ;
    rdfs:label "品质异常背景下的光刻产能恢复方向性情景"@zh ;
    semi:description "使用既有通用晶圆厂经营模型，以光刻产能增量代理异常处置后的产能恢复，评估受约束投入量与可销售产出的方向性变化。" ;
    semi:hasOperationalImpactChain <urn:pxai:semi:impactchain:fab_quality_excursion_business_impact_repair> ;
    semi:modelingLimitationText "干预变量和值沿用既有模型与示例，仅用于What-if业务讨论，不表示品质异常必然由光刻设备造成，也不代表现场实测改善或客户承诺。" ;
    semi:nameZh "品质异常背景下的光刻产能恢复方向性情景" ;
    semi:sourceRef "business/models/fab-baseline.yaml",
        "simulation/scenarios/fab-capacity-recovery.yaml" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:scenario:fab_quality_excursion_fragmented_analysis_repair> a semi:BusinessScenarioCard ;
    rdfs:label "晶圆厂品质异常跨系统分析场景"@zh ;
    semi:decisionUseText "用于确定异常调查的数据准备范围、证据边界和经营影响评估入口，不代替工程审批或现场处置决策。" ;
    semi:description "面向品质异常突发的业务场景，组织图像、传感器、制程和维护证据，支持从异常识别到根因分析及经营影响沟通。" ;
    semi:hasOperationalImpactChain <urn:pxai:semi:impactchain:fab_quality_excursion_business_impact_repair> ;
    semi:hasPainPattern <urn:pxai:semi:pain:fab_fragmented_rca_analysis_repair> ;
    semi:nameZh "晶圆厂品质异常跨系统分析场景" ;
    semi:sourceRef "https://link.springer.com/article/10.1007/s00170-026-18777-0" ;
    semi:sourceType "web" .

semi:validation.release_gate.current_review semi:hasEvidence semi:validation.review.evidence_completeness,
        semi:validation.review.provenance_quality .

<urn:pxai:semi:validation:gate:critical-anomaly-release-round1> semi:confidence "low" ;
    semi:decisionUseText "阻止将缺少可核查现场证据的关键异常覆盖结论作为已验证事实发布。" ;
    semi:gateDecisionCode "BLOCK" ;
    semi:hasValidationFinding <urn:pxai:semi:validation:finding:equipment-down-evidence-gap-round1>,
        <urn:pxai:semi:validation:finding:quality-excursion-evidence-gap-round1> ;
    semi:releaseBlockingFlag "true" ;
    semi:sourceRef "model_prior:round1.gap_analysis.uncovered" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:validation:ontology-validation-report-r1> a semi:OntologyValidationReport ;
    rdfs:label "异常覆盖本体校验报告R1"@zh ;
    semi:containsOntologyValidationResult <urn:pxai:semi:validation:equipment-anomaly-coverage-finding-r1>,
        <urn:pxai:semi:validation:quality-anomaly-coverage-finding-r1> ;
    semi:derivedFrom <urn:pxai:semi:validation:ontology-validation-run-r1> ;
    semi:gateDecisionCode "BLOCK" ;
    semi:hasValidationFinding <urn:pxai:semi:validation:equipment-anomaly-coverage-finding-r1>,
        <urn:pxai:semi:validation:quality-anomaly-coverage-finding-r1> ;
    semi:ontologyReportConforms "false" ;
    semi:releaseBlockingFlag "true" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:validation:review:quality-gate-round1> semi:confidence "low" ;
    semi:evaluatesFocusEntity <urn:pxai:semi:instance:equipment-downtime-anomaly-round1>,
        <urn:pxai:semi:instance:quality-excursion-anomaly-round1> ;
    semi:evidenceCoverageRatio "0" ;
    semi:hasValidationFinding <urn:pxai:semi:validation:finding:equipment-down-evidence-gap-round1>,
        <urn:pxai:semi:validation:finding:quality-excursion-evidence-gap-round1> ;
    semi:reviewStatusCode "INSUFFICIENT_EVIDENCE" ;
    semi:sourceRef "model_prior:round1.gap_analysis.uncovered" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:anomaly:fab_quality_excursion_delayed_detection_repair> a semi:QualityExcursionAnomaly ;
    rdfs:label "晶圆厂品质异常延迟识别事件"@zh ;
    semi:description "高维动态制造数据和跨系统信息难以由传统监控及时综合分析时，品质偏差可能未被及时识别，并进一步影响良率或产品可靠性。" ;
    semi:nameZh "晶圆厂品质异常延迟识别事件" ;
    semi:severity "critical" ;
    semi:sourceRef "https://link.springer.com/article/10.1007/s00170-026-18777-0" ;
    semi:sourceType "web" .

<urn:pxai:semi:fac:event:infrastructure_repair_r2> a semi:FacilityInfrastructureEvent ;
    rdfs:label "厂务基础设施事件门禁修复实体"@zh ;
    semi:aboutEntity <urn:pxai:semi:fac:utility:multi_system_repair_r2> ;
    semi:sourceRef "https://semiconductorx.com/fab-ops-facility-management.html" ;
    semi:sourceType "web" .

<urn:pxai:semi:impact:economic_quality_excursion_scrap_delivery_repair> a semi:EconomicImpact ;
    rdfs:label "品质异常的报废返工与交付经营影响"@zh ;
    semi:economicImpactText "品质偏差对良率和可靠性的影响可能沿生产流程形成报废、返工、可销售产出受限及交付风险；具体影响幅度必须结合现场数据和经营模型评估。" ;
    semi:nameZh "品质异常的报废返工与交付经营影响" ;
    semi:sourceRef "https://link.springer.com/article/10.1007/s00170-026-18777-0" ;
    semi:sourceType "web" .

<urn:pxai:semi:pain:fab_fragmented_rca_analysis_repair> a semi:CustomerProblemPainPattern ;
    rdfs:label "晶圆厂分散数据根因分析痛点模式"@zh ;
    semi:nameZh "晶圆厂分散数据根因分析痛点模式" ;
    semi:painPointText "传统监控难以处理高维动态制造数据，工程人员需要跨图像、传感器、制程和维护信息进行人工交叉分析，导致异常证据汇集和根因定位负担增加。" ;
    semi:sourceRef "https://link.springer.com/article/10.1007/s00170-026-18777-0" ;
    semi:sourceType "web" .

<urn:pxai:semi:validation:equipment-downtime-detection-metric-r1> a semi:Metric ;
    rdfs:label "设备停机检测指标R1"@zh ;
    semi:identifier "METRIC-EQUIPMENT-DOWNTIME-DETECTION-R1" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:validation:ontology-validation-run-r1> a semi:OntologyValidationRun ;
    rdfs:label "异常覆盖本体校验执行R1"@zh ;
    semi:evaluatesFocusEntity <urn:pxai:semi:validation:equipment-downtime-anomaly-case-r1>,
        <urn:pxai:semi:validation:quality-excursion-anomaly-case-r1> ;
    semi:evaluatesOntologyConstraint <urn:pxai:semi:validation:anomaly-detection-traceability-constraint-r1> ;
    semi:sourceType "model_prior" ;
    semi:validationStatus "failed" .

<urn:pxai:semi:validation:quality-excursion-detection-metric-r1> a semi:Metric ;
    rdfs:label "品质异常突发检测指标R1"@zh ;
    semi:identifier "METRIC-QUALITY-EXCURSION-DETECTION-R1" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:impactchain:fab_quality_excursion_business_impact_repair> a semi:OperationalImpactChain ;
    rdfs:label "晶圆厂品质异常至经营影响链"@zh ;
    semi:aboutEntity <urn:pxai:semi:anomaly:fab_quality_excursion_delayed_detection_repair> ;
    semi:impactMechanismText "制造偏差未被及时识别后，可能影响制程良率与产品可靠性，并进一步形成返工、报废、产出受限和交付风险。" ;
    semi:linksAnomalyToImpact <urn:pxai:semi:impact:economic_quality_excursion_scrap_delivery_repair> ;
    semi:modelingLimitationText "公开行业资料仅支持影响机制，不支持将任何改善比例、损失金额或处置周期视为特定工厂实测结果。" ;
    semi:nameZh "晶圆厂品质异常至经营影响链" ;
    semi:sourceRef "https://link.springer.com/article/10.1007/s00170-026-18777-0" ;
    semi:sourceType "web" .

<urn:pxai:semi:instance:equipment-downtime-anomaly-round1> semi:confidence "low" ;
    semi:identifier "core.anomaly.equipment_down" ;
    semi:severity "high" ;
    semi:sourceRef "model_prior:round1.gap_analysis.uncovered" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:instance:quality-excursion-anomaly-round1> semi:confidence "low" ;
    semi:identifier "core.anomaly.quality_excursion" ;
    semi:severity "critical" ;
    semi:sourceRef "model_prior:round1.gap_analysis.uncovered" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:validation:equipment-anomaly-coverage-finding-r1> a semi:ConstraintViolationValidationResult,
        semi:ValidationFinding ;
    rdfs:label "设备停机异常覆盖违规发现项R1"@zh ;
    semi:evaluatesFocusEntity <urn:pxai:semi:validation:equipment-downtime-anomaly-case-r1> ;
    semi:evaluatesOntologyConstraint <urn:pxai:semi:validation:anomaly-detection-traceability-constraint-r1> ;
    semi:findingCode "FIND-EQUIPMENT-DOWNTIME-COVERAGE-R1" ;
    semi:releaseBlockingFlag "true" ;
    semi:severity "high" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:validation:equipment-downtime-anomaly-case-r1> a semi:EquipmentDowntimeAnomaly ;
    rdfs:label "设备停机异常校验案例R1"@zh ;
    semi:affectsEquipment <urn:pxai:semi:validation:equipment-downtime-subject-equipment-r1> ;
    semi:detectedByMetric <urn:pxai:semi:validation:equipment-downtime-detection-metric-r1> ;
    semi:legacyId "core.anomaly.equipment_down" ;
    semi:severity "high" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:validation:equipment-downtime-subject-equipment-r1> a semi:Equipment ;
    rdfs:label "设备停机异常焦点设备R1"@zh ;
    semi:equipmentCode "VALIDATION-SUBJECT-EQUIPMENT-R1" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:validation:finding:equipment-down-evidence-gap-round1> semi:confidence "low" ;
    semi:description "设备停机异常尚无现场设备日志、维护记录或状态事件证据，当前不能作为已验证异常覆盖结果发布。" ;
    semi:evaluatesFocusEntity <urn:pxai:semi:instance:equipment-downtime-anomaly-round1> ;
    semi:findingCode "EQUIPMENT_DOWN_EVIDENCE_GAP" ;
    semi:releaseBlockingFlag "true" ;
    semi:requiredEvidenceType "设备状态事件、维护日志或可追溯生产记录" ;
    semi:severity "high" ;
    semi:sourceRef "model_prior:round1.gap_analysis.uncovered" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:validation:finding:quality-excursion-evidence-gap-round1> semi:confidence "low" ;
    semi:description "品质异常突发尚无量测结果、SPC记录、缺陷观测或批次履历证据，当前不能作为已验证异常覆盖结果发布。" ;
    semi:evaluatesFocusEntity <urn:pxai:semi:instance:quality-excursion-anomaly-round1> ;
    semi:findingCode "QUALITY_EXCURSION_EVIDENCE_GAP" ;
    semi:releaseBlockingFlag "true" ;
    semi:requiredEvidenceType "量测结果、SPC记录、缺陷观测或可追溯批次履历" ;
    semi:severity "critical" ;
    semi:sourceRef "model_prior:round1.gap_analysis.uncovered" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:validation:quality-anomaly-coverage-finding-r1> a semi:ConstraintViolationValidationResult,
        semi:ValidationFinding ;
    rdfs:label "品质异常突发覆盖违规发现项R1"@zh ;
    semi:evaluatesFocusEntity <urn:pxai:semi:validation:quality-excursion-anomaly-case-r1> ;
    semi:evaluatesOntologyConstraint <urn:pxai:semi:validation:anomaly-detection-traceability-constraint-r1> ;
    semi:findingCode "FIND-QUALITY-EXCURSION-COVERAGE-R1" ;
    semi:releaseBlockingFlag "true" ;
    semi:severity "critical" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:validation:quality-excursion-anomaly-case-r1> a semi:QualityExcursionAnomaly ;
    rdfs:label "品质异常突发校验案例R1"@zh ;
    semi:affectsEquipment <urn:pxai:semi:validation:equipment-downtime-subject-equipment-r1> ;
    semi:detectedByMetric <urn:pxai:semi:validation:quality-excursion-detection-metric-r1> ;
    semi:legacyId "core.anomaly.quality_excursion" ;
    semi:severity "critical" ;
    semi:sourceType "model_prior" .

<urn:pxai:semi:fac:utility:multi_system_repair_r2> a semi:UtilitySystem ;
    rdfs:label "多公用系统监测对象门禁修复实体"@zh ;
    semi:sourceRef "https://semiconductorx.com/fab-ops-facility-management.html" ;
    semi:sourceType "web" .

<urn:pxai:semi:validation:anomaly-detection-traceability-constraint-r1> a semi:OntologyIntegrityConstraint,
        semi:SemanticConsistencyConstraint ;
    rdfs:label "异常检测可追溯性约束R1"@zh ;
    semi:ontologyConstraintCode "VAL-ANOMALY-DETECTION-TRACE-R1" ;
    semi:ontologyConstraintMessage "异常实例应关联检测指标；涉及设备影响时还应关联受影响设备，并由校验发现项指明焦点实体。" ;
    semi:requiredEvidenceType "检测指标关联与受影响设备关联" ;
    semi:sourceType "model_prior" .

