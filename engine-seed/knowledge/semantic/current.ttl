        <urn:pxai:semi:catalog:fab.cause.env_excursion>,
        <urn:pxai:semi:catalog:fab.cause.lens_heating_drift>,
        <urn:pxai:semi:catalog:fab.cause.recipe_misload>,
        <urn:pxai:semi:catalog:fab.cause.wafer_backside_contamination>,
        <urn:pxai:semi:catalog:fab.param.overlay_offset> ;
    ns1:legacyId "kb.fab.overlay_shift_triage" ;
    ns1:symptomText "下游蚀刻被阻塞，等待处置决定"@zh,
        "偏移可能表现为全片系统性分量，或场内分量，或局部不规则分布"@zh,
        "套刻量测显示对位误差超出规格，批次在量测站被拦下"@zh .

<urn:pxai:semi:playbook:kb.fab.particle_excursion_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "颗粒突增排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.particle_excursion> ;
    ns1:economicImpactText """影响面取决于检出延迟：光罩类问题影响该光罩全部曝光批次， 环境类问题波及全区。这类异常的经济损失主要由发现速度决定， 而非缺陷本身严重度。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A3>,
        <urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A4> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A3>,
        <urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A4>,
        <urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A5> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.particle_excursion_triage%3A1> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.defect_scan> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.chamber_clean>,
        <urn:pxai:semi:catalog:fab.action.expand_sampling>,
        <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.reticle_clean> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.chamber_polymer_buildup>,
        <urn:pxai:semi:catalog:fab.cause.env_excursion>,
        <urn:pxai:semi:catalog:fab.cause.reticle_haze>,
        <urn:pxai:semi:catalog:fab.cause.slurry_agglomeration>,
        <urn:pxai:semi:catalog:fab.cause.target_end_of_life> ;
    ns1:legacyId "kb.fab.particle_excursion_triage" ;
    ns1:symptomText "可能同时影响多个产品与多个批次"@zh,
        "缺陷图(Defect Map)呈现特定空间分布形态"@zh,
        "缺陷密度较基线突然跃升数倍"@zh .

<urn:pxai:semi:playbook:kb.fab.quality_excursion_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "品质异常突变通用排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:core.anomaly.quality_excursion> ;
    ns1:economicImpactText """损失主要由发现速度决定而非偏移本身严重度：检出前已连续加工的片数决定 波及面，累计加工成本随暴露延迟沉没。真正的旋钮是量测抽样频次（把检出 提前）而不是事后处置速度。电性/介电类偏移还有一层延迟——要到 WAT/CP 才充分暴露，届时受影响批次已流过多道工序。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.quality_excursion_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.fab.quality_excursion_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.fab.quality_excursion_triage%3A3> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.quality_excursion_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.fab.quality_excursion_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.fab.quality_excursion_triage%3A3>,
        <urn:pxai:semi:cause-assertion:kb.fab.quality_excursion_triage%3A4> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.quality_excursion_triage%3A1>,
        <urn:pxai:semi:detection:kb.fab.quality_excursion_triage%3A2>,
        <urn:pxai:semi:detection:kb.fab.quality_excursion_triage%3A3> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:core.metric.yield>,
        <urn:pxai:semi:catalog:fab.metric.defect_density>,
        <urn:pxai:semi:catalog:fab.metric.wat_vt> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.expand_sampling>,
        <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.recipe_adjust> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.beam_current_drift>,
        <urn:pxai:semi:catalog:fab.cause.chamber_wall_condition>,
        <urn:pxai:semi:catalog:fab.cause.env_excursion>,
        <urn:pxai:semi:catalog:fab.cause.recipe_misload> ;
    ns1:legacyId "kb.fab.quality_excursion_triage" ;
    ns1:symptomText "偏移的分布形态（按机台/批次/时段/空间位置）是定位责任源的关键"@zh,
        "品质指标（良率/缺陷/电性）较基线突然跃变，超出管制界限"@zh,
        "缺陷分类比例或电性参数往往早于良率暴露，是更早的观测量"@zh .

<urn:pxai:semi:playbook:kb.fab.scanner_down_triage> a ns1:DiagnosticPlaybook ;
    rdfs:label "光刻机非计划停机排查与处置"@zh ;
    ns1:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.scanner_down> ;
    ns1:economicImpactText """光刻是典型瓶颈站点，停机损失近似等于停机时长 × 瓶颈产出率， 且不可通过后续赶工完全回补。可控旋钮有两个：PM 依从性 （用计划停机换非计划停机）与关键备件本地备货水位（用资金占用换停机时长）。 后者决定 MTTR 而非停机是否发生——若修复方案已明确却仍在等， 瓶颈就在备件调运或原厂工程师到场，不要继续往设备本体查。
"""@zh ;
    ns1:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.scanner_down_triage%3A1>,
        <urn:pxai:semi:action-instruction:kb.fab.scanner_down_triage%3A2>,
        <urn:pxai:semi:action-instruction:kb.fab.scanner_down_triage%3A3> ;
    ns1:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.scanner_down_triage%3A1>,
        <urn:pxai:semi:cause-assertion:kb.fab.scanner_down_triage%3A2>,
        <urn:pxai:semi:cause-assertion:kb.fab.scanner_down_triage%3A3>,
        <urn:pxai:semi:cause-assertion:kb.fab.scanner_down_triage%3A4> ;
    ns1:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.scanner_down_triage%3A1>,
        <urn:pxai:semi:detection:kb.fab.scanner_down_triage%3A2>,
        <urn:pxai:semi:detection:kb.fab.scanner_down_triage%3A3> ;
    ns1:hasDetectionMetric <urn:pxai:semi:catalog:core.metric.oee>,
        <urn:pxai:semi:catalog:core.metric.throughput>,
        <urn:pxai:semi:catalog:core.metric.wip> ;
    ns1:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.photo_exposure> ;
    ns1:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.dispatch_field_service>,
        <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.skip_ahead> ;
    ns1:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.env_excursion>,
        <urn:pxai:semi:catalog:fab.cause.light_source_degradation>,
        <urn:pxai:semi:catalog:fab.cause.pm_overdue>,
        <urn:pxai:semi:catalog:fab.cause.reticle_stage_error> ;
    ns1:legacyId "kb.fab.scanner_down_triage" ;
    ns1:symptomText "OEE 可用率跌落，主流程 CT 同步拉长"@zh,
        "光刻区 WIP 在数小时内快速累积，队列长度陡增"@zh,
        "机台报警停机，曝光工序在制批次无法继续流动"@zh .

