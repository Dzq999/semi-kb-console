<urn:pxai:semi:catalog:fab.material.photoresist> a ns1:CatalogConcept,
        ns1:MaterialType ;
    skos:definition """感光高分子材料，有效期与储存温度敏感。批号切换是 CD 漂移的 常见系统性成因，需做批号对比验证。
"""@zh ;
    skos:notation "fab.material.photoresist" ;
    skos:prefLabel "Photoresist"@en,
        "光阻"@zh ;
    ns1:legacyId "fab.material.photoresist" .

<urn:pxai:semi:catalog:fab.material.reticle> a ns1:CatalogConcept,
        ns1:MaterialType ;
    skos:definition """承载图形的石英掩膜版。表面沾污或雾化(Haze)会在所有曝光场重复 出现同位置缺陷，是"规律性重复缺陷"的首要排查对象。
"""@zh ;
    skos:notation "fab.material.reticle" ;
    skos:prefLabel "Reticle / Photomask"@en,
        "光罩"@zh ;
    ns1:legacyId "fab.material.reticle" .

<urn:pxai:semi:catalog:fab.process.wafer_start> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """裸片开卡投入产线，绑定产品别、Route 与批次号。投料节奏决定全线 WIP 基线水位，脉冲式投料是下游 WIP 堆积的常见上游成因。
"""@zh ;
    skos:notation "fab.process.wafer_start" ;
    skos:prefLabel "Wafer Start"@en,
        "投料"@zh ;
    ns1:legacyId "fab.process.wafer_start" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:core.metric.wip> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.diffusion> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.lot>,
        <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.wafer_clean> .

<urn:pxai:semi:catalog:fab.stage.implant> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "Implant",
        "植入",
        "离子布植" ;
    skos:definition """注入掺杂离子形成结区。剂量(Dose)与能量(Energy)决定电学参数， 注入后需退火激活并修复晶格损伤。
"""@zh ;
    skos:notation "fab.stage.implant" ;
    skos:prefLabel "Ion Implantation"@en,
        "离子注入"@zh ;
    ns1:legacyId "fab.stage.implant" .

<urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.efo_electrode_fouling> ;
    ns1:discriminatorText """报警集中在成球(FAB)阶段而非焊接阶段，且故障频次随打线点数累积上升。 查电极累积放电次数，清洗后立即恢复即可确认。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.wire_feed_jam> ;
    ns1:discriminatorText """停机形态是频繁短停，穿线复位即恢复，不伴随键合质量指标劣化。 这一点与瓷嘴磨损相反：后者拉力下降但机台不一定停。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.bond_head_servo_fault> ;
    ns1:discriminatorText """报警指向 Z 轴定位或换能器自检，与成球、送线环节无关。 复位无效且需原厂介入是强信号——此时不要继续在耗材上排查。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A4> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.capillary_wear> ;
    ns1:discriminatorText """主要表现为拉力/球剪切下降，通常先触发质量异常而非停机； 只有在瓷嘴堵塞导致送线受阻时才停机，需与卡线区分。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A5> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.fixture_shortage> ;
    ns1:discriminatorText """机台本身完好，停的是"没治具可上"。查治具台账即可排除， 它是排产型成因，处置走调配而非维修。
"""@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.ap.delamination_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.emc_moisture> ;
    ns1:discriminatorText """取该批塑封料的开封时刻与车间温湿度记录，按 MSL 等级比对 floor life 门槛（30°C 条件下 MSL 2 为 1 年、2a 为 4 周、 3 为 168 小时、4 为 72 小时、5 为 48 小时、5a 为 24 小时； MSL 1 不限、MSL 6 须用前烘烤）。暴露时长超过对应门槛即确认 吸湿为主因。两个辅助判别：分层跨模腔随机分布而非集中， 且同期开封的其他批次同步出现。注意车间高于 30°C 或 相对湿度高于 60% 时实际 floor life 短于表值，不能直接套用。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.delamination_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.pad_contamination> ;
    ns1:discriminatorText """分层集中在固定界面（焊垫或芯粒背面）而非随机分布， 且能追到特定等离子清洁批次或上游制程时窗。 与吸湿最快的区分：调整料的储存条件后不改善， 而追加等离子清洁后改善。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.delamination_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.param.cure_temp> ;
    ns1:discriminatorText """调固化温度记录，分层与特定烘箱或时段吻合， 且位置偏向装片胶界面而非塑封料界面。 温度不足致交联不全，此时芯粒剪切强度同步偏低—— 这一点可与吸湿区分，吸湿通常不压低剪切强度。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.dicing_chipping_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.blade_wear> ;
    ns1:discriminatorText """崩边尺寸随刀片累积切割长度单调上升，换刀后立即恢复。 若为局部崩齿，则崩边在固定切割位置突发出现。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.dicing_chipping_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.param.cut_feed_speed> ;
    ns1:discriminatorText "与配方变更时点重合，或为提产能而调高进给速度后出现"@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.dicing_chipping_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.param.blade_rpm> ;
    ns1:discriminatorText "转速与进给失配，查主轴转速实测值与设定值偏差"@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.grind_wheel_clog> ;
    ns1:discriminatorText """裂纹起始于背面且呈亚表面延伸特征。查砂轮使用时长与研磨电流趋势 （电流上升指示切削效率下降）。此成因在减薄站不可检， 须靠上游参数记录回溯。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.anomaly.dicing_chipping> ;
    ns1:discriminatorText """裂纹起始于芯粒边缘且与崩边位置连续。查同批崩边量测数据， 若崩边尺寸已接近上限，则裂纹是崩边扩展的结果， 处置应回到切割站而非装片站。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.param.die_bond_force> ;
    ns1:discriminatorText """裂纹呈中心放射状且与装片压力施加位置吻合，集中于特定装片机台。 薄芯粒产品尤其敏感。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A4> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.param.grind_feed_rate> ;
    ns1:discriminatorText "与减薄配方变更时点重合，查参数变更记录"@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.probe_card_wear> ;
    ns1:discriminatorText """伪失效的三个特征：重测通过率高、失效集中于特定 Site 或针位、 失效 Bin 多为开路/接触类。三者同时出现基本可确认。 这是首要排除项——若不先排除，会把良品当不良追查工艺，方向全错。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> ;
    ns1:discriminatorText """失效 Bin 为开路且重测不通过，回溯该批键合站拉力数据异常。 属键合不良的延迟暴露。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.anomaly.delamination> ;
    ns1:discriminatorText "失效随温度变化（高温测试失效率明显高），超声扫描可确认分层"@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A4> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.anomaly.die_crack> ;
    ns1:discriminatorText "失效无规律且分布随机，外观或 X-Ray 可见裂纹"@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A5> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.param.test_time> ;
    ns1:discriminatorText "与缩测方案上线时点重合，须复核测试覆盖率是否被削弱"@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.ap.missing_ball_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.flux_print_defect> ;
    ns1:discriminatorText """首要排除项。看不良的空间分布：跟印刷版面或治具孔位走（位置固定、 同版面重复出现）指向印刷不良；跟炉内温区走（沿炉长方向或按载具 位置分布）指向回流。缺球与连球同批共存也指向本成因—— 印刷黏度过低渗出致连球、过高填不满致缺球，同一物性两侧偏离 产生两种相反的表观不良。再查黏性：黏性不足时锡球在搬运中移位， 缺球位置随机而非固定，这一支与印刷量不足要分开看。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.missing_ball_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.reflow_profile_drift> ;
    ns1:discriminatorText """不良沿炉长方向或按载具位置呈梯度分布，且与炉温曲线仪校核记录的 温区衰退、链速偏移时点吻合。与印刷不良的关键区分：本成因下 印刷后（回流前）的检查是正常的——若厂内有回流前抽检， 一次比对即可定案，不必等 AOI。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.missing_ball_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.param.reflow_peak_temp> ;
    ns1:discriminatorText """与配方变更时点重合。峰值偏低时润湿不足致缺球且锡球形貌偏球形 残留；偏高时助焊剂在到达润湿温度前已耗尽或流失， 表观是锡球起皱与氧化。查参数变更记录，不要与炉体衰退混判—— 前者是设定变了，后者是设定没变而实际受热变了。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.emc_moisture> ;
    ns1:discriminatorText """查塑封料开封时间与储存条件。若开封超期或未低温储存， 空洞会跨模腔随机分布。返烤后改善即确认——这是与设备型成因 最快的区分方法。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.param.transfer_speed> ;
    ns1:discriminatorText "空洞位置与流动前沿末端吻合（远离注料口侧），降速后改善"@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.param.mold_pressure> ;
    ns1:discriminatorText "空洞集中于特定模腔且该腔排气槽有堵塞，属模具维护问题"@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A4> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.param.mold_temp> ;
    ns1:discriminatorText "温度偏低致黏度过高，通常伴随包封不全而非仅空洞"@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.anomaly.bonder_down> ;
    ns1:discriminatorText """查该站可用机台数与 E10 状态分布。若 Unscheduled Down 台数上升， 即为设备型。键合站机台数多，需看的是"可用台数占比"而非单机状态—— 单台停机通常不足以形成堆积。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.fixture_shortage> ;
    ns1:discriminatorText """机台状态显示 Standby（待料/待治具）而非 Down，且该产品别的治具或 载具在线数量不足。这是后段最容易被漏查的成因——设备报表看起来正常， 产能却锁死。判别关键在于区分 Standby 与 Down。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> ;
    ns1:discriminatorText """堆积批次中 Hold 状态占比高，且 Hold 原因为键合品质。 此时堆积是品质异常的后果而非产能问题，处置方向完全不同—— 应先解决品质判定，加派机台无效。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A4> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.process.wafer_receive> ;
    ns1:discriminatorText """回溯前 1~2 周收片量曲线。若出现投料脉冲（如前段集中交付）， 堆积会沿流程逐站传导，键合站只是显现位置而非根源。 特征是上游各站 WIP 也依次偏高。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A5> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:core.state.hold> ;
    ns1:discriminatorText "堆积批次长期未流动且 Hold 未解除，属流程管理问题而非产能问题"@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.capillary_wear> ;
    ns1:discriminatorText """不良集中于特定机台特定线位，且随该瓷嘴键合次数累积恶化。 换瓷嘴后立即恢复即确认。这是最常见也最容易验证的成因。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.epoxy_bleed> ;
    ns1:discriminatorText """目检焊垫可见胶体残留，且不良与特定装片机台关联。 属跨工序传导——键合站是显现位置，责任在装片站， 单纯调键合参数只会掩盖问题。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.pad_contamination> ;
    ns1:discriminatorText """全线跨机台同步出现，且追加等离子清洁后显著改善。 若污染源在前段（钝化层残留），需与晶圆厂协同， 判别方法是比对不同前段批号的不良率差异。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A4> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.param.bond_power> ;
    ns1:discriminatorText "与线材批号切换时点重合，需重建工艺窗口而非微调"@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A5> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:ap.cause.bond_param_drift> ;
    ns1:discriminatorText "同机台所有线位缓慢恶化，查换能器效率与加热台温度校验记录"@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.erp.billing_block_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:erp.cause.credit_limit_exceeded> ;
    ns1:discriminatorText """订单带信用冻结标记，客户未清应收+在途订单超授信额度。查客户信用敞口与额度—— 敞口超限是信用管理自动冻结的签名，需信用侧介入，非物流问题。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.erp.billing_block_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:erp.cause.delivery_not_posted> ;
    ns1:discriminatorText """订单无信用冻结但交货单 PGI 未过账，货权未转移不能开票。查交货单状态—— 物流未闭环型的特征是"信用正常、卡在发货过账"，与信用冻结的区分在单据状态。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.erp.cost_variance_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:erp.cause.purchase_price_swing> ;
    ns1:discriminatorText """价差随用量放大、且与硅片/靶材/化学品行情同步。查采购价格历史(PPV)， 若料价曲线与差异起点重合，即为采购价波动型。这是与标准过时型最关键的区分—— 价格波动是短期的，标准过时是持续单向的。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.erp.cost_variance_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:erp.cause.standard_cost_outdated> ;
    ns1:discriminatorText """全线同向差异且持续存在，标准成本上次重估距今过久。查标准成本版本日期， 若差异跨多料号、多期稳定同向，基本可确认标准过时。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.erp.cost_variance_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:erp.cause.overhead_allocation_drift> ;
    ns1:discriminatorText """差异集中于单一成本中心，其余成本中心正常。调阅该成本中心的分摊基准(工时/机时) 与实际是否偏离——分摊失真只影响成本对象间分配，不改变总成本，这是判别关键。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.erp.depreciation_error_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:erp.cause.asset_master_error> ;
    ns1:discriminatorText """同一资产类下多项资产折旧同向偏差。查该资产类的折旧方法/使用年限/残值主数据—— 全类同向是主数据错误的签名。若累计折旧已超原值，几乎可确认年限或方法设错。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.erp.depreciation_error_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:erp.cause.capitalization_delay> ;
    ns1:discriminatorText """仅单项资产异常且与在建工程转固时点相关。查该资产资本化日期与投产日期是否错位—— 转固延迟使折旧起始期错位，特征是"仅这一项、且时点可追"，与全类主数据错误相区分。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.erp.gr_ir_mismatch_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:erp.cause.invoice_not_received> ;
    ns1:discriminatorText """挂账项为"已收货未开票"，采购订单已收货但供应商发票未到。查 GR/IR 明细的收货/发票 两侧余额——单边(仅收货)挂账即发票未达型，属时间差，催票流程可解，非差错。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.erp.gr_ir_mismatch_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:erp.cause.po_invoice_discrepancy> ;
    ns1:discriminatorText """收货与发票都在但金额/数量不符，系统挂起无法自动清。核对采购订单价、收货数量、 发票金额三者——两侧都有却清不掉，即差异型，需采购与应付协同处理。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.erp.inventory_writedown_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:erp.cause.inventory_obsolescence> ;
    ns1:discriminatorText """特定料号周转率单调下滑、库龄拉长，且制程已迭代到新节点。查库龄分布与周转趋势—— 呆滞型的签名是"越积越久、市场已不需要"，是半导体存货减值的首因。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.erp.inventory_writedown_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:erp.cause.purchase_price_swing> ;
    ns1:discriminatorText """市价普跌导致 NRV 下降，但料号本身周转正常。与呆滞型的区分：呆滞是这批货卖不动， 市价型是能卖但售价跌破成本。看周转率是否正常即可分流。
"""@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.erp.yield_cost_impact_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:core.anomaly.quality_excursion> ;
    ns1:discriminatorText """单位成本升幅与良率降幅同步、且产量同步下降，指向良率损失经成本吸收传导。 这是"良率是财务问题"的接点：查产线良率趋势与单位成本趋势是否同期拐点。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.erp.yield_cost_impact_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:erp.cause.overhead_allocation_drift> ;
    ns1:discriminatorText """若良率平稳而单位成本仍升，回到分摊基准失真的排查，而非良率吸收。 良率吸收型的特征是分母(良品数)变小，分摊失真型是分摊规则本身变了。
"""@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.param.exposure_dose> ;
    ns1:discriminatorText """全片均匀偏移且方向与剂量变化一致。查 Scanner 光源能量趋势与照度校正记录； 若同机台所有产品同向偏移，基本可确认。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.hotplate_nonuniform> ;
    ns1:discriminatorText """片内呈稳定空间梯度（常见单边高/低），且梯度方向与热板温区分布吻合。 调阅热板温度映射图比对；换机台后梯度消失则确认。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.resist_lot_change> ;
    ns1:discriminatorText """偏移起始时点与光阻换批时点重合，且跨多台机台同步出现。 这是与设备型成因最关键的区分点——设备型不会跨机台同步。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A4> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.recipe_misload> ;
    ns1:discriminatorText "批间跳变且边界清晰，仅特定批次异常。核对配方版本与派工记录即可确认。"@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A5> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.param.exposure_focus> ;
    ns1:discriminatorText """CD 偏移伴随侧壁形貌恶化，且呈同心圆或局部区块分布。 单纯剂量问题不会改变侧壁角度，这是两者的判别关键。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A6> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.lens_contamination> ;
    ns1:discriminatorText "固定曝光场固定位置重复偏移，换光罩不改善。需停机检查光路。"@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.fab.cmp_scratch_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.pad_end_of_life> ;
    ns1:discriminatorText """划伤率随研磨垫累积使用时长上升，且去除率同步下降。 两个趋势同时出现基本可确认；换垫后立即恢复是最终验证。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.fab.cmp_scratch_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.slurry_agglomeration> ;
    ns1:discriminatorText """划伤突发而非渐增，且研磨垫寿命尚在中段。查研磨液批号、 过滤器压差与储存时长；换新液后改善则确认。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.cmp_scratch_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.param.cmp_pressure> ;
    ns1:discriminatorText "仅在配方变更或压力控制异常后出现，查参数变更记录"@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.pm_overdue> ;
    ns1:discriminatorText """先查 PM 计划是否已超期。超期则本次停机应归因于维护/排程依从性， 而不是记成随机设备故障——归因错了改善方向也会错。这是"用计划停机 换非计划停机"这一结构性旋钮的入口。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.reticle_stage_error> ;
    ns1:discriminatorText """代表突发型运动机构/伺服故障：报警发生在动作执行阶段、无任何前兆趋势。 "突发无前兆"是它与劣化型的分界，查伺服跟随误差日志即可确认。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.light_source_degradation> ;
    ns1:discriminatorText """代表渐变劣化型：停机前已有产出率缓降或处理时间延长的"先慢后停"趋势。 有前兆趋势即指向劣化，无前兆则倾向突发机构故障。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A4> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.env_excursion> ;
    ns1:discriminatorText """温湿度/振动/动力介质超限时多台设备同时报警；单台停机基本可排除环境型。 "跨设备同步"是环境型的判别签名。
"""@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.fab.etch_residue_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.chamber_polymer_buildup> ;
    ns1:discriminatorText """残留率随该腔体 RF Hours 单调上升，清洗后立即恢复。 这是渐变型特征，与突发型故障的区别在于有明确趋势。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.fab.etch_residue_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.epd_failure> ;
    ns1:discriminatorText """终点信号曲线异常（无明显拐点或信噪比低），且残留量在批内随机。 调阅 EPD 波形是最直接的确认手段。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.etch_residue_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.param.etch_time> ;
    ns1:discriminatorText """若前层膜厚偏厚（查薄膜工序量测记录），则蚀刻量相对不足， 属"上游膜厚偏移传导"，而非蚀刻本身失效。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.chamber_wall_condition> ;
    ns1:discriminatorText """看时点与收敛方向。本项出现在清洗/长待机之后，偏移随加工片数 收敛；腔体聚合物累积出现在连续生产中且随片数发散。方向相反， 一次片间趋势图就能分开。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.target_erosion_profile> ;
    ns1:discriminatorText """看径向剖面形状是否改变而非均值是否漂移。侵蚀沟槽演化改的是 形状（如中心厚转为边缘厚），功率或压力偏移改的是整体水平。 只看片均值会把这两类混成同一个"膜厚漂移"。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.target_end_of_life> ;
    ns1:discriminatorText """查靶材累计用量是否接近寿命上限，并看缺陷扫描有无同步的颗粒 跃升。均匀性恶化叠加颗粒风险上升是寿命末期签名；仅剖面渐变 而颗粒平稳则仍在可补偿区间。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A4> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.recipe_misload> ;
    ns1:discriminatorText """偏移是否在特定批次上突然出现且边界清晰。是则查配方版本与 机台配方履历，不要继续往设备本体查——归因错了改善方向也会错。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A5> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.param.chamber_pressure> ;
    ns1:discriminatorText """查腔压趋势是否与偏移同步。腔压改的是散射行为，表现偏向剖面 变化；纯粹的速率高低更可能来自功率侧。
"""@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.fab.implant_dose_drift_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.beam_current_drift> ;
    ns1:discriminatorText """按注入机台分组比对 Vt 分布，特定机台整体偏移即指向该机台束流系统。 做剂量校验片(Dose Monitor Wafer)测方阻可直接量化偏差量。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.fab.implant_dose_drift_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.recipe_misload> ;
    ns1:discriminatorText "单批突变且边界清晰，核对配方与派工记录"@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.implant_dose_drift_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.param.implant_dose> ;
    ns1:discriminatorText "参数变更记录中有剂量调整而未做验证，属变更管理漏洞"@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.recipe_misload> ;
    ns1:discriminatorText """先查配方与层别是否匹配——这是最快能排除、代价也最低的一项。 配方误用通常表现为整片大幅规律性偏移，且同机台同配方的 其他批次同样异常。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.alignment_mark_damage> ;
    ns1:discriminatorText """对位残差异常但曝光成像质量正常。关键判别：换机台重曝仍复现， 且问题跟着前层工艺批次走而非跟着曝光机台走。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.wafer_backside_contamination> ;
    ns1:discriminatorText """偏移呈局部化不规则分布，而非全片线性或旋转分量； 同一吸盘上不同晶圆的偏移位置重复出现。常伴随离焦与 CD 异常。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A4> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.lens_heating_drift> ;
    ns1:discriminatorText """场内分量随批次内曝光片数递进，停机冷却后自行恢复。 与光路沾污的区别是后者持续存在且伴随对比度下降。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A5> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.env_excursion> ;
    ns1:discriminatorText """温湿度或振动记录越限，且同期多台机台、多产品同时异常。 单机台单产品异常基本可排除环境因素。
"""@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A6> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.param.overlay_offset> ;
    ns1:discriminatorText """查 run-to-run 补偿量是否被异常更新——补偿模型吃进一个坏点后 可能把正常批次也带偏，此时机台与晶圆都没问题。
"""@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.reticle_haze> ;
    ns1:discriminatorText """缺陷在每个曝光场的同一相对位置重复出现——这是最有辨识度的签名。 只要看到逐场规律重复，优先查光罩，其余成因不会产生这种周期性。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.chamber_polymer_buildup> ;
    ns1:discriminatorText """缺陷集中于经过特定腔体的批次，且该腔体 RF Hours 接近清洗周期上限。 按机台/腔体交叉比对缺陷率即可锁定。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.target_end_of_life> ;
    ns1:discriminatorText "缺陷集中于 PVD 后工序，且靶材累积用量接近寿命上限"@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A4> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.env_excursion> ;
    ns1:discriminatorText """多个不相关工序同时缺陷上升，且分布随机无规律。 "跨工序同步"是环境型成因的标志——单一设备问题不会波及无关工序。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A5> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.slurry_agglomeration> ;
    ns1:discriminatorText "缺陷为线状划伤而非点状颗粒，且集中于 CMP 后量测点"@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.quality_excursion_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.recipe_misload> ;
    ns1:discriminatorText """偏移在特定批次上突然出现且边界清晰——是则查配方版本与机台配方履历， 不要继续往设备本体查。"突变+边界清晰"是配方/派工类的签名。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.fab.quality_excursion_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.beam_current_drift> ;
    ns1:discriminatorText """偏移集中在电性参数（Vt/方阻）且按机台分组后特定机台整体偏移， 指向该机台工艺子系统。做校验片可直接量化偏差量。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.quality_excursion_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.chamber_wall_condition> ;
    ns1:discriminatorText """偏移出现在清洗/长待机之后且随加工片数收敛——"事件后出现、随片数回稳" 是腔体状态型；连续生产中随片数发散的是累积型，方向相反。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.quality_excursion_triage%3A4> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.env_excursion> ;
    ns1:discriminatorText """多个不相关工序/机台同时品质下滑且分布随机无规律。"跨工序同步"是 环境型的标志——单一设备或配方问题不会波及无关工序。
"""@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:cause-assertion:kb.fab.scanner_down_triage%3A1> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.reticle_stage_error> ;
    ns1:discriminatorText """报警发生在扫描动作阶段而非光源侧，且常在特定 slit 位置或特定 扫描方向重复。查伺服跟随误差日志即可与光源类区分。
"""@zh ;
    ns1:likelihood "high" .

<urn:pxai:semi:cause-assertion:kb.fab.scanner_down_triage%3A2> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.light_source_degradation> ;
    ns1:discriminatorText """停机前已有产出率缓降或曝光时间延长的趋势——"先慢后停"是光源劣化 的签名。伺服类停机是突发的，没有这段前兆。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.scanner_down_triage%3A3> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.pm_overdue> ;
    ns1:discriminatorText """查 PM 计划是否已超期。超期则这次停机应归因于排程决策， 而不是记成随机设备故障——归因错了，改善方向也会错。
"""@zh ;
    ns1:likelihood "medium" .

<urn:pxai:semi:cause-assertion:kb.fab.scanner_down_triage%3A4> a ns1:PossibleCauseAssertion ;
    ns1:assertsCause <urn:pxai:semi:catalog:fab.cause.env_excursion> ;
    ns1:discriminatorText "温湿度或振动超限时多台设备同时报警；单台停机基本可排除"@zh ;
    ns1:likelihood "low" .

<urn:pxai:semi:customer-problem:scenario.ap.bonder_down_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现键合机停机，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.ap.delamination_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现界面分层，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.ap.dicing_chipping_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现切割崩边超规，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.ap.die_crack_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现芯粒裂纹，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.ap.ft_yield_drop_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现终测良率下滑，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.ap.missing_ball_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现缺球/连球，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.ap.mold_void_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现塑封空洞，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.ap.wire_bond_wip_bubble> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现WIP 堆积，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.ap.wire_nsop_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现金线不粘，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.fab.cd_out_of_spec_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现CD 超规，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.fab.cmp_scratch_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现CMP 划伤，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.fab.etch_residue_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现蚀刻残留，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.fab.film_thickness_dev_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现膜厚偏移/均匀性超规，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.fab.implant_dose_drift_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现注入剂量漂移，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.fab.overlay_shift_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现套刻偏移，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.fab.particle_excursion_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现颗粒突增，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:customer-problem:scenario.fab.scanner_down_triage> a ns1:CustomerProblem ;
    ns1:problemText "生产现场出现光刻机非计划停机，需要快速定位影响与处置。"@zh .

<urn:pxai:semi:detection:kb.ap.bonder_down_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.oee> ;
    ns1:signalText """可用率跌落。要同时看停机次数与单次时长：频繁短停指向卡线或电极， 一次长停指向轴系。只看总停机时长会把两类混为一谈。
"""@zh .

<urn:pxai:semi:detection:kb.ap.bonder_down_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.wip> ;
    ns1:signalText "键合区队列累积，是停机向下游塑封传导的最早观测量"@zh .

<urn:pxai:semi:detection:kb.ap.bonder_down_triage%3A3> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.wire_pull_strength> ;
    ns1:signalText """拉力同步下降则更可能是瓷嘴或参数问题而非纯停机故障， 可用于把停机型与质量型成因分开
"""@zh .

<urn:pxai:semi:detection:kb.ap.delamination_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.die_shear_strength> ;
    ns1:signalText """剪切强度低于规格下限，且失效模式为界面剥离而非芯粒体破裂。 失效模式比数值本身更有判别力
"""@zh .

<urn:pxai:semi:detection:kb.ap.delamination_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.void_ratio> ;
    ns1:signalText "分层面积占比超允收标准，按界面类型与位置分类统计用于定位成因"@zh .

<urn:pxai:semi:detection:kb.ap.dicing_chipping_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.chipping_size> ;
    ns1:signalText "最大崩边尺寸与 Scribe Line 余量比对，并按刀片使用长度做趋势分析"@zh .

<urn:pxai:semi:detection:kb.ap.die_crack_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.die_shear_strength> ;
    ns1:signalText "剪切强度异常偏低，或剪切失效面出现非预期断裂形态"@zh .

<urn:pxai:semi:detection:kb.ap.ft_yield_drop_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.ft_yield> ;
    ns1:signalText """良率趋势 + Bin 分布 + Site 分布。三者必须一起看： Bin 指向失效机理，Site 指向治具，趋势指向发生时点。
"""@zh .

<urn:pxai:semi:detection:kb.ap.ft_yield_drop_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.yield> ;
    ns1:signalText """与前段 CP 良率联动比对。CP 正常而 FT 下滑则成因在后段； 两者同步下滑则回溯前段。这是划分前后段责任的第一判据。
"""@zh .

<urn:pxai:semi:detection:kb.ap.missing_ball_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.coplanarity> ;
    ns1:signalText """共面性超规。但它是并发观测量而非缺球本身的判据—— 缺球在共面性数据上表现为该接点缺测点，而连球可能仍在规格内。 两者要分开判，把共面性超规直接当缺球会漏判连球。
"""@zh .

<urn:pxai:semi:detection:kb.ap.missing_ball_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.yield> ;
    ns1:signalText """植球站不良率趋势。按印刷版面位置与炉内位置两个维度分别做分布统计， 哪个维度先聚集就指向哪类成因——这是本异常最快的分流手段。
"""@zh .

<urn:pxai:semi:detection:kb.ap.mold_void_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.void_ratio> ;
    ns1:signalText "空洞占比超规，且按模腔位置统计的分布形态用于区分料因与模具因"@zh .

<urn:pxai:semi:detection:kb.ap.wire_bond_wip_bubble%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.wip> ;
    ns1:signalText """按站点分层的 WIP 水位与历史基线对比；同时看上下游站点分布形态， 判断是本站产生还是上游传导。
"""@zh .

<urn:pxai:semi:detection:kb.ap.wire_bond_wip_bubble%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.oee> ;
    ns1:signalText "该站 OEE 与 E10 状态分解，用于区分设备型(Down)与待料型(Standby)"@zh .

<urn:pxai:semi:detection:kb.ap.wire_bond_wip_bubble%3A3> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.cycle_time> ;
    ns1:signalText "该站 CT 贡献占比变化，量化堆积的交期影响"@zh .

<urn:pxai:semi:detection:kb.ap.wire_nsop_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.wire_pull_strength> ;
    ns1:signalText "拉力值下降，且失效模式分布向\"球脱\"偏移（失效模式比数值更有指向性）"@zh .

<urn:pxai:semi:detection:kb.ap.wire_nsop_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.ball_shear_strength> ;
    ns1:signalText "球剪切强度下降指向球焊界面金属间化合物形成不足"@zh .

<urn:pxai:semi:detection:kb.erp.billing_block_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:erp.metric.credit_exposure> ;
    ns1:signalText "客户信用敞口对授信额度的占用率，以及订单的冻结标记类型"@zh .

<urn:pxai:semi:detection:kb.erp.cost_variance_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:erp.metric.cost_variance_rate> ;
    ns1:signalText "按价差/量差/效率差分层看差异率，以及按成本中心的分布形态"@zh .

<urn:pxai:semi:detection:kb.erp.depreciation_error_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:erp.metric.net_book_value> ;
    ns1:signalText "资产净值与累计折旧/原值比例，触发\"累计折旧≤原值\"自检约束"@zh .

<urn:pxai:semi:detection:kb.erp.gr_ir_mismatch_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:erp.metric.gr_ir_balance> ;
    ns1:signalText "GR/IR 科目余额与账龄，按单边挂账/双边差异分层"@zh .

<urn:pxai:semi:detection:kb.erp.inventory_writedown_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:erp.metric.inventory_turnover> ;
    ns1:signalText "按料号的周转率与库龄分布，周转单调下滑是跌价先行信号"@zh .

<urn:pxai:semi:detection:kb.erp.yield_cost_impact_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.yield> ;
    ns1:signalText "产线良率趋势与单位成本趋势对齐比对，找同期拐点"@zh .

<urn:pxai:semi:detection:kb.erp.yield_cost_impact_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:erp.metric.cost_variance_rate> ;
    ns1:signalText "效率差/产量差部分的差异率变化，量化良率对成本的传导"@zh .

<urn:pxai:semi:detection:kb.fab.cd_out_of_spec_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.cd_uniformity> ;
    ns1:signalText "均值偏移量、片内 3σ、以及偏差的空间分布形态（三者需一起看）"@zh .

<urn:pxai:semi:detection:kb.fab.cmp_scratch_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
    ns1:signalText "scratch 类缺陷计数与研磨垫使用时长做相关性分析"@zh .

<urn:pxai:semi:detection:kb.fab.cmp_scratch_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.film_thickness> ;
    ns1:signalText "去除率下降趋势，与划伤率上升同步则指向研磨垫寿命"@zh .

<urn:pxai:semi:detection:kb.fab.equipment_down_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.oee> ;
    ns1:signalText """可用率跌落，且必须区分计划内 PM 与非计划停机——两者混在同一口径里 会让停机改善看起来毫无进展。
"""@zh .

<urn:pxai:semi:detection:kb.fab.equipment_down_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.wip> ;
    ns1:signalText "停机站点队列陡升，是停机向下游传导的最早观测量"@zh .

<urn:pxai:semi:detection:kb.fab.equipment_down_triage%3A3> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.throughput> ;
    ns1:signalText "处理率缓降可作为劣化型停机的前兆信号，早于硬停机"@zh .

<urn:pxai:semi:detection:kb.fab.etch_residue_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.etch_depth> ;
    ns1:signalText "深度不足，且与前层膜厚记录联动比对可区分是蚀刻不足还是膜厚偏厚"@zh .

<urn:pxai:semi:detection:kb.fab.etch_residue_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
    ns1:signalText "残留型缺陷计数上升，缺陷分类结果指向 residue 而非 particle"@zh .

<urn:pxai:semi:detection:kb.fab.film_thickness_dev_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.film_thickness> ;
    ns1:signalText """超出规格上下限，或片内均匀性超标。必须同时看剖面形状—— 只看片均值会漏掉"均值在规格内、边缘已超规"这一类。
"""@zh .

<urn:pxai:semi:detection:kb.fab.film_thickness_dev_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.sheet_resistance> ;
    ns1:signalText """金属层方阻与膜厚反向变动，可与膜厚量测互为交叉确认； 若两者不一致，先怀疑量测本身而不是制程。
"""@zh .

<urn:pxai:semi:detection:kb.fab.film_thickness_dev_triage%3A3> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
    ns1:signalText """颗粒数是否与膜厚偏移同步跃升。同步跃升把根因指向靶材寿命 末期或腔壁残留脱落，而不是纯参数漂移。
"""@zh .

<urn:pxai:semi:detection:kb.fab.implant_dose_drift_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.wat_vt> ;
    ns1:signalText "Vt 均值偏移，按机台分组后差异显著"@zh .

<urn:pxai:semi:detection:kb.fab.implant_dose_drift_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.sheet_resistance> ;
    ns1:signalText """方阻是比 Vt 更早的观测量。若已有注入后方阻抽测，可将检出 从 WAT 提前数十道工序，这是缩短此类异常暴露窗口的关键手段。
"""@zh .

<urn:pxai:semi:detection:kb.fab.overlay_shift_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.overlay_error> ;
    ns1:signalText """直接判定量。务必看偏移的空间分布而非只看单值超规： 全片线性、旋转、场内、局部四种分布分别指向不同根因， 只看超没超规会丢掉最关键的判别信息。
"""@zh .

<urn:pxai:semi:detection:kb.fab.overlay_shift_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.cd_uniformity> ;
    ns1:signalText """CD 与套刻同时异常时更可能是背面沾污引起的离焦， 可用于把平面度类根因与纯对位类根因分开
"""@zh .

<urn:pxai:semi:detection:kb.fab.overlay_shift_triage%3A3> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.yield> ;
    ns1:signalText "套刻超规若漏到后续层，最终以良率损失体现"@zh .

<urn:pxai:semi:detection:kb.fab.particle_excursion_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
    ns1:signalText """计数跃升 + 空间分布形态 + 缺陷分类比例。三者结合才能定位， 单看总数只能确认异常存在，无法指向责任工序。
"""@zh .

<urn:pxai:semi:detection:kb.fab.quality_excursion_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.yield> ;
    ns1:signalText """良率是最终后果但滞后。用作确认异常规模，不用作定位——定位要靠缺陷 分类与电性参数的分布形态。
"""@zh .

<urn:pxai:semi:detection:kb.fab.quality_excursion_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
    ns1:signalText "缺陷计数与分类比例变化，是良率下滑前的早期信号"@zh .

<urn:pxai:semi:detection:kb.fab.quality_excursion_triage%3A3> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.wat_vt> ;
    ns1:signalText "电性参数按机台分组后差异显著，指向特定机台的工艺偏移"@zh .

<urn:pxai:semi:detection:kb.fab.scanner_down_triage%3A1> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.oee> ;
    ns1:signalText """可用率跌落，且要区分计划内 PM 与非计划停机。两者混在同一口径里 会让停机改善看起来毫无进展。
"""@zh .

<urn:pxai:semi:detection:kb.fab.scanner_down_triage%3A2> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.wip> ;
    ns1:signalText "光刻区队列长度陡升，是停机向下游传导的最早观测量"@zh .

<urn:pxai:semi:detection:kb.fab.scanner_down_triage%3A3> a ns1:DetectionInstruction ;
    ns1:detectsWithMetric <urn:pxai:semi:catalog:core.metric.throughput> ;
    ns1:signalText "曝光层产出率缓降可作为光源劣化的前兆信号，早于硬停机"@zh .

<urn:pxai:semi:fac:event:infrastructure_repair_r2> a ns1:FacilityInfrastructureEvent ;
    rdfs:label "厂务基础设施事件门禁修复实体"@zh ;
    ns1:aboutEntity <urn:pxai:semi:fac:utility:multi_system_repair_r2> ;
    ns1:sourceRef "https://semiconductorx.com/fab-ops-facility-management.html" ;
    ns1:sourceType "web" .

<urn:pxai:semi:impact:economic_quality_excursion_scrap_delivery_repair> a ns1:EconomicImpact ;
    rdfs:label "品质异常的报废返工与交付经营影响"@zh ;
    ns1:economicImpactText "品质偏差对良率和可靠性的影响可能沿生产流程形成报废、返工、可销售产出受限及交付风险；具体影响幅度必须结合现场数据和经营模型评估。" ;
    ns1:nameZh "品质异常的报废返工与交付经营影响" ;
    ns1:sourceRef "https://link.springer.com/article/10.1007/s00170-026-18777-0" ;
    ns1:sourceType "web" .

