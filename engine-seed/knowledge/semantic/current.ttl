<urn:pxai:semi:pain-point:scenario.ap.bonder_down_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞金线键合、QFN 金线封装主流程并影响equipment_oee、throughput、cycle_time。"@zh .

<urn:pxai:semi:pain-point:scenario.ap.delamination_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞包装出货并影响yield、scrap_rate。"@zh .

<urn:pxai:semi:pain-point:scenario.ap.dicing_chipping_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞装片并影响yield、scrap_rate、cost_per_unit。"@zh .

<urn:pxai:semi:pain-point:scenario.ap.die_crack_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞包装出货并影响yield、scrap_rate。"@zh .

<urn:pxai:semi:pain-point:scenario.ap.ft_yield_drop_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞包装出货并影响yield、capacity_commit、cost_per_unit。"@zh .

<urn:pxai:semi:pain-point:scenario.ap.missing_ball_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞包装出货并影响yield、rework_rate。"@zh .

<urn:pxai:semi:pain-point:scenario.ap.mold_void_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞包装出货并影响yield、scrap_rate。"@zh .

<urn:pxai:semi:pain-point:scenario.ap.wire_bond_wip_bubble> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞后续生产并影响cycle_time、throughput、capacity_commit、equipment_oee。"@zh .

<urn:pxai:semi:pain-point:scenario.ap.wire_nsop_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞压模成型并影响yield、rework_rate、throughput。"@zh .

<urn:pxai:semi:pain-point:scenario.fab.cd_out_of_spec_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞干法蚀刻并影响yield、rework_rate、cycle_time。"@zh .

<urn:pxai:semi:pain-point:scenario.fab.cmp_scratch_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞CVD 层间介电沉积并影响yield、scrap_rate、cost_per_unit。"@zh .

<urn:pxai:semi:pain-point:scenario.fab.etch_residue_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞PVD 金属沉积并影响yield、rework_rate。"@zh .

<urn:pxai:semi:pain-point:scenario.fab.film_thickness_dev_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞金属 CMP、氧化层 CMP并影响yield、rework_rate、scrap_rate、cycle_time。"@zh .

<urn:pxai:semi:pain-point:scenario.fab.implant_dose_drift_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞晶圆针测并影响yield、scrap_rate、capacity_commit。"@zh .

<urn:pxai:semi:pain-point:scenario.fab.overlay_shift_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞干法蚀刻并影响yield、rework_rate。"@zh .

<urn:pxai:semi:pain-point:scenario.fab.particle_excursion_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞CMOS 逻辑主流程（单金属层）并影响yield、scrap_rate、capacity_commit。"@zh .

<urn:pxai:semi:pain-point:scenario.fab.scanner_down_triage> a ns1:PainPoint ;
    ns1:painPointText "候选原因分散，可能阻塞曝光、CMOS 逻辑主流程（单金属层）并影响throughput、capacity_commit、cycle_time、equipment_oee。"@zh .

<urn:pxai:semi:pain:fab_fragmented_rca_analysis_repair> a ns1:CustomerProblemPainPattern ;
    rdfs:label "晶圆厂分散数据根因分析痛点模式"@zh ;
    ns1:nameZh "晶圆厂分散数据根因分析痛点模式" ;
    ns1:painPointText "传统监控难以处理高维动态制造数据，工程人员需要跨图像、传感器、制程和维护信息进行人工交叉分析，导致异常证据汇集和根因定位负担增加。" ;
    ns1:sourceRef "https://link.springer.com/article/10.1007/s00170-026-18777-0" ;
    ns1:sourceType "web" .

<urn:pxai:semi:scenario:wafer_resume> a ns1:L2Scenario ;
    rdfs:label "Wafer Resume",
        "Wafer Resume"@zh ;
    ns1:composesCapability <urn:pxai:semi:capability:abnormal_case>,
        <urn:pxai:semi:capability:abnormal_lot>,
        <urn:pxai:semi:capability:inline_offline_analysis>,
        <urn:pxai:semi:capability:root_cause_analysis>,
        <urn:pxai:semi:capability:wat_cp_analysis> .

<urn:pxai:semi:validation:equipment-downtime-detection-metric-r1> a ns1:Metric ;
    rdfs:label "设备停机检测指标R1"@zh ;
    ns1:identifier "METRIC-EQUIPMENT-DOWNTIME-DETECTION-R1" ;
    ns1:sourceType "model_prior" .

<urn:pxai:semi:validation:ontology-validation-run-r1> a ns1:OntologyValidationRun ;
    rdfs:label "异常覆盖本体校验执行R1"@zh ;
    ns1:evaluatesFocusEntity <urn:pxai:semi:validation:equipment-downtime-anomaly-case-r1>,
        <urn:pxai:semi:validation:quality-excursion-anomaly-case-r1> ;
    ns1:evaluatesOntologyConstraint <urn:pxai:semi:validation:anomaly-detection-traceability-constraint-r1> ;
    ns1:sourceType "model_prior" ;
    ns1:validationStatus "failed" .

<urn:pxai:semi:validation:quality-excursion-detection-metric-r1> a ns1:Metric ;
    rdfs:label "品质异常突发检测指标R1"@zh ;
    ns1:identifier "METRIC-QUALITY-EXCURSION-DETECTION-R1" ;
    ns1:sourceType "model_prior" .

<urn:pxai:semi:business-variable:business.ap.general_baseline%3Abonding_yield> a ns1:BusinessVariable ;
    ns1:identifier "bonding_yield" ;
    ns1:numericValue 0.995 ;
    ns1:sourceRef "business/datasets/ap-demo-assumptions.yaml#bonding_yield" ;
    ns1:sourceType "assumption" ;
    ns1:unitCode "ratio" .

<urn:pxai:semi:business-variable:business.ap.general_baseline%3Aintervention_opex> a ns1:BusinessVariable ;
    ns1:identifier "intervention_opex" ;
    ns1:numericValue 0.0 ;
    ns1:sourceRef "business/datasets/ap-demo-assumptions.yaml#intervention_opex" ;
    ns1:sourceType "assumption" ;
    ns1:unitCode "CNY/month" .

<urn:pxai:semi:catalog:ap.cause.blade_wear> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "切割刀磨耗或局部崩齿，切割负荷上升致崩边加剧。"@zh ;
    skos:notation "ap.cause.blade_wear" ;
    skos:prefLabel "Dicing Blade Wear / Chipping"@en,
        "刀片磨损/崩齿"@zh ;
    ns1:legacyId "ap.cause.blade_wear" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.dicing_chipping>,
        <urn:pxai:semi:catalog:ap.anomaly.die_crack> .

<urn:pxai:semi:catalog:ap.cause.bond_head_servo_fault> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """键合头 Z 轴定位或超声换能器驱动异常，触发保护停机。 判别依据是报警指向轴系或换能器自检，而非成球与送线环节； 这类停机通常需原厂介入，不属厂内可自行恢复的耗材类停机。
"""@zh ;
    skos:notation "ap.cause.bond_head_servo_fault" ;
    skos:prefLabel "Bond Head Servo & Z-axis Fault"@en,
        "键合头伺服/Z 轴异常"@zh ;
    ns1:legacyId "ap.cause.bond_head_servo_fault" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.bonder_down> .

<urn:pxai:semi:catalog:ap.cause.bond_param_drift> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "超声换能器效率衰退或加热台温度偏移，致实际键合能量偏离设定。"@zh ;
    skos:notation "ap.cause.bond_param_drift" ;
    skos:prefLabel "Bond Parameter Drift"@en,
        "键合参数漂移"@zh ;
    ns1:legacyId "ap.cause.bond_param_drift" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> .

<urn:pxai:semi:catalog:ap.cause.efo_electrode_fouling> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """打火烧球(EFO)电极积附金属氧化物并随放电次数磨损，放电间隙漂移后 无法稳定成球，触发烧球失败报警并停机。特征是报警集中在成球阶段 而非焊接阶段，且随打线点数累积逐渐加重，清洗或更换电极后立即恢复。
"""@zh ;
    skos:notation "ap.cause.efo_electrode_fouling" ;
    skos:prefLabel "EFO Electrode Fouling & Wear"@en,
        "EFO 电极污染/磨损"@zh ;
    ns1:legacyId "ap.cause.efo_electrode_fouling" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.bonder_down>,
        <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> .

<urn:pxai:semi:catalog:ap.cause.epoxy_bleed> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "点胶量过多或胶体黏度偏低致胶体溢出至焊垫区，直接造成键合不粘。"@zh ;
    skos:notation "ap.cause.epoxy_bleed" ;
    skos:prefLabel "Epoxy Bleed Out"@en,
        "装片胶溢流"@zh ;
    ns1:legacyId "ap.cause.epoxy_bleed" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> .

<urn:pxai:semi:catalog:ap.cause.flux_print_defect> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """植球前助焊剂印刷量不足、未填满或渗出。荒川化学的技术资料把黏度列为 影响印刷性的主要物性：黏度过低易渗出并在焊接时桥连，黏度过高则难以 填满印刷区域而出现缺失与未填满。印刷条件（刮刀材质与角度、印压、 印速、金属掩膜形状、基板与掩膜间隙及分离速度）需针对基板与助焊剂 成对优化。另一条独立机理是黏性不足致锡球固定不住而移位。 判别要点：缺球与连球同批共存、且分布跟印刷版面走（而非跟炉内温区走） 时指向本成因——这是与回流曲线漂移最快的区分方式。
"""@zh ;
    skos:notation "ap.cause.flux_print_defect" ;
    skos:prefLabel "Flux Print Defect"@en,
        "助焊剂印刷不良"@zh ;
    ns1:legacyId "ap.cause.flux_print_defect" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.missing_ball> .

<urn:pxai:semi:catalog:ap.cause.grind_wheel_clog> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "砂轮磨屑堵塞降低切削效率，实际压力上升引入亚表面微裂纹。"@zh ;
    skos:notation "ap.cause.grind_wheel_clog" ;
    skos:prefLabel "Grind Wheel Clogging"@en,
        "砂轮堵塞"@zh ;
    ns1:legacyId "ap.cause.grind_wheel_clog" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.die_crack> .

<urn:pxai:semi:catalog:ap.cause.probe_card_wear> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """探针或测试座接触面磨损氧化致接触电阻上升，产生伪失效。 特征为重测通过率高且失效集中于特定 Site。
"""@zh ;
    skos:notation "ap.cause.probe_card_wear" ;
    skos:prefLabel "Probe Card / Socket Wear"@en,
        "测试治具磨损"@zh ;
    ns1:legacyId "ap.cause.probe_card_wear" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.ft_yield_drop> .

<urn:pxai:semi:catalog:ap.cause.reflow_profile_drift> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "回流炉温区衰退或链速偏移致实际受热曲线偏离设定。"@zh ;
    skos:notation "ap.cause.reflow_profile_drift" ;
    skos:prefLabel "Reflow Profile Drift"@en,
        "回流曲线漂移"@zh ;
    ns1:legacyId "ap.cause.reflow_profile_drift" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.missing_ball> .

<urn:pxai:semi:catalog:ap.cause.wire_feed_jam> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """线材在线轴、张力器或夹爪处缠绕、打结或断裂，导致送线中断而停机。 与瓷嘴磨损的区别在于：卡线是突发的送线通路故障，穿线复位后即恢复； 瓷嘴磨损是渐进的键合质量劣化，不必然停机。
"""@zh ;
    skos:notation "ap.cause.wire_feed_jam" ;
    skos:prefLabel "Wire Feed Jam & Wire Break"@en,
        "送线卡线/断线"@zh ;
    ns1:legacyId "ap.cause.wire_feed_jam" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.bonder_down> .

<urn:pxai:semi:catalog:ap.material.die_attach_epoxy> a ns1:CatalogConcept,
        ns1:MaterialType ;
    skos:definition "银胶或膜状黏着材料，黏度随温度与放置时间变化，需控制上机时效。"@zh ;
    skos:notation "ap.material.die_attach_epoxy" ;
    skos:prefLabel "Die Attach Epoxy"@en,
        "装片胶"@zh ;
    ns1:legacyId "ap.material.die_attach_epoxy" .

<urn:pxai:semi:catalog:ap.param.blade_rpm> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "刀轮转速，与进给速度共同决定切割负荷与崩边程度。"@zh ;
    skos:notation "ap.param.blade_rpm" ;
    skos:prefLabel "Dicing Blade RPM"@en,
        "切割刀转速"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.dicing> ;
    ns1:legacyId "ap.param.blade_rpm" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.dicing_chipping> ;
    ns1:unitCode "rpm" .

<urn:pxai:semi:catalog:ap.param.bond_power> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition """超声能量，破除氧化层形成金属间化合物。功率不足致不粘， 过高致焊垫下方硅裂(Cratering)。
"""@zh ;
    skos:notation "ap.param.bond_power" ;
    skos:prefLabel "Bond Ultrasonic Power"@en,
        "键合超声功率"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.wire_bond> ;
    ns1:legacyId "ap.param.bond_power" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> ;
    ns1:unitCode "mW" .

<urn:pxai:semi:catalog:ap.param.cure_temp> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "胶体或塑封料固化烘烤温度，与时间共同决定交联度。"@zh ;
    skos:notation "ap.param.cure_temp" ;
    skos:prefLabel "Cure Temperature"@en,
        "固化温度"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.epoxy_cure>,
        <urn:pxai:semi:catalog:ap.process.pmc> ;
    ns1:legacyId "ap.param.cure_temp" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.delamination> ;
    ns1:unitCode "℃" .

<urn:pxai:semi:catalog:ap.param.cut_feed_speed> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "切割行进速度。过快增大崩边，过慢降低产出且加剧刀片发热。"@zh ;
    skos:notation "ap.param.cut_feed_speed" ;
    skos:prefLabel "Cutting Feed Speed"@en,
        "切割进给速度"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.dicing>,
        <urn:pxai:semi:catalog:ap.process.singulation> ;
    ns1:legacyId "ap.param.cut_feed_speed" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.dicing_chipping> ;
    ns1:unitCode "mm/s" .

<urn:pxai:semi:catalog:ap.param.die_bond_force> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "芯粒压向基板的力。过大压裂薄芯粒，过小附着不良。"@zh ;
    skos:notation "ap.param.die_bond_force" ;
    skos:prefLabel "Die Bond Force"@en,
        "装片压力"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.die_attach>,
        <urn:pxai:semi:catalog:ap.process.flip_chip_bond> ;
    ns1:legacyId "ap.param.die_bond_force" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.die_crack> ;
    ns1:unitCode "gf" .

<urn:pxai:semi:catalog:ap.param.grind_feed_rate> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "砂轮下压速率。过快引入亚表面微裂纹，是延迟型裂片的隐性来源。"@zh ;
    skos:notation "ap.param.grind_feed_rate" ;
    skos:prefLabel "Grind Feed Rate"@en,
        "研磨进给速率"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.backgrind> ;
    ns1:legacyId "ap.param.grind_feed_rate" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.die_crack> ;
    ns1:unitCode "μm/s" .

<urn:pxai:semi:catalog:ap.param.mold_pressure> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "转注压力，压实塑封料排出气体。不足致空洞，过高致冲丝。"@zh ;
    skos:notation "ap.param.mold_pressure" ;
    skos:prefLabel "Mold Pressure"@en,
        "塑封压力"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.molding> ;
    ns1:legacyId "ap.param.mold_pressure" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.mold_void> ;
    ns1:unitCode "kgf/cm²" .

<urn:pxai:semi:catalog:ap.param.mold_temp> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "模具加热温度，决定塑封料熔融黏度与固化速率。"@zh ;
    skos:notation "ap.param.mold_temp" ;
    skos:prefLabel "Mold Temperature"@en,
        "模具温度"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.molding> ;
    ns1:legacyId "ap.param.mold_temp" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.mold_void> ;
    ns1:unitCode "℃" .

<urn:pxai:semi:catalog:ap.param.reflow_peak_temp> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition """回流焊峰值温度，须高于锡膏熔点且低于封装体耐温上限。 配合升温速率构成回流曲线，曲线失当致连球或虚焊。
"""@zh ;
    skos:notation "ap.param.reflow_peak_temp" ;
    skos:prefLabel "Reflow Peak Temperature"@en,
        "回流峰值温度"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.ball_mount>,
        <urn:pxai:semi:catalog:ap.process.bumping>,
        <urn:pxai:semi:catalog:ap.process.flip_chip_bond> ;
    ns1:legacyId "ap.param.reflow_peak_temp" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.missing_ball> ;
    ns1:unitCode "℃" .

<urn:pxai:semi:catalog:ap.param.test_time> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition """单颗测试历时。与并测数共同决定测试机 UPH，是后段单位成本的 最大可控变量。缩测需以覆盖率验证为前提。
"""@zh ;
    skos:notation "ap.param.test_time" ;
    skos:prefLabel "Test Time"@en,
        "测试时间"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.final_test> ;
    ns1:legacyId "ap.param.test_time" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.ft_yield_drop> ;
    ns1:unitCode "s/unit" .

<urn:pxai:semi:catalog:ap.param.transfer_speed> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "塑封料推进速度。过快卷入气体形成空洞并冲击金线。"@zh ;
    skos:notation "ap.param.transfer_speed" ;
    skos:prefLabel "Transfer Speed"@en,
        "转注速度"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:ap.process.molding> ;
    ns1:legacyId "ap.param.transfer_speed" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.mold_void> ;
    ns1:unitCode "mm/s" .

<urn:pxai:semi:catalog:ap.process.laser_mark> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition "在封装表面打印型号、批号与追溯码。打标深度过深损伤塑封体。"@zh ;
    skos:notation "ap.process.laser_mark" ;
    skos:prefLabel "Laser Marking"@en,
        "激光打标"@zh ;
    ns1:legacyId "ap.process.laser_mark" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.final_form> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.ball_mount>,
        <urn:pxai:semi:catalog:ap.process.singulation> .

<urn:pxai:semi:catalog:ap.process.plasma_clean> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """键合前去除焊垫表面有机污染与氧化层，提升可焊性。是抑制 金线不粘(NSOP)最有效的前置手段。
"""@zh ;
    skos:notation "ap.process.plasma_clean" ;
    skos:prefLabel "Plasma Clean"@en,
        "等离子清洁"@zh ;
    ns1:legacyId "ap.process.plasma_clean" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.interconnect> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.wire_bond> .

<urn:pxai:semi:catalog:ap.process.underfill> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition "填充芯粒与基板间隙缓解热膨胀失配应力，填充不完全形成空洞。"@zh ;
    skos:notation "ap.process.underfill" ;
    skos:prefLabel "Underfill"@en,
        "底部填充"@zh ;
    ns1:legacyId "ap.process.underfill" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.void_ratio> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.interconnect> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.molding> .

<urn:pxai:semi:catalog:ap.process.wafer_mount> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition "将晶圆贴于蓝膜与钢环上固定，供切割与取片。贴膜气泡致切割崩边。"@zh ;
    skos:notation "ap.process.wafer_mount" ;
    skos:prefLabel "Wafer Mounting"@en,
        "贴膜"@zh ;
    ns1:legacyId "ap.process.wafer_mount" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.wafer_prep> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:ap.material.dicing_tape>,
        <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.dicing> .

<urn:pxai:semi:catalog:ap.route.qfn_wirebond_main> a ns1:CatalogConcept,
        ns1:Route ;
    skos:definition """引线框架类封装的典型路径，以金线键合互连。steps 顺序与 40-flow-precedes.yaml 一致。塑封(molding)为不可逆分界点， 其前的不良多可重工挽回，其后基本只能判废。
"""@zh ;
    skos:notation "ap.route.qfn_wirebond_main" ;
    skos:prefLabel "QFN Wire Bond Main Flow"@en,
        "QFN 金线封装主流程"@zh ;
    ns1:legacyId "ap.route.qfn_wirebond_main" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.ft_yield>,
        <urn:pxai:semi:catalog:core.metric.cycle_time> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.lot>,
        <urn:pxai:semi:catalog:core.material.wafer> .

<urn:pxai:semi:catalog:ap.stage.die_bond> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "Die Attach",
        "上片",
        "黏晶" ;
    skos:definition "将芯粒从蓝膜取下贴装到基板或引线框架，胶量与贴装精度为控制重点。"@zh ;
    skos:notation "ap.stage.die_bond" ;
    skos:prefLabel "Die Bonding"@en,
        "装片"@zh ;
    ns1:legacyId "ap.stage.die_bond" .

<urn:pxai:semi:catalog:ap.stage.encapsulation> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "Molding",
        "塑封",
        "封胶" ;
    skos:definition "塑封料包覆保护结构，含压模成型与后固化。空洞与分层为主要缺陷。"@zh ;
    skos:notation "ap.stage.encapsulation" ;
    skos:prefLabel "Encapsulation"@en,
        "封装成型"@zh ;
    ns1:legacyId "ap.stage.encapsulation" .

<urn:pxai:semi:catalog:core.state.hold> a ns1:CatalogConcept,
        ns1:Status ;
    skos:definition """批次被人为冻结，禁止流入下一工序。常见类型：工程扣留(Engineering Hold)、 品质扣留(QA Hold)、待判扣留(MRB)。解除需明确责任人与处置结论。
"""@zh ;
    skos:notation "core.state.hold" ;
    skos:prefLabel "Hold"@en,
        "扣留"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:ap.route.qfn_wirebond_main>,
        <urn:pxai:semi:catalog:fab.route.cmos_logic_main> ;
    ns1:legacyId "core.state.hold" .

<urn:pxai:semi:catalog:erp.cause.asset_master_error> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "折旧方法/使用年限/残值设置错误，使折旧计提系统性偏差。全类资产同向偏差为其签名。"@zh ;
    skos:notation "erp.cause.asset_master_error" ;
    skos:prefLabel "Asset Master Data Error"@en,
        "资产主数据错误"@zh ;
    ns1:legacyId "erp.cause.asset_master_error" ;
    ns1:mayCause <urn:pxai:semi:catalog:erp.anomaly.depreciation_error> .

<urn:pxai:semi:catalog:erp.cause.capitalization_delay> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "在建工程转固延迟，折旧起始期错位，表现为单项资产折旧异常。"@zh ;
    skos:notation "erp.cause.capitalization_delay" ;
    skos:prefLabel "Capitalization Timing Delay"@en,
        "资本化时点延迟"@zh ;
    ns1:legacyId "erp.cause.capitalization_delay" ;
    ns1:mayCause <urn:pxai:semi:catalog:erp.anomaly.depreciation_error> .

<urn:pxai:semi:catalog:erp.cause.credit_limit_exceeded> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "客户未清应收+在途订单超过授信额度，信用管理自动冻结开票。"@zh ;
    skos:notation "erp.cause.credit_limit_exceeded" ;
    skos:prefLabel "Customer Credit Limit Exceeded"@en,
        "客户信用额度超限"@zh ;
    ns1:legacyId "erp.cause.credit_limit_exceeded" ;
    ns1:mayCause <urn:pxai:semi:catalog:erp.anomaly.billing_block> .

<urn:pxai:semi:catalog:erp.cause.delivery_not_posted> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "发货过账（Post Goods Issue）未完成，销售订单无货权转移不能开票。"@zh ;
    skos:notation "erp.cause.delivery_not_posted" ;
    skos:prefLabel "Delivery Not Posted (PGI Pending)"@en,
        "交货未过账（PGI 未做）"@zh ;
    ns1:legacyId "erp.cause.delivery_not_posted" ;
    ns1:mayCause <urn:pxai:semi:catalog:erp.anomaly.billing_block> .

<urn:pxai:semi:catalog:erp.cause.inventory_obsolescence> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "特定料号长期积压、周转恶化，制程迭代后可变现净值下降。伴随周转率单调下滑。"@zh ;
    skos:notation "erp.cause.inventory_obsolescence" ;
    skos:prefLabel "Inventory Obsolescence"@en,
        "存货呆滞"@zh ;
    ns1:legacyId "erp.cause.inventory_obsolescence" ;
    ns1:mayCause <urn:pxai:semi:catalog:erp.anomaly.inventory_writedown> .

<urn:pxai:semi:catalog:erp.cause.invoice_not_received> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "已收货但供应商发票未到，GR/IR 暂估挂账。是月结 GR/IR 未清最常见成因。"@zh ;
    skos:notation "erp.cause.invoice_not_received" ;
    skos:prefLabel "Invoice Not Received"@en,
        "发票未达"@zh ;
    ns1:legacyId "erp.cause.invoice_not_received" ;
    ns1:mayCause <urn:pxai:semi:catalog:erp.anomaly.gr_ir_mismatch> .

<urn:pxai:semi:catalog:erp.cause.po_invoice_discrepancy> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "发票价格或数量与采购订单不符，触发差异挂起无法自动清账。"@zh ;
    skos:notation "erp.cause.po_invoice_discrepancy" ;
    skos:prefLabel "PO-Invoice Price/Qty Discrepancy"@en,
        "采购订单与发票差异"@zh ;
    ns1:legacyId "erp.cause.po_invoice_discrepancy" ;
    ns1:mayCause <urn:pxai:semi:catalog:erp.anomaly.gr_ir_mismatch> .

<urn:pxai:semi:catalog:erp.cause.standard_cost_outdated> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "标准成本未随料价/工艺更新，导致差异系统性偏大。全线同向差异是其签名。"@zh ;
    skos:notation "erp.cause.standard_cost_outdated" ;
    skos:prefLabel "Outdated Standard Cost"@en,
        "标准成本过时"@zh ;
    ns1:legacyId "erp.cause.standard_cost_outdated" ;
    ns1:mayCause <urn:pxai:semi:catalog:erp.anomaly.cost_variance_excursion> .

<urn:pxai:semi:catalog:erp.profitcenter.foundry> a ns1:CatalogConcept,
        ns1:ProfitCenter ;
    skos:definition "利润中心，成本中心归属其下用于利润分析。"@zh ;
    skos:notation "erp.profitcenter.foundry" ;
    skos:prefLabel "Profit Center Foundry"@en,
        "利润中心—晶圆代工"@zh ;
    ns1:legacyId "erp.profitcenter.foundry" .

<urn:pxai:semi:catalog:fab.cause.alignment_mark_damage> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """晶圆对位标记被前层工艺（CMP 过抛、蚀刻、厚膜沉积）破坏或覆盖， 导致对位信号强度不足或重心判读偏移，机台按错误的基准曝光。 特征是同一片内对位残差异常但曝光成像质量正常，且问题随前层工艺 批次相关而非随曝光机台相关——换机台重曝仍复现是强判别信号。
"""@zh ;
    skos:notation "fab.cause.alignment_mark_damage" ;
    skos:prefLabel "Alignment Mark Damage & Poor Readability"@en,
        "对位标记损伤/读取不良"@zh ;
    ns1:legacyId "fab.cause.alignment_mark_damage" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.overlay_shift> .

<urn:pxai:semi:catalog:fab.cause.epd_failure> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "光学终点信号窗口沾污或信噪比不足，导致蚀刻在错误时点停止。"@zh ;
    skos:notation "fab.cause.epd_failure" ;
    skos:prefLabel "Endpoint Detection Failure"@en,
        "终点检测失效"@zh ;
    ns1:legacyId "fab.cause.epd_failure" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.etch_residue> .

<urn:pxai:semi:catalog:fab.cause.hotplate_nonuniform> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "涂布/烘烤模块热板温区偏差，产生片内 CD 梯度型分布。"@zh ;
    skos:notation "fab.cause.hotplate_nonuniform" ;
    skos:prefLabel "Hotplate Temperature Non-uniformity"@en,
        "热板温度不均"@zh ;
    ns1:legacyId "fab.cause.hotplate_nonuniform" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.cd_out_of_spec> .

<urn:pxai:semi:catalog:fab.cause.lens_contamination> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "光学元件沾污衰减有效照度并产生局部像差，表现为固定位置 CD 偏移。"@zh ;
    skos:notation "fab.cause.lens_contamination" ;
    skos:prefLabel "Lens & Optics Contamination"@en,
        "投影镜头/光路沾污"@zh ;
    ns1:legacyId "fab.cause.lens_contamination" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.cd_out_of_spec> .

<urn:pxai:semi:catalog:fab.cause.lens_heating_drift> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """高强度曝光使投影物镜局部升温，折射率与面形随曝光量累积变化， 引起场内（intra-field）套刻分量漂移。 与光路沾污的区别在于：热漂移随批次内曝光片数递进、停机冷却后自行恢复； 沾污是持续性的且伴随成像对比度下降。
"""@zh ;
    skos:notation "fab.cause.lens_heating_drift" ;
    skos:prefLabel "Lens Heating Induced Intra-field Drift"@en,
        "镜头热效应场内漂移"@zh ;
    ns1:legacyId "fab.cause.lens_heating_drift" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.overlay_shift> .

<urn:pxai:semi:catalog:fab.cause.pad_end_of_life> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "研磨垫沟槽磨平、表面硬化，去除率下降且划伤率上升。"@zh ;
    skos:notation "fab.cause.pad_end_of_life" ;
    skos:prefLabel "CMP Pad End of Life"@en,
        "研磨垫寿命末期"@zh ;
    ns1:legacyId "fab.cause.pad_end_of_life" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.cmp_scratch> .

<urn:pxai:semi:catalog:fab.cause.resist_lot_change> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """新批号光阻感光度差异造成全片均匀 CD 偏移。是典型的"材料引入型" 系统偏移，与设备型偏移的判别在于是否跨机台同步出现。
"""@zh ;
    skos:notation "fab.cause.resist_lot_change" ;
    skos:prefLabel "Photoresist Lot Change"@en,
        "光阻批号切换"@zh ;
    ns1:legacyId "fab.cause.resist_lot_change" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.cd_out_of_spec> .

<urn:pxai:semi:catalog:fab.cause.reticle_haze> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "光罩表面结晶或颗粒，在每个曝光场同一相对位置重复出现缺陷。"@zh ;
    skos:notation "fab.cause.reticle_haze" ;
    skos:prefLabel "Reticle Haze / Contamination"@en,
        "光罩雾化/沾污"@zh ;
    ns1:legacyId "fab.cause.reticle_haze" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.particle_excursion> .

<urn:pxai:semi:catalog:fab.cause.target_erosion_profile> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """磁场把等离子体约束在闭合跑道区，靶面被局部而非均匀溅蚀，随使用 形成并加深侵蚀沟槽。沟槽尺寸变化会改变有效溅射源的几何与出射角 分布，从而改变基片上的膜厚径向剖面——文献中随源尺寸/靶基距变化 可从中心厚的钟形转为边缘厚的鞍形，再趋于平坦。与靶材寿命末期的 判别在于：本项是渐变的剖面形状改变，寿命末期是均匀性恶化叠加 剥落颗粒风险跃升。
"""@zh ;
    skos:notation "fab.cause.target_erosion_profile" ;
    skos:prefLabel "Target Erosion Groove Evolution"@en,
        "靶材侵蚀轮廓演化"@zh ;
    ns1:legacyId "fab.cause.target_erosion_profile" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev> .

<urn:pxai:semi:catalog:fab.cause.wafer_backside_contamination> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """晶圆背面或曝光机吸盘表面附着颗粒，晶圆被真空吸附后局部抬升， 造成平面度偏差与离焦，同时在该处引入套刻偏移。 判别特征是偏移呈局部化的不规则分布（而非全片线性或旋转分量）， 且同一吸盘上不同晶圆的偏移位置重复出现——指向吸盘而非晶圆。
"""@zh ;
    skos:notation "fab.cause.wafer_backside_contamination" ;
    skos:prefLabel "Wafer Backside & Chuck Contamination"@en,
        "晶圆背面/吸盘沾污"@zh ;
    ns1:legacyId "fab.cause.wafer_backside_contamination" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.cd_out_of_spec>,
        <urn:pxai:semi:catalog:fab.anomaly.overlay_shift> .

<urn:pxai:semi:catalog:fab.param.chamber_pressure> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "真空腔工作压力。影响等离子体密度、沉积速率与台阶覆盖性。"@zh ;
    skos:notation "fab.param.chamber_pressure" ;
    skos:prefLabel "Chamber Pressure"@en,
        "腔体压力"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.ald_barrier>,
        <urn:pxai:semi:catalog:fab.process.cvd_ild>,
        <urn:pxai:semi:catalog:fab.process.dry_etch>,
        <urn:pxai:semi:catalog:fab.process.lpcvd_nitride>,
        <urn:pxai:semi:catalog:fab.process.poly_deposition>,
        <urn:pxai:semi:catalog:fab.process.pvd_metal> ;
    ns1:legacyId "fab.param.chamber_pressure" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev> ;
    ns1:unitCode "mTorr / Torr" .

<urn:pxai:semi:catalog:fab.param.cmp_pressure> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "晶圆压向研磨垫的压力，与转速共同决定去除率(Preston 方程)。"@zh ;
    skos:notation "fab.param.cmp_pressure" ;
    skos:prefLabel "CMP Down Force"@en,
        "CMP 研磨压力"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.cmp_metal>,
        <urn:pxai:semi:catalog:fab.process.cmp_oxide> ;
    ns1:legacyId "fab.param.cmp_pressure" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.cmp_scratch> ;
    ns1:unitCode "psi" .

<urn:pxai:semi:catalog:fab.param.etch_time> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "蚀刻时长，通常配合终点检测使用，过蚀时间(Over-etch)单独设定。"@zh ;
    skos:notation "fab.param.etch_time" ;
    skos:prefLabel "Etch Time"@en,
        "蚀刻时间"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.dry_etch>,
        <urn:pxai:semi:catalog:fab.process.pr_strip>,
        <urn:pxai:semi:catalog:fab.process.wet_etch> ;
    ns1:legacyId "fab.param.etch_time" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.etch_residue> ;
    ns1:unitCode "s" .

<urn:pxai:semi:catalog:fab.param.exposure_dose> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition """单位面积曝光能量。CD 的最主要旋钮，与焦距构成工艺窗口(Bossung Curve) 的两个轴。剂量漂移常源于光源能量衰退或照度校正失效。
"""@zh ;
    skos:notation "fab.param.exposure_dose" ;
    skos:prefLabel "Exposure Dose"@en,
        "曝光剂量"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.photo_exposure> ;
    ns1:legacyId "fab.param.exposure_dose" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.cd_out_of_spec> ;
    ns1:unitCode "mJ/cm²" .

<urn:pxai:semi:catalog:fab.param.exposure_focus> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition """投影焦平面位置偏移。焦深余量受晶圆平整度与前层 CMP 平坦化质量约束， 离焦表现为 CD 变化伴随侧壁形貌恶化。
"""@zh ;
    skos:notation "fab.param.exposure_focus" ;
    skos:prefLabel "Exposure Focus"@en,
        "曝光焦距"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.photo_exposure> ;
    ns1:legacyId "fab.param.exposure_focus" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.cd_out_of_spec> ;
    ns1:unitCode "nm" .

<urn:pxai:semi:catalog:fab.param.implant_dose> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition "单位面积注入离子数，决定掺杂浓度与方阻。由束流与扫描时间积分控制。"@zh ;
    skos:notation "fab.param.implant_dose" ;
    skos:prefLabel "Implant Dose"@en,
        "注入剂量"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.ion_implant> ;
    ns1:legacyId "fab.param.implant_dose" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.implant_dose_drift> ;
    ns1:unitCode "ions/cm²" .

<urn:pxai:semi:catalog:fab.param.overlay_offset> a ns1:CatalogConcept,
        ns1:ProcessParameter ;
    skos:definition """Scanner 逐批对位补正值，由前批 Overlay 量测结果经 APC 回馈生成。 补正模型失配时会出现补正越修越偏。
"""@zh ;
    skos:notation "fab.param.overlay_offset" ;
    skos:prefLabel "Overlay Correction Offset"@en,
        "对位补正量"@zh ;
    ns1:controlsProcess <urn:pxai:semi:catalog:fab.process.photo_exposure> ;
    ns1:legacyId "fab.param.overlay_offset" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.overlay_shift> ;
    ns1:unitCode "nm" .

<urn:pxai:semi:catalog:fab.stage.cmp> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "平坦化",
        "抛光",
        "研磨" ;
    skos:definition """平坦化制程，为后续光刻提供焦深余量。消耗研磨垫与研磨液， 划伤(Scratch)与碟形凹陷(Dishing)为典型缺陷。
"""@zh ;
    skos:notation "fab.stage.cmp" ;
    skos:prefLabel "CMP"@en,
        "化学机械研磨"@zh ;
    ns1:legacyId "fab.stage.cmp" .

<urn:pxai:semi:catalog:fab.stage.wat_cp> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "WAT",
        "中测",
        "电性",
        "电测" ;
    skos:definition """WAT(Wafer Acceptance Test) 测 Scribe Line 上的工艺控制结构， CP(Circuit Probe) 逐 die 测功能。前段良率在此结算。
"""@zh ;
    skos:notation "fab.stage.wat_cp" ;
    skos:prefLabel "WAT / CP"@en,
        "电性测试"@zh ;
    ns1:legacyId "fab.stage.wat_cp" .

<urn:pxai:semi:impactchain:fab_quality_excursion_business_impact_repair> a ns1:OperationalImpactChain ;
    rdfs:label "晶圆厂品质异常至经营影响链"@zh ;
    ns1:aboutEntity <urn:pxai:semi:anomaly:fab_quality_excursion_delayed_detection_repair> ;
    ns1:impactMechanismText "制造偏差未被及时识别后，可能影响制程良率与产品可靠性，并进一步形成返工、报废、产出受限和交付风险。" ;
    ns1:linksAnomalyToImpact <urn:pxai:semi:impact:economic_quality_excursion_scrap_delivery_repair> ;
    ns1:modelingLimitationText "公开行业资料仅支持影响机制，不支持将任何改善比例、损失金额或处置周期视为特定工厂实测结果。" ;
    ns1:nameZh "晶圆厂品质异常至经营影响链" ;
    ns1:sourceRef "https://link.springer.com/article/10.1007/s00170-026-18777-0" ;
    ns1:sourceType "web" .

<urn:pxai:semi:instance:equipment-downtime-anomaly-round1> ns1:confidence "low" ;
    ns1:identifier "core.anomaly.equipment_down" ;
    ns1:severity "high" ;
    ns1:sourceRef "model_prior:round1.gap_analysis.uncovered" ;
    ns1:sourceType "model_prior" .

<urn:pxai:semi:instance:quality-excursion-anomaly-round1> ns1:confidence "low" ;
    ns1:identifier "core.anomaly.quality_excursion" ;
    ns1:severity "critical" ;
    ns1:sourceRef "model_prior:round1.gap_analysis.uncovered" ;
    ns1:sourceType "model_prior" .

<urn:pxai:semi:scenario:auto_tool_matching> a ns1:L2Scenario ;
    rdfs:label "Auto Tool Matching",
        "Auto Tool Matching"@zh ;
    ns1:composesCapability <urn:pxai:semi:capability:bkm_baseline>,
        <urn:pxai:semi:capability:matching_library>,
        <urn:pxai:semi:capability:set_alert>,
        <urn:pxai:semi:capability:tool_matching>,
        <urn:pxai:semi:capability:user_notification> .

<urn:pxai:semi:validation:equipment-anomaly-coverage-finding-r1> a ns1:ConstraintViolationValidationResult,
        ns1:ValidationFinding ;
    rdfs:label "设备停机异常覆盖违规发现项R1"@zh ;
    ns1:evaluatesFocusEntity <urn:pxai:semi:validation:equipment-downtime-anomaly-case-r1> ;
    ns1:evaluatesOntologyConstraint <urn:pxai:semi:validation:anomaly-detection-traceability-constraint-r1> ;
    ns1:findingCode "FIND-EQUIPMENT-DOWNTIME-COVERAGE-R1" ;
    ns1:releaseBlockingFlag "true" ;
    ns1:severity "high" ;
    ns1:sourceType "model_prior" .

<urn:pxai:semi:validation:equipment-downtime-anomaly-case-r1> a ns1:EquipmentDowntimeAnomaly ;
    rdfs:label "设备停机异常校验案例R1"@zh ;
    ns1:affectsEquipment <urn:pxai:semi:validation:equipment-downtime-subject-equipment-r1> ;
    ns1:detectedByMetric <urn:pxai:semi:validation:equipment-downtime-detection-metric-r1> ;
    ns1:legacyId "core.anomaly.equipment_down" ;
    ns1:severity "high" ;
    ns1:sourceType "model_prior" .

<urn:pxai:semi:validation:equipment-downtime-subject-equipment-r1> a ns1:Equipment ;
    rdfs:label "设备停机异常焦点设备R1"@zh ;
    ns1:equipmentCode "VALIDATION-SUBJECT-EQUIPMENT-R1" ;
    ns1:sourceType "model_prior" .

<urn:pxai:semi:validation:finding:equipment-down-evidence-gap-round1> ns1:confidence "low" ;
    ns1:description "设备停机异常尚无现场设备日志、维护记录或状态事件证据，当前不能作为已验证异常覆盖结果发布。" ;
    ns1:evaluatesFocusEntity <urn:pxai:semi:instance:equipment-downtime-anomaly-round1> ;
    ns1:findingCode "EQUIPMENT_DOWN_EVIDENCE_GAP" ;
    ns1:releaseBlockingFlag "true" ;
    ns1:requiredEvidenceType "设备状态事件、维护日志或可追溯生产记录" ;
    ns1:severity "high" ;
    ns1:sourceRef "model_prior:round1.gap_analysis.uncovered" ;
    ns1:sourceType "model_prior" .

<urn:pxai:semi:validation:finding:quality-excursion-evidence-gap-round1> ns1:confidence "low" ;
    ns1:description "品质异常突发尚无量测结果、SPC记录、缺陷观测或批次履历证据，当前不能作为已验证异常覆盖结果发布。" ;
    ns1:evaluatesFocusEntity <urn:pxai:semi:instance:quality-excursion-anomaly-round1> ;
    ns1:findingCode "QUALITY_EXCURSION_EVIDENCE_GAP" ;
    ns1:releaseBlockingFlag "true" ;
    ns1:requiredEvidenceType "量测结果、SPC记录、缺陷观测或可追溯批次履历" ;
    ns1:severity "critical" ;
    ns1:sourceRef "model_prior:round1.gap_analysis.uncovered" ;
    ns1:sourceType "model_prior" .

<urn:pxai:semi:validation:quality-anomaly-coverage-finding-r1> a ns1:ConstraintViolationValidationResult,
        ns1:ValidationFinding ;
    rdfs:label "品质异常突发覆盖违规发现项R1"@zh ;
    ns1:evaluatesFocusEntity <urn:pxai:semi:validation:quality-excursion-anomaly-case-r1> ;
    ns1:evaluatesOntologyConstraint <urn:pxai:semi:validation:anomaly-detection-traceability-constraint-r1> ;
    ns1:findingCode "FIND-QUALITY-EXCURSION-COVERAGE-R1" ;
    ns1:releaseBlockingFlag "true" ;
    ns1:severity "critical" ;
    ns1:sourceType "model_prior" .

<urn:pxai:semi:validation:quality-excursion-anomaly-case-r1> a ns1:QualityExcursionAnomaly ;
    rdfs:label "品质异常突发校验案例R1"@zh ;
    ns1:affectsEquipment <urn:pxai:semi:validation:equipment-downtime-subject-equipment-r1> ;
    ns1:detectedByMetric <urn:pxai:semi:validation:quality-excursion-detection-metric-r1> ;
    ns1:legacyId "core.anomaly.quality_excursion" ;
    ns1:severity "critical" ;
    ns1:sourceType "model_prior" .

<urn:pxai:semi:catalog:ap.action.adjust_dispense> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "修正点胶量、针头高度或胶体温控，抑制溢胶与空洞。"@zh ;
    skos:notation "ap.action.adjust_dispense" ;
    skos:prefLabel "Adjust Dispense Parameters"@en,
        "调整点胶参数"@zh ;
    ns1:legacyId "ap.action.adjust_dispense" .

<urn:pxai:semi:catalog:ap.action.clean_efo_electrode> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition """按打线点数计数清洗或更换 EFO 电极，恢复放电间隙。 与更换瓷嘴不同：瓷嘴管的是焊接界面质量，电极管的是成球稳定性， 两者寿命周期与判废依据都不同，不能互相替代。
"""@zh ;
    skos:notation "ap.action.clean_efo_electrode" ;
    skos:prefLabel "Clean or Replace EFO Electrode"@en,
        "清洗/更换 EFO 电极"@zh ;
    ns1:legacyId "ap.action.clean_efo_electrode" .

<urn:pxai:semi:catalog:ap.action.reball_rework> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition """对缺球接点补植锡球或整体去球重植，重植后须复量共面性并复检外观。 与更换耗材类动作不同：本动作作用于产品而非设备，因此每次执行都 追加一次热历程，返工次数须受规范限制。连球一般不走本动作—— 桥连处已形成金属连接，去球重植的把握远低于补植缺失接点。
"""@zh ;
    skos:notation "ap.action.reball_rework" ;
    skos:prefLabel "Reball Rework"@en,
        "补植/重植锡球"@zh ;
    ns1:legacyId "ap.action.reball_rework" .

<urn:pxai:semi:catalog:ap.action.replace_probe_card> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition """清洗或更换探针卡与测试座，并对疑似伪失效批次重测。 重测前须先确认治具已恢复，否则重测数据无效。
"""@zh ;
    skos:notation "ap.action.replace_probe_card" ;
    skos:prefLabel "Replace or Clean Probe Card"@en,
        "更换/清洗测试治具"@zh ;
    ns1:legacyId "ap.action.replace_probe_card" .

<urn:pxai:semi:catalog:ap.action.retest> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition """对失效品重新测试以区分伪失效与真实失效。重测次数须受规范限制， 无限重测等于放宽标准。
"""@zh ;
    skos:notation "ap.action.retest" ;
    skos:prefLabel "Retest"@en,
        "重测"@zh ;
    ns1:legacyId "ap.action.retest" .

<urn:pxai:semi:catalog:ap.material.mold_compound> a ns1:CatalogConcept,
        ns1:MaterialType ;
    skos:broader <urn:pxai:semi:catalog:core.material.lot> ;
    skos:definition """环氧模塑料，具吸湿性，开封后有使用期限并须低温防潮储存。 吸湿后模压会汽化产生空洞与分层，是典型的材料状态型风险。
"""@zh ;
    skos:notation "ap.material.mold_compound" ;
    skos:prefLabel "Mold Compound (EMC)"@en,
        "塑封料"@zh ;
    ns1:analogousTo <urn:pxai:semi:external:ext.material.perishable_input> ;
    ns1:legacyId "ap.material.mold_compound" .

<urn:pxai:semi:catalog:ap.process.ball_mount> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """BGA 类封装植锡球并回流形成外部接点。助焊剂涂布量与回流曲线 决定连球、缺球与共面性。
"""@zh ;
    skos:notation "ap.process.ball_mount" ;
    skos:prefLabel "Ball Mount"@en,
        "植球"@zh ;
    ns1:legacyId "ap.process.ball_mount" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.coplanarity> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.final_form> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.singulation> .

<urn:pxai:semi:catalog:ap.process.bumping> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """晶圆级形成锡球或铜柱凸块，供倒装使用。含溅镀 UBM、电镀与回流。 凸块高度共面性决定后续倒装接合可靠性。
"""@zh ;
    skos:notation "ap.process.bumping" ;
    skos:prefLabel "Bumping"@en,
        "凸块制作"@zh ;
    ns1:legacyId "ap.process.bumping" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.coplanarity> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.interconnect> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.backgrind> .

<urn:pxai:semi:catalog:ap.process.burn_in> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """高温加偏压加速筛除早期失效(Infant Mortality)。车规与工规产品必需， 历时数小时至数十小时，是后段 CT 的最大单项。
"""@zh ;
    skos:notation "ap.process.burn_in" ;
    skos:prefLabel "Burn-in"@en,
        "烧机"@zh ;
    ns1:analogousTo <urn:pxai:semi:external:ext.process.stress_screening> ;
    ns1:legacyId "ap.process.burn_in" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.ft_yield> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.test> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.aoi> .

<urn:pxai:semi:catalog:ap.process.epoxy_cure> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition "烘烤固化装片胶达到目标附着强度。固化不足致后续键合时芯粒位移。"@zh ;
    skos:notation "ap.process.epoxy_cure" ;
    skos:prefLabel "Epoxy Cure"@en,
        "胶体固化"@zh ;
    ns1:legacyId "ap.process.epoxy_cure" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.die_shear_strength> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.die_bond> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:ap.material.die_attach_epoxy> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.plasma_clean> .

<urn:pxai:semi:catalog:ap.process.pmc> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition "长时间烘烤使塑封料完全交联达到最终机械与热性能。"@zh ;
    skos:notation "ap.process.pmc" ;
    skos:prefLabel "PMC (Post Mold Cure)"@en,
        "后固化"@zh ;
    ns1:legacyId "ap.process.pmc" ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.encapsulation> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:ap.material.mold_compound> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.laser_mark> .

<urn:pxai:semi:catalog:ap.process.wafer_receive> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """接收前段晶圆并核对 Wafer Map 与 CP 良率分级。投料量依 CP 良率折算， 是后段产能规划的输入起点。
"""@zh ;
    skos:notation "ap.process.wafer_receive" ;
    skos:prefLabel "Wafer Receiving"@en,
        "收片"@zh ;
    ns1:legacyId "ap.process.wafer_receive" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:core.metric.wip> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.wafer_prep> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.lot>,
        <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.backgrind>,
        <urn:pxai:semi:catalog:ap.process.bumping> .

<urn:pxai:semi:catalog:ap.stage.final_form> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "成型",
        "打标",
        "植球" ;
    skos:definition "打印标识、植球或引脚成型、切筋分离成单颗成品。"@zh ;
    skos:notation "ap.stage.final_form" ;
    skos:prefLabel "Final Forming"@en,
        "成品成型"@zh ;
    ns1:legacyId "ap.stage.final_form" .

<urn:pxai:semi:catalog:core.anomaly.equipment_down> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """机台失去产出能力。区分计划内(PM/Qual)与计划外(Breakdown)： 前者可排程避让，后者同时冲击 WIP 分布与稼动。前后段各自的具体 停机异常通过 refines 归入本节点，共享排查与影响评估骨架。
"""@zh ;
    skos:notation "core.anomaly.equipment_down" ;
    skos:prefLabel "Equipment Down"@en,
        "设备停机"@zh ;
    ns1:legacyId "core.anomaly.equipment_down" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:core.metric.oee>,
        <urn:pxai:semi:catalog:core.metric.throughput> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:erp.action.clear_gr_ir> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "匹配收货与发票完成自动清账；差异项人工核销或退回采购处理。"@zh ;
    skos:notation "erp.action.clear_gr_ir" ;
    skos:prefLabel "Clear GR/IR Balance"@en,
        "清理 GR/IR 暂估"@zh ;
    ns1:legacyId "erp.action.clear_gr_ir" .

<urn:pxai:semi:catalog:erp.action.correct_asset_master> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "修正折旧方法/年限/残值并重算折旧，必要时冲正错误期间计提。"@zh ;
    skos:notation "erp.action.correct_asset_master" ;
    skos:prefLabel "Correct Asset Master Data"@en,
        "修正资产主数据"@zh ;
    ns1:legacyId "erp.action.correct_asset_master" .

<urn:pxai:semi:catalog:erp.action.credit_review_release> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "复核客户授信与敞口，收款回补或审批提额后释放开票冻结。"@zh ;
    skos:notation "erp.action.credit_review_release" ;
    skos:prefLabel "Credit Review & Release"@en,
        "信用复核并释放"@zh ;
    ns1:legacyId "erp.action.credit_review_release" .

<urn:pxai:semi:catalog:erp.action.provision_writedown> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "按成本与可变现净值孰低计提存货跌价准备，冲减存货账面。"@zh ;
    skos:notation "erp.action.provision_writedown" ;
    skos:prefLabel "Provision for Write-down"@en,
        "计提跌价准备"@zh ;
    ns1:legacyId "erp.action.provision_writedown" .

<urn:pxai:semi:catalog:erp.action.recalc_allocation_rate> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "校正成本中心到成本对象的分摊基准与费率，消除交叉补贴。"@zh ;
    skos:notation "erp.action.recalc_allocation_rate" ;
    skos:prefLabel "Recalculate Allocation Rate"@en,
        "重算分摊率"@zh ;
    ns1:legacyId "erp.action.recalc_allocation_rate" .

<urn:pxai:semi:catalog:erp.anomaly.billing_block> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """销售订单无法开票放行。判别要点：客户敞口超信用额度指向信用管理冻结；交货未过账（PGI） 指向物流未完成；单据带人工开票冻结指向审批未释放。
"""@zh ;
    skos:notation "erp.anomaly.billing_block" ;
    skos:prefLabel "Billing Block / Credit Exceeded"@en,
        "开票冻结/信用超限"@zh ;
    ns1:legacyId "erp.anomaly.billing_block" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:erp.metric.credit_exposure> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:erp.action.credit_review_release> ;
    ns1:severity "medium" .

<urn:pxai:semi:catalog:erp.anomaly.depreciation_error> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """折旧计提金额偏离预期，或累计折旧逼近/超过资产原值。判别要点：全类资产同向偏差指向 折旧方法或年限主数据错误；单项资产异常指向资本化时点（在建工程转固延迟）或残值设置。
"""@zh ;
    skos:notation "erp.anomaly.depreciation_error" ;
    skos:prefLabel "Depreciation Posting Error"@en,
        "折旧计提异常"@zh ;
    ns1:legacyId "erp.anomaly.depreciation_error" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:erp.metric.net_book_value> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:erp.action.correct_asset_master> ;
    ns1:severity "medium" .

<urn:pxai:semi:catalog:erp.anomaly.gr_ir_mismatch> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """月结时收货/发票暂估科目（GR/IR）余额无法清零。判别要点：已收货未开票指向发票未到； 价格或数量不符指向采购订单与发票差异；长期挂账指向单据遗漏需人工清账。
"""@zh ;
    skos:notation "erp.anomaly.gr_ir_mismatch" ;
    skos:prefLabel "GR/IR Reconciliation Failure"@en,
        "GR/IR 暂估对账失败"@zh ;
    ns1:legacyId "erp.anomaly.gr_ir_mismatch" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:erp.metric.gr_ir_balance> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:erp.action.clear_gr_ir> ;
    ns1:severity "medium" .

<urn:pxai:semi:catalog:erp.anomaly.inventory_writedown> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """存货可变现净值（NRV）低于账面成本，须计提跌价准备。判别要点：市价普跌指向外部 行情；特定料号积压且周转恶化指向呆滞；伴随大额报废指向产线良率损失冲减。
"""@zh ;
    skos:notation "erp.anomaly.inventory_writedown" ;
    skos:prefLabel "Inventory Write-down"@en,
        "存货跌价"@zh ;
    ns1:legacyId "erp.anomaly.inventory_writedown" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:erp.metric.inventory_turnover> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:erp.action.provision_writedown> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:erp.anomaly.yield_cost_impact> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """产线良率下降经成本吸收传导为单位成本上升——跨源系统（制造→ERP）的经营影响。判别要点： 单位成本升幅与良率降幅同步且产量下降指向固定成本稀释不足；仅料成本升则回到采购价差。
"""@zh ;
    skos:notation "erp.anomaly.yield_cost_impact" ;
    skos:prefLabel "Yield-Driven Unit Cost Increase"@en,
        "良率下降致单位成本上升"@zh ;
    ns1:legacyId "erp.anomaly.yield_cost_impact" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:core.metric.yield>,
        <urn:pxai:semi:catalog:erp.metric.cost_variance_rate> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:erp.action.revalue_standard_cost>,
        <urn:pxai:semi:catalog:erp.action.variance_analysis> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:erp.bp.customer_fabless_a> a ns1:BusinessPartner,
        ns1:CatalogConcept ;
    skos:altLabel "BP",
        "客户主数据" ;
    skos:definition "BP 统一主数据（客户/供应商同源），承担客户角色。"@zh ;
    skos:notation "erp.bp.customer_fabless_a" ;
    skos:prefLabel "Business Partner Fabless-A"@en,
        "业务伙伴—Fabless 客户 A"@zh ;
    ns1:legacyId "erp.bp.customer_fabless_a" .

<urn:pxai:semi:catalog:erp.metric.credit_exposure> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "客户未清应收加在途订单金额，对比授信额度触发信用管理。"@zh ;
    skos:notation "erp.metric.credit_exposure" ;
    skos:prefLabel "Customer Credit Exposure"@en,
        "客户信用敞口"@zh ;
    ns1:legacyId "erp.metric.credit_exposure" ;
    ns1:unitCode "金额" .

<urn:pxai:semi:catalog:erp.metric.gr_ir_balance> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "收货/发票暂估科目余额。月结目标为清零，长期非零即对账阻塞。"@zh ;
    skos:notation "erp.metric.gr_ir_balance" ;
    skos:prefLabel "GR/IR Balance"@en,
        "GR/IR 暂估余额"@zh ;
    ns1:legacyId "erp.metric.gr_ir_balance" ;
    ns1:unitCode "金额" .

<urn:pxai:semi:catalog:erp.metric.inventory_turnover> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "销售成本除以平均存货。周转单调下滑是呆滞与跌价风险的先行信号。"@zh ;
    skos:notation "erp.metric.inventory_turnover" ;
    skos:prefLabel "Inventory Turnover"@en,
        "存货周转率"@zh ;
    ns1:legacyId "erp.metric.inventory_turnover" ;
    ns1:unitCode "次/期" .

<urn:pxai:semi:catalog:erp.metric.net_book_value> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "资产原值减累计折旧。自检约束：累计折旧不得超过原值（净值≥残值）。"@zh ;
    skos:notation "erp.metric.net_book_value" ;
    skos:prefLabel "Net Book Value"@en,
        "资产净值"@zh ;
    ns1:legacyId "erp.metric.net_book_value" ;
    ns1:unitCode "金额" .

<urn:pxai:semi:catalog:fab.action.chamber_season> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition """清洗后按制程配方在腔体内壁与零件上沉积一层预处理膜，封住残留 污染物并使腔体热态与沉积环境回到稳态，之后跑验证片确认膜厚与 均匀性恢复再放行量产。是清洗之后的独立步骤，不是清洗的一部分。
"""@zh ;
    skos:notation "fab.action.chamber_season" ;
    skos:prefLabel "Chamber Seasoning"@en,
        "腔体预处理（seasoning）"@zh ;
    ns1:legacyId "fab.action.chamber_season" .

<urn:pxai:semi:catalog:fab.action.clean_chuck> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition """停机清洗曝光机晶圆吸盘并复测平面度，消除背面颗粒引起的局部抬升。 与已有的腔体清洗、光罩清洗不同：对象是承片吸盘， 验证方式是平面度与套刻复测，而非颗粒计数或成像质量。
"""@zh ;
    skos:notation "fab.action.clean_chuck" ;
    skos:prefLabel "Clean Exposure Chuck"@en,
        "清洗曝光机吸盘"@zh ;
    ns1:legacyId "fab.action.clean_chuck" .

<urn:pxai:semi:catalog:fab.action.reticle_clean> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "送洗光罩并复检，期间需备用光罩或排程避让。"@zh ;
    skos:notation "fab.action.reticle_clean" ;
    skos:prefLabel "Reticle Clean"@en,
        "光罩清洗"@zh ;
    ns1:legacyId "fab.action.reticle_clean" .

<urn:pxai:semi:catalog:fab.process.cp_test> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """逐 die 探针测试功能与性能，产出 Wafer Map 与良率分级。 结果决定后段投料数量与分选策略。
"""@zh ;
    skos:notation "fab.process.cp_test" ;
    skos:prefLabel "CP (Circuit Probe)"@en,
        "晶圆针测"@zh ;
    ns1:legacyId "fab.process.cp_test" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:core.metric.yield> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.wat_cp> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.lot>,
        <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.wafer_receive> .

<urn:pxai:semi:catalog:fab.route.cmos_logic_main> a ns1:CatalogConcept,
        ns1:Route ;
    skos:definition """成熟制程 CMOS 逻辑产品的简化主流程，从投料到 CP 结算。实际多层金属 产品在"光刻-蚀刻-薄膜-CMP"区段循环 6~12 轮，此处只展开一轮以保持 链路可读。steps 顺序与 20-flow-precedes.yaml 的 precedes 链严格一致。
"""@zh ;
    skos:notation "fab.route.cmos_logic_main" ;
    skos:prefLabel "CMOS Logic Main Flow (Single Metal Layer)"@en,
        "CMOS 逻辑主流程（单金属层）"@zh ;
    ns1:legacyId "fab.route.cmos_logic_main" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:core.metric.cycle_time>,
        <urn:pxai:semi:catalog:core.metric.wip>,
        <urn:pxai:semi:catalog:core.metric.yield> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.lot>,
        <urn:pxai:semi:catalog:core.material.wafer> .

<urn:pxai:semi:catalog:fab.stage.metrology> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "QC 站",
        "缺陷检测",
        "量测",
        "量测区" ;
    skos:definition """非增值但决定可观测性的工序段。含 CD/膜厚/Overlay 量测与 明场/暗场缺陷扫描。抽检率是产能与风险暴露的权衡。
"""@zh ;
    skos:notation "fab.stage.metrology" ;
    skos:prefLabel "Metrology & Inspection"@en,
        "量测与缺陷检测"@zh ;
    ns1:legacyId "fab.stage.metrology" .

<urn:pxai:semi:catalog:fab.stage.photo> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "Litho",
        "光罩制程",
        "黄光",
        "黄光区" ;
    skos:broader <urn:pxai:semi:catalog:core.risknode.bottleneck_station> ;
    skos:definition """图形转移制程段，涂胶-曝光-显影三段联动。是前段最贵、通常最紧的产能 环节，CD 与 Overlay 两项指标决定后续所有图形精度。
"""@zh ;
    skos:notation "fab.stage.photo" ;
    skos:prefLabel "Photolithography"@en,
        "光刻"@zh ;
    ns1:legacyId "fab.stage.photo" .

<urn:pxai:semi:catalog:fab.stage.thinfilm> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "沉积",
        "薄膜",
        "镀膜" ;
    skos:definition "PVD/CVD/ALD 沉积导体与介电层。膜厚均匀性与应力控制为核心。"@zh ;
    skos:notation "fab.stage.thinfilm" ;
    skos:prefLabel "Thin Film Deposition"@en,
        "薄膜沉积"@zh ;
    ns1:legacyId "fab.stage.thinfilm" .

<urn:pxai:semi:fac:utility:multi_system_repair_r2> a ns1:UtilitySystem ;
    rdfs:label "多公用系统监测对象门禁修复实体"@zh ;
    ns1:sourceRef "https://semiconductorx.com/fab-ops-facility-management.html" ;
    ns1:sourceType "web" .

<urn:pxai:semi:validation:anomaly-detection-traceability-constraint-r1> a ns1:OntologyIntegrityConstraint,
        ns1:SemanticConsistencyConstraint ;
    rdfs:label "异常检测可追溯性约束R1"@zh ;
    ns1:ontologyConstraintCode "VAL-ANOMALY-DETECTION-TRACE-R1" ;
    ns1:ontologyConstraintMessage "异常实例应关联检测指标；涉及设备影响时还应关联受影响设备，并由校验发现项指明焦点实体。" ;
    ns1:requiredEvidenceType "检测指标关联与受影响设备关联" ;
    ns1:sourceType "model_prior" .

<urn:pxai:semi:catalog:ap.cause.capillary_wear> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """键合瓷嘴端面磨损或积屑，改变超声能量传递效率。特征是不良集中于 特定机台特定线位，且随键合次数累积恶化。
"""@zh ;
    skos:notation "ap.cause.capillary_wear" ;
    skos:prefLabel "Capillary Wear"@en,
        "瓷嘴磨损"@zh ;
    ns1:legacyId "ap.cause.capillary_wear" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> .

<urn:pxai:semi:catalog:ap.cause.emc_moisture> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """塑封料开封后吸湿或超期使用，模压时水分汽化形成空洞与分层。 是典型的材料状态型根因，与设备无关。
"""@zh ;
    skos:notation "ap.cause.emc_moisture" ;
    skos:prefLabel "Mold Compound Moisture"@en,
        "塑封料吸湿"@zh ;
    ns1:legacyId "ap.cause.emc_moisture" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.delamination>,
        <urn:pxai:semi:catalog:ap.anomaly.mold_void> .

<urn:pxai:semi:catalog:ap.cause.fixture_shortage> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """测试治具、烧机板或载具数量不足，机台可用但无法开工。 是后段 WIP 堆积中容易被忽略的非设备型成因。
"""@zh ;
    skos:notation "ap.cause.fixture_shortage" ;
    skos:prefLabel "Fixture & Carrier Shortage"@en,
        "治具/载具短缺"@zh ;
    ns1:legacyId "ap.cause.fixture_shortage" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.bonder_down>,
        <urn:pxai:semi:catalog:core.anomaly.wip_bubble> .

<urn:pxai:semi:catalog:ap.cause.pad_contamination> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """焊垫表面有机残留、氧化或溢胶覆盖，阻碍金属间化合物形成。 来源可能在前段（钝化层残留）或后段（装片溢胶）。
"""@zh ;
    skos:notation "ap.cause.pad_contamination" ;
    skos:prefLabel "Bond Pad Contamination"@en,
        "焊垫污染"@zh ;
    ns1:legacyId "ap.cause.pad_contamination" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.delamination>,
        <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> .

<urn:pxai:semi:catalog:ap.metric.ball_shear_strength> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "侧向剪切焊球评估球焊接合面积与金属间化合物形成质量。"@zh ;
    skos:notation "ap.metric.ball_shear_strength" ;
    skos:prefLabel "Ball Shear Strength"@en,
        "球剪切强度"@zh ;
    ns1:legacyId "ap.metric.ball_shear_strength" ;
    ns1:unitCode "gf" .

<urn:pxai:semi:catalog:ap.process.backgrind> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """磨除晶圆背面材料至目标厚度。厚度越薄机械强度越低，进给速率过快或 砂轮堵塞会引入微裂纹，成为后续裂片的隐性起点。
"""@zh ;
    skos:notation "ap.process.backgrind" ;
    skos:prefLabel "Backgrinding"@en,
        "背面研磨"@zh ;
    ns1:legacyId "ap.process.backgrind" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.wafer_thickness_var> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.wafer_prep> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.wafer_mount> .

<urn:pxai:semi:catalog:ap.process.flip_chip_bond> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """芯粒翻转使凸块直接对位接合基板，经回流形成连接。对位精度与 凸块共面性要求高，适用高脚数高频产品。
"""@zh ;
    skos:notation "ap.process.flip_chip_bond" ;
    skos:prefLabel "Flip Chip Bonding"@en,
        "倒装接合"@zh ;
    ns1:legacyId "ap.process.flip_chip_bond" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.coplanarity> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.interconnect> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.underfill> .

<urn:pxai:semi:catalog:ap.process.singulation> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition "切除连接筋分离成单颗成品，引脚成型至规格角度与共面度。"@zh ;
    skos:notation "ap.process.singulation" ;
    skos:prefLabel "Singulation / Trim & Form"@en,
        "切筋分离"@zh ;
    ns1:legacyId "ap.process.singulation" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.coplanarity> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.final_form> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.final_test> .

<urn:pxai:semi:catalog:ap.stage.test> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "Final Test",
        "成测",
        "终测" ;
    skos:definition """成品终测、可靠性烧机与外观检验。是后段良率结算点， 测试机台与治具产能通常是后段瓶颈。
"""@zh ;
    skos:notation "ap.stage.test" ;
    skos:prefLabel "Test"@en,
        "测试"@zh ;
    ns1:analogousTo <urn:pxai:semi:external:ext.stage.grading_sorting> ;
    ns1:legacyId "ap.stage.test" .

<urn:pxai:semi:catalog:ap.stage.wafer_prep> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "前处理",
        "磨切",
        "背磨切割" ;
    skos:definition """收片、背面研磨减薄、贴膜与切割。将前段交付的完整晶圆转为独立芯粒(Die)。 此段的机械应力控制决定后续裂片风险。
"""@zh ;
    skos:notation "ap.stage.wafer_prep" ;
    skos:prefLabel "Wafer Preparation"@en,
        "晶圆前处理"@zh ;
    ns1:legacyId "ap.stage.wafer_prep" .

<urn:pxai:semi:catalog:erp.anomaly.cost_variance_excursion> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """实际成本对标准成本的差异（价差/量差/效率差）超出管控界限。判别要点在差异分解： 全线料成本同向上升指向实际采购价波动或标准成本过时；单位成本随产出下降而升指向 良率吸收；仅特定成本中心异常指向制造费用分摊基准失真。
"""@zh ;
    skos:notation "erp.anomaly.cost_variance_excursion" ;
    skos:prefLabel "Cost Variance Excursion"@en,
        "成本差异超标"@zh ;
    ns1:legacyId "erp.anomaly.cost_variance_excursion" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:erp.metric.cost_variance_rate> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:erp.action.recalc_allocation_rate>,
        <urn:pxai:semi:catalog:erp.action.revalue_standard_cost>,
        <urn:pxai:semi:catalog:erp.action.variance_analysis> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:erp.cause.overhead_allocation_drift> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """成本中心费用按失真基准（工时/机时）分摊到成本对象，使单一成本中心差异异常。 特征是差异集中于特定成本中心而非全线。
"""@zh ;
    skos:notation "erp.cause.overhead_allocation_drift" ;
    skos:prefLabel "Overhead Allocation Base Drift"@en,
        "制造费用分摊基准失真"@zh ;
    ns1:legacyId "erp.cause.overhead_allocation_drift" ;
    ns1:mayCause <urn:pxai:semi:catalog:erp.anomaly.cost_variance_excursion>,
        <urn:pxai:semi:catalog:erp.anomaly.yield_cost_impact> .

<urn:pxai:semi:catalog:erp.cause.purchase_price_swing> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "原材料/委外实际采购价偏离标准，形成价差（PPV）。与量差的区分在于是否随用量放大。"@zh ;
    skos:notation "erp.cause.purchase_price_swing" ;
    skos:prefLabel "Actual Purchase Price Swing"@en,
        "采购实际价波动"@zh ;
    ns1:legacyId "erp.cause.purchase_price_swing" ;
    ns1:mayCause <urn:pxai:semi:catalog:erp.anomaly.cost_variance_excursion>,
        <urn:pxai:semi:catalog:erp.anomaly.inventory_writedown> .

<urn:pxai:semi:catalog:fab.cause.beam_current_drift> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "法拉第杯沾污或离子源老化导致束流读数偏离实际，剂量随之失准。"@zh ;
    skos:notation "fab.cause.beam_current_drift" ;
    skos:prefLabel "Beam Current Measurement Drift"@en,
        "束流测量漂移"@zh ;
    ns1:legacyId "fab.cause.beam_current_drift" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.implant_dose_drift> .

<urn:pxai:semi:catalog:fab.cause.chamber_polymer_buildup> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """蚀刻腔内壁反应产物累积，改变等离子体阻抗与选择比，造成蚀刻速率漂移 与颗粒剥落。表现为随 RF Hours 增长的渐变型恶化。
"""@zh ;
    skos:notation "fab.cause.chamber_polymer_buildup" ;
    skos:prefLabel "Chamber Polymer Buildup"@en,
        "腔体聚合物累积"@zh ;
    ns1:legacyId "fab.cause.chamber_polymer_buildup" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.etch_residue>,
        <urn:pxai:semi:catalog:fab.anomaly.particle_excursion> .

<urn:pxai:semi:catalog:fab.cause.chamber_wall_condition> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """清洗后未做 seasoning、或 seasoning 膜与后续制程不匹配时，腔体内壁与 零件的残留状态会同时影响片间沉积速率与片内均匀性，残留物脱落还会 转为颗粒污染。表现签名是清洗或长时间待机后的首片偏离、随后逐片 回稳。与腔体聚合物累积的判别在于时点与方向：本项出现在清洗/待机 之后且随加工片数收敛，累积类出现在长时间连续生产中且随片数发散。
"""@zh ;
    skos:notation "fab.cause.chamber_wall_condition" ;
    skos:prefLabel "Unconditioned Chamber Wall State"@en,
        "腔体壁沉积状态未预处理"@zh ;
    ns1:legacyId "fab.cause.chamber_wall_condition" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev>,
        <urn:pxai:semi:catalog:fab.anomaly.particle_excursion> .

<urn:pxai:semi:catalog:fab.cause.light_source_degradation> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """准分子激光或 EUV 光源功率随累积脉冲衰减，跌破配方所需剂量下限时 曝光被拒或需延长扫描时间。区别于伺服类停机：产出率先缓慢下降， 再转为硬停机，属可预测型劣化。
"""@zh ;
    skos:notation "fab.cause.light_source_degradation" ;
    skos:prefLabel "Light Source Power Degradation"@en,
        "曝光光源功率衰减/熄灭"@zh ;
    ns1:legacyId "fab.cause.light_source_degradation" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.scanner_down> .

<urn:pxai:semi:catalog:fab.cause.pm_overdue> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """瓶颈机台的 PM 常因赶产被推迟，逾期后非计划停机概率显著上升。 判别依据是停机前 PM 计划已超期，而非任何硬件突发信号—— 这类停机本质是排程决策的后果，不是设备故障。
"""@zh ;
    skos:notation "fab.cause.pm_overdue" ;
    skos:prefLabel "Preventive Maintenance Overdue"@en,
        "预防保养逾期"@zh ;
    ns1:legacyId "fab.cause.pm_overdue" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.scanner_down> .

<urn:pxai:semi:catalog:fab.cause.reticle_stage_error> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """双工件台同步扫描依赖纳米级伺服跟随，编码器、气浮或温控偏差会触发 扫描中断报警并锁机。特征是报警集中于扫描动作阶段而非曝光光源侧， 且常伴随特定 slit 位置重复出现。
"""@zh ;
    skos:notation "fab.cause.reticle_stage_error" ;
    skos:prefLabel "Reticle & Wafer Stage Servo Error"@en,
        "光罩台/工件台伺服异常"@zh ;
    ns1:legacyId "fab.cause.reticle_stage_error" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.scanner_down> .

<urn:pxai:semi:catalog:fab.cause.slurry_agglomeration> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "研磨液储存或输送中颗粒团聚成大粒径硬颗粒，成为划伤直接来源。"@zh ;
    skos:notation "fab.cause.slurry_agglomeration" ;
    skos:prefLabel "Slurry Particle Agglomeration"@en,
        "研磨液粒径团聚"@zh ;
    ns1:legacyId "fab.cause.slurry_agglomeration" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.cmp_scratch>,
        <urn:pxai:semi:catalog:fab.anomaly.particle_excursion> .

<urn:pxai:semi:catalog:fab.cause.target_end_of_life> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition "靶材侵蚀至极限，膜厚均匀性恶化且剥落颗粒风险显著上升。"@zh ;
    skos:notation "fab.cause.target_end_of_life" ;
    skos:prefLabel "PVD Target End of Life"@en,
        "靶材寿命末期"@zh ;
    ns1:legacyId "fab.cause.target_end_of_life" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev>,
        <urn:pxai:semi:catalog:fab.anomaly.particle_excursion> .

<urn:pxai:semi:catalog:fab.process.ald_barrier> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """原子层沉积，逐层自限制生长，台阶覆盖性最佳。速率低， 单片工序时间长，先进制程中逐渐成为产能约束点。
"""@zh ;
    skos:notation "fab.process.ald_barrier" ;
    skos:prefLabel "ALD Barrier Deposition"@en,
        "ALD 阻挡层沉积"@zh ;
    ns1:legacyId "fab.process.ald_barrier" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.film_thickness> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.thinfilm> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.pvd_metal> .

<urn:pxai:semi:catalog:fab.process.furnace_anneal> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition "长时间批式退火，用于致密化介电层或应力释放。"@zh ;
    skos:notation "fab.process.furnace_anneal" ;
    skos:prefLabel "Furnace Anneal"@en,
        "炉管退火"@zh ;
    ns1:legacyId "fab.process.furnace_anneal" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.film_thickness> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.diffusion> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.cmp_oxide> .

<urn:pxai:semi:catalog:fab.process.gate_oxidation> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """生长栅极介电层，厚度均匀性与界面缺陷密度直接决定器件阈值电压与可靠性。 对颗粒与金属污染最敏感的工序之一。
"""@zh ;
    skos:notation "fab.process.gate_oxidation" ;
    skos:prefLabel "Gate Oxidation"@en,
        "栅氧化"@zh ;
    ns1:legacyId "fab.process.gate_oxidation" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.film_thickness>,
        <urn:pxai:semi:catalog:fab.metric.wat_vt> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.diffusion> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.poly_deposition> .

<urn:pxai:semi:catalog:fab.process.lpcvd_nitride> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """低压化学气相沉积 Si3N4，作硬掩膜或钝化层。批式炉管加工， 片间与片内均匀性受气流分布与温区平衡影响。
"""@zh ;
    skos:notation "fab.process.lpcvd_nitride" ;
    skos:prefLabel "LPCVD Nitride Deposition"@en,
        "LPCVD 氮化硅沉积"@zh ;
    ns1:legacyId "fab.process.lpcvd_nitride" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.film_thickness> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.diffusion> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.photo_coat> .

<urn:pxai:semi:catalog:fab.process.photo_develop> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """显影液溶解曝光区（正胶）形成图形，随后硬烤固化。显影时间与温度 偏移直接改变 CD，是 CD 微调的常用旋钮。
"""@zh ;
    skos:notation "fab.process.photo_develop" ;
    skos:prefLabel "Development"@en,
        "显影"@zh ;
    ns1:legacyId "fab.process.photo_develop" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.cd_uniformity> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.photo> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.cd_measure> .

<urn:pxai:semi:catalog:fab.process.poly_deposition> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition "沉积多晶硅作栅极材料，晶粒尺寸与掺杂浓度影响方阻。"@zh ;
    skos:notation "fab.process.poly_deposition" ;
    skos:prefLabel "Polysilicon Deposition"@en,
        "多晶硅沉积"@zh ;
    ns1:legacyId "fab.process.poly_deposition" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.film_thickness>,
        <urn:pxai:semi:catalog:fab.metric.sheet_resistance> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.diffusion> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.wet_etch> .

<urn:pxai:semi:catalog:fab.process.rta_anneal> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """秒级升降温激活掺杂并修复注入损伤。单片加工，热预算控制优于炉管退火， 抑制掺杂扩散拖尾。
"""@zh ;
    skos:notation "fab.process.rta_anneal" ;
    skos:prefLabel "RTA (Rapid Thermal Anneal)"@en,
        "快速热退火"@zh ;
    ns1:legacyId "fab.process.rta_anneal" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.sheet_resistance> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.diffusion> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.gate_oxidation> .

<urn:pxai:semi:catalog:fab.process.thermal_oxidation> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """高温通氧生长 SiO2，用作垫氧化层或牺牲层。干氧致密速率慢，湿氧速率快 质量略低。厚度由温度-时间-气氛共同决定。
"""@zh ;
    skos:notation "fab.process.thermal_oxidation" ;
    skos:prefLabel "Thermal Oxidation"@en,
        "热氧化"@zh ;
    ns1:legacyId "fab.process.thermal_oxidation" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.film_thickness> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.diffusion> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.lpcvd_nitride> .

<urn:pxai:semi:catalog:fab.process.wafer_clean> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """RCA/SPM 等化学清洗去除颗粒、有机物与金属污染。是几乎每个 关键工序前的标配预处理，清洗能力直接决定缺陷基线。
"""@zh ;
    skos:notation "fab.process.wafer_clean" ;
    skos:prefLabel "Wafer Clean"@en,
        "晶圆清洗"@zh ;
    ns1:legacyId "fab.process.wafer_clean" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.etch> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.thermal_oxidation> .

<urn:pxai:semi:catalog:fab.process.wet_etch> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """化学溶液各向同性蚀刻，选择比高但侧向侵蚀明显。用于牺牲层去除 与特定材料剥离。槽液浓度随使用衰减，需按 batch count 换槽。
"""@zh ;
    skos:notation "fab.process.wet_etch" ;
    skos:prefLabel "Wet Etch"@en,
        "湿法蚀刻"@zh ;
    ns1:legacyId "fab.process.wet_etch" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.etch_depth> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.etch> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.ald_barrier> .

<urn:pxai:semi:catalog:fab.stage.etch> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "Dry Etch",
        "干蚀",
        "蚀刻区" ;
    skos:definition """按光阻图形去除材料。干法(等离子)为主流，湿法用于特定选择性需求。 关键指标为蚀刻速率、选择比、侧壁形貌与均匀性。
"""@zh ;
    skos:notation "fab.stage.etch" ;
    skos:prefLabel "Etch"@en,
        "蚀刻"@zh ;
    ns1:legacyId "fab.stage.etch" .

<urn:pxai:semi:catalog:ap.action.plasma_clean_rerun> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "对疑似焊垫污染批次补做等离子清洁后重新键合验证。"@zh ;
    skos:notation "ap.action.plasma_clean_rerun" ;
    skos:prefLabel "Additional Plasma Clean"@en,
        "追加等离子清洁"@zh ;
    ns1:legacyId "ap.action.plasma_clean_rerun" .

<urn:pxai:semi:catalog:ap.action.reallocate_fixture> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "跨产品调配测试治具与烧机板，或改派至等价机台缓解堆积。"@zh ;
    skos:notation "ap.action.reallocate_fixture" ;
    skos:prefLabel "Reallocate Fixture or Machine"@en,
        "调配治具/改派机台"@zh ;
    ns1:legacyId "ap.action.reallocate_fixture" .

<urn:pxai:semi:catalog:ap.action.replace_capillary> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "更换键合瓷嘴并跑首件拉力确认恢复。"@zh ;
    skos:notation "ap.action.replace_capillary" ;
    skos:prefLabel "Replace Capillary"@en,
        "更换瓷嘴"@zh ;
    ns1:legacyId "ap.action.replace_capillary" .

<urn:pxai:semi:catalog:ap.metric.chipping_size> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "切割边缘破损的最大尺寸。超过 Scribe Line 余量即侵入有效电路区。"@zh ;
    skos:notation "ap.metric.chipping_size" ;
    skos:prefLabel "Chipping Size"@en,
        "崩边尺寸"@zh ;
    ns1:legacyId "ap.metric.chipping_size" ;
    ns1:unitCode "μm" .

<urn:pxai:semi:catalog:ap.process.die_attach> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """取片并以银胶或膜状胶贴装到基板/引线框架。胶量过多溢出污染键合区(Epoxy Bleed)， 过少则空洞率上升影响散热与附着力。
"""@zh ;
    skos:notation "ap.process.die_attach" ;
    skos:prefLabel "Die Attach"@en,
        "装片"@zh ;
    ns1:legacyId "ap.process.die_attach" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.die_shear_strength>,
        <urn:pxai:semi:catalog:ap.metric.void_ratio> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.die_bond> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:ap.material.die_attach_epoxy>,
        <urn:pxai:semi:catalog:ap.material.mold_compound> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.epoxy_cure> .

<urn:pxai:semi:catalog:ap.stage.interconnect> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "Bonding",
        "打线",
        "焊线",
        "键合" ;
    skos:definition """建立芯粒与外部的电气连接。金线键合(Wire Bond)为传统主流， 凸块加倒装(Bumping + Flip Chip)用于高脚数高频产品。
"""@zh ;
    skos:notation "ap.stage.interconnect" ;
    skos:prefLabel "Interconnect"@en,
        "互连"@zh ;
    ns1:legacyId "ap.stage.interconnect" .

<urn:pxai:semi:catalog:fab.action.skip_ahead> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition """将批次绕过故障机台改派至替代机台或调整工序顺序，用于缓解 WIP 堆积。 需评估替代机台的工艺等价性(Tool Matching)。
"""@zh ;
    skos:notation "fab.action.skip_ahead" ;
    skos:prefLabel "Skip Ahead / Reroute"@en,
        "越站/改道"@zh ;
    ns1:legacyId "fab.action.skip_ahead" .

<urn:pxai:semi:catalog:fab.anomaly.implant_dose_drift> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """实际注入剂量偏离设定值，通常由束流测量系统污染、法拉第杯读数偏差或 离子源老化引起。前段无直接量测，多经方阻或 WAT Vt 间接暴露， 检出滞后是其主要风险特征。
"""@zh ;
    skos:notation "fab.anomaly.implant_dose_drift" ;
    skos:prefLabel "Implant Dose Drift"@en,
        "注入剂量漂移"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:fab.process.cp_test> ;
    ns1:detectedAt <urn:pxai:semi:catalog:fab.process.wat> ;
    ns1:legacyId "fab.anomaly.implant_dose_drift" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.sheet_resistance>,
        <urn:pxai:semi:catalog:fab.metric.wat_vt> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:fab.action.expand_sampling>,
        <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.recipe_adjust> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:fab.anomaly.scanner_down> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:broader <urn:pxai:semi:catalog:core.anomaly.equipment_down> ;
    skos:definition """曝光设备突发故障。因光刻通常为瓶颈，其停机同时造成上游 WIP 堆积 与下游断流，且产能损失不可由后续工序补偿。
"""@zh ;
    skos:notation "fab.anomaly.scanner_down" ;
    skos:prefLabel "Scanner Unscheduled Down"@en,
        "光刻机非计划停机"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:fab.process.photo_exposure>,
        <urn:pxai:semi:catalog:fab.route.cmos_logic_main> ;
    ns1:detectedAt <urn:pxai:semi:catalog:fab.process.photo_exposure> ;
    ns1:legacyId "fab.anomaly.scanner_down" ;
    ns1:mayCause <urn:pxai:semi:catalog:core.anomaly.wip_bubble> ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:core.metric.oee>,
        <urn:pxai:semi:catalog:core.metric.throughput>,
        <urn:pxai:semi:catalog:core.metric.wip> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:fab.action.dispatch_field_service>,
        <urn:pxai:semi:catalog:fab.action.skip_ahead> ;
    ns1:severity "critical" .

<urn:pxai:semi:catalog:fab.metric.etch_depth> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "蚀刻去除的纵向尺寸，配合侧壁角度评估形貌。"@zh ;
    skos:notation "fab.metric.etch_depth" ;
    skos:prefLabel "Etch Depth"@en,
        "蚀刻深度"@zh ;
    ns1:legacyId "fab.metric.etch_depth" ;
    ns1:unitCode "Å / nm" .

<urn:pxai:semi:catalog:fab.metric.overlay_error> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition """当前层图形与前层的对位偏差，分解为平移、旋转、放大、非线性分量。 超规导致接触不良或短路，是多层结构的累积性风险。
"""@zh ;
    skos:notation "fab.metric.overlay_error" ;
    skos:prefLabel "Overlay Error"@en,
        "套刻误差"@zh ;
    ns1:legacyId "fab.metric.overlay_error" ;
    ns1:unitCode "nm" .

<urn:pxai:semi:catalog:fab.process.cd_measure> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """CD-SEM 量测关键尺寸。抽样点位与频率决定异常检出灵敏度， 是光刻与蚀刻工艺窗口监控的主要数据源。
"""@zh ;
    skos:notation "fab.process.cd_measure" ;
    skos:prefLabel "CD Measurement"@en,
        "CD 量测"@zh ;
    ns1:legacyId "fab.process.cd_measure" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.cd_uniformity> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.metrology> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.overlay_measure> .

<urn:pxai:semi:catalog:fab.process.ion_implant> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """加速掺杂离子轰击晶圆形成掺杂区。剂量决定载流子浓度，能量决定结深。 束流稳定性与角度精度是主要控制难点。
"""@zh ;
    skos:notation "fab.process.ion_implant" ;
    skos:prefLabel "Ion Implantation"@en,
        "离子注入"@zh ;
    ns1:legacyId "fab.process.ion_implant" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.sheet_resistance>,
        <urn:pxai:semi:catalog:fab.metric.wat_vt> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.implant> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.rta_anneal> .

<urn:pxai:semi:catalog:fab.process.overlay_measure> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition "量测层间对位偏差，结果回馈 Scanner 做逐批对位补正(APC)。"@zh ;
    skos:notation "fab.process.overlay_measure" ;
    skos:prefLabel "Overlay Measurement"@en,
        "套刻精度量测"@zh ;
    ns1:legacyId "fab.process.overlay_measure" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.overlay_error> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.metrology> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.dry_etch> .

<urn:pxai:semi:catalog:fab.process.photo_coat> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """旋涂光阻并软烤。膜厚由转速与光阻黏度决定，均匀性受环境温湿度与 涂布杯气流影响。涂布缺陷（彗尾、气泡）会在曝光后放大为图形缺陷。
"""@zh ;
    skos:notation "fab.process.photo_coat" ;
    skos:prefLabel "Photoresist Coating"@en,
        "光阻涂布"@zh ;
    ns1:legacyId "fab.process.photo_coat" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.film_thickness> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.photo> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer>,
        <urn:pxai:semi:catalog:fab.material.photoresist> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.photo_exposure> .

<urn:pxai:semi:catalog:fab.process.pr_strip> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """灰化或湿法去除残余光阻。去除不净形成的残留会成为后续沉积的 缺陷源，也是光刻重工路径的必经工序。
"""@zh ;
    skos:notation "fab.process.pr_strip" ;
    skos:prefLabel "Photoresist Strip"@en,
        "去光阻"@zh ;
    ns1:legacyId "fab.process.pr_strip" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.etch> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.defect_scan> .

<urn:pxai:semi:catalog:fab.process.wat> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """测量 Scribe Line 上工艺控制结构的电学参数（Vt、Rs、Idsat 等）， 判定工艺是否落在规格内。是前段工艺能力的总结算点。
"""@zh ;
    skos:notation "fab.process.wat" ;
    skos:prefLabel "WAT (Wafer Acceptance Test)"@en,
        "晶圆电性测试"@zh ;
    ns1:legacyId "fab.process.wat" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.sheet_resistance>,
        <urn:pxai:semi:catalog:fab.metric.wat_vt> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.wat_cp> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.cp_test> .

<urn:pxai:semi:catalog:ap.action.bake_emc> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "对吸湿塑封料按规范返烤除湿；超过开封期限者直接报废不返烤。"@zh ;
    skos:notation "ap.action.bake_emc" ;
    skos:prefLabel "Bake Mold Compound"@en,
        "塑封料返烤"@zh ;
    ns1:legacyId "ap.action.bake_emc" .

<urn:pxai:semi:catalog:ap.action.replace_blade> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "更换刀片或做修刀恢复切削锋利度，换后首件量测崩边确认。"@zh ;
    skos:notation "ap.action.replace_blade" ;
    skos:prefLabel "Replace or Dress Dicing Blade"@en,
        "更换/修整切割刀"@zh ;
    ns1:legacyId "ap.action.replace_blade" .

<urn:pxai:semi:catalog:ap.metric.wire_pull_strength> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition """破坏性拉力测试值，评估键合强度。失效模式(线断/球脱/焊垫剥离) 比数值本身更能指示根因。
"""@zh ;
    skos:notation "ap.metric.wire_pull_strength" ;
    skos:prefLabel "Wire Pull Strength"@en,
        "金线拉力"@zh ;
    ns1:legacyId "ap.metric.wire_pull_strength" ;
    ns1:unitCode "gf" .

<urn:pxai:semi:catalog:ap.process.final_test> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """在测试机与治具上逐颗测功能、时序与直流参数，按 Bin 分级。 测试时间与并测数(Parallelism)决定单位测试成本，治具磨损会造成 接触不良型伪失效。
"""@zh ;
    skos:notation "ap.process.final_test" ;
    skos:prefLabel "Final Test (FT)"@en,
        "成品终测"@zh ;
    ns1:legacyId "ap.process.final_test" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.ft_yield>,
        <urn:pxai:semi:catalog:core.metric.yield> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.test> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.lot> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.burn_in> .

<urn:pxai:semi:catalog:core.anomaly.wip_bubble> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """某站点或制程段 WIP 显著高于正常水位，形成"气泡"并向下游传导断流。 成因分四类：设备产能不足(Down/慢机)、上游投料脉冲、 配方或治具切换损失、品质异常导致的批量 Hold。
"""@zh ;
    skos:notation "core.anomaly.wip_bubble" ;
    skos:prefLabel "WIP Bubble"@en,
        "WIP 堆积"@zh ;
    ns1:legacyId "core.anomaly.wip_bubble" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:core.metric.cycle_time>,
        <urn:pxai:semi:catalog:core.metric.throughput>,
        <urn:pxai:semi:catalog:core.metric.wip> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:erp.action.revalue_standard_cost> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "按最新料价/工艺重跑标准成本估算，收敛系统性差异。需评估存货重估影响。"@zh ;
    skos:notation "erp.action.revalue_standard_cost" ;
    skos:prefLabel "Revalue Standard Cost"@en,
        "重估标准成本"@zh ;
    ns1:legacyId "erp.action.revalue_standard_cost" .

<urn:pxai:semi:catalog:erp.action.variance_analysis> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "把总差异拆成价差/量差/效率差分别归因，定位可控与不可控部分。"@zh ;
    skos:notation "erp.action.variance_analysis" ;
    skos:prefLabel "Cost Variance Decomposition"@en,
        "差异分解分析"@zh ;
    ns1:legacyId "erp.action.variance_analysis" .

<urn:pxai:semi:catalog:erp.metric.cost_variance_rate> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "实际成本对标准成本的偏离比例，价差/量差/效率差之和占标准成本的百分比。"@zh ;
    skos:notation "erp.metric.cost_variance_rate" ;
    skos:prefLabel "Cost Variance Rate"@en,
        "成本差异率"@zh ;
    ns1:legacyId "erp.metric.cost_variance_rate" ;
    ns1:unitCode "%" .

<urn:pxai:semi:catalog:fab.action.chamber_clean> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "原位或离线清除腔体累积物，清洗后需跑验证片确认恢复。"@zh ;
    skos:notation "fab.action.chamber_clean" ;
    skos:prefLabel "Chamber Clean / Wet Clean"@en,
        "腔体清洗"@zh ;
    ns1:legacyId "fab.action.chamber_clean" .

<urn:pxai:semi:catalog:fab.action.photo_rework> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition """去光阻后重新涂布曝光。仅在蚀刻前可行，且重工次数受膜层损伤与 产品规范上限约束。
"""@zh ;
    skos:notation "fab.action.photo_rework" ;
    skos:prefLabel "Photolithography Rework"@en,
        "光刻重工"@zh ;
    ns1:legacyId "fab.action.photo_rework" .

<urn:pxai:semi:catalog:fab.action.replace_consumable> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "更换研磨垫、靶材、过滤器等寿命件，换后需跑首件确认。"@zh ;
    skos:notation "fab.action.replace_consumable" ;
    skos:prefLabel "Replace Consumable"@en,
        "更换耗材"@zh ;
    ns1:legacyId "fab.action.replace_consumable" .

<urn:pxai:semi:catalog:fab.anomaly.cmp_scratch> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """研磨造成的线状机械损伤。研磨液粒径团聚、研磨垫寿命末期表面硬化、 压力过高、或垫面修整(Conditioning)不足均可致。金属层划伤易引发短路。
"""@zh ;
    skos:notation "fab.anomaly.cmp_scratch" ;
    skos:prefLabel "CMP Scratch"@en,
        "CMP 划伤"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:fab.process.cvd_ild> ;
    ns1:detectedAt <urn:pxai:semi:catalog:fab.process.defect_scan> ;
    ns1:legacyId "fab.anomaly.cmp_scratch" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.replace_consumable> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:fab.anomaly.etch_residue> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """蚀刻后应去除区域残留材料，造成接触未开或图形桥连。多源于终点检测 失效、腔体聚合物累积改变选择比、或前层膜厚偏厚导致蚀刻量不足。
"""@zh ;
    skos:notation "fab.anomaly.etch_residue" ;
    skos:prefLabel "Etch Residue"@en,
        "蚀刻残留"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:fab.process.pvd_metal> ;
    ns1:detectedAt <urn:pxai:semi:catalog:fab.process.defect_scan> ;
    ns1:legacyId "fab.anomaly.etch_residue" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.defect_density>,
        <urn:pxai:semi:catalog:fab.metric.etch_depth> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:fab.action.chamber_clean>,
        <urn:pxai:semi:catalog:fab.action.recipe_adjust> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:fab.process.cmp_metal> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """去除多余金属形成镶嵌结构(Damascene)。过研磨造成碟形凹陷， 研磨不足造成金属残留短路，工艺窗口窄。
"""@zh ;
    skos:notation "fab.process.cmp_metal" ;
    skos:prefLabel "Metal CMP"@en,
        "金属 CMP"@zh ;
    ns1:legacyId "fab.process.cmp_metal" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.defect_density>,
        <urn:pxai:semi:catalog:fab.metric.sheet_resistance> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.cmp> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.cvd_ild> .

<urn:pxai:semi:catalog:fab.process.cmp_oxide> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """研磨介电层实现平坦化，为后续光刻提供焦深余量。研磨垫状态与 研磨液粒径分布是划伤与去除率稳定性的主因。
"""@zh ;
    skos:notation "fab.process.cmp_oxide" ;
    skos:prefLabel "Oxide CMP"@en,
        "氧化层 CMP"@zh ;
    ns1:legacyId "fab.process.cmp_oxide" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.defect_density>,
        <urn:pxai:semi:catalog:fab.metric.film_thickness> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.cmp> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.wat> .

<urn:pxai:semi:catalog:fab.process.cvd_ild> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """沉积层间介电层隔离金属层。填孔能力(Gap Fill)不足会形成空洞， 在后续 CMP 或电测阶段暴露为漏电与可靠性问题。
"""@zh ;
    skos:notation "fab.process.cvd_ild" ;
    skos:prefLabel "CVD ILD Deposition"@en,
        "CVD 层间介电沉积"@zh ;
    ns1:legacyId "fab.process.cvd_ild" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.film_thickness> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.thinfilm> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.furnace_anneal> .

<urn:pxai:semi:catalog:ap.action.bond_param_doe> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition """以功率-压力-时间-温度做实验设计重建工艺窗口，适用于线材批号切换 或持续性不粘。须以拉力与剪切数据双指标验证。
"""@zh ;
    skos:notation "ap.action.bond_param_doe" ;
    skos:prefLabel "Bond Parameter DOE"@en,
        "键合参数优化"@zh ;
    ns1:legacyId "ap.action.bond_param_doe" .

<urn:pxai:semi:catalog:ap.anomaly.missing_ball> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """植球后接点缺失或相邻锡球桥连。助焊剂涂布不均、植球治具孔位堵塞、 回流曲线失当为主因。缺球可补植返工，连球通常判废。
"""@zh ;
    skos:notation "ap.anomaly.missing_ball" ;
    skos:prefLabel "Missing / Bridged Ball"@en,
        "缺球/连球"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:ap.process.packing> ;
    ns1:detectedAt <urn:pxai:semi:catalog:ap.process.aoi> ;
    ns1:legacyId "ap.anomaly.missing_ball" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.coplanarity> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:ap.action.clean_placement_fixture>,
        <urn:pxai:semi:catalog:ap.action.hold_lot>,
        <urn:pxai:semi:catalog:ap.action.reball_rework> ;
    ns1:severity "medium" .

<urn:pxai:semi:catalog:ap.anomaly.mold_void> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """塑封体内部气泡。成因分三类：塑封料吸湿汽化、转注速度过快卷气、 模具排气不畅。X-Ray 抽检检出，塑封后不可返工。
"""@zh ;
    skos:notation "ap.anomaly.mold_void" ;
    skos:prefLabel "Mold Void"@en,
        "塑封空洞"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:ap.process.packing> ;
    ns1:detectedAt <urn:pxai:semi:catalog:ap.process.aoi> ;
    ns1:legacyId "ap.anomaly.mold_void" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.void_ratio> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:ap.action.bake_emc>,
        <urn:pxai:semi:catalog:ap.action.hold_lot> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:ap.metric.ft_yield> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:broader <urn:pxai:semi:catalog:core.metric.yield> ;
    skos:definition """终测通过比例。需与 CP 良率联动分析：若 FT 良率下滑而 CP 正常， 成因在后段；若同步下滑，回溯前段。治具磨损会造成接触不良型伪失效， 需与真实功能失效区分。
"""@zh ;
    skos:notation "ap.metric.ft_yield" ;
    skos:prefLabel "Final Test Yield"@en,
        "终测良率"@zh ;
    ns1:legacyId "ap.metric.ft_yield" ;
    ns1:unitCode "%" .

<urn:pxai:semi:catalog:ap.process.dicing> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """刀轮或激光沿 Scribe Line 切割分离芯粒。刀片磨损、转速与进给速度失配 产生崩边(Chipping)，崩边尺寸超规会延伸至有效电路区。
"""@zh ;
    skos:notation "ap.process.dicing" ;
    skos:prefLabel "Wafer Dicing"@en,
        "晶圆切割"@zh ;
    ns1:legacyId "ap.process.dicing" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.chipping_size> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.wafer_prep> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.die_attach>,
        <urn:pxai:semi:catalog:ap.process.flip_chip_bond> .

<urn:pxai:semi:catalog:ap.process.molding> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """加热熔融塑封料经转注压入模腔包覆结构。模温、压力与转注速度决定 流动前沿形态，失衡产生空洞、冲丝或包封不全。塑封后缺陷基本不可返工。
"""@zh ;
    skos:notation "ap.process.molding" ;
    skos:prefLabel "Molding"@en,
        "压模成型"@zh ;
    ns1:legacyId "ap.process.molding" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.void_ratio> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.encapsulation> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:ap.material.mold_compound> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.pmc> .

<urn:pxai:semi:catalog:ap.process.packing> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition "依客户要求以卷带/管装/托盘包装并做防潮处理，完成交付。"@zh ;
    skos:notation "ap.process.packing" ;
    skos:prefLabel "Packing & Shipping"@en,
        "包装出货"@zh ;
    ns1:legacyId "ap.process.packing" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:core.metric.cycle_time> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.test> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.lot> .

<urn:pxai:semi:catalog:core.anomaly.quality_excursion> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """品质指标突然越出控制界限，通常伴随批量性影响。共性处置骨架为 止损扣留 → 圈定关联批次 → 定位责任机台/时段 → 根因确认 → 放行或判废。 前后段各类突发品质异常通过 refines 归入本节点。
"""@zh ;
    skos:notation "core.anomaly.quality_excursion" ;
    skos:prefLabel "Quality Excursion"@en,
        "品质异常突发"@zh ;
    ns1:legacyId "core.anomaly.quality_excursion" ;
    ns1:mayCause <urn:pxai:semi:catalog:erp.anomaly.yield_cost_impact> ;
    ns1:severity "critical" .

<urn:pxai:semi:catalog:fab.stage.diffusion> a ns1:CatalogConcept,
        ns1:Stage ;
    skos:altLabel "Furnace",
        "扩散区",
        "炉管",
        "热制程" ;
    skos:definition """高温炉管类工序集合，含氧化、退火、LPCVD 薄膜。批式加工(Batch Furnace) 为主，单批 100~150 片，热预算(Thermal Budget)为核心约束。
"""@zh ;
    skos:notation "fab.stage.diffusion" ;
    skos:prefLabel "Diffusion & Thermal"@en,
        "扩散/热制程"@zh ;
    ns1:analogousTo <urn:pxai:semi:external:ext.stage.thermal_process> ;
    ns1:legacyId "fab.stage.diffusion" .

<urn:pxai:semi:catalog:ap.anomaly.bonder_down> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:broader <urn:pxai:semi:catalog:core.anomaly.equipment_down> ;
    skos:definition """键合设备故障。键合站通常机台数多但单机产能低，个别停机影响有限， 但同型号批量故障或治具短缺会造成该站 WIP 快速堆积。
"""@zh ;
    skos:notation "ap.anomaly.bonder_down" ;
    skos:prefLabel "Wire Bonder Down"@en,
        "键合机停机"@zh ;
    ns1:analogousTo <urn:pxai:semi:external:ext.anomaly.bottleneck_outage> ;
    ns1:blocks <urn:pxai:semi:catalog:ap.process.wire_bond>,
        <urn:pxai:semi:catalog:ap.route.qfn_wirebond_main> ;
    ns1:detectedAt <urn:pxai:semi:catalog:ap.process.wire_bond> ;
    ns1:legacyId "ap.anomaly.bonder_down" ;
    ns1:mayCause <urn:pxai:semi:catalog:core.anomaly.wip_bubble> ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:core.metric.oee>,
        <urn:pxai:semi:catalog:core.metric.wip> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:ap.action.clean_efo_electrode>,
        <urn:pxai:semi:catalog:ap.action.reallocate_fixture> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:ap.anomaly.delamination> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """塑封料与芯粒、基板或引线框架界面剥离。多源于材料吸湿、界面污染 或热膨胀系数失配。超声扫描(C-SAM)检出，是可靠性失效的前兆。
"""@zh ;
    skos:notation "ap.anomaly.delamination" ;
    skos:prefLabel "Delamination"@en,
        "界面分层"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:ap.process.packing> ;
    ns1:detectedAt <urn:pxai:semi:catalog:ap.process.aoi> ;
    ns1:legacyId "ap.anomaly.delamination" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.ft_yield_drop> ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.die_shear_strength>,
        <urn:pxai:semi:catalog:ap.metric.void_ratio> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:ap.action.bake_emc>,
        <urn:pxai:semi:catalog:ap.action.hold_lot> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:ap.anomaly.dicing_chipping> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """崩边尺寸超出 Scribe Line 余量。刀片磨损或崩齿、进给速度过快、 贴膜气泡致支撑不良均可致。崩边同时是裂片的起始源。
"""@zh ;
    skos:notation "ap.anomaly.dicing_chipping" ;
    skos:prefLabel "Dicing Chipping Excursion"@en,
        "切割崩边超规"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:ap.process.die_attach> ;
    ns1:detectedAt <urn:pxai:semi:catalog:ap.process.dicing> ;
    ns1:legacyId "ap.anomaly.dicing_chipping" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.die_crack> ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.chipping_size> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:ap.action.hold_lot>,
        <urn:pxai:semi:catalog:ap.action.replace_blade> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:ap.anomaly.ft_yield_drop> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:broader <urn:pxai:semi:catalog:core.anomaly.quality_excursion> ;
    skos:definition """终测良率跌破管制下限。首要判别是区分真实失效与治具接触不良型伪失效： 重测通过率高、失效点位集中于特定 Site 或特定针位指向治具； 失效分布随机且重测不通过则为真实失效，需按 Bin 类型回溯工序。 同时应比对 CP 良率以划分前后段责任。
"""@zh ;
    skos:notation "ap.anomaly.ft_yield_drop" ;
    skos:prefLabel "FT Yield Drop"@en,
        "终测良率下滑"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:ap.process.packing> ;
    ns1:detectedAt <urn:pxai:semi:catalog:ap.process.final_test> ;
    ns1:legacyId "ap.anomaly.ft_yield_drop" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.ft_yield>,
        <urn:pxai:semi:catalog:core.metric.yield> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:ap.action.hold_lot>,
        <urn:pxai:semi:catalog:ap.action.replace_probe_card>,
        <urn:pxai:semi:catalog:ap.action.retest> ;
    ns1:severity "critical" .

<urn:pxai:semi:catalog:ap.metric.coplanarity> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "外部接点（锡球或引脚）高度的最大落差，决定客户端 SMT 贴装可靠性。"@zh ;
    skos:notation "ap.metric.coplanarity" ;
    skos:prefLabel "Coplanarity"@en,
        "共面性"@zh ;
    ns1:legacyId "ap.metric.coplanarity" ;
    ns1:unitCode "μm" .

<urn:pxai:semi:catalog:ap.metric.die_shear_strength> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "评估装片胶附着力与固化充分度。"@zh ;
    skos:notation "ap.metric.die_shear_strength" ;
    skos:prefLabel "Die Shear Strength"@en,
        "芯粒剪切强度"@zh ;
    ns1:legacyId "ap.metric.die_shear_strength" ;
    ns1:unitCode "kgf" .

<urn:pxai:semi:catalog:core.metric.cycle_time> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition """批次从投料到完工的历时。常用 CT/Layer 或 X-Factor（实际 CT ÷ 纯加工时间） 做跨产品可比化，X-Factor 通常 2~4，越高说明等待浪费越大。
"""@zh ;
    skos:notation "core.metric.cycle_time" ;
    skos:prefLabel "Cycle Time"@en,
        "生产周期"@zh ;
    ns1:legacyId "core.metric.cycle_time" ;
    ns1:unitCode "day" .

<urn:pxai:semi:catalog:core.metric.throughput> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "单位时间完工产出。与 WIP、Cycle Time 由 Little's Law 三者联动。"@zh ;
    skos:notation "core.metric.throughput" ;
    skos:prefLabel "Throughput"@en,
        "产出率"@zh ;
    ns1:legacyId "core.metric.throughput" ;
    ns1:unitCode "wpm (wafer per month) / kpcs per day" .

<urn:pxai:semi:catalog:erp.coa.ykint> a ns1:CatalogConcept,
        ns1:ChartOfAccounts ;
    skos:definition "公司代码采用的统一科目表，规定全部会计科目的编号与结构。"@zh ;
    skos:notation "erp.coa.ykint" ;
    skos:prefLabel "Chart of Accounts YKINT"@en,
        "集团科目表 YKINT"@zh ;
    ns1:legacyId "erp.coa.ykint" .

<urn:pxai:semi:catalog:fab.action.dispatch_field_service> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition """开设备工单并按合约响应等级升级催派。适用于原厂锁定模块， 厂内自行处理会失去保修或造成二次损伤的情形。
"""@zh ;
    skos:notation "fab.action.dispatch_field_service" ;
    skos:prefLabel "Dispatch Field Service Engineer"@en,
        "报修并催派原厂工程师"@zh ;
    ns1:legacyId "fab.action.dispatch_field_service" .

<urn:pxai:semi:catalog:fab.metric.wat_vt> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition """WAT 关键电学参数。受栅氧厚度、通道掺杂剂量、CD 三者共同影响， 是多个前段工序偏移的汇总观测量。
"""@zh ;
    skos:notation "fab.metric.wat_vt" ;
    skos:prefLabel "Threshold Voltage (Vt)"@en,
        "阈值电压"@zh ;
    ns1:legacyId "fab.metric.wat_vt" ;
    ns1:unitCode "V" .

<urn:pxai:semi:catalog:fab.process.dry_etch> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """等离子体各向异性蚀刻，转移光阻图形到下层材料。终点检测(EPD)控制 蚀刻深度，腔体状态漂移（聚合物累积）影响速率与形貌重复性。
"""@zh ;
    skos:notation "fab.process.dry_etch" ;
    skos:prefLabel "Dry Etch"@en,
        "干法蚀刻"@zh ;
    ns1:legacyId "fab.process.dry_etch" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.cd_uniformity>,
        <urn:pxai:semi:catalog:fab.metric.etch_depth> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.etch> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.pr_strip> .

<urn:pxai:semi:catalog:fab.process.pvd_metal> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """物理气相沉积（溅镀）铝/铜/钛等金属层与阻挡层。靶材寿命末期 颗粒剥落风险升高，膜厚均匀性随靶材侵蚀轮廓变化。
"""@zh ;
    skos:notation "fab.process.pvd_metal" ;
    skos:prefLabel "PVD Metal Deposition"@en,
        "PVD 金属沉积"@zh ;
    ns1:legacyId "fab.process.pvd_metal" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.defect_density>,
        <urn:pxai:semi:catalog:fab.metric.film_thickness>,
        <urn:pxai:semi:catalog:fab.metric.sheet_resistance> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.thinfilm> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.cmp_metal> .

<urn:pxai:semi:simulation-scenario:sim.fab.lithography_capacity_recovery> a ns1:SimulationScenario ;
    rdfs:label "光刻瓶颈产能恢复"@zh ;
    ns1:hasIntervention <urn:pxai:semi:intervention:sim.fab.lithography_capacity_recovery%3A1>,
        <urn:pxai:semi:intervention:sim.fab.lithography_capacity_recovery%3A2> ;
    ns1:oneTimeInvestment 10000000.0 ;
    ns1:usesBusinessModel <urn:pxai:semi:business-model:business.fab.general_baseline> .

<urn:pxai:semi:catalog:ap.metric.void_ratio> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition """X-Ray 或超声扫描量测的空洞占比。影响散热路径与热循环可靠性， 是塑封、装片、底填三个工序共用的判定指标。
"""@zh ;
    skos:notation "ap.metric.void_ratio" ;
    skos:prefLabel "Void Ratio"@en,
        "空洞率"@zh ;
    ns1:legacyId "ap.metric.void_ratio" ;
    ns1:unitCode "%" .

<urn:pxai:semi:catalog:core.material.lot> a ns1:CatalogConcept,
        ns1:MaterialType ;
    skos:altLabel "Batch",
        "工单批" ;
    skos:definition """生产调度与追溯的最小成组单位。承载工艺路径(Route)、当前状态(State)、 在制数量与历史量测记录。前段以片数计，后段以颗/条计。
"""@zh ;
    skos:notation "core.material.lot" ;
    skos:prefLabel "Lot"@en,
        "批次"@zh ;
    ns1:analogousTo <urn:pxai:semi:external:ext.material.livestock_batch> ;
    ns1:legacyId "core.material.lot" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:core.metric.cycle_time>,
        <urn:pxai:semi:catalog:core.metric.wip> .

<urn:pxai:semi:catalog:fab.anomaly.overlay_shift> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """层间对位超规。按分量拆解定位成因：均匀平移指向对位标记识别或 载台校正，旋转/放大分量指向晶圆夹持或热变形，非线性残差指向 前层应力或补正模型失配。
"""@zh ;
    skos:notation "fab.anomaly.overlay_shift" ;
    skos:prefLabel "Overlay Shift"@en,
        "套刻偏移"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:fab.process.dry_etch> ;
    ns1:detectedAt <urn:pxai:semi:catalog:fab.process.overlay_measure> ;
    ns1:legacyId "fab.anomaly.overlay_shift" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.overlay_error> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:fab.action.clean_chuck>,
        <urn:pxai:semi:catalog:fab.action.dispatch_field_service>,
        <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.photo_rework>,
        <urn:pxai:semi:catalog:fab.action.recipe_adjust> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:fab.metric.cd_uniformity> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:broader <urn:pxai:semi:catalog:core.metric.yield> ;
    skos:definition """关键尺寸的目标偏差与分布离散度，分片内(WIW)、片间(WTW)、批间(LTL)三层。 CD 是前段最核心的图形指标，直接决定器件电学参数分布。
"""@zh ;
    skos:notation "fab.metric.cd_uniformity" ;
    skos:prefLabel "CD Uniformity"@en,
        "关键尺寸均匀性"@zh ;
    ns1:legacyId "fab.metric.cd_uniformity" ;
    ns1:unitCode "nm (3σ)" .

<urn:pxai:semi:catalog:fab.process.photo_exposure> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """经光罩将图形投影到光阻。曝光剂量与焦距共同决定 CD， 对位精度决定 Overlay。扫描机(Scanner)是前段最贵设备与典型瓶颈。
"""@zh ;
    skos:notation "fab.process.photo_exposure" ;
    skos:prefLabel "Exposure"@en,
        "曝光"@zh ;
    ns1:legacyId "fab.process.photo_exposure" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.cd_uniformity>,
        <urn:pxai:semi:catalog:fab.metric.overlay_error> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.photo> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer>,
        <urn:pxai:semi:catalog:fab.material.reticle> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.photo_develop> .

<urn:pxai:semi:simulation-scenario:sim.ap.bonding_yield_improvement> a ns1:SimulationScenario ;
    rdfs:label "键合良率改善"@zh ;
    ns1:hasIntervention <urn:pxai:semi:intervention:sim.ap.bonding_yield_improvement%3A1>,
        <urn:pxai:semi:intervention:sim.ap.bonding_yield_improvement%3A2> ;
    ns1:oneTimeInvestment 120000.0 ;
    ns1:usesBusinessModel <urn:pxai:semi:business-model:business.ap.general_baseline> .

<urn:pxai:semi:catalog:fab.action.expand_sampling> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "异常期间加严量测抽样，缩短检出窗口以限制受影响批次数。"@zh ;
    skos:notation "fab.action.expand_sampling" ;
    skos:prefLabel "Expand Sampling Rate"@en,
        "提高抽检率"@zh ;
    ns1:legacyId "fab.action.expand_sampling" .

<urn:pxai:semi:catalog:fab.anomaly.particle_excursion> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:broader <urn:pxai:semi:catalog:core.anomaly.quality_excursion> ;
    skos:definition """缺陷密度突然跃升。空间分布是关键线索：随机分布指向环境或清洗， 同心圆指向旋转类设备，边缘集中指向传片机构或夹持环， 规律重复指向光罩或载台污染。
"""@zh ;
    skos:notation "fab.anomaly.particle_excursion" ;
    skos:prefLabel "Particle Excursion"@en,
        "颗粒突增"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:fab.route.cmos_logic_main> ;
    ns1:detectedAt <urn:pxai:semi:catalog:fab.process.defect_scan> ;
    ns1:legacyId "fab.anomaly.particle_excursion" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:fab.action.chamber_clean>,
        <urn:pxai:semi:catalog:fab.action.expand_sampling>,
        <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.reticle_clean> ;
    ns1:severity "critical" .

<urn:pxai:semi:catalog:fab.cause.env_excursion> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """温湿度或粒子等级超出控制界限。影响面广且跨工序同步出现， 是"多站点同时异常"场景的首要排查方向。
"""@zh ;
    skos:notation "fab.cause.env_excursion" ;
    skos:prefLabel "Cleanroom Environment Excursion"@en,
        "洁净室环境超限"@zh ;
    ns1:legacyId "fab.cause.env_excursion" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.cd_out_of_spec>,
        <urn:pxai:semi:catalog:fab.anomaly.overlay_shift>,
        <urn:pxai:semi:catalog:fab.anomaly.particle_excursion> .

<urn:pxai:semi:catalog:fab.cause.recipe_misload> a ns1:CatalogConcept,
        ns1:Cause ;
    skos:definition """加载错误配方或参数版本，造成批间跳变型偏移。与渐变型设备漂移的 判别在于异常是否在特定批次上突然出现且边界清晰。
"""@zh ;
    skos:notation "fab.cause.recipe_misload" ;
    skos:prefLabel "Recipe Misload"@en,
        "配方误用"@zh ;
    ns1:legacyId "fab.cause.recipe_misload" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.cd_out_of_spec>,
        <urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev>,
        <urn:pxai:semi:catalog:fab.anomaly.overlay_shift> .

<urn:pxai:semi:catalog:ap.anomaly.die_crack> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """芯粒机械开裂。起点常在减薄引入的亚表面微裂纹或切割崩边， 经装片压力或热应力扩展。特征是检出工序与成因工序相隔较远， 需回溯多个上游站点。
"""@zh ;
    skos:notation "ap.anomaly.die_crack" ;
    skos:prefLabel "Die Crack"@en,
        "芯粒裂纹"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:ap.process.packing> ;
    ns1:detectedAt <urn:pxai:semi:catalog:ap.process.aoi> ;
    ns1:legacyId "ap.anomaly.die_crack" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.ft_yield_drop> ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.die_shear_strength> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:ap.action.hold_lot>,
        <urn:pxai:semi:catalog:ap.action.replace_blade> ;
    ns1:severity "critical" .

<urn:pxai:semi:catalog:fab.anomaly.cd_out_of_spec> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:broader <urn:pxai:semi:catalog:core.anomaly.quality_excursion> ;
    skos:definition """关键尺寸偏离目标或均匀性超标。判别要点在分布形态：片内梯度指向热板 或涂布均匀性，全片均匀偏移指向剂量或光阻批号，特定曝光场异常指向光罩， 批间跳变指向机台切换或配方误用。
"""@zh ;
    skos:notation "fab.anomaly.cd_out_of_spec" ;
    skos:prefLabel "CD Out of Spec"@en,
        "CD 超规"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:fab.process.dry_etch> ;
    ns1:detectedAt <urn:pxai:semi:catalog:fab.process.cd_measure> ;
    ns1:legacyId "fab.anomaly.cd_out_of_spec" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.cd_uniformity> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.photo_rework>,
        <urn:pxai:semi:catalog:fab.action.recipe_adjust> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:broader <urn:pxai:semi:catalog:core.anomaly.quality_excursion> ;
    skos:definition """沉积膜层厚度偏离目标值或片内均匀性超标。判别要点在偏移的时空形态： 片内径向剖面形状（中心厚的钟形 / 边缘厚的鞍形）指向沉积源几何与 靶材侵蚀轮廓，片间单调漂移指向耗材寿命或腔体壁累积， 批间跳变且边界清晰指向配方误用，同腔首片偏离而后续回稳指向 腔体状态未预处理。
"""@zh ;
    skos:notation "fab.anomaly.film_thickness_dev" ;
    skos:prefLabel "Film Thickness Deviation"@en,
        "膜厚偏移/均匀性超规"@zh ;
    ns1:analogousTo <urn:pxai:semi:external:ext.coating.coat_weight_deviation> ;
    ns1:blocks <urn:pxai:semi:catalog:fab.process.cmp_metal>,
        <urn:pxai:semi:catalog:fab.process.cmp_oxide> ;
    ns1:detectedAt <urn:pxai:semi:catalog:fab.process.cvd_ild>,
        <urn:pxai:semi:catalog:fab.process.pvd_metal> ;
    ns1:legacyId "fab.anomaly.film_thickness_dev" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.film_thickness>,
        <urn:pxai:semi:catalog:fab.metric.sheet_resistance> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:fab.action.chamber_season>,
        <urn:pxai:semi:catalog:fab.action.hold_lot>,
        <urn:pxai:semi:catalog:fab.action.recipe_adjust>,
        <urn:pxai:semi:catalog:fab.action.replace_consumable> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:fab.process.defect_scan> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """明场/暗场光学扫描统计缺陷数与分布图。缺陷签名(Signature)的空间 分布形态是定位问题机台与工序的关键线索。
"""@zh ;
    skos:notation "fab.process.defect_scan" ;
    skos:prefLabel "Defect Inspection"@en,
        "缺陷扫描"@zh ;
    ns1:legacyId "fab.process.defect_scan" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.stage.metrology> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:core.material.wafer> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:fab.process.ion_implant> .

<urn:pxai:semi:catalog:core.metric.oee> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition """可用率 × 性能率 × 良品率。半导体常配合 E10 状态模型 （Productive / Standby / Engineering / Scheduled Down / Unscheduled Down）拆解。
"""@zh ;
    skos:notation "core.metric.oee" ;
    skos:prefLabel "OEE (Overall Equipment Effectiveness)"@en,
        "设备综合效率"@zh ;
    ns1:legacyId "core.metric.oee" ;
    ns1:unitCode "%" .

<urn:pxai:semi:catalog:fab.metric.sheet_resistance> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "掺杂层或金属层的面电阻，四点探针量测。反映掺杂剂量与激活效果。"@zh ;
    skos:notation "fab.metric.sheet_resistance" ;
    skos:prefLabel "Sheet Resistance"@en,
        "方阻"@zh ;
    ns1:legacyId "fab.metric.sheet_resistance" ;
    ns1:unitCode "Ω/sq" .

<urn:pxai:semi:business-model:business.fab.general_baseline> a ns1:BusinessModel ;
    rdfs:label "通用晶圆厂经营模型"@zh ;
    ns1:hasBusinessVariable <urn:pxai:semi:business-variable:business.fab.general_baseline%3Acmp_capacity>,
        <urn:pxai:semi:business-variable:business.fab.general_baseline%3Aetch_capacity>,
        <urn:pxai:semi:business-variable:business.fab.general_baseline%3Afinal_test_yield>,
        <urn:pxai:semi:business-variable:business.fab.general_baseline%3Afixed_cost>,
        <urn:pxai:semi:business-variable:business.fab.general_baseline%3Aincoming_quality>,
        <urn:pxai:semi:business-variable:business.fab.general_baseline%3Aintervention_opex>,
        <urn:pxai:semi:business-variable:business.fab.general_baseline%3Alithography_capacity>,
        <urn:pxai:semi:business-variable:business.fab.general_baseline%3Amanufacturing_yield>,
        <urn:pxai:semi:business-variable:business.fab.general_baseline%3Aselling_price>,
        <urn:pxai:semi:business-variable:business.fab.general_baseline%3Avariable_unit_cost>,
        <urn:pxai:semi:business-variable:business.fab.general_baseline%3Awafer_starts> ;
    ns1:sourceRef "business/models/fab-baseline.yaml" .

<urn:pxai:semi:catalog:ap.anomaly.wire_nsop> a ns1:Anomaly,
        ns1:CatalogConcept ;
    skos:definition """焊球未能与焊垫形成有效接合。判别路径：若集中于特定机台特定瓷嘴 则指向瓷嘴磨损，若全线同步出现则指向前段焊垫状态或线材批号， 若与装片工序关联则查溢胶污染。是后段最高频的键合类不良。
"""@zh ;
    skos:notation "ap.anomaly.wire_nsop" ;
    skos:prefLabel "NSOP (Non-Stick On Pad)"@en,
        "金线不粘"@zh ;
    ns1:blocks <urn:pxai:semi:catalog:ap.process.molding> ;
    ns1:detectedAt <urn:pxai:semi:catalog:ap.process.wire_bond> ;
    ns1:legacyId "ap.anomaly.wire_nsop" ;
    ns1:mayCause <urn:pxai:semi:catalog:ap.anomaly.ft_yield_drop> ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.ball_shear_strength>,
        <urn:pxai:semi:catalog:ap.metric.wire_pull_strength> ;
    ns1:mitigatedBy <urn:pxai:semi:catalog:ap.action.adjust_dispense>,
        <urn:pxai:semi:catalog:ap.action.bond_param_doe>,
        <urn:pxai:semi:catalog:ap.action.hold_lot>,
        <urn:pxai:semi:catalog:ap.action.plasma_clean_rerun>,
        <urn:pxai:semi:catalog:ap.action.replace_capillary> ;
    ns1:severity "high" .

<urn:pxai:semi:catalog:ap.process.aoi> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition "光学检查封装外观、打标与引脚形态，拦截机械类不良出货。"@zh ;
    skos:notation "ap.process.aoi" ;
    skos:prefLabel "AOI (Automated Optical Inspection)"@en,
        "自动外观检验"@zh ;
    ns1:legacyId "ap.process.aoi" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.chipping_size>,
        <urn:pxai:semi:catalog:ap.metric.coplanarity> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.test> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.packing> .

<urn:pxai:semi:catalog:fab.equip.scanner> a ns1:CatalogConcept,
        ns1:EquipmentType ;
    skos:definition """分步扫描投影曝光机。单台资本支出为全厂最高，折旧摊提使其稼动率 直接决定单位成本。光源、镜头、对位系统三者状态共同决定 CD 与 Overlay 能力， 机台间差异(Tool-to-Tool)需靠 Overlay 修正参数补偿，因此不可随意换机。
"""@zh ;
    skos:notation "fab.equip.scanner" ;
    skos:prefLabel "Scanner / Lithography Tool"@en,
        "扫描式曝光机"@zh ;
    ns1:legacyId "fab.equip.scanner" ;
    ns1:mayCause <urn:pxai:semi:catalog:fab.anomaly.cd_out_of_spec>,
        <urn:pxai:semi:catalog:fab.anomaly.overlay_shift> ;
    ns1:partOf <urn:pxai:semi:catalog:fab.process.photo_exposure> .

<urn:pxai:semi:scenario:auto_dn> a ns1:L2Scenario ;
    rdfs:label "Auto DN",
        "Auto DN"@zh ;
    ns1:composesCapability <urn:pxai:semi:capability:common_tool>,
        <urn:pxai:semi:capability:defect_library>,
        <urn:pxai:semi:capability:defect_notice>,
        <urn:pxai:semi:capability:impact_lot>,
        <urn:pxai:semi:capability:on_duty_coordination> .

<urn:pxai:semi:business-variable:business.fab.general_baseline%3Aintervention_opex> a ns1:BusinessVariable ;
    ns1:identifier "intervention_opex" ;
    ns1:numericValue 0.0 ;
    ns1:sourceRef "business/datasets/fab-demo-assumptions.yaml#intervention_opex" ;
    ns1:sourceType "assumption" ;
    ns1:unitCode "CNY/month" .

<urn:pxai:semi:business-variable:business.fab.general_baseline%3Alithography_capacity> a ns1:BusinessVariable ;
    ns1:identifier "lithography_capacity" ;
    ns1:numericValue 29000.0 ;
    ns1:sourceRef "business/datasets/fab-demo-assumptions.yaml#lithography_capacity" ;
    ns1:sourceType "assumption" ;
    ns1:unitCode "wafer/month" .

<urn:pxai:semi:catalog:ap.process.wire_bond> a ns1:CatalogConcept,
        ns1:Process ;
    skos:definition """以热压超声在焊垫与引脚间形成球焊与楔焊连接。键合功率、压力、时间与 温度四参数构成工艺窗口，焊垫状态与瓷嘴磨损是稳定性主因。 多为后段站点数最多、WIP 最易堆积的工序。
"""@zh ;
    skos:notation "ap.process.wire_bond" ;
    skos:prefLabel "Wire Bonding"@en,
        "金线键合"@zh ;
    ns1:legacyId "ap.process.wire_bond" ;
    ns1:measuredByMetric <urn:pxai:semi:catalog:ap.metric.ball_shear_strength>,
        <urn:pxai:semi:catalog:ap.metric.wire_pull_strength> ;
    ns1:partOf <urn:pxai:semi:catalog:ap.stage.interconnect> ;
    ns1:performedOnMaterial <urn:pxai:semi:catalog:ap.material.bonding_wire> ;
    ns1:precedesProcess <urn:pxai:semi:catalog:ap.process.molding> .

<urn:pxai:semi:catalog:fab.metric.film_thickness> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition "沉积或生长膜层厚度及其均匀性，用椭偏仪或反射光谱量测。"@zh ;
    skos:notation "fab.metric.film_thickness" ;
    skos:prefLabel "Film Thickness"@en,
        "膜厚"@zh ;
    ns1:legacyId "fab.metric.film_thickness" ;
    ns1:unitCode "Å / nm" .

<urn:pxai:semi:catalog:core.metric.wip> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition """某时刻在线未完工的批次或片数。按站点、制程段、产品分层统计。 WIP 分布形态（是否在某站点异常堆积）是产线健康度的第一观测量。
"""@zh ;
    skos:notation "core.metric.wip" ;
    skos:prefLabel "WIP (Work In Process)"@en,
        "在制量"@zh ;
    ns1:legacyId "core.metric.wip" ;
    ns1:unitCode "lot / wafer / kpcs" .

<urn:pxai:semi:catalog:core.metric.yield> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:definition """合格产出占投入的比例。需区分 Line Yield（流程存活率）与 Die Yield / Test Yield（功能良率），两者成因体系不同。
"""@zh ;
    skos:notation "core.metric.yield" ;
    skos:prefLabel "Yield"@en,
        "良率"@zh ;
    ns1:legacyId "core.metric.yield" ;
    ns1:unitCode "%" .

<urn:pxai:semi:catalog:fab.metric.defect_density> a ns1:CatalogConcept,
        ns1:Metric ;
    skos:broader <urn:pxai:semi:catalog:core.metric.yield> ;
    skos:definition """单位面积缺陷数。分类(颗粒、划伤、残留、桥连)与空间分布形态 是定位责任工序与机台的核心线索。
"""@zh ;
    skos:notation "fab.metric.defect_density" ;
    skos:prefLabel "Defect Density"@en,
        "缺陷密度"@zh ;
    ns1:analogousTo <urn:pxai:semi:external:ext.metric.defect_rate> ;
    ns1:legacyId "fab.metric.defect_density" ;
    ns1:unitCode "ea/cm² / ea per wafer" .

<urn:pxai:semi:catalog:ap.action.hold_lot> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "冻结受影响批次并圈定同机台同时段关联批次，防止流入不可逆工序。"@zh ;
    skos:notation "ap.action.hold_lot" ;
    skos:prefLabel "Hold Lot"@en,
        "扣留批次"@zh ;
    ns1:legacyId "ap.action.hold_lot" .

<urn:pxai:semi:catalog:fab.action.hold_lot> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "立即冻结受影响批次防止扩散，同时圈定同机台同时段的关联批次。"@zh ;
    skos:notation "fab.action.hold_lot" ;
    skos:prefLabel "Hold Lot"@en,
        "扣留批次"@zh ;
    ns1:legacyId "fab.action.hold_lot" .

<urn:pxai:semi:catalog:fab.action.recipe_adjust> a ns1:Action,
        ns1:CatalogConcept ;
    skos:definition "依偏移量反算补偿值（如剂量补偿 CD 漂移），须留变更记录与验证数据。"@zh ;
    skos:notation "fab.action.recipe_adjust" ;
    skos:prefLabel "Recipe Parameter Adjustment"@en,
        "配方参数补偿"@zh ;
    ns1:legacyId "fab.action.recipe_adjust" .

<urn:pxai:semi:catalog:core.material.wafer> a ns1:CatalogConcept,
        ns1:MaterialType ;
    skos:definition """硅基载体，前段厂的加工对象，后段厂的输入物料。以直径(6/8/12 吋)与 片号(Slot)标识，是良率统计的基本单元。
"""@zh ;
    skos:notation "core.material.wafer" ;
    skos:prefLabel "Wafer"@en,
        "晶圆"@zh ;
    ns1:legacyId "core.material.wafer" .

