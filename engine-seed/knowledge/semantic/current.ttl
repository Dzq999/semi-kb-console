        <urn:pxai:semi:business-variable:business.eqp.general_baseline%3Ainput_units>,
        <urn:pxai:semi:business-variable:business.eqp.general_baseline%3Aintervention_opex>,
        <urn:pxai:semi:business-variable:business.eqp.general_baseline%3Aoee_performance>,
        <urn:pxai:semi:business-variable:business.eqp.general_baseline%3Aoee_quality>,
        <urn:pxai:semi:business-variable:business.eqp.general_baseline%3Aprocess_yield>,
        <urn:pxai:semi:business-variable:business.eqp.general_baseline%3Aselling_price>,
        <urn:pxai:semi:business-variable:business.eqp.general_baseline%3Atheoretical_rate>,
        <urn:pxai:semi:business-variable:business.eqp.general_baseline%3Avariable_unit_cost> ;
    ns1:sourceRef "business/models/eqp-baseline.yaml" .

