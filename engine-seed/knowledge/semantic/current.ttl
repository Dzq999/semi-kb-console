<urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """成球阶段报警时首选，厂内可自行执行。恢复后跑首件确认成球稳定， 并按打线点数把清洗纳入预防性周期，避免同一原因反复停机。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.clean_efo_electrode> .

<urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText """瓷嘴寿命末期或堵塞时更换。换后需确认键合参数无需重新优化， 否则应连带走参数 DOE。
"""@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.replace_capillary> .

<urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText """预估停机超过一个班次时改派同类打线机，需确认目标机台键合参数 已对该产品验证过；参数未验证的改派会把停机问题换成质量问题。
"""@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.reallocate_fixture> .

<urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A4> a ns1:ActionInstruction ;
    ns1:actionConditionText """停机瞬间在机的部分打线批次须扣留待判，不可直接续打—— 半成品的未完成焊点位置需人工确认后才能决定续打或返工。
"""@zh ;
    ns1:actionOrder 4 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.ap.delamination_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """必须优先执行。分层不可逆，且不一定伴随电性异常， 纯靠终测拦不住——扣留是唯一能防止漏出至客户端的手段
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.ap.delamination_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText """仅适用于尚未使用的库存料，目的是防止复发。 对已分层的成品无效：返烤去除水分，不能重新贴合已剥离的界面。 开封已超期者直接报废，不做返烤——超期料交联性能已不可恢复
"""@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.bake_emc> .

<urn:pxai:semi:action-instruction:kb.ap.delamination_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText "仅当判定为焊垫污染分支时执行，对吸湿成因无效"@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.plasma_clean_rerun> .

<urn:pxai:semi:action-instruction:kb.ap.dicing_chipping_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText "确认磨损后换刀或修刀，换后首件量测崩边确认恢复"@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.replace_blade> .

<urn:pxai:semi:action-instruction:kb.ap.dicing_chipping_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText """崩边侵入有效电路区时扣留判废。即使未侵入也需评估—— 崩边是后续裂片的起始源，属延迟风险。
"""@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.ap.die_crack_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """立即执行，且圈定范围要宽。本异常是延迟暴露型——检出时该批已跨 多道工序，须回溯减薄与切割的同机台同时段批次，不能只扣当前批。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.ap.die_crack_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText "确认为崩边扩展型后更换切割刀，并同步复查砂轮状态"@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.replace_blade> .

<urn:pxai:semi:action-instruction:kb.ap.ft_yield_drop_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """确认治具磨损后清洗或更换。这一步优先级最高，因为治具问题会污染 后续所有分析数据——治具未恢复前的良率数据不可用于判断工艺。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.replace_probe_card> .

<urn:pxai:semi:action-instruction:kb.ap.ft_yield_drop_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText """仅在治具已确认恢复后执行，用于挽回被过杀的良品。 重测次数须受规范限制，无限重测等于变相放宽标准。
"""@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.retest> .

<urn:pxai:semi:action-instruction:kb.ap.ft_yield_drop_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText "确认为真实工艺失效后扣留，并按 Bin 类型回溯责任工序"@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.ap.missing_ball_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """根因未明前先扣留。缺球与连球的处置方向相反（前者可返工、 后者多判废），未分清就放行会把判废品混入返工流。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.ap.missing_ball_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText """仅对缺球分支执行，重植后复量共面性并复检外观。 连球不走本动作。返工次数须受规范限制——每次重植追加一次热历程， 无限返工等于用可靠性换良率。
"""@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.reball_rework> .

<urn:pxai:semi:action-instruction:kb.ap.mold_void_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """确认吸湿后按规范返烤。超过开封期限者直接报废，不做返烤—— 超期料的交联性能已不可恢复，返烤只解决水分不解决老化。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.bake_emc> .

<urn:pxai:semi:action-instruction:kb.ap.mold_void_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText "必须执行。塑封已不可逆，扣留目的是防止不良流入后续成型与出货"@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.ap.wire_bond_wip_bubble%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """确认为治具短缺或个别机台故障后执行。跨产品调配治具是最快见效的手段， 但需评估换线损失；长期需补充治具投资，否则问题会反复。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.reallocate_fixture> .

<urn:pxai:semi:action-instruction:kb.ap.wire_bond_wip_bubble%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText """仅当堆积伴随品质异常时使用（防止不良批次继续流入不可逆的塑封工序）。 纯产能型堆积不应扣留，否则加剧滞留。
"""@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.ap.wire_bond_wip_bubble%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText """若堆积源于键合不良导致的反复重工，须从工艺窗口根治。 此时表面是产能问题，实质是良率问题。
"""@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.bond_param_doe> .

<urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText "疑似焊垫污染时首选，成本低见效快，可作为快速验证手段"@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.plasma_clean_rerun> .

<urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText "确认瓷嘴磨损后立即更换，换后跑首件拉力确认"@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.replace_capillary> .

<urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText "确认为装片溢胶后回到装片站调整，键合站参数不应为此让步"@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.adjust_dispense> .

<urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A4> a ns1:ActionInstruction ;
    ns1:actionConditionText """线材批号切换或持续性不粘时执行。见效慢但根治， 避免以补偿参数掩盖根因导致隐患累积。
"""@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.bond_param_doe> .

<urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A5> a ns1:ActionInstruction ;
    ns1:actionConditionText "塑封前必须完成判定——塑封后不粘不可返工，只能判废"@zh ;
    ns1:actionOrder 4 ;
    ns1:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.erp.billing_block_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """信用超限型：复核授信、收款回补或审批提额后释放，释放前须评估坏账风险不可无条件放行。 交货未过账型：先完成 PGI 再开票，不属信用问题。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:erp.action.credit_review_release> .

<urn:pxai:semi:action-instruction:kb.erp.cost_variance_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText "先把总差异拆成价差/量差/效率差归因，区分可控与不可控，再决定处置方向"@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:erp.action.variance_analysis> .

<urn:pxai:semi:action-instruction:kb.erp.cost_variance_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText """确认为标准过时型后按最新料价工艺重估。注意重估会一次性调整在库存货估值， 须在期末前评估对当期损益的影响。
"""@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:erp.action.revalue_standard_cost> .

<urn:pxai:semi:action-instruction:kb.erp.cost_variance_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText "仅当为分摊失真型时校正分摊率；对价差量差无效，用错方向会掩盖真实成因"@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:erp.action.recalc_allocation_rate> .

<urn:pxai:semi:action-instruction:kb.erp.depreciation_error_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """修正折旧方法/年限/残值并重算。跨期错误需走以前年度调整、冲正错误期间计提， 注意审计留痕；不可直接改数不留轨迹。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:erp.action.correct_asset_master> .

<urn:pxai:semi:action-instruction:kb.erp.gr_ir_mismatch_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """发票未达型走催票后匹配清账；差异型人工核销或退回采购处理。长期挂账须专项清理， 否则月结反复受阻。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:erp.action.clear_gr_ir> .

<urn:pxai:semi:action-instruction:kb.erp.inventory_writedown_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """按成本与可变现净值孰低计提跌价准备，冲减存货账面。计提影响当期损益， 须与呆滞处置(变卖/报废)联动，避免只提准备不清库存。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:erp.action.provision_writedown> .

<urn:pxai:semi:action-instruction:kb.erp.yield_cost_impact_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText "分解出良率吸收(产量差)部分，与料价工时差异区分开"@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:erp.action.variance_analysis> .

<urn:pxai:semi:action-instruction:kb.erp.yield_cost_impact_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText "若良率标准本身已系统性改变，更新良率假设后重估标准成本"@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:erp.action.revalue_standard_cost> .

<urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText "超规幅度达判废线，或成因未明时先止损；同时圈定同机台同时段批次"@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText """仅限尚未进入 dry_etch 的批次，且重工次数未达产品规范上限。 已蚀刻批次不可重工，只能评估电性影响后判定放行或报废。
"""@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.photo_rework> .

<urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText """确认为剂量或显影时间型偏移后做补偿。注意：补偿只治表， 若根因是光源衰退或热板故障，须同步开设备工单，否则偏移会持续扩大。
"""@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.recipe_adjust> .

<urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A4> a ns1:ActionInstruction ;
    ns1:actionConditionText "成因未定期间加严抽检，收窄检出窗口以限制受影响批次数"@zh ;
    ns1:actionOrder 4 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.expand_sampling> .

<urn:pxai:semi:action-instruction:kb.fab.cmp_scratch_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """确认研磨垫寿命末期后更换，换后跑首件确认。 换垫周期本身是决策变量：提前换降低划伤但抬高耗材成本。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.replace_consumable> .

<urn:pxai:semi:action-instruction:kb.fab.cmp_scratch_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText "金属层划伤须扣留，短路风险不可放行；介电层轻微划伤可评估后放行"@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.fab.equipment_down_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """判定为原厂锁定模块时立即报修并按合约等级升级；厂内自行拆装会失去保修， 且伺服/光学系统需原厂重新校准。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.dispatch_field_service> .

<urn:pxai:semi:action-instruction:kb.fab.equipment_down_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText """预估停机超过一个班次时改派同类机台；须确认可越站且后续站点无时效约束。 路径强制点（如光刻）多数情况不适用。
"""@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.skip_ahead> .

<urn:pxai:semi:action-instruction:kb.fab.equipment_down_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText """停机瞬间在机批次可能处于半加工状态，须扣留待工程判定， 恢复后先跑首件确认再放行队列。
"""@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.fab.etch_residue_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText "轻微残留可追加过蚀刻时间挽回；桥连型残留通常已不可逆，不适用"@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.recipe_adjust> .

<urn:pxai:semi:action-instruction:kb.fab.etch_residue_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText "确认为腔体累积后执行，清洗后须跑验证片确认速率恢复再放行量产"@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.chamber_clean> .

<urn:pxai:semi:action-instruction:kb.fab.etch_residue_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText "残留造成桥连风险时先扣留，待电性影响评估后判定"@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """超规确认后先扣留同腔在制批次。膜厚偏移在后续层会被叠加， 放行的成本随层数增加而放大。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText """偏移出现在清洗或长待机之后、且随片数收敛时执行。预处理后必须 跑验证片确认恢复再放量产；连续生产中途出现的发散型偏移不适用 本动作，那是累积而非未预处理。
"""@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.chamber_season> .

<urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText """偏移量稳定、方向一致且在补偿窗口内时按偏移反算补偿，须留变更 记录与验证数据。剖面形状已改变的情况不适用——补偿只能移动 整体水平，改不回形状。
"""@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.recipe_adjust> .

<urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A4> a ns1:ActionInstruction ;
    ns1:actionConditionText """靶材接近寿命上限或剖面已无法用参数补偿时换靶，换后跑首件确认。 换靶同时会重置腔体状态，因此换后应连带做预处理。
"""@zh ;
    ns1:actionOrder 4 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.replace_consumable> .

<urn:pxai:semi:action-instruction:kb.fab.implant_dose_drift_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """扣留该机台自上次校验通过后的全部批次。注意范围可能很大—— 因为无在线量测，中间批次全部处于未验证状态。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.fab.implant_dose_drift_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText "以校验片实测反算补偿量，同时开设备工单处理束流系统"@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.recipe_adjust> .

<urn:pxai:semi:action-instruction:kb.fab.implant_dose_drift_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText """增设注入后方阻抽测。这是本异常的根本改善方向： 问题不在漂移本身，而在于缺乏在线反馈导致检出滞后。
"""@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.expand_sampling> .

<urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """先扣留，不要急着重工。套刻偏移的成因决定了该重工还是该修机台， 盲目重工会在同一台有问题的机台上再废一次。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText """确认为配方误用或补偿量异常时修正配方。 若是补偿模型被坏点带偏，需同时清理该点再让模型收敛。
"""@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.recipe_adjust> .

<urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText """判定为背面/吸盘沾污时停机清洗并复测平面度。 清洗后要复测套刻确认恢复，否则可能是晶圆背面而非吸盘的问题。
"""@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.clean_chuck> .

<urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A4> a ns1:ActionInstruction ;
    ns1:actionConditionText """仅在该层可返工且根因已消除时重工。 根因未除就重工等于把良品也拖进去。
"""@zh ;
    ns1:actionOrder 4 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.photo_rework> .

<urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A5> a ns1:ActionInstruction ;
    ns1:actionConditionText """对位系统或镜头热补偿模型异常且厂内手段无效时报修。 这类问题通常需要原厂调机，不属厂内可自行恢复的范畴。
"""@zh ;
    ns1:actionOrder 5 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.dispatch_field_service> .

<urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """立即执行。关键是圈定范围：以缺陷批次经过的机台与时段反查所有 同条件批次，而非只扣留已检出的批次。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText "确认为逐场重复签名后送洗；无备用光罩时需先排程避让"@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.reticle_clean> .

<urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText "确认为腔体来源后执行，清洗后跑颗粒验证片确认恢复"@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.chamber_clean> .

<urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A4> a ns1:ActionInstruction ;
    ns1:actionConditionText """成因未定期间必做。突增类异常的损失规模近似等于 检出延迟时间 × 产出速率，加严抽检是压缩这个乘积的唯一手段。
"""@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.expand_sampling> .

<urn:pxai:semi:action-instruction:kb.fab.quality_excursion_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """立即执行，关键是圈定范围：以异常批次经过的机台与时段反查所有同条件 批次，而非只扣留已检出的批次。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

<urn:pxai:semi:action-instruction:kb.fab.quality_excursion_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText """成因未定期间必做。突变类异常的损失规模近似等于检出延迟 × 产出速率， 加严抽检是压缩这个乘积的唯一手段。
"""@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.expand_sampling> .

<urn:pxai:semi:action-instruction:kb.fab.quality_excursion_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText """偏移量稳定、方向一致且在补偿窗口内时按实测反算补偿，须留变更记录与 验证数据。剖面形状已改变或成因未定的情况不适用——补偿只移动整体水平。
"""@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.recipe_adjust> .

<urn:pxai:semi:action-instruction:kb.fab.scanner_down_triage%3A1> a ns1:ActionInstruction ;
    ns1:actionConditionText """判定为原厂锁定模块（工件台、光源）时立即报修并按合约等级升级。 厂内自行拆装会失去保修，且伺服系统需原厂重新校准。
"""@zh ;
    ns1:actionOrder 1 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.dispatch_field_service> .

<urn:pxai:semi:action-instruction:kb.fab.scanner_down_triage%3A2> a ns1:ActionInstruction ;
    ns1:actionConditionText """预估停机超过一个班次时改派同类机台，需确认套刻补正模型按机台管理， 否则改派本身会引入套刻偏移。注意越站分支多数情况下不适用—— 光刻是路径强制点，只有工艺允许延后且后续站点无时效性约束才可考虑。
"""@zh ;
    ns1:actionOrder 2 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.skip_ahead> .

<urn:pxai:semi:action-instruction:kb.fab.scanner_down_triage%3A3> a ns1:ActionInstruction ;
    ns1:actionConditionText """停机瞬间在机批次可能处于部分曝光状态，须扣留待工程判定， 不可直接续跑。恢复后先跑首件确认再放行队列。
"""@zh ;
    ns1:actionOrder 3 ;
    ns1:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

<urn:pxai:semi:anomaly:fab_quality_excursion_delayed_detection_repair> a ns1:QualityExcursionAnomaly ;
    rdfs:label "晶圆厂品质异常延迟识别事件"@zh ;
    ns1:description "高维动态制造数据和跨系统信息难以由传统监控及时综合分析时，品质偏差可能未被及时识别，并进一步影响良率或产品可靠性。" ;
    ns1:nameZh "晶圆厂品质异常延迟识别事件" ;
    ns1:severity "critical" ;
    ns1:sourceRef "https://link.springer.com/article/10.1007/s00170-026-18777-0" ;
    ns1:sourceType "web" .

