    rdfs:label "通用晶圆厂经营模型"@zh ;
    ns1:hasBusinessVariable <urn:pxai:semi:business-variable:business.agent.run-c163313475f54c2f.r1.run-c163313475f54c2f-a01.1%3Acmp_capacity>,
        <urn:pxai:semi:business-variable:business.agent.run-c163313475f54c2f.r1.run-c163313475f54c2f-a01.1%3Aetch_capacity>,
        <urn:pxai:semi:business-variable:business.agent.run-c163313475f54c2f.r1.run-c163313475f54c2f-a01.1%3Afinal_test_yield>,
        <urn:pxai:semi:business-variable:business.agent.run-c163313475f54c2f.r1.run-c163313475f54c2f-a01.1%3Afixed_cost>,
        <urn:pxai:semi:business-variable:business.agent.run-c163313475f54c2f.r1.run-c163313475f54c2f-a01.1%3Aincoming_quality>,
        <urn:pxai:semi:business-variable:business.agent.run-c163313475f54c2f.r1.run-c163313475f54c2f-a01.1%3Aintervention_opex>,
        <urn:pxai:semi:business-variable:business.agent.run-c163313475f54c2f.r1.run-c163313475f54c2f-a01.1%3Alithography_capacity>,
        <urn:pxai:semi:business-variable:business.agent.run-c163313475f54c2f.r1.run-c163313475f54c2f-a01.1%3Amanufacturing_yield>,
        <urn:pxai:semi:business-variable:business.agent.run-c163313475f54c2f.r1.run-c163313475f54c2f-a01.1%3Aselling_price>,
        <urn:pxai:semi:business-variable:business.agent.run-c163313475f54c2f.r1.run-c163313475f54c2f-a01.1%3Avariable_unit_cost>,
        <urn:pxai:semi:business-variable:business.agent.run-c163313475f54c2f.r1.run-c163313475f54c2f-a01.1%3Awafer_starts> ;
    ns1:sourceRef "business/models/business.agent.run-c163313475f54c2f.r1.run-c163313475f54c2f-a01.1.yaml" .

