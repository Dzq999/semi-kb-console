{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pxai:semi:vfab-source-contract",
  "title": "vFab source delivery contract",
  "type": "object",
  "required": ["source_id", "delivered_at", "files"],
  "properties": {
    "source_id": {"const": "internal.vfab"},
    "delivered_at": {"type": "string", "format": "date-time"},
    "owner": {"type": "string", "minLength": 1},
    "classification": {"enum": ["internal", "internal_confidential", "restricted"]},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "format", "sha256", "target_class"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "format": {"enum": ["xlsx", "xls", "csv", "tsv", "json", "parquet"]},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "target_class": {"type": "string", "pattern": "^urn:pxai:semi:[A-Za-z][A-Za-z0-9_-]*$"},
          "entity_keys": {"type": "array", "items": {"type": "string"}},
          "time_field": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
