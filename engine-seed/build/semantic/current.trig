            <urn:pxai:semi:catalog:fab.cause.recipe_misload> ;
        semi:legacyId "kb.fab.quality_excursion_triage" ;
        semi:symptomText "偏移的分布形态（按机台/批次/时段/空间位置）是定位责任源的关键"@zh,
            "品质指标（良率/缺陷/电性）较基线突然跃变，超出管制界限"@zh,
            "缺陷分类比例或电性参数往往早于良率暴露，是更早的观测量"@zh .

    <urn:pxai:semi:playbook:kb.fab.scanner_down_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "光刻机非计划停机排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.scanner_down> ;
        semi:economicImpactText """光刻是典型瓶颈站点，停机损失近似等于停机时长 × 瓶颈产出率， 且不可通过后续赶工完全回补。可控旋钮有两个：PM 依从性 （用计划停机换非计划停机）与关键备件本地备货水位（用资金占用换停机时长）。 后者决定 MTTR 而非停机是否发生——若修复方案已明确却仍在等， 瓶颈就在备件调运或原厂工程师到场，不要继续往设备本体查。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.scanner_down_triage%3A1>,
