            <urn:pxai:semi:catalog:core.metric.wip> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.photo_exposure> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.dispatch_field_service>,
            <urn:pxai:semi:catalog:fab.action.hold_lot>,
            <urn:pxai:semi:catalog:fab.action.skip_ahead> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.env_excursion>,
