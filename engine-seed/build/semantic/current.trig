            <urn:pxai:semi:cause-assertion:kb.fab.implant_dose_drift_triage%3A3> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.implant_dose_drift_triage%3A1>,
            <urn:pxai:semi:detection:kb.fab.implant_dose_drift_triage%3A2> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:fab.metric.sheet_resistance>,
            <urn:pxai:semi:catalog:fab.metric.wat_vt> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.wat> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.expand_sampling>,
            <urn:pxai:semi:catalog:fab.action.hold_lot>,
            <urn:pxai:semi:catalog:fab.action.recipe_adjust> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.beam_current_drift>,
            <urn:pxai:semi:catalog:fab.cause.recipe_misload>,
            <urn:pxai:semi:catalog:fab.param.implant_dose> ;
        semi:legacyId "kb.fab.implant_dose_drift_triage" ;
        semi:symptomText "WAT Vt 或方阻整批偏移，超出管制界限"@zh,
            "偏移集中于特定注入机台的批次"@zh,
            "前段各站点量测记录均正常（图形与膜厚无异常）"@zh .

    <urn:pxai:semi:playbook:kb.fab.overlay_shift_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "套刻偏移排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.overlay_shift> ;
        semi:economicImpactText """套刻偏移的代价高度依赖发现时机：在量测站拦下只是重工或报废单批， 漏到后续层则可能整批失效且已投入更多工序成本。 可返工层与不可返工层的处置逻辑完全不同，前者权衡重工成本， 后者直接是报废。若根因在机台侧，还要叠加该机台后续批次的 连带风险——这也是不建议根因未明就先重工的原因。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A2>,
            <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A3>,
            <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A4>,
            <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A5> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A3>,
            <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A4>,
            <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A5>,
            <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A6> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.overlay_shift_triage%3A1>,
            <urn:pxai:semi:detection:kb.fab.overlay_shift_triage%3A2>,
            <urn:pxai:semi:detection:kb.fab.overlay_shift_triage%3A3> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:core.metric.yield>,
            <urn:pxai:semi:catalog:fab.metric.cd_uniformity>,
            <urn:pxai:semi:catalog:fab.metric.overlay_error> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.overlay_measure> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.clean_chuck>,
            <urn:pxai:semi:catalog:fab.action.dispatch_field_service>,
            <urn:pxai:semi:catalog:fab.action.hold_lot>,
            <urn:pxai:semi:catalog:fab.action.photo_rework>,
            <urn:pxai:semi:catalog:fab.action.recipe_adjust> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.alignment_mark_damage>,
            <urn:pxai:semi:catalog:fab.cause.env_excursion>,
            <urn:pxai:semi:catalog:fab.cause.lens_heating_drift>,
            <urn:pxai:semi:catalog:fab.cause.recipe_misload>,
            <urn:pxai:semi:catalog:fab.cause.wafer_backside_contamination>,
            <urn:pxai:semi:catalog:fab.param.overlay_offset> ;
        semi:legacyId "kb.fab.overlay_shift_triage" ;
        semi:symptomText "下游蚀刻被阻塞，等待处置决定"@zh,
            "偏移可能表现为全片系统性分量，或场内分量，或局部不规则分布"@zh,
            "套刻量测显示对位误差超出规格，批次在量测站被拦下"@zh .

    <urn:pxai:semi:playbook:kb.fab.particle_excursion_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "颗粒突增排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.particle_excursion> ;
        semi:economicImpactText """影响面取决于检出延迟：光罩类问题影响该光罩全部曝光批次， 环境类问题波及全区。这类异常的经济损失主要由发现速度决定， 而非缺陷本身严重度。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A2>,
            <urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A3>,
            <urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A4> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A1>,
