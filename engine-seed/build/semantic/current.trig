    <urn:pxai:semi:catalog:fab.anomaly.cd_out_of_spec> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """关键尺寸偏离目标或均匀性超标。判别要点在分布形态：片内梯度指向热板 或涂布均匀性，全片均匀偏移指向剂量或光阻批号，特定曝光场异常指向光罩， 批间跳变指向机台切换或配方误用。
"""@zh ;
        skos:notation "fab.anomaly.cd_out_of_spec" ;
        skos:prefLabel "CD Out of Spec"@en,
            "CD 超规"@zh ;
        semi:legacyId "fab.anomaly.cd_out_of_spec" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:fab.anomaly.cmp_scratch> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """研磨造成的线状机械损伤。研磨液粒径团聚、研磨垫寿命末期表面硬化、 压力过高、或垫面修整(Conditioning)不足均可致。金属层划伤易引发短路。
"""@zh ;
        skos:notation "fab.anomaly.cmp_scratch" ;
        skos:prefLabel "CMP Scratch"@en,
            "CMP 划伤"@zh ;
        semi:legacyId "fab.anomaly.cmp_scratch" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:fab.anomaly.etch_residue> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """蚀刻后应去除区域残留材料，造成接触未开或图形桥连。多源于终点检测 失效、腔体聚合物累积改变选择比、或前层膜厚偏厚导致蚀刻量不足。
"""@zh ;
        skos:notation "fab.anomaly.etch_residue" ;
        skos:prefLabel "Etch Residue"@en,
            "蚀刻残留"@zh ;
        semi:legacyId "fab.anomaly.etch_residue" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """沉积膜层厚度偏离目标值或片内均匀性超标。判别要点在偏移的时空形态： 片内径向剖面形状（中心厚的钟形 / 边缘厚的鞍形）指向沉积源几何与 靶材侵蚀轮廓，片间单调漂移指向耗材寿命或腔体壁累积， 批间跳变且边界清晰指向配方误用，同腔首片偏离而后续回稳指向 腔体状态未预处理。
"""@zh ;
        skos:notation "fab.anomaly.film_thickness_dev" ;
        skos:prefLabel "Film Thickness Deviation"@en,
            "膜厚偏移/均匀性超规"@zh ;
        semi:legacyId "fab.anomaly.film_thickness_dev" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:fab.anomaly.implant_dose_drift> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """实际注入剂量偏离设定值，通常由束流测量系统污染、法拉第杯读数偏差或 离子源老化引起。前段无直接量测，多经方阻或 WAT Vt 间接暴露， 检出滞后是其主要风险特征。
"""@zh ;
        skos:notation "fab.anomaly.implant_dose_drift" ;
        skos:prefLabel "Implant Dose Drift"@en,
            "注入剂量漂移"@zh ;
        semi:legacyId "fab.anomaly.implant_dose_drift" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:fab.anomaly.overlay_shift> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """层间对位超规。按分量拆解定位成因：均匀平移指向对位标记识别或 载台校正，旋转/放大分量指向晶圆夹持或热变形，非线性残差指向 前层应力或补正模型失配。
"""@zh ;
        skos:notation "fab.anomaly.overlay_shift" ;
        skos:prefLabel "Overlay Shift"@en,
            "套刻偏移"@zh ;
        semi:legacyId "fab.anomaly.overlay_shift" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:fab.anomaly.particle_excursion> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """缺陷密度突然跃升。空间分布是关键线索：随机分布指向环境或清洗， 同心圆指向旋转类设备，边缘集中指向传片机构或夹持环， 规律重复指向光罩或载台污染。
"""@zh ;
        skos:notation "fab.anomaly.particle_excursion" ;
        skos:prefLabel "Particle Excursion"@en,
            "颗粒突增"@zh ;
        semi:legacyId "fab.anomaly.particle_excursion" ;
        semi:severity "critical" .

    <urn:pxai:semi:catalog:fab.anomaly.scanner_down> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """曝光设备突发故障。因光刻通常为瓶颈，其停机同时造成上游 WIP 堆积 与下游断流，且产能损失不可由后续工序补偿。
"""@zh ;
        skos:notation "fab.anomaly.scanner_down" ;
        skos:prefLabel "Scanner Unscheduled Down"@en,
            "光刻机非计划停机"@zh ;
        semi:legacyId "fab.anomaly.scanner_down" ;
        semi:severity "critical" .

    <urn:pxai:semi:catalog:fab.cause.alignment_mark_damage> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """晶圆对位标记被前层工艺（CMP 过抛、蚀刻、厚膜沉积）破坏或覆盖， 导致对位信号强度不足或重心判读偏移，机台按错误的基准曝光。 特征是同一片内对位残差异常但曝光成像质量正常，且问题随前层工艺 批次相关而非随曝光机台相关——换机台重曝仍复现是强判别信号。
"""@zh ;
        skos:notation "fab.cause.alignment_mark_damage" ;
        skos:prefLabel "Alignment Mark Damage & Poor Readability"@en,
            "对位标记损伤/读取不良"@zh ;
        semi:legacyId "fab.cause.alignment_mark_damage" .

    <urn:pxai:semi:catalog:fab.cause.beam_current_drift> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "法拉第杯沾污或离子源老化导致束流读数偏离实际，剂量随之失准。"@zh ;
        skos:notation "fab.cause.beam_current_drift" ;
        skos:prefLabel "Beam Current Measurement Drift"@en,
            "束流测量漂移"@zh ;
        semi:legacyId "fab.cause.beam_current_drift" .

    <urn:pxai:semi:catalog:fab.cause.chamber_polymer_buildup> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """蚀刻腔内壁反应产物累积，改变等离子体阻抗与选择比，造成蚀刻速率漂移 与颗粒剥落。表现为随 RF Hours 增长的渐变型恶化。
"""@zh ;
        skos:notation "fab.cause.chamber_polymer_buildup" ;
        skos:prefLabel "Chamber Polymer Buildup"@en,
            "腔体聚合物累积"@zh ;
        semi:legacyId "fab.cause.chamber_polymer_buildup" .

    <urn:pxai:semi:catalog:fab.cause.chamber_wall_condition> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """清洗后未做 seasoning、或 seasoning 膜与后续制程不匹配时，腔体内壁与 零件的残留状态会同时影响片间沉积速率与片内均匀性，残留物脱落还会 转为颗粒污染。表现签名是清洗或长时间待机后的首片偏离、随后逐片 回稳。与腔体聚合物累积的判别在于时点与方向：本项出现在清洗/待机 之后且随加工片数收敛，累积类出现在长时间连续生产中且随片数发散。
"""@zh ;
        skos:notation "fab.cause.chamber_wall_condition" ;
        skos:prefLabel "Unconditioned Chamber Wall State"@en,
            "腔体壁沉积状态未预处理"@zh ;
        semi:legacyId "fab.cause.chamber_wall_condition" .

    <urn:pxai:semi:catalog:fab.cause.env_excursion> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """温湿度或粒子等级超出控制界限。影响面广且跨工序同步出现， 是"多站点同时异常"场景的首要排查方向。
"""@zh ;
        skos:notation "fab.cause.env_excursion" ;
        skos:prefLabel "Cleanroom Environment Excursion"@en,
            "洁净室环境超限"@zh ;
        semi:legacyId "fab.cause.env_excursion" .

    <urn:pxai:semi:catalog:fab.cause.epd_failure> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "光学终点信号窗口沾污或信噪比不足，导致蚀刻在错误时点停止。"@zh ;
        skos:notation "fab.cause.epd_failure" ;
        skos:prefLabel "Endpoint Detection Failure"@en,
            "终点检测失效"@zh ;
        semi:legacyId "fab.cause.epd_failure" .

    <urn:pxai:semi:catalog:fab.cause.hotplate_nonuniform> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "涂布/烘烤模块热板温区偏差，产生片内 CD 梯度型分布。"@zh ;
        skos:notation "fab.cause.hotplate_nonuniform" ;
        skos:prefLabel "Hotplate Temperature Non-uniformity"@en,
            "热板温度不均"@zh ;
        semi:legacyId "fab.cause.hotplate_nonuniform" .

    <urn:pxai:semi:catalog:fab.cause.lens_contamination> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "光学元件沾污衰减有效照度并产生局部像差，表现为固定位置 CD 偏移。"@zh ;
        skos:notation "fab.cause.lens_contamination" ;
        skos:prefLabel "Lens & Optics Contamination"@en,
            "投影镜头/光路沾污"@zh ;
        semi:legacyId "fab.cause.lens_contamination" .

    <urn:pxai:semi:catalog:fab.cause.lens_heating_drift> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """高强度曝光使投影物镜局部升温，折射率与面形随曝光量累积变化， 引起场内（intra-field）套刻分量漂移。 与光路沾污的区别在于：热漂移随批次内曝光片数递进、停机冷却后自行恢复； 沾污是持续性的且伴随成像对比度下降。
"""@zh ;
        skos:notation "fab.cause.lens_heating_drift" ;
        skos:prefLabel "Lens Heating Induced Intra-field Drift"@en,
            "镜头热效应场内漂移"@zh ;
        semi:legacyId "fab.cause.lens_heating_drift" .

    <urn:pxai:semi:catalog:fab.cause.light_source_degradation> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """准分子激光或 EUV 光源功率随累积脉冲衰减，跌破配方所需剂量下限时 曝光被拒或需延长扫描时间。区别于伺服类停机：产出率先缓慢下降， 再转为硬停机，属可预测型劣化。
"""@zh ;
        skos:notation "fab.cause.light_source_degradation" ;
        skos:prefLabel "Light Source Power Degradation"@en,
            "曝光光源功率衰减/熄灭"@zh ;
        semi:legacyId "fab.cause.light_source_degradation" .

    <urn:pxai:semi:catalog:fab.cause.pad_end_of_life> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "研磨垫沟槽磨平、表面硬化，去除率下降且划伤率上升。"@zh ;
        skos:notation "fab.cause.pad_end_of_life" ;
        skos:prefLabel "CMP Pad End of Life"@en,
            "研磨垫寿命末期"@zh ;
        semi:legacyId "fab.cause.pad_end_of_life" .

    <urn:pxai:semi:catalog:fab.cause.pm_overdue> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """瓶颈机台的 PM 常因赶产被推迟，逾期后非计划停机概率显著上升。 判别依据是停机前 PM 计划已超期，而非任何硬件突发信号—— 这类停机本质是排程决策的后果，不是设备故障。
"""@zh ;
        skos:notation "fab.cause.pm_overdue" ;
        skos:prefLabel "Preventive Maintenance Overdue"@en,
            "预防保养逾期"@zh ;
        semi:legacyId "fab.cause.pm_overdue" .

    <urn:pxai:semi:catalog:fab.cause.recipe_misload> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """加载错误配方或参数版本，造成批间跳变型偏移。与渐变型设备漂移的 判别在于异常是否在特定批次上突然出现且边界清晰。
"""@zh ;
        skos:notation "fab.cause.recipe_misload" ;
        skos:prefLabel "Recipe Misload"@en,
            "配方误用"@zh ;
        semi:legacyId "fab.cause.recipe_misload" .

    <urn:pxai:semi:catalog:fab.cause.resist_lot_change> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """新批号光阻感光度差异造成全片均匀 CD 偏移。是典型的"材料引入型" 系统偏移，与设备型偏移的判别在于是否跨机台同步出现。
"""@zh ;
        skos:notation "fab.cause.resist_lot_change" ;
        skos:prefLabel "Photoresist Lot Change"@en,
            "光阻批号切换"@zh ;
        semi:legacyId "fab.cause.resist_lot_change" .

    <urn:pxai:semi:catalog:fab.cause.reticle_haze> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "光罩表面结晶或颗粒，在每个曝光场同一相对位置重复出现缺陷。"@zh ;
        skos:notation "fab.cause.reticle_haze" ;
        skos:prefLabel "Reticle Haze / Contamination"@en,
            "光罩雾化/沾污"@zh ;
        semi:legacyId "fab.cause.reticle_haze" .

    <urn:pxai:semi:catalog:fab.cause.reticle_stage_error> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """双工件台同步扫描依赖纳米级伺服跟随，编码器、气浮或温控偏差会触发 扫描中断报警并锁机。特征是报警集中于扫描动作阶段而非曝光光源侧， 且常伴随特定 slit 位置重复出现。
"""@zh ;
        skos:notation "fab.cause.reticle_stage_error" ;
        skos:prefLabel "Reticle & Wafer Stage Servo Error"@en,
            "光罩台/工件台伺服异常"@zh ;
        semi:legacyId "fab.cause.reticle_stage_error" .

    <urn:pxai:semi:catalog:fab.cause.slurry_agglomeration> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "研磨液储存或输送中颗粒团聚成大粒径硬颗粒，成为划伤直接来源。"@zh ;
        skos:notation "fab.cause.slurry_agglomeration" ;
        skos:prefLabel "Slurry Particle Agglomeration"@en,
            "研磨液粒径团聚"@zh ;
        semi:legacyId "fab.cause.slurry_agglomeration" .

    <urn:pxai:semi:catalog:fab.cause.target_end_of_life> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "靶材侵蚀至极限，膜厚均匀性恶化且剥落颗粒风险显著上升。"@zh ;
        skos:notation "fab.cause.target_end_of_life" ;
        skos:prefLabel "PVD Target End of Life"@en,
            "靶材寿命末期"@zh ;
        semi:legacyId "fab.cause.target_end_of_life" .

    <urn:pxai:semi:catalog:fab.cause.target_erosion_profile> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """磁场把等离子体约束在闭合跑道区，靶面被局部而非均匀溅蚀，随使用 形成并加深侵蚀沟槽。沟槽尺寸变化会改变有效溅射源的几何与出射角 分布，从而改变基片上的膜厚径向剖面——文献中随源尺寸/靶基距变化 可从中心厚的钟形转为边缘厚的鞍形，再趋于平坦。与靶材寿命末期的 判别在于：本项是渐变的剖面形状改变，寿命末期是均匀性恶化叠加 剥落颗粒风险跃升。
"""@zh ;
        skos:notation "fab.cause.target_erosion_profile" ;
        skos:prefLabel "Target Erosion Groove Evolution"@en,
            "靶材侵蚀轮廓演化"@zh ;
        semi:legacyId "fab.cause.target_erosion_profile" .

    <urn:pxai:semi:catalog:fab.cause.wafer_backside_contamination> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """晶圆背面或曝光机吸盘表面附着颗粒，晶圆被真空吸附后局部抬升， 造成平面度偏差与离焦，同时在该处引入套刻偏移。 判别特征是偏移呈局部化的不规则分布（而非全片线性或旋转分量）， 且同一吸盘上不同晶圆的偏移位置重复出现——指向吸盘而非晶圆。
"""@zh ;
        skos:notation "fab.cause.wafer_backside_contamination" ;
        skos:prefLabel "Wafer Backside & Chuck Contamination"@en,
            "晶圆背面/吸盘沾污"@zh ;
        semi:legacyId "fab.cause.wafer_backside_contamination" .

    <urn:pxai:semi:catalog:fab.equip.ald> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """自限制反应逐层沉积，厚度控制精度最高但速率最低。 用于高深宽比结构的阻挡层与高 k 介质。速率低使其在需要 厚膜时不具经济性，选用边界由膜厚需求决定。
"""@zh ;
        skos:notation "fab.equip.ald" ;
        skos:prefLabel "ALD Tool"@en,
            "原子层沉积机"@zh ;
        semi:legacyId "fab.equip.ald" .

    <urn:pxai:semi:catalog:fab.equip.cd_sem> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """非破坏量测线宽的电子显微设备。量测本身不增值但决定是否放行， 抽样率是"检出速度"与"量测机台产能"的权衡。量测排队会延后 重工决策窗口，把可挽回的偏移变成不可挽回。
"""@zh ;
        skos:notation "fab.equip.cd_sem" ;
        skos:prefLabel "CD-SEM"@en,
            "关键尺寸扫描电镜"@zh ;
        semi:legacyId "fab.equip.cd_sem" .

    <urn:pxai:semi:catalog:fab.equip.cmp> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """研磨垫加抛光液的平坦化设备。研磨垫随抛光片数磨耗， 去除速率随之衰减，需按片数修整(Conditioning)或换垫。 碟形凹陷与刮伤是主要缺陷模式，抛光后清洗能力同样关键。
"""@zh ;
        skos:notation "fab.equip.cmp" ;
        skos:prefLabel "CMP Polisher"@en,
            "化学机械抛光机"@zh ;
        semi:legacyId "fab.equip.cmp" .

    <urn:pxai:semi:catalog:fab.equip.cvd> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """介质膜沉积设备。腔体壁沉积物累积是颗粒主要来源，需定期 腔体清洗(Chamber Clean)与预镀(Pre-coat)。膜厚均匀性受 喷淋头状态影响，是缓变型漂移。
"""@zh ;
        skos:notation "fab.equip.cvd" ;
        skos:prefLabel "CVD Tool"@en,
            "化学气相沉积机"@zh ;
        semi:legacyId "fab.equip.cvd" .

    <urn:pxai:semi:catalog:fab.equip.defect_scanner> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """光学或电子束扫描全片缺陷并分类。灵敏度与吞吐量成反比， 检测配方(Recipe)决定能看见什么。缺陷空间分布形态是定位 责任机台的核心线索，因此检测点布置决定问题可诊断性。
"""@zh ;
        skos:notation "fab.equip.defect_scanner" ;
        skos:prefLabel "Defect Inspection Tool"@en,
            "缺陷检测机"@zh ;
        semi:legacyId "fab.equip.defect_scanner" .

    <urn:pxai:semi:catalog:fab.equip.etcher_plasma> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """多腔体(Cluster)配置，各腔体独立漂移。聚合物累积改变蚀刻速率与形貌， 需按 RF 累积时数排 PM 与 Seasoning。腔体是有效调度单元， 同机不同腔的产出需分开做 SPC。
"""@zh ;
        skos:notation "fab.equip.etcher_plasma" ;
        skos:prefLabel "Plasma Etcher"@en,
            "等离子蚀刻机"@zh ;
        semi:legacyId "fab.equip.etcher_plasma" .

    <urn:pxai:semi:catalog:fab.equip.furnace> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """一次装载多舟(100+ 片)的批式热处理设备。升降温加保温的周期长达数小时， 是前段最长的单工序周期时间。批量大意味着排程上倾向凑满批， 因此常成为 WIP 堆积点 —— 等批比等机台更常见。
"""@zh ;
        skos:notation "fab.equip.furnace" ;
        skos:prefLabel "Vertical Furnace"@en,
            "立式扩散炉"@zh ;
        semi:legacyId "fab.equip.furnace" .

    <urn:pxai:semi:catalog:fab.equip.implanter> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """按能量段分中束流/高电流/高能三类机型，机型间不可互换。 束流稳定性决定剂量精度，换 species 需长时间清洗与调机， 因此排程强烈偏好同 species 连做 —— 换机成本体现为设置时间而非停机。
"""@zh ;
        skos:notation "fab.equip.implanter" ;
        skos:prefLabel "Ion Implanter"@en,
            "离子植入机"@zh ;
        semi:legacyId "fab.equip.implanter" .

    <urn:pxai:semi:catalog:fab.equip.overlay_metro> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """量测层间对位偏差并回馈修正量给 Scanner(APC 回路)。 其数据质量直接决定回馈修正是否有效，量测精度不足会把 噪声当信号回馈，反而放大 Overlay 波动。
"""@zh ;
        skos:notation "fab.equip.overlay_metro" ;
        skos:prefLabel "Overlay Metrology Tool"@en,
            "套刻量测机"@zh ;
        semi:legacyId "fab.equip.overlay_metro" .

    <urn:pxai:semi:catalog:fab.equip.prober> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """探针卡接触焊垫做电性测试，与测试机(Tester)配对使用。 测试时间由测试项数决定，是前段最后一道也是最贵的量测。 探针卡磨耗导致接触不良会误判为良率下降，需与真实失效区分。
"""@zh ;
        skos:notation "fab.equip.prober" ;
        skos:prefLabel "Wafer Prober / Tester"@en,
            "晶圆测试机"@zh ;
        semi:legacyId "fab.equip.prober" .

    <urn:pxai:semi:catalog:fab.equip.pvd> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """溅镀金属膜的多腔体设备。靶材随消耗改变沉积速率，靶材寿命末期 颗粒污染风险上升。换靶是计划性停机，靶材成本进入单位成本。
"""@zh ;
        skos:notation "fab.equip.pvd" ;
        skos:prefLabel "PVD / Sputter"@en,
            "物理气相沉积机"@zh ;
        semi:legacyId "fab.equip.pvd" .

    <urn:pxai:semi:catalog:fab.equip.rtp> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """灯管加热的单片式热处理设备，秒级升温。相较扩散炉热预算低得多， 用于浅接面激活。单片式使其无凑批延迟，但产能受限于单片处理时间。
"""@zh ;
        skos:notation "fab.equip.rtp" ;
        skos:prefLabel "Rapid Thermal Processor (RTP)"@en,
            "快速热处理机"@zh ;
        semi:legacyId "fab.equip.rtp" .

    <urn:pxai:semi:catalog:fab.equip.scanner> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """分步扫描投影曝光机。单台资本支出为全厂最高，折旧摊提使其稼动率 直接决定单位成本。光源、镜头、对位系统三者状态共同决定 CD 与 Overlay 能力， 机台间差异(Tool-to-Tool)需靠 Overlay 修正参数补偿，因此不可随意换机。
"""@zh ;
        skos:notation "fab.equip.scanner" ;
        skos:prefLabel "Scanner / Lithography Tool"@en,
            "扫描式曝光机"@zh ;
        semi:legacyId "fab.equip.scanner" .

    <urn:pxai:semi:catalog:fab.equip.track> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """涂布、烤板、显影一体的轨道式设备，通常与 Scanner 联机(In-line)。 热板温度均匀性是 CD 均匀性的直接来源。联机意味着 Track 故障会连带 锁死 Scanner，其可用性影响被放大。
"""@zh ;
        skos:notation "fab.equip.track" ;
        skos:prefLabel "Coater / Developer Track"@en,
            "涂布显影机"@zh ;
        semi:legacyId "fab.equip.track" .

    <urn:pxai:semi:catalog:fab.equip.wafer_sorter> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """读取晶圆 ID 并在片盒间搬运重组批次。是批次拆分合并的执行点， 也是 WIP 追溯的数据来源。分片错误导致的批次混料是追溯性事故， 影响面按后续所有工序展开。
"""@zh ;
        skos:notation "fab.equip.wafer_sorter" ;
        skos:prefLabel "Wafer Sorter"@en,
            "晶圆分片机"@zh ;
        semi:legacyId "fab.equip.wafer_sorter" .

    <urn:pxai:semi:catalog:fab.equip.wet_bench> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """多槽化学处理设备，一次处理整批(通常 25~50 片)。槽液随累积用量衰减， 按 batch count 换槽形成周期性能力波动。批式处理使其单位成本低， 但一次异常影响整批，损失粒度大。
"""@zh ;
        skos:notation "fab.equip.wet_bench" ;
        skos:prefLabel "Wet Bench"@en,
            "湿式工作台"@zh ;
        semi:legacyId "fab.equip.wet_bench" .

    <urn:pxai:semi:catalog:fab.material.photoresist> a semi:CatalogConcept,
            semi:MaterialType ;
        skos:definition """感光高分子材料，有效期与储存温度敏感。批号切换是 CD 漂移的 常见系统性成因，需做批号对比验证。
"""@zh ;
        skos:notation "fab.material.photoresist" ;
        skos:prefLabel "Photoresist"@en,
            "光阻"@zh ;
        semi:legacyId "fab.material.photoresist" .

    <urn:pxai:semi:catalog:fab.material.reticle> a semi:CatalogConcept,
            semi:MaterialType ;
        skos:definition """承载图形的石英掩膜版。表面沾污或雾化(Haze)会在所有曝光场重复 出现同位置缺陷，是"规律性重复缺陷"的首要排查对象。
"""@zh ;
        skos:notation "fab.material.reticle" ;
        skos:prefLabel "Reticle / Photomask"@en,
            "光罩"@zh ;
        semi:legacyId "fab.material.reticle" .

    <urn:pxai:semi:catalog:fab.metric.cd_uniformity> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition """关键尺寸的目标偏差与分布离散度，分片内(WIW)、片间(WTW)、批间(LTL)三层。 CD 是前段最核心的图形指标，直接决定器件电学参数分布。
"""@zh ;
        skos:notation "fab.metric.cd_uniformity" ;
        skos:prefLabel "CD Uniformity"@en,
            "关键尺寸均匀性"@zh ;
        semi:legacyId "fab.metric.cd_uniformity" ;
        semi:unitCode "nm (3σ)" .

    <urn:pxai:semi:catalog:fab.metric.defect_density> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition """单位面积缺陷数。分类(颗粒、划伤、残留、桥连)与空间分布形态 是定位责任工序与机台的核心线索。
"""@zh ;
        skos:notation "fab.metric.defect_density" ;
        skos:prefLabel "Defect Density"@en,
            "缺陷密度"@zh ;
        semi:legacyId "fab.metric.defect_density" ;
        semi:unitCode "ea/cm² / ea per wafer" .

    <urn:pxai:semi:catalog:fab.metric.etch_depth> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition "蚀刻去除的纵向尺寸，配合侧壁角度评估形貌。"@zh ;
        skos:notation "fab.metric.etch_depth" ;
        skos:prefLabel "Etch Depth"@en,
            "蚀刻深度"@zh ;
        semi:legacyId "fab.metric.etch_depth" ;
        semi:unitCode "Å / nm" .

    <urn:pxai:semi:catalog:fab.metric.film_thickness> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition "沉积或生长膜层厚度及其均匀性，用椭偏仪或反射光谱量测。"@zh ;
        skos:notation "fab.metric.film_thickness" ;
        skos:prefLabel "Film Thickness"@en,
            "膜厚"@zh ;
        semi:legacyId "fab.metric.film_thickness" ;
        semi:unitCode "Å / nm" .

    <urn:pxai:semi:catalog:fab.metric.overlay_error> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition """当前层图形与前层的对位偏差，分解为平移、旋转、放大、非线性分量。 超规导致接触不良或短路，是多层结构的累积性风险。
"""@zh ;
        skos:notation "fab.metric.overlay_error" ;
        skos:prefLabel "Overlay Error"@en,
            "套刻误差"@zh ;
        semi:legacyId "fab.metric.overlay_error" ;
        semi:unitCode "nm" .

    <urn:pxai:semi:catalog:fab.metric.sheet_resistance> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition "掺杂层或金属层的面电阻，四点探针量测。反映掺杂剂量与激活效果。"@zh ;
        skos:notation "fab.metric.sheet_resistance" ;
        skos:prefLabel "Sheet Resistance"@en,
            "方阻"@zh ;
        semi:legacyId "fab.metric.sheet_resistance" ;
        semi:unitCode "Ω/sq" .

    <urn:pxai:semi:catalog:fab.metric.wat_vt> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition """WAT 关键电学参数。受栅氧厚度、通道掺杂剂量、CD 三者共同影响， 是多个前段工序偏移的汇总观测量。
"""@zh ;
        skos:notation "fab.metric.wat_vt" ;
        skos:prefLabel "Threshold Voltage (Vt)"@en,
            "阈值电压"@zh ;
        semi:legacyId "fab.metric.wat_vt" ;
        semi:unitCode "V" .

    <urn:pxai:semi:catalog:fab.param.chamber_pressure> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "真空腔工作压力。影响等离子体密度、沉积速率与台阶覆盖性。"@zh ;
        skos:notation "fab.param.chamber_pressure" ;
        skos:prefLabel "Chamber Pressure"@en,
            "腔体压力"@zh ;
        semi:legacyId "fab.param.chamber_pressure" ;
        semi:unitCode "mTorr / Torr" .

    <urn:pxai:semi:catalog:fab.param.cmp_platen_speed> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "研磨盘转速，影响去除率与研磨液分布均匀性。"@zh ;
        skos:notation "fab.param.cmp_platen_speed" ;
        skos:prefLabel "CMP Platen Speed"@en,
            "CMP 转盘转速"@zh ;
        semi:legacyId "fab.param.cmp_platen_speed" ;
        semi:unitCode "rpm" .

    <urn:pxai:semi:catalog:fab.param.cmp_pressure> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "晶圆压向研磨垫的压力，与转速共同决定去除率(Preston 方程)。"@zh ;
        skos:notation "fab.param.cmp_pressure" ;
        skos:prefLabel "CMP Down Force"@en,
            "CMP 研磨压力"@zh ;
        semi:legacyId "fab.param.cmp_pressure" ;
        semi:unitCode "psi" .

    <urn:pxai:semi:catalog:fab.param.cmp_slurry_flow> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition """研磨液供给速率，不足会导致局部干磨与划伤。研磨液粒径团聚 是划伤类缺陷的主要来源之一。
"""@zh ;
        skos:notation "fab.param.cmp_slurry_flow" ;
        skos:prefLabel "CMP Slurry Flow Rate"@en,
            "研磨液流量"@zh ;
        semi:legacyId "fab.param.cmp_slurry_flow" ;
        semi:unitCode "ml/min" .

    <urn:pxai:semi:catalog:fab.param.develop_time> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "显影液作用时间，CD 微调的次级旋钮。"@zh ;
        skos:notation "fab.param.develop_time" ;
        skos:prefLabel "Development Time"@en,
            "显影时间"@zh ;
        semi:legacyId "fab.param.develop_time" ;
        semi:unitCode "s" .

    <urn:pxai:semi:catalog:fab.param.etch_gas_flow> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "反应气体与稀释气体配比，决定化学选择比与聚合物生成量。"@zh ;
        skos:notation "fab.param.etch_gas_flow" ;
        skos:prefLabel "Etch Gas Flow"@en,
            "蚀刻气体流量"@zh ;
        semi:legacyId "fab.param.etch_gas_flow" ;
        semi:unitCode "sccm" .

    <urn:pxai:semi:catalog:fab.param.etch_rf_power> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "等离子体激发功率，决定离子能量与蚀刻速率、各向异性程度。"@zh ;
        skos:notation "fab.param.etch_rf_power" ;
        skos:prefLabel "Etch RF Power"@en,
            "蚀刻射频功率"@zh ;
        semi:legacyId "fab.param.etch_rf_power" ;
        semi:unitCode "W" .

    <urn:pxai:semi:catalog:fab.param.etch_time> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "蚀刻时长，通常配合终点检测使用，过蚀时间(Over-etch)单独设定。"@zh ;
        skos:notation "fab.param.etch_time" ;
        skos:prefLabel "Etch Time"@en,
            "蚀刻时间"@zh ;
        semi:legacyId "fab.param.etch_time" ;
        semi:unitCode "s" .

    <urn:pxai:semi:catalog:fab.param.etchant_concentration> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "湿制程槽液有效成分浓度，随使用衰减，需按累积批次数补液或换槽。"@zh ;
        skos:notation "fab.param.etchant_concentration" ;
        skos:prefLabel "Etchant Concentration"@en,
            "蚀刻液浓度"@zh ;
        semi:legacyId "fab.param.etchant_concentration" ;
        semi:unitCode "% / ratio" .

    <urn:pxai:semi:catalog:fab.param.exposure_dose> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition """单位面积曝光能量。CD 的最主要旋钮，与焦距构成工艺窗口(Bossung Curve) 的两个轴。剂量漂移常源于光源能量衰退或照度校正失效。
"""@zh ;
        skos:notation "fab.param.exposure_dose" ;
        skos:prefLabel "Exposure Dose"@en,
            "曝光剂量"@zh ;
        semi:legacyId "fab.param.exposure_dose" ;
        semi:unitCode "mJ/cm²" .

    <urn:pxai:semi:catalog:fab.param.exposure_focus> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition """投影焦平面位置偏移。焦深余量受晶圆平整度与前层 CMP 平坦化质量约束， 离焦表现为 CD 变化伴随侧壁形貌恶化。
"""@zh ;
        skos:notation "fab.param.exposure_focus" ;
        skos:prefLabel "Exposure Focus"@en,
            "曝光焦距"@zh ;
        semi:legacyId "fab.param.exposure_focus" ;
        semi:unitCode "nm" .

    <urn:pxai:semi:catalog:fab.param.furnace_temp> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "炉管温区设定值。温区平衡直接决定片间(Wafer-to-Wafer)均匀性。"@zh ;
        skos:notation "fab.param.furnace_temp" ;
        skos:prefLabel "Furnace Temperature"@en,
            "炉温"@zh ;
        semi:legacyId "fab.param.furnace_temp" ;
        semi:unitCode "℃" .

    <urn:pxai:semi:catalog:fab.param.furnace_time> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "高温保持时间。与温度共同构成热预算，是膜厚/结深的主控量。"@zh ;
        skos:notation "fab.param.furnace_time" ;
        skos:prefLabel "Furnace Time"@en,
            "炉管时间"@zh ;
        semi:legacyId "fab.param.furnace_time" ;
        semi:unitCode "min" .

    <urn:pxai:semi:catalog:fab.param.hardbake_temp> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "显影后固化光阻，提升抗蚀刻能力。过高导致图形流动变形。"@zh ;
        skos:notation "fab.param.hardbake_temp" ;
        skos:prefLabel "Hard Bake Temperature"@en,
            "硬烤温度"@zh ;
        semi:legacyId "fab.param.hardbake_temp" ;
        semi:unitCode "℃" .

    <urn:pxai:semi:catalog:fab.param.implant_dose> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "单位面积注入离子数，决定掺杂浓度与方阻。由束流与扫描时间积分控制。"@zh ;
        skos:notation "fab.param.implant_dose" ;
        skos:prefLabel "Implant Dose"@en,
            "注入剂量"@zh ;
        semi:legacyId "fab.param.implant_dose" ;
        semi:unitCode "ions/cm²" .

    <urn:pxai:semi:catalog:fab.param.implant_energy> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "加速电压决定的离子能量，控制投影射程即结深。"@zh ;
        skos:notation "fab.param.implant_energy" ;
        skos:prefLabel "Implant Energy"@en,
            "注入能量"@zh ;
        semi:legacyId "fab.param.implant_energy" ;
        semi:unitCode "keV" .

    <urn:pxai:semi:catalog:fab.param.implant_tilt> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "束流与晶圆法线夹角。控制沟道效应(Channeling)与阴影效应。"@zh ;
        skos:notation "fab.param.implant_tilt" ;
        skos:prefLabel "Implant Tilt Angle"@en,
            "注入倾角"@zh ;
        semi:legacyId "fab.param.implant_tilt" ;
        semi:unitCode "degree" .

    <urn:pxai:semi:catalog:fab.param.overlay_offset> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition """Scanner 逐批对位补正值，由前批 Overlay 量测结果经 APC 回馈生成。 补正模型失配时会出现补正越修越偏。
"""@zh ;
        skos:notation "fab.param.overlay_offset" ;
        skos:prefLabel "Overlay Correction Offset"@en,
            "对位补正量"@zh ;
        semi:legacyId "fab.param.overlay_offset" ;
        semi:unitCode "nm" .

    <urn:pxai:semi:catalog:fab.param.pvd_power> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "靶材溅射功率，决定沉积速率。功率与靶材侵蚀形貌共同影响均匀性。"@zh ;
        skos:notation "fab.param.pvd_power" ;
        skos:prefLabel "PVD Sputtering Power"@en,
            "溅镀功率"@zh ;
        semi:legacyId "fab.param.pvd_power" ;
        semi:unitCode "kW" .

    <urn:pxai:semi:catalog:fab.param.rta_ramp_rate> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "快速升温斜率。过快引起片内热应力与滑移线缺陷。"@zh ;
        skos:notation "fab.param.rta_ramp_rate" ;
        skos:prefLabel "RTA Ramp Rate"@en,
            "RTA 升温速率"@zh ;
        semi:legacyId "fab.param.rta_ramp_rate" ;
        semi:unitCode "℃/s" .

    <urn:pxai:semi:catalog:fab.param.softbake_temp> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "涂布后去除溶剂的烘烤温度。影响光阻感光度与显影对比度。"@zh ;
        skos:notation "fab.param.softbake_temp" ;
        skos:prefLabel "Soft Bake Temperature"@en,
            "软烤温度"@zh ;
        semi:legacyId "fab.param.softbake_temp" ;
        semi:unitCode "℃" .

    <urn:pxai:semi:catalog:fab.param.spin_speed> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "旋涂转速，与光阻黏度共同决定膜厚（近似正比于转速平方根倒数）。"@zh ;
        skos:notation "fab.param.spin_speed" ;
        skos:prefLabel "Spin Speed"@en,
            "涂布转速"@zh ;
        semi:legacyId "fab.param.spin_speed" ;
        semi:unitCode "rpm" .

    <urn:pxai:semi:catalog:fab.process.ald_barrier> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """原子层沉积，逐层自限制生长，台阶覆盖性最佳。速率低， 单片工序时间长，先进制程中逐渐成为产能约束点。
"""@zh ;
        skos:notation "fab.process.ald_barrier" ;
        skos:prefLabel "ALD Barrier Deposition"@en,
            "ALD 阻挡层沉积"@zh ;
        semi:legacyId "fab.process.ald_barrier" .

    <urn:pxai:semi:catalog:fab.process.cd_measure> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """CD-SEM 量测关键尺寸。抽样点位与频率决定异常检出灵敏度， 是光刻与蚀刻工艺窗口监控的主要数据源。
"""@zh ;
        skos:notation "fab.process.cd_measure" ;
        skos:prefLabel "CD Measurement"@en,
            "CD 量测"@zh ;
        semi:legacyId "fab.process.cd_measure" .

    <urn:pxai:semi:catalog:fab.process.cmp_metal> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """去除多余金属形成镶嵌结构(Damascene)。过研磨造成碟形凹陷， 研磨不足造成金属残留短路，工艺窗口窄。
"""@zh ;
        skos:notation "fab.process.cmp_metal" ;
        skos:prefLabel "Metal CMP"@en,
            "金属 CMP"@zh ;
        semi:legacyId "fab.process.cmp_metal" .

    <urn:pxai:semi:catalog:fab.process.cmp_oxide> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """研磨介电层实现平坦化，为后续光刻提供焦深余量。研磨垫状态与 研磨液粒径分布是划伤与去除率稳定性的主因。
"""@zh ;
        skos:notation "fab.process.cmp_oxide" ;
        skos:prefLabel "Oxide CMP"@en,
            "氧化层 CMP"@zh ;
        semi:legacyId "fab.process.cmp_oxide" .

    <urn:pxai:semi:catalog:fab.process.cp_test> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """逐 die 探针测试功能与性能，产出 Wafer Map 与良率分级。 结果决定后段投料数量与分选策略。
"""@zh ;
        skos:notation "fab.process.cp_test" ;
        skos:prefLabel "CP (Circuit Probe)"@en,
            "晶圆针测"@zh ;
        semi:legacyId "fab.process.cp_test" .

    <urn:pxai:semi:catalog:fab.process.cvd_ild> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """沉积层间介电层隔离金属层。填孔能力(Gap Fill)不足会形成空洞， 在后续 CMP 或电测阶段暴露为漏电与可靠性问题。
"""@zh ;
        skos:notation "fab.process.cvd_ild" ;
        skos:prefLabel "CVD ILD Deposition"@en,
            "CVD 层间介电沉积"@zh ;
        semi:legacyId "fab.process.cvd_ild" .

    <urn:pxai:semi:catalog:fab.process.defect_scan> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """明场/暗场光学扫描统计缺陷数与分布图。缺陷签名(Signature)的空间 分布形态是定位问题机台与工序的关键线索。
"""@zh ;
        skos:notation "fab.process.defect_scan" ;
        skos:prefLabel "Defect Inspection"@en,
            "缺陷扫描"@zh ;
        semi:legacyId "fab.process.defect_scan" .

    <urn:pxai:semi:catalog:fab.process.dry_etch> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """等离子体各向异性蚀刻，转移光阻图形到下层材料。终点检测(EPD)控制 蚀刻深度，腔体状态漂移（聚合物累积）影响速率与形貌重复性。
"""@zh ;
        skos:notation "fab.process.dry_etch" ;
        skos:prefLabel "Dry Etch"@en,
            "干法蚀刻"@zh ;
        semi:legacyId "fab.process.dry_etch" .

    <urn:pxai:semi:catalog:fab.process.furnace_anneal> a semi:CatalogConcept,
            semi:Process ;
        skos:definition "长时间批式退火，用于致密化介电层或应力释放。"@zh ;
        skos:notation "fab.process.furnace_anneal" ;
        skos:prefLabel "Furnace Anneal"@en,
            "炉管退火"@zh ;
        semi:legacyId "fab.process.furnace_anneal" .

    <urn:pxai:semi:catalog:fab.process.gate_oxidation> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """生长栅极介电层，厚度均匀性与界面缺陷密度直接决定器件阈值电压与可靠性。 对颗粒与金属污染最敏感的工序之一。
"""@zh ;
        skos:notation "fab.process.gate_oxidation" ;
        skos:prefLabel "Gate Oxidation"@en,
            "栅氧化"@zh ;
        semi:legacyId "fab.process.gate_oxidation" .

    <urn:pxai:semi:catalog:fab.process.ion_implant> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """加速掺杂离子轰击晶圆形成掺杂区。剂量决定载流子浓度，能量决定结深。 束流稳定性与角度精度是主要控制难点。
"""@zh ;
        skos:notation "fab.process.ion_implant" ;
        skos:prefLabel "Ion Implantation"@en,
            "离子注入"@zh ;
        semi:legacyId "fab.process.ion_implant" .

    <urn:pxai:semi:catalog:fab.process.lpcvd_nitride> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """低压化学气相沉积 Si3N4，作硬掩膜或钝化层。批式炉管加工， 片间与片内均匀性受气流分布与温区平衡影响。
"""@zh ;
        skos:notation "fab.process.lpcvd_nitride" ;
        skos:prefLabel "LPCVD Nitride Deposition"@en,
            "LPCVD 氮化硅沉积"@zh ;
        semi:legacyId "fab.process.lpcvd_nitride" .

    <urn:pxai:semi:catalog:fab.process.overlay_measure> a semi:CatalogConcept,
            semi:Process ;
        skos:definition "量测层间对位偏差，结果回馈 Scanner 做逐批对位补正(APC)。"@zh ;
        skos:notation "fab.process.overlay_measure" ;
        skos:prefLabel "Overlay Measurement"@en,
            "套刻精度量测"@zh ;
        semi:legacyId "fab.process.overlay_measure" .

    <urn:pxai:semi:catalog:fab.process.photo_coat> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """旋涂光阻并软烤。膜厚由转速与光阻黏度决定，均匀性受环境温湿度与 涂布杯气流影响。涂布缺陷（彗尾、气泡）会在曝光后放大为图形缺陷。
"""@zh ;
        skos:notation "fab.process.photo_coat" ;
        skos:prefLabel "Photoresist Coating"@en,
            "光阻涂布"@zh ;
        semi:legacyId "fab.process.photo_coat" .

    <urn:pxai:semi:catalog:fab.process.photo_develop> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """显影液溶解曝光区（正胶）形成图形，随后硬烤固化。显影时间与温度 偏移直接改变 CD，是 CD 微调的常用旋钮。
"""@zh ;
        skos:notation "fab.process.photo_develop" ;
        skos:prefLabel "Development"@en,
            "显影"@zh ;
        semi:legacyId "fab.process.photo_develop" .

    <urn:pxai:semi:catalog:fab.process.photo_exposure> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """经光罩将图形投影到光阻。曝光剂量与焦距共同决定 CD， 对位精度决定 Overlay。扫描机(Scanner)是前段最贵设备与典型瓶颈。
"""@zh ;
        skos:notation "fab.process.photo_exposure" ;
        skos:prefLabel "Exposure"@en,
            "曝光"@zh ;
        semi:legacyId "fab.process.photo_exposure" .

    <urn:pxai:semi:catalog:fab.process.poly_deposition> a semi:CatalogConcept,
            semi:Process ;
        skos:definition "沉积多晶硅作栅极材料，晶粒尺寸与掺杂浓度影响方阻。"@zh ;
        skos:notation "fab.process.poly_deposition" ;
        skos:prefLabel "Polysilicon Deposition"@en,
            "多晶硅沉积"@zh ;
        semi:legacyId "fab.process.poly_deposition" .

    <urn:pxai:semi:catalog:fab.process.pr_strip> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """灰化或湿法去除残余光阻。去除不净形成的残留会成为后续沉积的 缺陷源，也是光刻重工路径的必经工序。
"""@zh ;
        skos:notation "fab.process.pr_strip" ;
        skos:prefLabel "Photoresist Strip"@en,
            "去光阻"@zh ;
        semi:legacyId "fab.process.pr_strip" .

    <urn:pxai:semi:catalog:fab.process.pvd_metal> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """物理气相沉积（溅镀）铝/铜/钛等金属层与阻挡层。靶材寿命末期 颗粒剥落风险升高，膜厚均匀性随靶材侵蚀轮廓变化。
"""@zh ;
        skos:notation "fab.process.pvd_metal" ;
        skos:prefLabel "PVD Metal Deposition"@en,
            "PVD 金属沉积"@zh ;
        semi:legacyId "fab.process.pvd_metal" .

    <urn:pxai:semi:catalog:fab.process.rta_anneal> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """秒级升降温激活掺杂并修复注入损伤。单片加工，热预算控制优于炉管退火， 抑制掺杂扩散拖尾。
"""@zh ;
        skos:notation "fab.process.rta_anneal" ;
        skos:prefLabel "RTA (Rapid Thermal Anneal)"@en,
            "快速热退火"@zh ;
        semi:legacyId "fab.process.rta_anneal" .

    <urn:pxai:semi:catalog:fab.process.thermal_oxidation> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """高温通氧生长 SiO2，用作垫氧化层或牺牲层。干氧致密速率慢，湿氧速率快 质量略低。厚度由温度-时间-气氛共同决定。
"""@zh ;
        skos:notation "fab.process.thermal_oxidation" ;
        skos:prefLabel "Thermal Oxidation"@en,
            "热氧化"@zh ;
        semi:legacyId "fab.process.thermal_oxidation" .

    <urn:pxai:semi:catalog:fab.process.wafer_clean> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """RCA/SPM 等化学清洗去除颗粒、有机物与金属污染。是几乎每个 关键工序前的标配预处理，清洗能力直接决定缺陷基线。
"""@zh ;
        skos:notation "fab.process.wafer_clean" ;
        skos:prefLabel "Wafer Clean"@en,
            "晶圆清洗"@zh ;
        semi:legacyId "fab.process.wafer_clean" .

    <urn:pxai:semi:catalog:fab.process.wafer_start> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """裸片开卡投入产线，绑定产品别、Route 与批次号。投料节奏决定全线 WIP 基线水位，脉冲式投料是下游 WIP 堆积的常见上游成因。
"""@zh ;
        skos:notation "fab.process.wafer_start" ;
        skos:prefLabel "Wafer Start"@en,
            "投料"@zh ;
        semi:legacyId "fab.process.wafer_start" .

    <urn:pxai:semi:catalog:fab.process.wat> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """测量 Scribe Line 上工艺控制结构的电学参数（Vt、Rs、Idsat 等）， 判定工艺是否落在规格内。是前段工艺能力的总结算点。
"""@zh ;
        skos:notation "fab.process.wat" ;
        skos:prefLabel "WAT (Wafer Acceptance Test)"@en,
            "晶圆电性测试"@zh ;
        semi:legacyId "fab.process.wat" .

    <urn:pxai:semi:catalog:fab.process.wet_etch> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """化学溶液各向同性蚀刻，选择比高但侧向侵蚀明显。用于牺牲层去除 与特定材料剥离。槽液浓度随使用衰减，需按 batch count 换槽。
"""@zh ;
        skos:notation "fab.process.wet_etch" ;
        skos:prefLabel "Wet Etch"@en,
            "湿法蚀刻"@zh ;
        semi:legacyId "fab.process.wet_etch" .

    <urn:pxai:semi:catalog:fab.route.cmos_logic_main> a semi:CatalogConcept,
            semi:Route ;
        skos:definition """成熟制程 CMOS 逻辑产品的简化主流程，从投料到 CP 结算。实际多层金属 产品在"光刻-蚀刻-薄膜-CMP"区段循环 6~12 轮，此处只展开一轮以保持 链路可读。steps 顺序与 20-flow-precedes.yaml 的 precedes 链严格一致。
"""@zh ;
        skos:notation "fab.route.cmos_logic_main" ;
        skos:prefLabel "CMOS Logic Main Flow (Single Metal Layer)"@en,
            "CMOS 逻辑主流程（单金属层）"@zh ;
        semi:legacyId "fab.route.cmos_logic_main" .

    <urn:pxai:semi:catalog:fab.stage.cmp> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "平坦化",
            "抛光",
            "研磨" ;
        skos:definition """平坦化制程，为后续光刻提供焦深余量。消耗研磨垫与研磨液， 划伤(Scratch)与碟形凹陷(Dishing)为典型缺陷。
"""@zh ;
        skos:notation "fab.stage.cmp" ;
        skos:prefLabel "CMP"@en,
            "化学机械研磨"@zh ;
        semi:legacyId "fab.stage.cmp" .

    <urn:pxai:semi:catalog:fab.stage.diffusion> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "Furnace",
            "扩散区",
            "炉管",
            "热制程" ;
        skos:definition """高温炉管类工序集合，含氧化、退火、LPCVD 薄膜。批式加工(Batch Furnace) 为主，单批 100~150 片，热预算(Thermal Budget)为核心约束。
"""@zh ;
        skos:notation "fab.stage.diffusion" ;
        skos:prefLabel "Diffusion & Thermal"@en,
            "扩散/热制程"@zh ;
        semi:legacyId "fab.stage.diffusion" .

    <urn:pxai:semi:catalog:fab.stage.etch> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "Dry Etch",
            "干蚀",
            "蚀刻区" ;
        skos:definition """按光阻图形去除材料。干法(等离子)为主流，湿法用于特定选择性需求。 关键指标为蚀刻速率、选择比、侧壁形貌与均匀性。
"""@zh ;
        skos:notation "fab.stage.etch" ;
        skos:prefLabel "Etch"@en,
            "蚀刻"@zh ;
        semi:legacyId "fab.stage.etch" .

    <urn:pxai:semi:catalog:fab.stage.implant> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "Implant",
            "植入",
            "离子布植" ;
        skos:definition """注入掺杂离子形成结区。剂量(Dose)与能量(Energy)决定电学参数， 注入后需退火激活并修复晶格损伤。
"""@zh ;
        skos:notation "fab.stage.implant" ;
        skos:prefLabel "Ion Implantation"@en,
            "离子注入"@zh ;
        semi:legacyId "fab.stage.implant" .

    <urn:pxai:semi:catalog:fab.stage.metrology> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "QC 站",
            "缺陷检测",
            "量测",
            "量测区" ;
        skos:definition """非增值但决定可观测性的工序段。含 CD/膜厚/Overlay 量测与 明场/暗场缺陷扫描。抽检率是产能与风险暴露的权衡。
"""@zh ;
        skos:notation "fab.stage.metrology" ;
        skos:prefLabel "Metrology & Inspection"@en,
            "量测与缺陷检测"@zh ;
        semi:legacyId "fab.stage.metrology" .

    <urn:pxai:semi:catalog:fab.stage.photo> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "Litho",
            "光罩制程",
            "黄光",
            "黄光区" ;
        skos:definition """图形转移制程段，涂胶-曝光-显影三段联动。是前段最贵、通常最紧的产能 环节，CD 与 Overlay 两项指标决定后续所有图形精度。
"""@zh ;
        skos:notation "fab.stage.photo" ;
        skos:prefLabel "Photolithography"@en,
            "光刻"@zh ;
        semi:legacyId "fab.stage.photo" .

    <urn:pxai:semi:catalog:fab.stage.thinfilm> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "沉积",
            "薄膜",
            "镀膜" ;
        skos:definition "PVD/CVD/ALD 沉积导体与介电层。膜厚均匀性与应力控制为核心。"@zh ;
        skos:notation "fab.stage.thinfilm" ;
        skos:prefLabel "Thin Film Deposition"@en,
            "薄膜沉积"@zh ;
        semi:legacyId "fab.stage.thinfilm" .

    <urn:pxai:semi:catalog:fab.stage.wat_cp> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "WAT",
            "中测",
            "电性",
            "电测" ;
        skos:definition """WAT(Wafer Acceptance Test) 测 Scribe Line 上的工艺控制结构， CP(Circuit Probe) 逐 die 测功能。前段良率在此结算。
"""@zh ;
        skos:notation "fab.stage.wat_cp" ;
        skos:prefLabel "WAT / CP"@en,
            "电性测试"@zh ;
        semi:legacyId "fab.stage.wat_cp" .
}

<urn:pxai:semi:graph:semantic-abox> {
    semi:current-knowledge a owl:Ontology ;
        owl:imports semi:common .

    semi:eqp.capability.ai_fault_detection_rca semi:supportsPredictiveMaintenance semi:eqp.plan.predictive_maintenance .

    <urn:pxai:semi:ext:web:springer:telemetry_causal_integration_pattern_02> a semi:RCAEvidenceIntegrationPattern ;
        rdfs:label "遥测与因果分析集成模式02"@zh ;
        semi:description "将图像或传感器分析、设备时间序列、模式识别和因果建模组织为故障检测与根因分析证据链的行业模式，同时保留数据质量与可解释性限制。" ;
        semi:modelingLimitationText "公开综述支持行业层面的能力模式，但不能据此声明特定工厂的检测准确率、停机减少量、良率提升或收益。" ;
        semi:nameZh "遥测与因果分析集成模式02" ;
        semi:sourceRef "https://link.springer.com/article/10.1007/s00170-026-18777-0" ;
        semi:sourceType "web" .

    <urn:pxai:semi:fac:digital_twin:facility_repair_r2> a semi:FacilityDigitalTwin ;
        rdfs:label "设施级数字孪生门禁修复实体"@zh ;
        semi:hasEvent <urn:pxai:semi:fac:event:infrastructure_repair_r2> ;
        semi:hasSubsystem <urn:pxai:semi:fac:utility:multi_system_repair_r2> ;
        semi:sourceRef "https://semiconductorx.com/fab-ops-facility-management.html" ;
        semi:sourceType "web" .

    <urn:pxai:semi:fac:fms:utility_integration_repair_r2> a semi:FacilityManagementSystem ;
        rdfs:label "公用系统集成型厂务管理系统门禁修复实体"@zh ;
        semi:aggregatesUtilityData <urn:pxai:semi:fac:utility:multi_system_repair_r2> ;
        semi:sourceRef "https://semiconductorx.com/fab-ops-facility-management.html" ;
        semi:sourceType "web" .

    <urn:pxai:semi:scenario:fab_quality_excursion_capacity_recovery_whatif_repair> a semi:SimulationScenario ;
        rdfs:label "品质异常背景下的光刻产能恢复方向性情景"@zh ;
        semi:description "使用既有通用晶圆厂经营模型，以光刻产能增量代理异常处置后的产能恢复，评估受约束投入量与可销售产出的方向性变化。" ;
        semi:hasOperationalImpactChain <urn:pxai:semi:impactchain:fab_quality_excursion_business_impact_repair> ;
        semi:modelingLimitationText "干预变量和值沿用既有模型与示例，仅用于What-if业务讨论，不表示品质异常必然由光刻设备造成，也不代表现场实测改善或客户承诺。" ;
        semi:nameZh "品质异常背景下的光刻产能恢复方向性情景" ;
        semi:sourceRef "business/models/fab-baseline.yaml",
            "simulation/scenarios/fab-capacity-recovery.yaml" ;
        semi:sourceType "model_prior" .

