        semi:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.defect_scan> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.chamber_clean>,
            <urn:pxai:semi:catalog:fab.action.hold_lot>,
            <urn:pxai:semi:catalog:fab.action.recipe_adjust> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.chamber_polymer_buildup>,
            <urn:pxai:semi:catalog:fab.cause.epd_failure>,
            <urn:pxai:semi:catalog:fab.param.etch_time> ;
        semi:legacyId "kb.fab.etch_residue_triage" ;
        semi:symptomText "接触孔未开通或相邻图形桥连"@zh,
            "缺陷扫描出现应去除区域的材料残留"@zh,
            "蚀刻深度量测值低于目标"@zh .

    <urn:pxai:semi:playbook:kb.fab.film_thickness_dev_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "薄膜膜厚偏移/均匀性超规排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev> ;
        semi:economicImpactText """损失结构与突增类异常一致：检出前已连续加工的片数决定波及面， 所以真正的旋钮是量测抽样频次而不是事后处置速度。膜厚不足不可 回补，过厚仅少数层可靠 CMP 修正，多数情况只能判废。 介电层偏移的代价还有一层延迟——改变的是层间电容与击穿裕度， 要到 WAT/CP 才充分暴露，届时受影响批次已流过多道工序。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A2>,
            <urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A3>,
            <urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A4> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A3>,
            <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A4>,
            <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A5> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.film_thickness_dev_triage%3A1>,
            <urn:pxai:semi:detection:kb.fab.film_thickness_dev_triage%3A2>,
            <urn:pxai:semi:detection:kb.fab.film_thickness_dev_triage%3A3> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:fab.metric.defect_density>,
            <urn:pxai:semi:catalog:fab.metric.film_thickness>,
            <urn:pxai:semi:catalog:fab.metric.sheet_resistance> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.pvd_metal> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.chamber_season>,
            <urn:pxai:semi:catalog:fab.action.hold_lot>,
            <urn:pxai:semi:catalog:fab.action.recipe_adjust>,
            <urn:pxai:semi:catalog:fab.action.replace_consumable> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.chamber_wall_condition>,
            <urn:pxai:semi:catalog:fab.cause.recipe_misload>,
            <urn:pxai:semi:catalog:fab.cause.target_end_of_life>,
            <urn:pxai:semi:catalog:fab.cause.target_erosion_profile>,
            <urn:pxai:semi:catalog:fab.param.chamber_pressure> ;
        semi:legacyId "kb.fab.film_thickness_dev_triage" ;
        semi:symptomText "片内径向剖面形状改变：中心与边缘的高低关系发生翻转"@zh,
            "腔体清洗或长时间待机后的首片明显偏离，随后逐片回稳"@zh,
            "金属层方阻与膜厚同向偏移（膜薄则方阻升高），可作为交叉确认"@zh,
            "随线膜厚量测超出上下规格，或片内均匀性指标超标"@zh .

    <urn:pxai:semi:playbook:kb.fab.implant_dose_drift_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "注入剂量漂移排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.implant_dose_drift> ;
        semi:economicImpactText """检出滞后是主要损失来源。WAT 暴露时批次已完成前段绝大部分工序， 累计加工成本全部沉没。增设中段方阻抽测的成本远低于一次批量失效。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.implant_dose_drift_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.fab.implant_dose_drift_triage%3A2>,
            <urn:pxai:semi:action-instruction:kb.fab.implant_dose_drift_triage%3A3> ;
