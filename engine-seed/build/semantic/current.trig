    <urn:pxai:semi:catalog:fab.action.chamber_clean> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "原位或离线清除腔体累积物，清洗后需跑验证片确认恢复。"@zh ;
        skos:notation "fab.action.chamber_clean" ;
        skos:prefLabel "Chamber Clean / Wet Clean"@en,
            "腔体清洗"@zh ;
        semi:legacyId "fab.action.chamber_clean" .

    <urn:pxai:semi:catalog:fab.action.chamber_season> a semi:Action,
            semi:CatalogConcept ;
        skos:definition """清洗后按制程配方在腔体内壁与零件上沉积一层预处理膜，封住残留 污染物并使腔体热态与沉积环境回到稳态，之后跑验证片确认膜厚与 均匀性恢复再放行量产。是清洗之后的独立步骤，不是清洗的一部分。
"""@zh ;
        skos:notation "fab.action.chamber_season" ;
        skos:prefLabel "Chamber Seasoning"@en,
            "腔体预处理（seasoning）"@zh ;
        semi:legacyId "fab.action.chamber_season" .

    <urn:pxai:semi:catalog:fab.action.clean_chuck> a semi:Action,
            semi:CatalogConcept ;
        skos:definition """停机清洗曝光机晶圆吸盘并复测平面度，消除背面颗粒引起的局部抬升。 与已有的腔体清洗、光罩清洗不同：对象是承片吸盘， 验证方式是平面度与套刻复测，而非颗粒计数或成像质量。
"""@zh ;
        skos:notation "fab.action.clean_chuck" ;
        skos:prefLabel "Clean Exposure Chuck"@en,
            "清洗曝光机吸盘"@zh ;
        semi:legacyId "fab.action.clean_chuck" .

    <urn:pxai:semi:catalog:fab.action.dispatch_field_service> a semi:Action,
            semi:CatalogConcept ;
        skos:definition """开设备工单并按合约响应等级升级催派。适用于原厂锁定模块， 厂内自行处理会失去保修或造成二次损伤的情形。
"""@zh ;
        skos:notation "fab.action.dispatch_field_service" ;
        skos:prefLabel "Dispatch Field Service Engineer"@en,
            "报修并催派原厂工程师"@zh ;
        semi:legacyId "fab.action.dispatch_field_service" .

