@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix semi: <urn:pxai:semi:> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:pxai:semi:graph:catalog> {
    <urn:pxai:semi:catalog:ap.action.adjust_dispense> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "修正点胶量、针头高度或胶体温控，抑制溢胶与空洞。"@zh ;
        skos:notation "ap.action.adjust_dispense" ;
        skos:prefLabel "Adjust Dispense Parameters"@en,
            "调整点胶参数"@zh ;
        semi:legacyId "ap.action.adjust_dispense" .

    <urn:pxai:semi:catalog:ap.action.bake_emc> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "对吸湿塑封料按规范返烤除湿；超过开封期限者直接报废不返烤。"@zh ;
        skos:notation "ap.action.bake_emc" ;
        skos:prefLabel "Bake Mold Compound"@en,
            "塑封料返烤"@zh ;
        semi:legacyId "ap.action.bake_emc" .

    <urn:pxai:semi:catalog:ap.action.bond_param_doe> a semi:Action,
            semi:CatalogConcept ;
        skos:definition """以功率-压力-时间-温度做实验设计重建工艺窗口，适用于线材批号切换 或持续性不粘。须以拉力与剪切数据双指标验证。
"""@zh ;
        skos:notation "ap.action.bond_param_doe" ;
        skos:prefLabel "Bond Parameter DOE"@en,
            "键合参数优化"@zh ;
        semi:legacyId "ap.action.bond_param_doe" .

    <urn:pxai:semi:catalog:ap.action.clean_efo_electrode> a semi:Action,
            semi:CatalogConcept ;
        skos:definition """按打线点数计数清洗或更换 EFO 电极，恢复放电间隙。 与更换瓷嘴不同：瓷嘴管的是焊接界面质量，电极管的是成球稳定性， 两者寿命周期与判废依据都不同，不能互相替代。
"""@zh ;
        skos:notation "ap.action.clean_efo_electrode" ;
        skos:prefLabel "Clean or Replace EFO Electrode"@en,
            "清洗/更换 EFO 电极"@zh ;
        semi:legacyId "ap.action.clean_efo_electrode" .

    <urn:pxai:semi:catalog:ap.action.clean_placement_fixture> a semi:Action,
            semi:CatalogConcept ;
        skos:definition """对植球治具/掩膜孔位做清洁除残渣，或用清洁替代件换上、对换下件排程 深度清洁。换后须跑首件确认缺球消失。与 reball_rework 不同：本动作 作用于治具（生产工具），纠正的是缺球的上游成因；reball_rework 作用于 已缺球的成品，是产品级返工。两者一因一果，处置对象不同。
"""@zh ;
        skos:notation "ap.action.clean_placement_fixture" ;
        skos:prefLabel "Clean or Replace Ball Placement Fixture"@en,
            "清洁/更换植球治具"@zh ;
        semi:legacyId "ap.action.clean_placement_fixture" .

    <urn:pxai:semi:catalog:ap.action.hold_lot> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "冻结受影响批次并圈定同机台同时段关联批次，防止流入不可逆工序。"@zh ;
        skos:notation "ap.action.hold_lot" ;
        skos:prefLabel "Hold Lot"@en,
            "扣留批次"@zh ;
        semi:legacyId "ap.action.hold_lot" .

    <urn:pxai:semi:catalog:ap.action.plasma_clean_rerun> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "对疑似焊垫污染批次补做等离子清洁后重新键合验证。"@zh ;
        skos:notation "ap.action.plasma_clean_rerun" ;
        skos:prefLabel "Additional Plasma Clean"@en,
            "追加等离子清洁"@zh ;
        semi:legacyId "ap.action.plasma_clean_rerun" .

    <urn:pxai:semi:catalog:ap.action.reallocate_fixture> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "跨产品调配测试治具与烧机板，或改派至等价机台缓解堆积。"@zh ;
        skos:notation "ap.action.reallocate_fixture" ;
        skos:prefLabel "Reallocate Fixture or Machine"@en,
            "调配治具/改派机台"@zh ;
        semi:legacyId "ap.action.reallocate_fixture" .

    <urn:pxai:semi:catalog:ap.action.reball_rework> a semi:Action,
            semi:CatalogConcept ;
        skos:definition """对缺球接点补植锡球或整体去球重植，重植后须复量共面性并复检外观。 与更换耗材类动作不同：本动作作用于产品而非设备，因此每次执行都 追加一次热历程，返工次数须受规范限制。连球一般不走本动作—— 桥连处已形成金属连接，去球重植的把握远低于补植缺失接点。
"""@zh ;
        skos:notation "ap.action.reball_rework" ;
        skos:prefLabel "Reball Rework"@en,
            "补植/重植锡球"@zh ;
        semi:legacyId "ap.action.reball_rework" .

    <urn:pxai:semi:catalog:ap.action.replace_blade> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "更换刀片或做修刀恢复切削锋利度，换后首件量测崩边确认。"@zh ;
        skos:notation "ap.action.replace_blade" ;
        skos:prefLabel "Replace or Dress Dicing Blade"@en,
            "更换/修整切割刀"@zh ;
        semi:legacyId "ap.action.replace_blade" .

    <urn:pxai:semi:catalog:ap.action.replace_capillary> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "更换键合瓷嘴并跑首件拉力确认恢复。"@zh ;
        skos:notation "ap.action.replace_capillary" ;
        skos:prefLabel "Replace Capillary"@en,
            "更换瓷嘴"@zh ;
        semi:legacyId "ap.action.replace_capillary" .

    <urn:pxai:semi:catalog:ap.action.replace_probe_card> a semi:Action,
            semi:CatalogConcept ;
        skos:definition """清洗或更换探针卡与测试座，并对疑似伪失效批次重测。 重测前须先确认治具已恢复，否则重测数据无效。
"""@zh ;
        skos:notation "ap.action.replace_probe_card" ;
        skos:prefLabel "Replace or Clean Probe Card"@en,
            "更换/清洗测试治具"@zh ;
        semi:legacyId "ap.action.replace_probe_card" .

    <urn:pxai:semi:catalog:ap.action.retest> a semi:Action,
            semi:CatalogConcept ;
        skos:definition """对失效品重新测试以区分伪失效与真实失效。重测次数须受规范限制， 无限重测等于放宽标准。
"""@zh ;
        skos:notation "ap.action.retest" ;
        skos:prefLabel "Retest"@en,
            "重测"@zh ;
        semi:legacyId "ap.action.retest" .

    <urn:pxai:semi:catalog:ap.anomaly.bonder_down> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """键合设备故障。键合站通常机台数多但单机产能低，个别停机影响有限， 但同型号批量故障或治具短缺会造成该站 WIP 快速堆积。
"""@zh ;
        skos:notation "ap.anomaly.bonder_down" ;
        skos:prefLabel "Wire Bonder Down"@en,
            "键合机停机"@zh ;
        semi:legacyId "ap.anomaly.bonder_down" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:ap.anomaly.delamination> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """塑封料与芯粒、基板或引线框架界面剥离。多源于材料吸湿、界面污染 或热膨胀系数失配。超声扫描(C-SAM)检出，是可靠性失效的前兆。
"""@zh ;
        skos:notation "ap.anomaly.delamination" ;
        skos:prefLabel "Delamination"@en,
            "界面分层"@zh ;
        semi:legacyId "ap.anomaly.delamination" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:ap.anomaly.dicing_chipping> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """崩边尺寸超出 Scribe Line 余量。刀片磨损或崩齿、进给速度过快、 贴膜气泡致支撑不良均可致。崩边同时是裂片的起始源。
"""@zh ;
        skos:notation "ap.anomaly.dicing_chipping" ;
        skos:prefLabel "Dicing Chipping Excursion"@en,
            "切割崩边超规"@zh ;
        semi:legacyId "ap.anomaly.dicing_chipping" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:ap.anomaly.die_crack> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """芯粒机械开裂。起点常在减薄引入的亚表面微裂纹或切割崩边， 经装片压力或热应力扩展。特征是检出工序与成因工序相隔较远， 需回溯多个上游站点。
"""@zh ;
        skos:notation "ap.anomaly.die_crack" ;
        skos:prefLabel "Die Crack"@en,
            "芯粒裂纹"@zh ;
        semi:legacyId "ap.anomaly.die_crack" ;
        semi:severity "critical" .

    <urn:pxai:semi:catalog:ap.anomaly.ft_yield_drop> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """终测良率跌破管制下限。首要判别是区分真实失效与治具接触不良型伪失效： 重测通过率高、失效点位集中于特定 Site 或特定针位指向治具； 失效分布随机且重测不通过则为真实失效，需按 Bin 类型回溯工序。 同时应比对 CP 良率以划分前后段责任。
"""@zh ;
        skos:notation "ap.anomaly.ft_yield_drop" ;
        skos:prefLabel "FT Yield Drop"@en,
            "终测良率下滑"@zh ;
        semi:legacyId "ap.anomaly.ft_yield_drop" ;
        semi:severity "critical" .

    <urn:pxai:semi:catalog:ap.anomaly.missing_ball> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """植球后接点缺失或相邻锡球桥连。助焊剂涂布不均、植球治具孔位堵塞、 回流曲线失当为主因。缺球可补植返工，连球通常判废。
"""@zh ;
        skos:notation "ap.anomaly.missing_ball" ;
        skos:prefLabel "Missing / Bridged Ball"@en,
            "缺球/连球"@zh ;
        semi:legacyId "ap.anomaly.missing_ball" ;
        semi:severity "medium" .

    <urn:pxai:semi:catalog:ap.anomaly.mold_void> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """塑封体内部气泡。成因分三类：塑封料吸湿汽化、转注速度过快卷气、 模具排气不畅。X-Ray 抽检检出，塑封后不可返工。
"""@zh ;
        skos:notation "ap.anomaly.mold_void" ;
        skos:prefLabel "Mold Void"@en,
            "塑封空洞"@zh ;
        semi:legacyId "ap.anomaly.mold_void" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """焊球未能与焊垫形成有效接合。判别路径：若集中于特定机台特定瓷嘴 则指向瓷嘴磨损，若全线同步出现则指向前段焊垫状态或线材批号， 若与装片工序关联则查溢胶污染。是后段最高频的键合类不良。
"""@zh ;
        skos:notation "ap.anomaly.wire_nsop" ;
        skos:prefLabel "NSOP (Non-Stick On Pad)"@en,
            "金线不粘"@zh ;
        semi:legacyId "ap.anomaly.wire_nsop" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:ap.cause.blade_wear> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "切割刀磨耗或局部崩齿，切割负荷上升致崩边加剧。"@zh ;
        skos:notation "ap.cause.blade_wear" ;
        skos:prefLabel "Dicing Blade Wear / Chipping"@en,
            "刀片磨损/崩齿"@zh ;
        semi:legacyId "ap.cause.blade_wear" .

    <urn:pxai:semi:catalog:ap.cause.bond_head_servo_fault> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """键合头 Z 轴定位或超声换能器驱动异常，触发保护停机。 判别依据是报警指向轴系或换能器自检，而非成球与送线环节； 这类停机通常需原厂介入，不属厂内可自行恢复的耗材类停机。
"""@zh ;
        skos:notation "ap.cause.bond_head_servo_fault" ;
        skos:prefLabel "Bond Head Servo & Z-axis Fault"@en,
            "键合头伺服/Z 轴异常"@zh ;
        semi:legacyId "ap.cause.bond_head_servo_fault" .

    <urn:pxai:semi:catalog:ap.cause.bond_param_drift> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "超声换能器效率衰退或加热台温度偏移，致实际键合能量偏离设定。"@zh ;
        skos:notation "ap.cause.bond_param_drift" ;
        skos:prefLabel "Bond Parameter Drift"@en,
            "键合参数漂移"@zh ;
        semi:legacyId "ap.cause.bond_param_drift" .

    <urn:pxai:semi:catalog:ap.cause.capillary_wear> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """键合瓷嘴端面磨损或积屑，改变超声能量传递效率。特征是不良集中于 特定机台特定线位，且随键合次数累积恶化。
"""@zh ;
        skos:notation "ap.cause.capillary_wear" ;
        skos:prefLabel "Capillary Wear"@en,
            "瓷嘴磨损"@zh ;
        semi:legacyId "ap.cause.capillary_wear" .

    <urn:pxai:semi:catalog:ap.cause.efo_electrode_fouling> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """打火烧球(EFO)电极积附金属氧化物并随放电次数磨损，放电间隙漂移后 无法稳定成球，触发烧球失败报警并停机。特征是报警集中在成球阶段 而非焊接阶段，且随打线点数累积逐渐加重，清洗或更换电极后立即恢复。
"""@zh ;
        skos:notation "ap.cause.efo_electrode_fouling" ;
        skos:prefLabel "EFO Electrode Fouling & Wear"@en,
            "EFO 电极污染/磨损"@zh ;
        semi:legacyId "ap.cause.efo_electrode_fouling" .

    <urn:pxai:semi:catalog:ap.cause.emc_moisture> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """塑封料开封后吸湿或超期使用，模压时水分汽化形成空洞与分层。 是典型的材料状态型根因，与设备无关。
"""@zh ;
        skos:notation "ap.cause.emc_moisture" ;
        skos:prefLabel "Mold Compound Moisture"@en,
            "塑封料吸湿"@zh ;
        semi:legacyId "ap.cause.emc_moisture" .

    <urn:pxai:semi:catalog:ap.cause.epoxy_bleed> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "点胶量过多或胶体黏度偏低致胶体溢出至焊垫区，直接造成键合不粘。"@zh ;
        skos:notation "ap.cause.epoxy_bleed" ;
        skos:prefLabel "Epoxy Bleed Out"@en,
            "装片胶溢流"@zh ;
        semi:legacyId "ap.cause.epoxy_bleed" .

    <urn:pxai:semi:catalog:ap.cause.fixture_shortage> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """测试治具、烧机板或载具数量不足，机台可用但无法开工。 是后段 WIP 堆积中容易被忽略的非设备型成因。
"""@zh ;
        skos:notation "ap.cause.fixture_shortage" ;
        skos:prefLabel "Fixture & Carrier Shortage"@en,
            "治具/载具短缺"@zh ;
        semi:legacyId "ap.cause.fixture_shortage" .

    <urn:pxai:semi:catalog:ap.cause.flux_print_defect> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """植球前助焊剂印刷量不足、未填满或渗出。荒川化学的技术资料把黏度列为 影响印刷性的主要物性：黏度过低易渗出并在焊接时桥连，黏度过高则难以 填满印刷区域而出现缺失与未填满。印刷条件（刮刀材质与角度、印压、 印速、金属掩膜形状、基板与掩膜间隙及分离速度）需针对基板与助焊剂 成对优化。另一条独立机理是黏性不足致锡球固定不住而移位。 判别要点：缺球与连球同批共存、且分布跟印刷版面走（而非跟炉内温区走） 时指向本成因——这是与回流曲线漂移最快的区分方式。
"""@zh ;
        skos:notation "ap.cause.flux_print_defect" ;
        skos:prefLabel "Flux Print Defect"@en,
            "助焊剂印刷不良"@zh ;
        semi:legacyId "ap.cause.flux_print_defect" .

    <urn:pxai:semi:catalog:ap.cause.grind_wheel_clog> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "砂轮磨屑堵塞降低切削效率，实际压力上升引入亚表面微裂纹。"@zh ;
        skos:notation "ap.cause.grind_wheel_clog" ;
        skos:prefLabel "Grind Wheel Clogging"@en,
            "砂轮堵塞"@zh ;
        semi:legacyId "ap.cause.grind_wheel_clog" .

    <urn:pxai:semi:catalog:ap.cause.pad_contamination> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """焊垫表面有机残留、氧化或溢胶覆盖，阻碍金属间化合物形成。 来源可能在前段（钝化层残留）或后段（装片溢胶）。
"""@zh ;
        skos:notation "ap.cause.pad_contamination" ;
        skos:prefLabel "Bond Pad Contamination"@en,
            "焊垫污染"@zh ;
        semi:legacyId "ap.cause.pad_contamination" .

    <urn:pxai:semi:catalog:ap.cause.placement_fixture_clog> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """植球治具/掩膜孔位被助焊剂残渣、错位或卡滞的锡球、或治具内壁积累物 堵塞，导致锡球无法落位而出现缺球。判别要点：缺球位置与治具孔位呈 固定一一对应（同一孔位反复缺、且批次间位置不漂移），而非跟印刷版面 或炉内温区走。堵塞通常随使用次数累积渐进恶化，清洁或更换治具后 立即恢复。与助焊剂印刷不良的关键区分：前者是*涂布环节*涂得对不对， 本成因是*植球环节*孔位通不通——两者都作用于植球前，但失效部位与 处置手段不同，不能合并。
"""@zh ;
        skos:notation "ap.cause.placement_fixture_clog" ;
        skos:prefLabel "Ball Placement Fixture Aperture Clogging"@en,
            "植球治具孔位堵塞"@zh ;
        semi:legacyId "ap.cause.placement_fixture_clog" .

    <urn:pxai:semi:catalog:ap.cause.probe_card_wear> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """探针或测试座接触面磨损氧化致接触电阻上升，产生伪失效。 特征为重测通过率高且失效集中于特定 Site。
"""@zh ;
        skos:notation "ap.cause.probe_card_wear" ;
        skos:prefLabel "Probe Card / Socket Wear"@en,
            "测试治具磨损"@zh ;
        semi:legacyId "ap.cause.probe_card_wear" .

    <urn:pxai:semi:catalog:ap.cause.reflow_profile_drift> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "回流炉温区衰退或链速偏移致实际受热曲线偏离设定。"@zh ;
        skos:notation "ap.cause.reflow_profile_drift" ;
        skos:prefLabel "Reflow Profile Drift"@en,
            "回流曲线漂移"@zh ;
        semi:legacyId "ap.cause.reflow_profile_drift" .

    <urn:pxai:semi:catalog:ap.cause.wire_feed_jam> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """线材在线轴、张力器或夹爪处缠绕、打结或断裂，导致送线中断而停机。 与瓷嘴磨损的区别在于：卡线是突发的送线通路故障，穿线复位后即恢复； 瓷嘴磨损是渐进的键合质量劣化，不必然停机。
"""@zh ;
        skos:notation "ap.cause.wire_feed_jam" ;
        skos:prefLabel "Wire Feed Jam & Wire Break"@en,
            "送线卡线/断线"@zh ;
        semi:legacyId "ap.cause.wire_feed_jam" .

    <urn:pxai:semi:catalog:ap.equip.aoi> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """影像比对检测外观缺陷。判定门槛决定误杀(Overkill)与 漏检(Escape)的平衡，门槛设定本身是经营决策： 误杀损失内部良品，漏检损失客户信任。
"""@zh ;
        skos:notation "ap.equip.aoi" ;
        skos:prefLabel "AOI System"@en,
            "自动光学检测机"@zh ;
        semi:legacyId "ap.equip.aoi" .

    <urn:pxai:semi:catalog:ap.equip.ball_mounter> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """锡球植入并回流形成 BGA 外部端子。缺球、连球、共面度超规 是主要缺陷。共面度不良在客户端 SMT 才暴露，属于 高逃逸风险项。
"""@zh ;
        skos:notation "ap.equip.ball_mounter" ;
        skos:prefLabel "Ball Mounter"@en,
            "植球机"@zh ;
        semi:legacyId "ap.equip.ball_mounter" .

    <urn:pxai:semi:catalog:ap.equip.bumping_line> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """电镀或植球形成晶圆级凸块，含光刻、电镀、回流多步。 本质是前段式产线放在后段厂，工艺复杂度与设备投资远高于 传统后段单元设备，产能规划需按线而非按机台。
"""@zh ;
        skos:notation "ap.equip.bumping_line" ;
        skos:prefLabel "Bumping Line"@en,
            "凸块制造线"@zh ;
        semi:legacyId "ap.equip.bumping_line" .

    <urn:pxai:semi:catalog:ap.equip.burn_in_oven> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """高温加电应力筛选早期失效。按小时计的固定时长无法压缩， 是周期时间的刚性组成。老化板(Burn-in Board)专用且数量有限， 板数常比炉子容量更早成为约束。
"""@zh ;
        skos:notation "ap.equip.burn_in_oven" ;
        skos:prefLabel "Burn-in Oven"@en,
            "老化炉"@zh ;
        semi:legacyId "ap.equip.burn_in_oven" .

    <urn:pxai:semi:catalog:ap.equip.cure_oven> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """批式烘烤固化黏晶胶或底填胶。温度曲线(Ramp/Soak)决定固化度， 固化不足在后续高温步骤才显现为分层。批式加长周期使其 成为在制品排队点，且异常回溯困难 —— 一炉多批同时受影响。
"""@zh ;
        skos:notation "ap.equip.cure_oven" ;
        skos:prefLabel "Cure Oven"@en,
            "固化炉"@zh ;
        semi:legacyId "ap.equip.cure_oven" .

    <urn:pxai:semi:catalog:ap.equip.dicing_saw> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """刀片切割分离晶粒。刀片磨耗与冷却水状态决定崩边(Chipping)大小， 切割道宽度直接影响每片可得晶粒数。切割速度与崩边质量成反比， 是良率与产能的直接权衡。
"""@zh ;
        skos:notation "ap.equip.dicing_saw" ;
        skos:prefLabel "Dicing Saw"@en,
            "晶圆切割机"@zh ;
        semi:legacyId "ap.equip.dicing_saw" .

    <urn:pxai:semi:catalog:ap.equip.die_bonder> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """取放晶粒到基板并点胶固定。UPH(每小时产出)按颗计， 是后段最直接的产能计量单位。取放精度决定后续打线可行性， 换封装型体需更换治具与吸嘴，换型时间进入有效产能损失。
"""@zh ;
        skos:notation "ap.equip.die_bonder" ;
        skos:prefLabel "Die Bonder"@en,
            "黏晶机"@zh ;
        semi:legacyId "ap.equip.die_bonder" .

    <urn:pxai:semi:catalog:ap.equip.fc_bonder> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """晶粒翻转对位后热压接合凸块。对位精度要求高于黏晶机一个量级， 热压曲线决定凸块塌陷量与接合强度。设备单价与换型成本均高， 通常按产品族专机专用。
"""@zh ;
        skos:notation "ap.equip.fc_bonder" ;
        skos:prefLabel "Flip Chip Bonder"@en,
            "覆晶接合机"@zh ;
        semi:legacyId "ap.equip.fc_bonder" .

    <urn:pxai:semi:catalog:ap.equip.final_tester> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """测试机配分选机做成品电性与温度条件测试。测试时间乘以 测试项数决定机时消耗，多站并测(Multi-site)是主要产能杠杆。 测试程式版本管理是误判的常见根源。
"""@zh ;
        skos:notation "ap.equip.final_tester" ;
        skos:prefLabel "Final Tester + Handler"@en,
            "成品测试机"@zh ;
        semi:legacyId "ap.equip.final_tester" .

    <urn:pxai:semi:catalog:ap.equip.grinder> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """粗磨加精磨减薄晶圆背面。砂轮磨耗改变去除速率与表面粗糙度， 背面微裂纹是后续 die crack 的潜伏源。减薄越薄翘曲越大， 薄片处理能力是封装型体的准入条件。
"""@zh ;
        skos:notation "ap.equip.grinder" ;
        skos:prefLabel "Backgrinder"@en,
            "晶圆研磨机"@zh ;
        semi:legacyId "ap.equip.grinder" .

    <urn:pxai:semi:catalog:ap.equip.laser_marker> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """激光刻蚀封装表面标识。打标内容错误属于可追溯性事故 —— 产品本身良好但标识错误需全数重工或报废， 是"非工艺性"损失的典型来源。
"""@zh ;
        skos:notation "ap.equip.laser_marker" ;
        skos:prefLabel "Laser Marker"@en,
            "激光打标机"@zh ;
        semi:legacyId "ap.equip.laser_marker" .

    <urn:pxai:semi:catalog:ap.equip.mold_press> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """转移成型将塑封料压入模腔包封。模具按封装型体专用， 换模是主要换型损失。模具磨耗导致溢料(Flash)与填充不全， 模具寿命管理是后段最重要的资产管理项之一。
"""@zh ;
        skos:notation "ap.equip.mold_press" ;
        skos:prefLabel "Molding Press"@en,
            "塑封成型机"@zh ;
        semi:legacyId "ap.equip.mold_press" .

    <urn:pxai:semi:catalog:ap.equip.plasma_cleaner> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """等离子活化表面并去除有机污染，提升后续接合与塑封附着力。 是"预防性"设备 —— 其效果只在下游失效率上体现， 因此容易被当作可省略步骤，省略的代价延后暴露。
"""@zh ;
        skos:notation "ap.equip.plasma_cleaner" ;
        skos:prefLabel "Plasma Cleaner"@en,
            "等离子清洗机"@zh ;
        semi:legacyId "ap.equip.plasma_cleaner" .

    <urn:pxai:semi:catalog:ap.equip.pmc_oven> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """长时间(数小时)高温完成塑封料交联。周期长且批量大， 是后段最长的单工序周期。固化度不足直接对应分层与 可靠性失效，且此时价值已接近成品，损失最大。
"""@zh ;
        skos:notation "ap.equip.pmc_oven" ;
        skos:prefLabel "Post Mold Cure Oven"@en,
            "后固化炉"@zh ;
        semi:legacyId "ap.equip.pmc_oven" .

    <urn:pxai:semi:catalog:ap.equip.singulation_saw> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """切割成型后的连片(Strip)为单颗封装体。切割毛边与分层是 主要缺陷，此时单位价值已含全部前后段成本， 崩损的经济损失是切割晶圆阶段的数倍。
"""@zh ;
        skos:notation "ap.equip.singulation_saw" ;
        skos:prefLabel "Singulation Saw"@en,
            "封装切单机"@zh ;
        semi:legacyId "ap.equip.singulation_saw" .

    <urn:pxai:semi:catalog:ap.equip.tape_mounter> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """将晶圆贴到切割胶带与钢圈上。贴膜气泡导致切割时晶粒位移， 胶带黏性过强则顶出困难。胶带型号与减薄厚度需匹配， 属于低成本但影响下游多道工序的前置动作。
"""@zh ;
        skos:notation "ap.equip.tape_mounter" ;
        skos:prefLabel "Wafer Mounter"@en,
            "贴膜机"@zh ;
        semi:legacyId "ap.equip.tape_mounter" .

    <urn:pxai:semi:catalog:ap.equip.taping_machine> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """装入卷带或托盘并做防潮包装。干燥包装(Dry Pack)执行不到位 直接违背 MSL 楼面寿命要求，使前面所有防潮控制失效。 是流程最后一道，也是最容易被视为纯物流而放松管控的一道。
"""@zh ;
        skos:notation "ap.equip.taping_machine" ;
        skos:prefLabel "Taping / Packing Machine"@en,
            "编带包装机"@zh ;
        semi:legacyId "ap.equip.taping_machine" .

    <urn:pxai:semi:catalog:ap.equip.underfill_dispenser> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """毛细流动填充晶粒与基板间隙。流动时间随间隙缩小而变长， 是覆晶路径的周期时间瓶颈之一。填充不完全形成空洞， 空洞在温度循环下成为裂纹起点。
"""@zh ;
        skos:notation "ap.equip.underfill_dispenser" ;
        skos:prefLabel "Underfill Dispenser"@en,
            "底填胶点胶机"@zh ;
        semi:legacyId "ap.equip.underfill_dispenser" .

    <urn:pxai:semi:catalog:ap.equip.wire_bonder> a semi:CatalogConcept,
            semi:EquipmentType ;
        skos:definition """超声波加热压焊形成金属线连接。按线数计时，引脚数越多单颗越慢， 因此产能与产品引脚数强相关。金线是直接材料成本主项， 线弧形状与线长同时影响成本与电性。
"""@zh ;
        skos:notation "ap.equip.wire_bonder" ;
        skos:prefLabel "Wire Bonder"@en,
            "打线机"@zh ;
        semi:legacyId "ap.equip.wire_bonder" .

    <urn:pxai:semi:catalog:ap.material.bonding_wire> a semi:CatalogConcept,
            semi:MaterialType ;
        skos:definition """金线、铜线或银合金线。铜线成本低但硬度高需更精细的工艺窗口， 线材批号切换是键合参数需重新验证的触发点。
"""@zh ;
        skos:notation "ap.material.bonding_wire" ;
        skos:prefLabel "Bonding Wire"@en,
            "键合线"@zh ;
        semi:legacyId "ap.material.bonding_wire" .

    <urn:pxai:semi:catalog:ap.material.dicing_tape> a semi:CatalogConcept,
            semi:MaterialType ;
        skos:definition "固定晶圆的黏性膜，黏着力须兼顾切割固定与取片剥离两个矛盾需求。"@zh ;
        skos:notation "ap.material.dicing_tape" ;
        skos:prefLabel "Dicing Tape"@en,
            "切割膜"@zh ;
        semi:legacyId "ap.material.dicing_tape" .

    <urn:pxai:semi:catalog:ap.material.die_attach_epoxy> a semi:CatalogConcept,
            semi:MaterialType ;
        skos:definition "银胶或膜状黏着材料，黏度随温度与放置时间变化，需控制上机时效。"@zh ;
        skos:notation "ap.material.die_attach_epoxy" ;
        skos:prefLabel "Die Attach Epoxy"@en,
            "装片胶"@zh ;
        semi:legacyId "ap.material.die_attach_epoxy" .

    <urn:pxai:semi:catalog:ap.material.mold_compound> a semi:CatalogConcept,
            semi:MaterialType ;
        skos:definition """环氧模塑料，具吸湿性，开封后有使用期限并须低温防潮储存。 吸湿后模压会汽化产生空洞与分层，是典型的材料状态型风险。
"""@zh ;
        skos:notation "ap.material.mold_compound" ;
        skos:prefLabel "Mold Compound (EMC)"@en,
            "塑封料"@zh ;
        semi:legacyId "ap.material.mold_compound" .

    <urn:pxai:semi:catalog:ap.metric.ball_shear_strength> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition "侧向剪切焊球评估球焊接合面积与金属间化合物形成质量。"@zh ;
        skos:notation "ap.metric.ball_shear_strength" ;
        skos:prefLabel "Ball Shear Strength"@en,
            "球剪切强度"@zh ;
        semi:legacyId "ap.metric.ball_shear_strength" ;
        semi:unitCode "gf" .

    <urn:pxai:semi:catalog:ap.metric.chipping_size> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition "切割边缘破损的最大尺寸。超过 Scribe Line 余量即侵入有效电路区。"@zh ;
        skos:notation "ap.metric.chipping_size" ;
        skos:prefLabel "Chipping Size"@en,
            "崩边尺寸"@zh ;
        semi:legacyId "ap.metric.chipping_size" ;
        semi:unitCode "μm" .

    <urn:pxai:semi:catalog:ap.metric.coplanarity> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition "外部接点（锡球或引脚）高度的最大落差，决定客户端 SMT 贴装可靠性。"@zh ;
        skos:notation "ap.metric.coplanarity" ;
        skos:prefLabel "Coplanarity"@en,
            "共面性"@zh ;
        semi:legacyId "ap.metric.coplanarity" ;
        semi:unitCode "μm" .

    <urn:pxai:semi:catalog:ap.metric.die_shear_strength> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition "评估装片胶附着力与固化充分度。"@zh ;
        skos:notation "ap.metric.die_shear_strength" ;
        skos:prefLabel "Die Shear Strength"@en,
            "芯粒剪切强度"@zh ;
        semi:legacyId "ap.metric.die_shear_strength" ;
        semi:unitCode "kgf" .

    <urn:pxai:semi:catalog:ap.metric.ft_yield> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition """终测通过比例。需与 CP 良率联动分析：若 FT 良率下滑而 CP 正常， 成因在后段；若同步下滑，回溯前段。治具磨损会造成接触不良型伪失效， 需与真实功能失效区分。
"""@zh ;
        skos:notation "ap.metric.ft_yield" ;
        skos:prefLabel "Final Test Yield"@en,
            "终测良率"@zh ;
        semi:legacyId "ap.metric.ft_yield" ;
        semi:unitCode "%" .

    <urn:pxai:semi:catalog:ap.metric.void_ratio> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition """X-Ray 或超声扫描量测的空洞占比。影响散热路径与热循环可靠性， 是塑封、装片、底填三个工序共用的判定指标。
"""@zh ;
        skos:notation "ap.metric.void_ratio" ;
        skos:prefLabel "Void Ratio"@en,
            "空洞率"@zh ;
        semi:legacyId "ap.metric.void_ratio" ;
        semi:unitCode "%" .

    <urn:pxai:semi:catalog:ap.metric.wafer_thickness_var> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition "减薄后总厚度变异。变异过大致切割深度不一与后续贴装应力不均。"@zh ;
        skos:notation "ap.metric.wafer_thickness_var" ;
        skos:prefLabel "Wafer Thickness Variation (TTV)"@en,
            "晶圆厚度变异"@zh ;
        semi:legacyId "ap.metric.wafer_thickness_var" ;
        semi:unitCode "μm" .

    <urn:pxai:semi:catalog:ap.metric.wire_pull_strength> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition """破坏性拉力测试值，评估键合强度。失效模式(线断/球脱/焊垫剥离) 比数值本身更能指示根因。
"""@zh ;
        skos:notation "ap.metric.wire_pull_strength" ;
        skos:prefLabel "Wire Pull Strength"@en,
            "金线拉力"@zh ;
        semi:legacyId "ap.metric.wire_pull_strength" ;
        semi:unitCode "gf" .

    <urn:pxai:semi:catalog:ap.param.blade_rpm> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "刀轮转速，与进给速度共同决定切割负荷与崩边程度。"@zh ;
        skos:notation "ap.param.blade_rpm" ;
        skos:prefLabel "Dicing Blade RPM"@en,
            "切割刀转速"@zh ;
        semi:legacyId "ap.param.blade_rpm" ;
        semi:unitCode "rpm" .

    <urn:pxai:semi:catalog:ap.param.bond_force> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "瓷嘴压向焊垫的力，与超声功率交互决定焊球形变量。"@zh ;
        skos:notation "ap.param.bond_force" ;
        skos:prefLabel "Bond Force"@en,
            "键合压力"@zh ;
        semi:legacyId "ap.param.bond_force" ;
        semi:unitCode "gf" .

    <urn:pxai:semi:catalog:ap.param.bond_power> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition """超声能量，破除氧化层形成金属间化合物。功率不足致不粘， 过高致焊垫下方硅裂(Cratering)。
"""@zh ;
        skos:notation "ap.param.bond_power" ;
        skos:prefLabel "Bond Ultrasonic Power"@en,
            "键合超声功率"@zh ;
        semi:legacyId "ap.param.bond_power" ;
        semi:unitCode "mW" .

    <urn:pxai:semi:catalog:ap.param.bond_stage_temp> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "加热台温度，提升金属塑性以助键合。温度不足显著抬升不粘率。"@zh ;
        skos:notation "ap.param.bond_stage_temp" ;
        skos:prefLabel "Bond Stage Temperature"@en,
            "键合台温度"@zh ;
        semi:legacyId "ap.param.bond_stage_temp" ;
        semi:unitCode "℃" .

    <urn:pxai:semi:catalog:ap.param.bond_time> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "单点键合作用时长。延长可补偿功率不足，但压低 UPH。"@zh ;
        skos:notation "ap.param.bond_time" ;
        skos:prefLabel "Bond Time"@en,
            "键合时间"@zh ;
        semi:legacyId "ap.param.bond_time" ;
        semi:unitCode "ms" .

    <urn:pxai:semi:catalog:ap.param.burn_in_temp> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "加速老化温度，依 Arrhenius 模型折算等效使用时长。"@zh ;
        skos:notation "ap.param.burn_in_temp" ;
        skos:prefLabel "Burn-in Temperature"@en,
            "烧机温度"@zh ;
        semi:legacyId "ap.param.burn_in_temp" ;
        semi:unitCode "℃" .

    <urn:pxai:semi:catalog:ap.param.cure_temp> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "胶体或塑封料固化烘烤温度，与时间共同决定交联度。"@zh ;
        skos:notation "ap.param.cure_temp" ;
        skos:prefLabel "Cure Temperature"@en,
            "固化温度"@zh ;
        semi:legacyId "ap.param.cure_temp" ;
        semi:unitCode "℃" .

    <urn:pxai:semi:catalog:ap.param.cut_feed_speed> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "切割行进速度。过快增大崩边，过慢降低产出且加剧刀片发热。"@zh ;
        skos:notation "ap.param.cut_feed_speed" ;
        skos:prefLabel "Cutting Feed Speed"@en,
            "切割进给速度"@zh ;
        semi:legacyId "ap.param.cut_feed_speed" ;
        semi:unitCode "mm/s" .

    <urn:pxai:semi:catalog:ap.param.die_bond_force> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "芯粒压向基板的力。过大压裂薄芯粒，过小附着不良。"@zh ;
        skos:notation "ap.param.die_bond_force" ;
        skos:prefLabel "Die Bond Force"@en,
            "装片压力"@zh ;
        semi:legacyId "ap.param.die_bond_force" ;
        semi:unitCode "gf" .

    <urn:pxai:semi:catalog:ap.param.epoxy_dispense_volume> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition """单颗装片胶量。过多溢胶污染焊垫致键合不粘，过少空洞率上升。 针头堵塞与胶体黏度随温度变化是主要波动源。
"""@zh ;
        skos:notation "ap.param.epoxy_dispense_volume" ;
        skos:prefLabel "Epoxy Dispense Volume"@en,
            "点胶量"@zh ;
        semi:legacyId "ap.param.epoxy_dispense_volume" ;
        semi:unitCode "mg" .

    <urn:pxai:semi:catalog:ap.param.grind_feed_rate> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "砂轮下压速率。过快引入亚表面微裂纹，是延迟型裂片的隐性来源。"@zh ;
        skos:notation "ap.param.grind_feed_rate" ;
        skos:prefLabel "Grind Feed Rate"@en,
            "研磨进给速率"@zh ;
        semi:legacyId "ap.param.grind_feed_rate" ;
        semi:unitCode "μm/s" .

    <urn:pxai:semi:catalog:ap.param.mold_pressure> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "转注压力，压实塑封料排出气体。不足致空洞，过高致冲丝。"@zh ;
        skos:notation "ap.param.mold_pressure" ;
        skos:prefLabel "Mold Pressure"@en,
            "塑封压力"@zh ;
        semi:legacyId "ap.param.mold_pressure" ;
        semi:unitCode "kgf/cm²" .

    <urn:pxai:semi:catalog:ap.param.mold_temp> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "模具加热温度，决定塑封料熔融黏度与固化速率。"@zh ;
        skos:notation "ap.param.mold_temp" ;
        skos:prefLabel "Mold Temperature"@en,
            "模具温度"@zh ;
        semi:legacyId "ap.param.mold_temp" ;
        semi:unitCode "℃" .

    <urn:pxai:semi:catalog:ap.param.reflow_peak_temp> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition """回流焊峰值温度，须高于锡膏熔点且低于封装体耐温上限。 配合升温速率构成回流曲线，曲线失当致连球或虚焊。
"""@zh ;
        skos:notation "ap.param.reflow_peak_temp" ;
        skos:prefLabel "Reflow Peak Temperature"@en,
            "回流峰值温度"@zh ;
        semi:legacyId "ap.param.reflow_peak_temp" ;
        semi:unitCode "℃" .

    <urn:pxai:semi:catalog:ap.param.test_time> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition """单颗测试历时。与并测数共同决定测试机 UPH，是后段单位成本的 最大可控变量。缩测需以覆盖率验证为前提。
"""@zh ;
        skos:notation "ap.param.test_time" ;
        skos:prefLabel "Test Time"@en,
            "测试时间"@zh ;
        semi:legacyId "ap.param.test_time" ;
        semi:unitCode "s/unit" .

    <urn:pxai:semi:catalog:ap.param.transfer_speed> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition "塑封料推进速度。过快卷入气体形成空洞并冲击金线。"@zh ;
        skos:notation "ap.param.transfer_speed" ;
        skos:prefLabel "Transfer Speed"@en,
            "转注速度"@zh ;
        semi:legacyId "ap.param.transfer_speed" ;
        semi:unitCode "mm/s" .

    <urn:pxai:semi:catalog:ap.process.aoi> a semi:CatalogConcept,
            semi:Process ;
        skos:definition "光学检查封装外观、打标与引脚形态，拦截机械类不良出货。"@zh ;
        skos:notation "ap.process.aoi" ;
        skos:prefLabel "AOI (Automated Optical Inspection)"@en,
            "自动外观检验"@zh ;
        semi:legacyId "ap.process.aoi" .

    <urn:pxai:semi:catalog:ap.process.backgrind> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """磨除晶圆背面材料至目标厚度。厚度越薄机械强度越低，进给速率过快或 砂轮堵塞会引入微裂纹，成为后续裂片的隐性起点。
"""@zh ;
        skos:notation "ap.process.backgrind" ;
        skos:prefLabel "Backgrinding"@en,
            "背面研磨"@zh ;
        semi:legacyId "ap.process.backgrind" .

    <urn:pxai:semi:catalog:ap.process.ball_mount> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """BGA 类封装植锡球并回流形成外部接点。助焊剂涂布量与回流曲线 决定连球、缺球与共面性。
"""@zh ;
        skos:notation "ap.process.ball_mount" ;
        skos:prefLabel "Ball Mount"@en,
            "植球"@zh ;
        semi:legacyId "ap.process.ball_mount" .

    <urn:pxai:semi:catalog:ap.process.bumping> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """晶圆级形成锡球或铜柱凸块，供倒装使用。含溅镀 UBM、电镀与回流。 凸块高度共面性决定后续倒装接合可靠性。
"""@zh ;
        skos:notation "ap.process.bumping" ;
        skos:prefLabel "Bumping"@en,
            "凸块制作"@zh ;
        semi:legacyId "ap.process.bumping" .

    <urn:pxai:semi:catalog:ap.process.burn_in> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """高温加偏压加速筛除早期失效(Infant Mortality)。车规与工规产品必需， 历时数小时至数十小时，是后段 CT 的最大单项。
"""@zh ;
        skos:notation "ap.process.burn_in" ;
        skos:prefLabel "Burn-in"@en,
            "烧机"@zh ;
        semi:legacyId "ap.process.burn_in" .

    <urn:pxai:semi:catalog:ap.process.dicing> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """刀轮或激光沿 Scribe Line 切割分离芯粒。刀片磨损、转速与进给速度失配 产生崩边(Chipping)，崩边尺寸超规会延伸至有效电路区。
"""@zh ;
        skos:notation "ap.process.dicing" ;
        skos:prefLabel "Wafer Dicing"@en,
            "晶圆切割"@zh ;
        semi:legacyId "ap.process.dicing" .

    <urn:pxai:semi:catalog:ap.process.die_attach> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """取片并以银胶或膜状胶贴装到基板/引线框架。胶量过多溢出污染键合区(Epoxy Bleed)， 过少则空洞率上升影响散热与附着力。
"""@zh ;
        skos:notation "ap.process.die_attach" ;
        skos:prefLabel "Die Attach"@en,
            "装片"@zh ;
        semi:legacyId "ap.process.die_attach" .

    <urn:pxai:semi:catalog:ap.process.epoxy_cure> a semi:CatalogConcept,
            semi:Process ;
        skos:definition "烘烤固化装片胶达到目标附着强度。固化不足致后续键合时芯粒位移。"@zh ;
        skos:notation "ap.process.epoxy_cure" ;
        skos:prefLabel "Epoxy Cure"@en,
            "胶体固化"@zh ;
        semi:legacyId "ap.process.epoxy_cure" .

    <urn:pxai:semi:catalog:ap.process.final_test> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """在测试机与治具上逐颗测功能、时序与直流参数，按 Bin 分级。 测试时间与并测数(Parallelism)决定单位测试成本，治具磨损会造成 接触不良型伪失效。
"""@zh ;
        skos:notation "ap.process.final_test" ;
        skos:prefLabel "Final Test (FT)"@en,
            "成品终测"@zh ;
        semi:legacyId "ap.process.final_test" .

    <urn:pxai:semi:catalog:ap.process.flip_chip_bond> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """芯粒翻转使凸块直接对位接合基板，经回流形成连接。对位精度与 凸块共面性要求高，适用高脚数高频产品。
"""@zh ;
        skos:notation "ap.process.flip_chip_bond" ;
        skos:prefLabel "Flip Chip Bonding"@en,
            "倒装接合"@zh ;
        semi:legacyId "ap.process.flip_chip_bond" .

    <urn:pxai:semi:catalog:ap.process.laser_mark> a semi:CatalogConcept,
            semi:Process ;
        skos:definition "在封装表面打印型号、批号与追溯码。打标深度过深损伤塑封体。"@zh ;
        skos:notation "ap.process.laser_mark" ;
        skos:prefLabel "Laser Marking"@en,
            "激光打标"@zh ;
        semi:legacyId "ap.process.laser_mark" .

    <urn:pxai:semi:catalog:ap.process.molding> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """加热熔融塑封料经转注压入模腔包覆结构。模温、压力与转注速度决定 流动前沿形态，失衡产生空洞、冲丝或包封不全。塑封后缺陷基本不可返工。
"""@zh ;
        skos:notation "ap.process.molding" ;
        skos:prefLabel "Molding"@en,
            "压模成型"@zh ;
        semi:legacyId "ap.process.molding" .

    <urn:pxai:semi:catalog:ap.process.packing> a semi:CatalogConcept,
            semi:Process ;
        skos:definition "依客户要求以卷带/管装/托盘包装并做防潮处理，完成交付。"@zh ;
        skos:notation "ap.process.packing" ;
        skos:prefLabel "Packing & Shipping"@en,
            "包装出货"@zh ;
        semi:legacyId "ap.process.packing" .

    <urn:pxai:semi:catalog:ap.process.plasma_clean> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """键合前去除焊垫表面有机污染与氧化层，提升可焊性。是抑制 金线不粘(NSOP)最有效的前置手段。
"""@zh ;
        skos:notation "ap.process.plasma_clean" ;
        skos:prefLabel "Plasma Clean"@en,
            "等离子清洁"@zh ;
        semi:legacyId "ap.process.plasma_clean" .

    <urn:pxai:semi:catalog:ap.process.pmc> a semi:CatalogConcept,
            semi:Process ;
        skos:definition "长时间烘烤使塑封料完全交联达到最终机械与热性能。"@zh ;
        skos:notation "ap.process.pmc" ;
        skos:prefLabel "PMC (Post Mold Cure)"@en,
            "后固化"@zh ;
        semi:legacyId "ap.process.pmc" .

    <urn:pxai:semi:catalog:ap.process.singulation> a semi:CatalogConcept,
            semi:Process ;
        skos:definition "切除连接筋分离成单颗成品，引脚成型至规格角度与共面度。"@zh ;
        skos:notation "ap.process.singulation" ;
        skos:prefLabel "Singulation / Trim & Form"@en,
            "切筋分离"@zh ;
        semi:legacyId "ap.process.singulation" .

    <urn:pxai:semi:catalog:ap.process.underfill> a semi:CatalogConcept,
            semi:Process ;
        skos:definition "填充芯粒与基板间隙缓解热膨胀失配应力，填充不完全形成空洞。"@zh ;
        skos:notation "ap.process.underfill" ;
        skos:prefLabel "Underfill"@en,
            "底部填充"@zh ;
        semi:legacyId "ap.process.underfill" .

    <urn:pxai:semi:catalog:ap.process.wafer_mount> a semi:CatalogConcept,
            semi:Process ;
        skos:definition "将晶圆贴于蓝膜与钢环上固定，供切割与取片。贴膜气泡致切割崩边。"@zh ;
        skos:notation "ap.process.wafer_mount" ;
        skos:prefLabel "Wafer Mounting"@en,
            "贴膜"@zh ;
        semi:legacyId "ap.process.wafer_mount" .

    <urn:pxai:semi:catalog:ap.process.wafer_receive> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """接收前段晶圆并核对 Wafer Map 与 CP 良率分级。投料量依 CP 良率折算， 是后段产能规划的输入起点。
"""@zh ;
        skos:notation "ap.process.wafer_receive" ;
        skos:prefLabel "Wafer Receiving"@en,
            "收片"@zh ;
        semi:legacyId "ap.process.wafer_receive" .

    <urn:pxai:semi:catalog:ap.process.wire_bond> a semi:CatalogConcept,
            semi:Process ;
        skos:definition """以热压超声在焊垫与引脚间形成球焊与楔焊连接。键合功率、压力、时间与 温度四参数构成工艺窗口，焊垫状态与瓷嘴磨损是稳定性主因。 多为后段站点数最多、WIP 最易堆积的工序。
"""@zh ;
        skos:notation "ap.process.wire_bond" ;
        skos:prefLabel "Wire Bonding"@en,
            "金线键合"@zh ;
        semi:legacyId "ap.process.wire_bond" .

    <urn:pxai:semi:catalog:ap.route.bga_flipchip_main> a semi:CatalogConcept,
            semi:Route ;
        skos:definition """基板类封装路径，以晶圆级凸块加倒装互连，适用高脚数高频产品。 与 QFN 路径共享前处理与测试段，在互连与成型段分叉。
"""@zh ;
        skos:notation "ap.route.bga_flipchip_main" ;
        skos:prefLabel "BGA Flip Chip Main Flow"@en,
            "BGA 倒装封装主流程"@zh ;
        semi:legacyId "ap.route.bga_flipchip_main" .

    <urn:pxai:semi:catalog:ap.route.qfn_wirebond_main> a semi:CatalogConcept,
            semi:Route ;
        skos:definition """引线框架类封装的典型路径，以金线键合互连。steps 顺序与 40-flow-precedes.yaml 一致。塑封(molding)为不可逆分界点， 其前的不良多可重工挽回，其后基本只能判废。
"""@zh ;
        skos:notation "ap.route.qfn_wirebond_main" ;
        skos:prefLabel "QFN Wire Bond Main Flow"@en,
            "QFN 金线封装主流程"@zh ;
        semi:legacyId "ap.route.qfn_wirebond_main" .

    <urn:pxai:semi:catalog:ap.stage.die_bond> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "Die Attach",
            "上片",
            "黏晶" ;
        skos:definition "将芯粒从蓝膜取下贴装到基板或引线框架，胶量与贴装精度为控制重点。"@zh ;
        skos:notation "ap.stage.die_bond" ;
        skos:prefLabel "Die Bonding"@en,
            "装片"@zh ;
        semi:legacyId "ap.stage.die_bond" .

    <urn:pxai:semi:catalog:ap.stage.encapsulation> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "Molding",
            "塑封",
            "封胶" ;
        skos:definition "塑封料包覆保护结构，含压模成型与后固化。空洞与分层为主要缺陷。"@zh ;
        skos:notation "ap.stage.encapsulation" ;
        skos:prefLabel "Encapsulation"@en,
            "封装成型"@zh ;
        semi:legacyId "ap.stage.encapsulation" .

    <urn:pxai:semi:catalog:ap.stage.final_form> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "成型",
            "打标",
            "植球" ;
        skos:definition "打印标识、植球或引脚成型、切筋分离成单颗成品。"@zh ;
        skos:notation "ap.stage.final_form" ;
        skos:prefLabel "Final Forming"@en,
            "成品成型"@zh ;
        semi:legacyId "ap.stage.final_form" .

    <urn:pxai:semi:catalog:ap.stage.interconnect> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "Bonding",
            "打线",
            "焊线",
            "键合" ;
        skos:definition """建立芯粒与外部的电气连接。金线键合(Wire Bond)为传统主流， 凸块加倒装(Bumping + Flip Chip)用于高脚数高频产品。
"""@zh ;
        skos:notation "ap.stage.interconnect" ;
        skos:prefLabel "Interconnect"@en,
            "互连"@zh ;
        semi:legacyId "ap.stage.interconnect" .

    <urn:pxai:semi:catalog:ap.stage.test> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "Final Test",
            "成测",
            "终测" ;
        skos:definition """成品终测、可靠性烧机与外观检验。是后段良率结算点， 测试机台与治具产能通常是后段瓶颈。
"""@zh ;
        skos:notation "ap.stage.test" ;
        skos:prefLabel "Test"@en,
            "测试"@zh ;
        semi:legacyId "ap.stage.test" .

    <urn:pxai:semi:catalog:ap.stage.wafer_prep> a semi:CatalogConcept,
            semi:Stage ;
        skos:altLabel "前处理",
            "磨切",
            "背磨切割" ;
        skos:definition """收片、背面研磨减薄、贴膜与切割。将前段交付的完整晶圆转为独立芯粒(Die)。 此段的机械应力控制决定后续裂片风险。
"""@zh ;
        skos:notation "ap.stage.wafer_prep" ;
        skos:prefLabel "Wafer Preparation"@en,
            "晶圆前处理"@zh ;
        semi:legacyId "ap.stage.wafer_prep" .

    <urn:pxai:semi:catalog:core.anomaly.equipment_down> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """机台失去产出能力。区分计划内(PM/Qual)与计划外(Breakdown)： 前者可排程避让，后者同时冲击 WIP 分布与稼动。前后段各自的具体 停机异常通过 refines 归入本节点，共享排查与影响评估骨架。
"""@zh ;
        skos:notation "core.anomaly.equipment_down" ;
        skos:prefLabel "Equipment Down"@en,
            "设备停机"@zh ;
        semi:legacyId "core.anomaly.equipment_down" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:core.anomaly.quality_excursion> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """品质指标突然越出控制界限，通常伴随批量性影响。共性处置骨架为 止损扣留 → 圈定关联批次 → 定位责任机台/时段 → 根因确认 → 放行或判废。 前后段各类突发品质异常通过 refines 归入本节点。
"""@zh ;
        skos:notation "core.anomaly.quality_excursion" ;
        skos:prefLabel "Quality Excursion"@en,
            "品质异常突发"@zh ;
        semi:legacyId "core.anomaly.quality_excursion" ;
        semi:severity "critical" .

    <urn:pxai:semi:catalog:core.anomaly.wip_bubble> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """某站点或制程段 WIP 显著高于正常水位，形成"气泡"并向下游传导断流。 成因分四类：设备产能不足(Down/慢机)、上游投料脉冲、 配方或治具切换损失、品质异常导致的批量 Hold。
"""@zh ;
        skos:notation "core.anomaly.wip_bubble" ;
        skos:prefLabel "WIP Bubble"@en,
            "WIP 堆积"@zh ;
        semi:legacyId "core.anomaly.wip_bubble" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:core.material.lot> a semi:CatalogConcept,
            semi:MaterialType ;
        skos:altLabel "Batch",
            "工单批" ;
        skos:definition """生产调度与追溯的最小成组单位。承载工艺路径(Route)、当前状态(State)、 在制数量与历史量测记录。前段以片数计，后段以颗/条计。
"""@zh ;
        skos:notation "core.material.lot" ;
        skos:prefLabel "Lot"@en,
            "批次"@zh ;
        semi:legacyId "core.material.lot" .

    <urn:pxai:semi:catalog:core.material.wafer> a semi:CatalogConcept,
            semi:MaterialType ;
        skos:definition """硅基载体，前段厂的加工对象，后段厂的输入物料。以直径(6/8/12 吋)与 片号(Slot)标识，是良率统计的基本单元。
"""@zh ;
        skos:notation "core.material.wafer" ;
        skos:prefLabel "Wafer"@en,
            "晶圆"@zh ;
        semi:legacyId "core.material.wafer" .

    <urn:pxai:semi:catalog:core.metric.cycle_time> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition """批次从投料到完工的历时。常用 CT/Layer 或 X-Factor（实际 CT ÷ 纯加工时间） 做跨产品可比化，X-Factor 通常 2~4，越高说明等待浪费越大。
"""@zh ;
        skos:notation "core.metric.cycle_time" ;
        skos:prefLabel "Cycle Time"@en,
            "生产周期"@zh ;
        semi:legacyId "core.metric.cycle_time" ;
        semi:unitCode "day" .

    <urn:pxai:semi:catalog:core.metric.oee> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition """可用率 × 性能率 × 良品率。半导体常配合 E10 状态模型 （Productive / Standby / Engineering / Scheduled Down / Unscheduled Down）拆解。
"""@zh ;
        skos:notation "core.metric.oee" ;
        skos:prefLabel "OEE (Overall Equipment Effectiveness)"@en,
            "设备综合效率"@zh ;
        semi:legacyId "core.metric.oee" ;
        semi:unitCode "%" .

    <urn:pxai:semi:catalog:core.metric.throughput> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition "单位时间完工产出。与 WIP、Cycle Time 由 Little's Law 三者联动。"@zh ;
        skos:notation "core.metric.throughput" ;
        skos:prefLabel "Throughput"@en,
            "产出率"@zh ;
        semi:legacyId "core.metric.throughput" ;
        semi:unitCode "wpm (wafer per month) / kpcs per day" .

    <urn:pxai:semi:catalog:core.metric.wip> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition """某时刻在线未完工的批次或片数。按站点、制程段、产品分层统计。 WIP 分布形态（是否在某站点异常堆积）是产线健康度的第一观测量。
"""@zh ;
        skos:notation "core.metric.wip" ;
        skos:prefLabel "WIP (Work In Process)"@en,
            "在制量"@zh ;
        semi:legacyId "core.metric.wip" ;
        semi:unitCode "lot / wafer / kpcs" .

    <urn:pxai:semi:catalog:core.metric.yield> a semi:CatalogConcept,
            semi:Metric ;
        skos:definition """合格产出占投入的比例。需区分 Line Yield（流程存活率）与 Die Yield / Test Yield（功能良率），两者成因体系不同。
"""@zh ;
        skos:notation "core.metric.yield" ;
        skos:prefLabel "Yield"@en,
            "良率"@zh ;
        semi:legacyId "core.metric.yield" ;
        semi:unitCode "%" .

    <urn:pxai:semi:catalog:core.param.cleanroom_particle> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition """单位体积空气中粒径超标颗粒数。前段光刻与薄膜区要求最严， 粒子失控直接转化为缺陷密度上升。
"""@zh ;
        skos:notation "core.param.cleanroom_particle" ;
        skos:prefLabel "Cleanroom Particle Class"@en,
            "洁净室悬浮粒子等级"@zh ;
        semi:legacyId "core.param.cleanroom_particle" ;
        semi:unitCode "ISO Class / Class(FS209E)" .

    <urn:pxai:semi:catalog:core.param.cleanroom_temp> a semi:CatalogConcept,
            semi:ProcessParameter ;
        skos:definition """环境温湿度稳定性。影响光阻涂布均匀性、量测机台热漂移、 塑封料吸湿状态。属于典型的"环境控制"类节点。
"""@zh ;
        skos:notation "core.param.cleanroom_temp" ;
        skos:prefLabel "Cleanroom Temperature & Humidity"@en,
            "洁净室温湿度"@zh ;
        semi:legacyId "core.param.cleanroom_temp" ;
        semi:unitCode "℃ / %RH" .

    <urn:pxai:semi:catalog:core.risknode.bottleneck_station> a semi:CatalogConcept,
            semi:RiskNode ;
        skos:definition """产能最紧、决定整线节拍的工序位置。瓶颈前必然形成 WIP 缓冲， 瓶颈的稼动损失无法被后续工序补偿。
"""@zh ;
        skos:notation "core.risknode.bottleneck_station" ;
        skos:prefLabel "Bottleneck Station"@en,
            "瓶颈站点"@zh ;
        semi:legacyId "core.risknode.bottleneck_station" .

    <urn:pxai:semi:catalog:core.state.hold> a semi:CatalogConcept,
            semi:Status ;
        skos:definition """批次被人为冻结，禁止流入下一工序。常见类型：工程扣留(Engineering Hold)、 品质扣留(QA Hold)、待判扣留(MRB)。解除需明确责任人与处置结论。
"""@zh ;
        skos:notation "core.state.hold" ;
        skos:prefLabel "Hold"@en,
            "扣留"@zh ;
        semi:legacyId "core.state.hold" .

    <urn:pxai:semi:catalog:core.state.rework> a semi:CatalogConcept,
            semi:Status ;
        skos:definition """批次返回已完成工序重新加工。可挽回良率但消耗额外产能，且部分工序 重工次数有上限（如光刻重工受膜层损伤限制）。
"""@zh ;
        skos:notation "core.state.rework" ;
        skos:prefLabel "Rework"@en,
            "重工"@zh ;
        semi:legacyId "core.state.rework" .

    <urn:pxai:semi:catalog:core.state.scrap> a semi:CatalogConcept,
            semi:Status ;
        skos:definition "批次或部分片/颗判定无法挽回，退出生产流程并计入损失。"@zh ;
        skos:notation "core.state.scrap" ;
        skos:prefLabel "Scrap"@en,
            "报废"@zh ;
        semi:legacyId "core.state.scrap" .

    <urn:pxai:semi:catalog:core.state.wip_queue> a semi:CatalogConcept,
            semi:Status ;
        skos:definition "批次已到站但未上机，处于队列中。是 WIP 堆积的直接观测状态。"@zh ;
        skos:notation "core.state.wip_queue" ;
        skos:prefLabel "WIP Queue"@en,
            "在制等待"@zh ;
        semi:legacyId "core.state.wip_queue" .

    <urn:pxai:semi:catalog:erp.action.clear_gr_ir> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "匹配收货与发票完成自动清账；差异项人工核销或退回采购处理。"@zh ;
        skos:notation "erp.action.clear_gr_ir" ;
        skos:prefLabel "Clear GR/IR Balance"@en,
            "清理 GR/IR 暂估"@zh ;
        semi:legacyId "erp.action.clear_gr_ir" .

    <urn:pxai:semi:catalog:erp.action.correct_asset_master> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "修正折旧方法/年限/残值并重算折旧，必要时冲正错误期间计提。"@zh ;
        skos:notation "erp.action.correct_asset_master" ;
        skos:prefLabel "Correct Asset Master Data"@en,
            "修正资产主数据"@zh ;
        semi:legacyId "erp.action.correct_asset_master" .

    <urn:pxai:semi:catalog:erp.action.credit_review_release> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "复核客户授信与敞口，收款回补或审批提额后释放开票冻结。"@zh ;
        skos:notation "erp.action.credit_review_release" ;
        skos:prefLabel "Credit Review & Release"@en,
            "信用复核并释放"@zh ;
        semi:legacyId "erp.action.credit_review_release" .

    <urn:pxai:semi:catalog:erp.action.provision_writedown> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "按成本与可变现净值孰低计提存货跌价准备，冲减存货账面。"@zh ;
        skos:notation "erp.action.provision_writedown" ;
        skos:prefLabel "Provision for Write-down"@en,
            "计提跌价准备"@zh ;
        semi:legacyId "erp.action.provision_writedown" .

    <urn:pxai:semi:catalog:erp.action.recalc_allocation_rate> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "校正成本中心到成本对象的分摊基准与费率，消除交叉补贴。"@zh ;
        skos:notation "erp.action.recalc_allocation_rate" ;
        skos:prefLabel "Recalculate Allocation Rate"@en,
            "重算分摊率"@zh ;
        semi:legacyId "erp.action.recalc_allocation_rate" .

    <urn:pxai:semi:catalog:erp.action.revalue_standard_cost> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "按最新料价/工艺重跑标准成本估算，收敛系统性差异。需评估存货重估影响。"@zh ;
        skos:notation "erp.action.revalue_standard_cost" ;
        skos:prefLabel "Revalue Standard Cost"@en,
            "重估标准成本"@zh ;
        semi:legacyId "erp.action.revalue_standard_cost" .

    <urn:pxai:semi:catalog:erp.action.variance_analysis> a semi:Action,
            semi:CatalogConcept ;
        skos:definition "把总差异拆成价差/量差/效率差分别归因，定位可控与不可控部分。"@zh ;
        skos:notation "erp.action.variance_analysis" ;
        skos:prefLabel "Cost Variance Decomposition"@en,
            "差异分解分析"@zh ;
        semi:legacyId "erp.action.variance_analysis" .

    <urn:pxai:semi:catalog:erp.anomaly.billing_block> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """销售订单无法开票放行。判别要点：客户敞口超信用额度指向信用管理冻结；交货未过账（PGI） 指向物流未完成；单据带人工开票冻结指向审批未释放。
"""@zh ;
        skos:notation "erp.anomaly.billing_block" ;
        skos:prefLabel "Billing Block / Credit Exceeded"@en,
            "开票冻结/信用超限"@zh ;
        semi:legacyId "erp.anomaly.billing_block" ;
        semi:severity "medium" .

    <urn:pxai:semi:catalog:erp.anomaly.cost_variance_excursion> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """实际成本对标准成本的差异（价差/量差/效率差）超出管控界限。判别要点在差异分解： 全线料成本同向上升指向实际采购价波动或标准成本过时；单位成本随产出下降而升指向 良率吸收；仅特定成本中心异常指向制造费用分摊基准失真。
"""@zh ;
        skos:notation "erp.anomaly.cost_variance_excursion" ;
        skos:prefLabel "Cost Variance Excursion"@en,
            "成本差异超标"@zh ;
        semi:legacyId "erp.anomaly.cost_variance_excursion" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:erp.anomaly.depreciation_error> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """折旧计提金额偏离预期，或累计折旧逼近/超过资产原值。判别要点：全类资产同向偏差指向 折旧方法或年限主数据错误；单项资产异常指向资本化时点（在建工程转固延迟）或残值设置。
"""@zh ;
        skos:notation "erp.anomaly.depreciation_error" ;
        skos:prefLabel "Depreciation Posting Error"@en,
            "折旧计提异常"@zh ;
        semi:legacyId "erp.anomaly.depreciation_error" ;
        semi:severity "medium" .

    <urn:pxai:semi:catalog:erp.anomaly.gr_ir_mismatch> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """月结时收货/发票暂估科目（GR/IR）余额无法清零。判别要点：已收货未开票指向发票未到； 价格或数量不符指向采购订单与发票差异；长期挂账指向单据遗漏需人工清账。
"""@zh ;
        skos:notation "erp.anomaly.gr_ir_mismatch" ;
        skos:prefLabel "GR/IR Reconciliation Failure"@en,
            "GR/IR 暂估对账失败"@zh ;
        semi:legacyId "erp.anomaly.gr_ir_mismatch" ;
        semi:severity "medium" .

    <urn:pxai:semi:catalog:erp.anomaly.inventory_writedown> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """存货可变现净值（NRV）低于账面成本，须计提跌价准备。判别要点：市价普跌指向外部 行情；特定料号积压且周转恶化指向呆滞；伴随大额报废指向产线良率损失冲减。
"""@zh ;
        skos:notation "erp.anomaly.inventory_writedown" ;
        skos:prefLabel "Inventory Write-down"@en,
            "存货跌价"@zh ;
        semi:legacyId "erp.anomaly.inventory_writedown" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:erp.anomaly.yield_cost_impact> a semi:Anomaly,
            semi:CatalogConcept ;
        skos:definition """产线良率下降经成本吸收传导为单位成本上升——跨源系统（制造→ERP）的经营影响。判别要点： 单位成本升幅与良率降幅同步且产量下降指向固定成本稀释不足；仅料成本升则回到采购价差。
"""@zh ;
        skos:notation "erp.anomaly.yield_cost_impact" ;
        skos:prefLabel "Yield-Driven Unit Cost Increase"@en,
            "良率下降致单位成本上升"@zh ;
        semi:legacyId "erp.anomaly.yield_cost_impact" ;
        semi:severity "high" .

    <urn:pxai:semi:catalog:erp.ar.ar2026_0001> a semi:AccountsReceivable,
            semi:CatalogConcept ;
        skos:definition "开票过账自动生成的客户未清项，收款后逐笔核销。"@zh ;
        skos:notation "erp.ar.ar2026_0001" ;
        skos:prefLabel "AR Customer-A VF0001"@en,
            "应收账款—客户A VF0001"@zh ;
        semi:legacyId "erp.ar.ar2026_0001" .

    <urn:pxai:semi:catalog:erp.asset.litho_scanner> a semi:CatalogConcept,
            semi:FixedAsset ;
        skos:definition "折旧计提对象（skill：折旧计提，自检累计折旧<原值）。"@zh ;
        skos:notation "erp.asset.litho_scanner" ;
        skos:prefLabel "Fixed Asset Litho Scanner"@en,
            "固定资产—光刻机"@zh ;
        semi:legacyId "erp.asset.litho_scanner" .

    <urn:pxai:semi:catalog:erp.bank.icbc_main> a semi:BankAccount,
            semi:CatalogConcept ;
        skos:definition "收款流水来源，用于应收清账匹配。"@zh ;
        skos:notation "erp.bank.icbc_main" ;
        skos:prefLabel "Bank Account ICBC-Main"@en,
            "银行账户—工行基本户"@zh ;
        semi:legacyId "erp.bank.icbc_main" .

    <urn:pxai:semi:catalog:erp.billing.vf2026_0001> a semi:BillingDocument,
            semi:CatalogConcept ;
        skos:definition "依发货单开票，确认主营业务收入并计提销项税。"@zh ;
        skos:notation "erp.billing.vf2026_0001" ;
        skos:prefLabel "Billing VF-2026-0001"@en,
            "发票 VF-2026-0001（标准发票）"@zh ;
        semi:legacyId "erp.billing.vf2026_0001" .

    <urn:pxai:semi:catalog:erp.bp.customer_fabless_a> a semi:BusinessPartner,
            semi:CatalogConcept ;
        skos:altLabel "BP",
            "客户主数据" ;
        skos:definition "BP 统一主数据（客户/供应商同源），承担客户角色。"@zh ;
        skos:notation "erp.bp.customer_fabless_a" ;
        skos:prefLabel "Business Partner Fabless-A"@en,
            "业务伙伴—Fabless 客户 A"@zh ;
        semi:legacyId "erp.bp.customer_fabless_a" .

    <urn:pxai:semi:catalog:erp.bp.vendor_osat_b> a semi:BusinessPartner,
            semi:CatalogConcept ;
        skos:definition "承担供应商角色（后段封测委外）。"@zh ;
        skos:notation "erp.bp.vendor_osat_b" ;
        skos:prefLabel "Business Partner OSAT-B"@en,
            "业务伙伴—OSAT 供应商 B"@zh ;
        semi:legacyId "erp.bp.vendor_osat_b" .

    <urn:pxai:semi:catalog:erp.cause.asset_master_error> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "折旧方法/使用年限/残值设置错误，使折旧计提系统性偏差。全类资产同向偏差为其签名。"@zh ;
        skos:notation "erp.cause.asset_master_error" ;
        skos:prefLabel "Asset Master Data Error"@en,
            "资产主数据错误"@zh ;
        semi:legacyId "erp.cause.asset_master_error" .

    <urn:pxai:semi:catalog:erp.cause.capitalization_delay> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "在建工程转固延迟，折旧起始期错位，表现为单项资产折旧异常。"@zh ;
        skos:notation "erp.cause.capitalization_delay" ;
        skos:prefLabel "Capitalization Timing Delay"@en,
            "资本化时点延迟"@zh ;
        semi:legacyId "erp.cause.capitalization_delay" .

    <urn:pxai:semi:catalog:erp.cause.credit_limit_exceeded> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "客户未清应收+在途订单超过授信额度，信用管理自动冻结开票。"@zh ;
        skos:notation "erp.cause.credit_limit_exceeded" ;
        skos:prefLabel "Customer Credit Limit Exceeded"@en,
            "客户信用额度超限"@zh ;
        semi:legacyId "erp.cause.credit_limit_exceeded" .

    <urn:pxai:semi:catalog:erp.cause.delivery_not_posted> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "发货过账（Post Goods Issue）未完成，销售订单无货权转移不能开票。"@zh ;
        skos:notation "erp.cause.delivery_not_posted" ;
        skos:prefLabel "Delivery Not Posted (PGI Pending)"@en,
            "交货未过账（PGI 未做）"@zh ;
        semi:legacyId "erp.cause.delivery_not_posted" .

    <urn:pxai:semi:catalog:erp.cause.inventory_obsolescence> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "特定料号长期积压、周转恶化，制程迭代后可变现净值下降。伴随周转率单调下滑。"@zh ;
        skos:notation "erp.cause.inventory_obsolescence" ;
        skos:prefLabel "Inventory Obsolescence"@en,
            "存货呆滞"@zh ;
        semi:legacyId "erp.cause.inventory_obsolescence" .

    <urn:pxai:semi:catalog:erp.cause.invoice_not_received> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition "已收货但供应商发票未到，GR/IR 暂估挂账。是月结 GR/IR 未清最常见成因。"@zh ;
        skos:notation "erp.cause.invoice_not_received" ;
        skos:prefLabel "Invoice Not Received"@en,
            "发票未达"@zh ;
        semi:legacyId "erp.cause.invoice_not_received" .

    <urn:pxai:semi:catalog:erp.cause.overhead_allocation_drift> a semi:CatalogConcept,
            semi:Cause ;
        skos:definition """成本中心费用按失真基准（工时/机时）分摊到成本对象，使单一成本中心差异异常。 特征是差异集中于特定成本中心而非全线。
"""@zh ;
        skos:notation "erp.cause.overhead_allocation_drift" ;
        skos:prefLabel "Overhead Allocation Base Drift"@en,
            "制造费用分摊基准失真"@zh ;
        semi:legacyId "erp.cause.overhead_allocation_drift" .

    <urn:pxai:semi:catalog:erp.cause.po_invoice_discrepancy> a semi:CatalogConcept,
            semi:Cause ;
