            <urn:pxai:semi:catalog:fab.cause.pm_overdue>,
            <urn:pxai:semi:catalog:fab.cause.reticle_stage_error> ;
        semi:legacyId "kb.fab.scanner_down_triage" ;
        semi:symptomText "OEE 可用率跌落，主流程 CT 同步拉长"@zh,
            "光刻区 WIP 在数小时内快速累积，队列长度陡增"@zh,
            "机台报警停机，曝光工序在制批次无法继续流动"@zh .

