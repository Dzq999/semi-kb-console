    <urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """成球阶段报警时首选，厂内可自行执行。恢复后跑首件确认成球稳定， 并按打线点数把清洗纳入预防性周期，避免同一原因反复停机。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.clean_efo_electrode> .

    <urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText """瓷嘴寿命末期或堵塞时更换。换后需确认键合参数无需重新优化， 否则应连带走参数 DOE。
"""@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.replace_capillary> .

    <urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText """预估停机超过一个班次时改派同类打线机，需确认目标机台键合参数 已对该产品验证过；参数未验证的改派会把停机问题换成质量问题。
"""@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.reallocate_fixture> .

    <urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A4> a semi:ActionInstruction ;
        semi:actionConditionText """停机瞬间在机的部分打线批次须扣留待判，不可直接续打—— 半成品的未完成焊点位置需人工确认后才能决定续打或返工。
"""@zh ;
        semi:actionOrder 4 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.ap.delamination_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """必须优先执行。分层不可逆，且不一定伴随电性异常， 纯靠终测拦不住——扣留是唯一能防止漏出至客户端的手段
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.ap.delamination_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText """仅适用于尚未使用的库存料，目的是防止复发。 对已分层的成品无效：返烤去除水分，不能重新贴合已剥离的界面。 开封已超期者直接报废，不做返烤——超期料交联性能已不可恢复
"""@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.bake_emc> .

    <urn:pxai:semi:action-instruction:kb.ap.delamination_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText "仅当判定为焊垫污染分支时执行，对吸湿成因无效"@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.plasma_clean_rerun> .

    <urn:pxai:semi:action-instruction:kb.ap.dicing_chipping_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText "确认磨损后换刀或修刀，换后首件量测崩边确认恢复"@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.replace_blade> .

    <urn:pxai:semi:action-instruction:kb.ap.dicing_chipping_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText """崩边侵入有效电路区时扣留判废。即使未侵入也需评估—— 崩边是后续裂片的起始源，属延迟风险。
"""@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.ap.die_crack_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """立即执行，且圈定范围要宽。本异常是延迟暴露型——检出时该批已跨 多道工序，须回溯减薄与切割的同机台同时段批次，不能只扣当前批。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.ap.die_crack_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText "确认为崩边扩展型后更换切割刀，并同步复查砂轮状态"@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.replace_blade> .

    <urn:pxai:semi:action-instruction:kb.ap.ft_yield_drop_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """确认治具磨损后清洗或更换。这一步优先级最高，因为治具问题会污染 后续所有分析数据——治具未恢复前的良率数据不可用于判断工艺。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.replace_probe_card> .

    <urn:pxai:semi:action-instruction:kb.ap.ft_yield_drop_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText """仅在治具已确认恢复后执行，用于挽回被过杀的良品。 重测次数须受规范限制，无限重测等于变相放宽标准。
"""@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.retest> .

    <urn:pxai:semi:action-instruction:kb.ap.ft_yield_drop_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText "确认为真实工艺失效后扣留，并按 Bin 类型回溯责任工序"@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.ap.missing_ball_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """根因未明前先扣留。缺球与连球的处置方向相反（前者可返工、 后者多判废），未分清就放行会把判废品混入返工流。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.ap.missing_ball_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText """仅对缺球分支执行，重植后复量共面性并复检外观。 连球不走本动作。返工次数须受规范限制——每次重植追加一次热历程， 无限返工等于用可靠性换良率。
"""@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.reball_rework> .

    <urn:pxai:semi:action-instruction:kb.ap.mold_void_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """确认吸湿后按规范返烤。超过开封期限者直接报废，不做返烤—— 超期料的交联性能已不可恢复，返烤只解决水分不解决老化。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.bake_emc> .

    <urn:pxai:semi:action-instruction:kb.ap.mold_void_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText "必须执行。塑封已不可逆，扣留目的是防止不良流入后续成型与出货"@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.ap.wire_bond_wip_bubble%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """确认为治具短缺或个别机台故障后执行。跨产品调配治具是最快见效的手段， 但需评估换线损失；长期需补充治具投资，否则问题会反复。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.reallocate_fixture> .

    <urn:pxai:semi:action-instruction:kb.ap.wire_bond_wip_bubble%3A2> a semi:ActionInstruction ;
        semi:actionConditionText """仅当堆积伴随品质异常时使用（防止不良批次继续流入不可逆的塑封工序）。 纯产能型堆积不应扣留，否则加剧滞留。
"""@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.ap.wire_bond_wip_bubble%3A3> a semi:ActionInstruction ;
        semi:actionConditionText """若堆积源于键合不良导致的反复重工，须从工艺窗口根治。 此时表面是产能问题，实质是良率问题。
"""@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.bond_param_doe> .

    <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText "疑似焊垫污染时首选，成本低见效快，可作为快速验证手段"@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.plasma_clean_rerun> .

    <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText "确认瓷嘴磨损后立即更换，换后跑首件拉力确认"@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.replace_capillary> .

    <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText "确认为装片溢胶后回到装片站调整，键合站参数不应为此让步"@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.adjust_dispense> .

    <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A4> a semi:ActionInstruction ;
        semi:actionConditionText """线材批号切换或持续性不粘时执行。见效慢但根治， 避免以补偿参数掩盖根因导致隐患累积。
"""@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.bond_param_doe> .

    <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A5> a semi:ActionInstruction ;
        semi:actionConditionText "塑封前必须完成判定——塑封后不粘不可返工，只能判废"@zh ;
        semi:actionOrder 4 ;
        semi:instructsAction <urn:pxai:semi:catalog:ap.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.erp.billing_block_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """信用超限型：复核授信、收款回补或审批提额后释放，释放前须评估坏账风险不可无条件放行。 交货未过账型：先完成 PGI 再开票，不属信用问题。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:erp.action.credit_review_release> .

    <urn:pxai:semi:action-instruction:kb.erp.cost_variance_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText "先把总差异拆成价差/量差/效率差归因，区分可控与不可控，再决定处置方向"@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:erp.action.variance_analysis> .

    <urn:pxai:semi:action-instruction:kb.erp.cost_variance_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText """确认为标准过时型后按最新料价工艺重估。注意重估会一次性调整在库存货估值， 须在期末前评估对当期损益的影响。
"""@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:erp.action.revalue_standard_cost> .

    <urn:pxai:semi:action-instruction:kb.erp.cost_variance_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText "仅当为分摊失真型时校正分摊率；对价差量差无效，用错方向会掩盖真实成因"@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:erp.action.recalc_allocation_rate> .

    <urn:pxai:semi:action-instruction:kb.erp.depreciation_error_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """修正折旧方法/年限/残值并重算。跨期错误需走以前年度调整、冲正错误期间计提， 注意审计留痕；不可直接改数不留轨迹。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:erp.action.correct_asset_master> .

    <urn:pxai:semi:action-instruction:kb.erp.gr_ir_mismatch_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """发票未达型走催票后匹配清账；差异型人工核销或退回采购处理。长期挂账须专项清理， 否则月结反复受阻。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:erp.action.clear_gr_ir> .

    <urn:pxai:semi:action-instruction:kb.erp.inventory_writedown_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """按成本与可变现净值孰低计提跌价准备，冲减存货账面。计提影响当期损益， 须与呆滞处置(变卖/报废)联动，避免只提准备不清库存。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:erp.action.provision_writedown> .

    <urn:pxai:semi:action-instruction:kb.erp.yield_cost_impact_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText "分解出良率吸收(产量差)部分，与料价工时差异区分开"@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:erp.action.variance_analysis> .

    <urn:pxai:semi:action-instruction:kb.erp.yield_cost_impact_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText "若良率标准本身已系统性改变，更新良率假设后重估标准成本"@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:erp.action.revalue_standard_cost> .

    <urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText "超规幅度达判废线，或成因未明时先止损；同时圈定同机台同时段批次"@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText """仅限尚未进入 dry_etch 的批次，且重工次数未达产品规范上限。 已蚀刻批次不可重工，只能评估电性影响后判定放行或报废。
"""@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.photo_rework> .

    <urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText """确认为剂量或显影时间型偏移后做补偿。注意：补偿只治表， 若根因是光源衰退或热板故障，须同步开设备工单，否则偏移会持续扩大。
"""@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.recipe_adjust> .

    <urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A4> a semi:ActionInstruction ;
        semi:actionConditionText "成因未定期间加严抽检，收窄检出窗口以限制受影响批次数"@zh ;
        semi:actionOrder 4 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.expand_sampling> .

    <urn:pxai:semi:action-instruction:kb.fab.cmp_scratch_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """确认研磨垫寿命末期后更换，换后跑首件确认。 换垫周期本身是决策变量：提前换降低划伤但抬高耗材成本。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.replace_consumable> .

    <urn:pxai:semi:action-instruction:kb.fab.cmp_scratch_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText "金属层划伤须扣留，短路风险不可放行；介电层轻微划伤可评估后放行"@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.fab.equipment_down_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """判定为原厂锁定模块时立即报修并按合约等级升级；厂内自行拆装会失去保修， 且伺服/光学系统需原厂重新校准。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.dispatch_field_service> .

    <urn:pxai:semi:action-instruction:kb.fab.equipment_down_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText """预估停机超过一个班次时改派同类机台；须确认可越站且后续站点无时效约束。 路径强制点（如光刻）多数情况不适用。
"""@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.skip_ahead> .

    <urn:pxai:semi:action-instruction:kb.fab.equipment_down_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText """停机瞬间在机批次可能处于半加工状态，须扣留待工程判定， 恢复后先跑首件确认再放行队列。
"""@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.fab.etch_residue_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText "轻微残留可追加过蚀刻时间挽回；桥连型残留通常已不可逆，不适用"@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.recipe_adjust> .

    <urn:pxai:semi:action-instruction:kb.fab.etch_residue_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText "确认为腔体累积后执行，清洗后须跑验证片确认速率恢复再放行量产"@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.chamber_clean> .

    <urn:pxai:semi:action-instruction:kb.fab.etch_residue_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText "残留造成桥连风险时先扣留，待电性影响评估后判定"@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """超规确认后先扣留同腔在制批次。膜厚偏移在后续层会被叠加， 放行的成本随层数增加而放大。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText """偏移出现在清洗或长待机之后、且随片数收敛时执行。预处理后必须 跑验证片确认恢复再放量产；连续生产中途出现的发散型偏移不适用 本动作，那是累积而非未预处理。
"""@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.chamber_season> .

    <urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText """偏移量稳定、方向一致且在补偿窗口内时按偏移反算补偿，须留变更 记录与验证数据。剖面形状已改变的情况不适用——补偿只能移动 整体水平，改不回形状。
"""@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.recipe_adjust> .

    <urn:pxai:semi:action-instruction:kb.fab.film_thickness_dev_triage%3A4> a semi:ActionInstruction ;
        semi:actionConditionText """靶材接近寿命上限或剖面已无法用参数补偿时换靶，换后跑首件确认。 换靶同时会重置腔体状态，因此换后应连带做预处理。
"""@zh ;
        semi:actionOrder 4 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.replace_consumable> .

    <urn:pxai:semi:action-instruction:kb.fab.implant_dose_drift_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """扣留该机台自上次校验通过后的全部批次。注意范围可能很大—— 因为无在线量测，中间批次全部处于未验证状态。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.fab.implant_dose_drift_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText "以校验片实测反算补偿量，同时开设备工单处理束流系统"@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.recipe_adjust> .

    <urn:pxai:semi:action-instruction:kb.fab.implant_dose_drift_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText """增设注入后方阻抽测。这是本异常的根本改善方向： 问题不在漂移本身，而在于缺乏在线反馈导致检出滞后。
"""@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.expand_sampling> .

    <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """先扣留，不要急着重工。套刻偏移的成因决定了该重工还是该修机台， 盲目重工会在同一台有问题的机台上再废一次。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText """确认为配方误用或补偿量异常时修正配方。 若是补偿模型被坏点带偏，需同时清理该点再让模型收敛。
"""@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.recipe_adjust> .

    <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText """判定为背面/吸盘沾污时停机清洗并复测平面度。 清洗后要复测套刻确认恢复，否则可能是晶圆背面而非吸盘的问题。
"""@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.clean_chuck> .

    <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A4> a semi:ActionInstruction ;
        semi:actionConditionText """仅在该层可返工且根因已消除时重工。 根因未除就重工等于把良品也拖进去。
"""@zh ;
        semi:actionOrder 4 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.photo_rework> .

    <urn:pxai:semi:action-instruction:kb.fab.overlay_shift_triage%3A5> a semi:ActionInstruction ;
        semi:actionConditionText """对位系统或镜头热补偿模型异常且厂内手段无效时报修。 这类问题通常需要原厂调机，不属厂内可自行恢复的范畴。
"""@zh ;
        semi:actionOrder 5 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.dispatch_field_service> .

    <urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """立即执行。关键是圈定范围：以缺陷批次经过的机台与时段反查所有 同条件批次，而非只扣留已检出的批次。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText "确认为逐场重复签名后送洗；无备用光罩时需先排程避让"@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.reticle_clean> .

    <urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText "确认为腔体来源后执行，清洗后跑颗粒验证片确认恢复"@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.chamber_clean> .

    <urn:pxai:semi:action-instruction:kb.fab.particle_excursion_triage%3A4> a semi:ActionInstruction ;
        semi:actionConditionText """成因未定期间必做。突增类异常的损失规模近似等于 检出延迟时间 × 产出速率，加严抽检是压缩这个乘积的唯一手段。
"""@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.expand_sampling> .

    <urn:pxai:semi:action-instruction:kb.fab.quality_excursion_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """立即执行，关键是圈定范围：以异常批次经过的机台与时段反查所有同条件 批次，而非只扣留已检出的批次。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

    <urn:pxai:semi:action-instruction:kb.fab.quality_excursion_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText """成因未定期间必做。突变类异常的损失规模近似等于检出延迟 × 产出速率， 加严抽检是压缩这个乘积的唯一手段。
"""@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.expand_sampling> .

    <urn:pxai:semi:action-instruction:kb.fab.quality_excursion_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText """偏移量稳定、方向一致且在补偿窗口内时按实测反算补偿，须留变更记录与 验证数据。剖面形状已改变或成因未定的情况不适用——补偿只移动整体水平。
"""@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.recipe_adjust> .

    <urn:pxai:semi:action-instruction:kb.fab.scanner_down_triage%3A1> a semi:ActionInstruction ;
        semi:actionConditionText """判定为原厂锁定模块（工件台、光源）时立即报修并按合约等级升级。 厂内自行拆装会失去保修，且伺服系统需原厂重新校准。
"""@zh ;
        semi:actionOrder 1 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.dispatch_field_service> .

    <urn:pxai:semi:action-instruction:kb.fab.scanner_down_triage%3A2> a semi:ActionInstruction ;
        semi:actionConditionText """预估停机超过一个班次时改派同类机台，需确认套刻补正模型按机台管理， 否则改派本身会引入套刻偏移。注意越站分支多数情况下不适用—— 光刻是路径强制点，只有工艺允许延后且后续站点无时效性约束才可考虑。
"""@zh ;
        semi:actionOrder 2 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.skip_ahead> .

    <urn:pxai:semi:action-instruction:kb.fab.scanner_down_triage%3A3> a semi:ActionInstruction ;
        semi:actionConditionText """停机瞬间在机批次可能处于部分曝光状态，须扣留待工程判定， 不可直接续跑。恢复后先跑首件确认再放行队列。
"""@zh ;
        semi:actionOrder 3 ;
        semi:instructsAction <urn:pxai:semi:catalog:fab.action.hold_lot> .

    <urn:pxai:semi:capability:abnormal_case> a semi:L1Capability ;
        rdfs:label "Abnormal Case",
            "Abnormal Case"@zh .

    <urn:pxai:semi:capability:abnormal_lot> a semi:L1Capability ;
        rdfs:label "Abnormal Lot",
            "Abnormal Lot"@zh .

    <urn:pxai:semi:capability:bkm_baseline> a semi:L1Capability ;
        rdfs:label "BKM Baseline",
            "BKM Baseline"@zh .

    <urn:pxai:semi:capability:common_tool> a semi:L1Capability ;
        rdfs:label "Common Tool",
            "Common Tool"@zh .

    <urn:pxai:semi:capability:defect_library> a semi:L1Capability ;
        rdfs:label "Defect Library",
            "Defect Library"@zh .

    <urn:pxai:semi:capability:defect_notice> a semi:L1Capability ;
        rdfs:label "Defect Notice",
            "Defect Notice"@zh .

    <urn:pxai:semi:capability:impact_lot> a semi:L1Capability ;
        rdfs:label "Impact Lot",
            "Impact Lot"@zh .

    <urn:pxai:semi:capability:inline_offline_analysis> a semi:L1Capability ;
        rdfs:label "Inline/Offline",
            "Inline/Offline"@zh .

    <urn:pxai:semi:capability:matching_library> a semi:L1Capability ;
        rdfs:label "Matching Library",
            "Matching Library"@zh .

    <urn:pxai:semi:capability:on_duty_coordination> a semi:L1Capability ;
        rdfs:label "On-duty Coordination",
            "On-duty Coordination"@zh .

    <urn:pxai:semi:capability:root_cause_analysis> a semi:L1Capability ;
        rdfs:label "Root Cause",
            "Root Cause"@zh .

    <urn:pxai:semi:capability:set_alert> a semi:L1Capability ;
        rdfs:label "Set Alert",
            "Set Alert"@zh .

    <urn:pxai:semi:capability:tool_matching> a semi:L1Capability ;
        rdfs:label "Tool Matching",
            "Tool Matching"@zh .

    <urn:pxai:semi:capability:user_notification> a semi:L1Capability ;
        rdfs:label "Info User",
            "Info User"@zh .

    <urn:pxai:semi:capability:wat_cp_analysis> a semi:L1Capability ;
        rdfs:label "WAT/CP",
            "WAT/CP"@zh .

    <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.efo_electrode_fouling> ;
        semi:discriminatorText """报警集中在成球(FAB)阶段而非焊接阶段，且故障频次随打线点数累积上升。 查电极累积放电次数，清洗后立即恢复即可确认。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.wire_feed_jam> ;
        semi:discriminatorText """停机形态是频繁短停，穿线复位即恢复，不伴随键合质量指标劣化。 这一点与瓷嘴磨损相反：后者拉力下降但机台不一定停。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.bond_head_servo_fault> ;
        semi:discriminatorText """报警指向 Z 轴定位或换能器自检，与成球、送线环节无关。 复位无效且需原厂介入是强信号——此时不要继续在耗材上排查。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A4> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.capillary_wear> ;
        semi:discriminatorText """主要表现为拉力/球剪切下降，通常先触发质量异常而非停机； 只有在瓷嘴堵塞导致送线受阻时才停机，需与卡线区分。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A5> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.fixture_shortage> ;
        semi:discriminatorText """机台本身完好，停的是"没治具可上"。查治具台账即可排除， 它是排产型成因，处置走调配而非维修。
"""@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.ap.delamination_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.emc_moisture> ;
        semi:discriminatorText """取该批塑封料的开封时刻与车间温湿度记录，按 MSL 等级比对 floor life 门槛（30°C 条件下 MSL 2 为 1 年、2a 为 4 周、 3 为 168 小时、4 为 72 小时、5 为 48 小时、5a 为 24 小时； MSL 1 不限、MSL 6 须用前烘烤）。暴露时长超过对应门槛即确认 吸湿为主因。两个辅助判别：分层跨模腔随机分布而非集中， 且同期开封的其他批次同步出现。注意车间高于 30°C 或 相对湿度高于 60% 时实际 floor life 短于表值，不能直接套用。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.delamination_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.pad_contamination> ;
        semi:discriminatorText """分层集中在固定界面（焊垫或芯粒背面）而非随机分布， 且能追到特定等离子清洁批次或上游制程时窗。 与吸湿最快的区分：调整料的储存条件后不改善， 而追加等离子清洁后改善。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.delamination_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.param.cure_temp> ;
        semi:discriminatorText """调固化温度记录，分层与特定烘箱或时段吻合， 且位置偏向装片胶界面而非塑封料界面。 温度不足致交联不全，此时芯粒剪切强度同步偏低—— 这一点可与吸湿区分，吸湿通常不压低剪切强度。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.dicing_chipping_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.blade_wear> ;
        semi:discriminatorText """崩边尺寸随刀片累积切割长度单调上升，换刀后立即恢复。 若为局部崩齿，则崩边在固定切割位置突发出现。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.dicing_chipping_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.param.cut_feed_speed> ;
        semi:discriminatorText "与配方变更时点重合，或为提产能而调高进给速度后出现"@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.dicing_chipping_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.param.blade_rpm> ;
        semi:discriminatorText "转速与进给失配，查主轴转速实测值与设定值偏差"@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.grind_wheel_clog> ;
        semi:discriminatorText """裂纹起始于背面且呈亚表面延伸特征。查砂轮使用时长与研磨电流趋势 （电流上升指示切削效率下降）。此成因在减薄站不可检， 须靠上游参数记录回溯。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.anomaly.dicing_chipping> ;
        semi:discriminatorText """裂纹起始于芯粒边缘且与崩边位置连续。查同批崩边量测数据， 若崩边尺寸已接近上限，则裂纹是崩边扩展的结果， 处置应回到切割站而非装片站。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.param.die_bond_force> ;
        semi:discriminatorText """裂纹呈中心放射状且与装片压力施加位置吻合，集中于特定装片机台。 薄芯粒产品尤其敏感。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A4> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.param.grind_feed_rate> ;
        semi:discriminatorText "与减薄配方变更时点重合，查参数变更记录"@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.probe_card_wear> ;
        semi:discriminatorText """伪失效的三个特征：重测通过率高、失效集中于特定 Site 或针位、 失效 Bin 多为开路/接触类。三者同时出现基本可确认。 这是首要排除项——若不先排除，会把良品当不良追查工艺，方向全错。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> ;
        semi:discriminatorText """失效 Bin 为开路且重测不通过，回溯该批键合站拉力数据异常。 属键合不良的延迟暴露。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.anomaly.delamination> ;
        semi:discriminatorText "失效随温度变化（高温测试失效率明显高），超声扫描可确认分层"@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A4> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.anomaly.die_crack> ;
        semi:discriminatorText "失效无规律且分布随机，外观或 X-Ray 可见裂纹"@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A5> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.param.test_time> ;
        semi:discriminatorText "与缩测方案上线时点重合，须复核测试覆盖率是否被削弱"@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.ap.missing_ball_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.flux_print_defect> ;
        semi:discriminatorText """首要排除项。看不良的空间分布：跟印刷版面或治具孔位走（位置固定、 同版面重复出现）指向印刷不良；跟炉内温区走（沿炉长方向或按载具 位置分布）指向回流。缺球与连球同批共存也指向本成因—— 印刷黏度过低渗出致连球、过高填不满致缺球，同一物性两侧偏离 产生两种相反的表观不良。再查黏性：黏性不足时锡球在搬运中移位， 缺球位置随机而非固定，这一支与印刷量不足要分开看。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.missing_ball_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.reflow_profile_drift> ;
        semi:discriminatorText """不良沿炉长方向或按载具位置呈梯度分布，且与炉温曲线仪校核记录的 温区衰退、链速偏移时点吻合。与印刷不良的关键区分：本成因下 印刷后（回流前）的检查是正常的——若厂内有回流前抽检， 一次比对即可定案，不必等 AOI。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.missing_ball_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.param.reflow_peak_temp> ;
        semi:discriminatorText """与配方变更时点重合。峰值偏低时润湿不足致缺球且锡球形貌偏球形 残留；偏高时助焊剂在到达润湿温度前已耗尽或流失， 表观是锡球起皱与氧化。查参数变更记录，不要与炉体衰退混判—— 前者是设定变了，后者是设定没变而实际受热变了。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.emc_moisture> ;
        semi:discriminatorText """查塑封料开封时间与储存条件。若开封超期或未低温储存， 空洞会跨模腔随机分布。返烤后改善即确认——这是与设备型成因 最快的区分方法。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.param.transfer_speed> ;
        semi:discriminatorText "空洞位置与流动前沿末端吻合（远离注料口侧），降速后改善"@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.param.mold_pressure> ;
        semi:discriminatorText "空洞集中于特定模腔且该腔排气槽有堵塞，属模具维护问题"@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A4> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.param.mold_temp> ;
        semi:discriminatorText "温度偏低致黏度过高，通常伴随包封不全而非仅空洞"@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.anomaly.bonder_down> ;
        semi:discriminatorText """查该站可用机台数与 E10 状态分布。若 Unscheduled Down 台数上升， 即为设备型。键合站机台数多，需看的是"可用台数占比"而非单机状态—— 单台停机通常不足以形成堆积。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.fixture_shortage> ;
        semi:discriminatorText """机台状态显示 Standby（待料/待治具）而非 Down，且该产品别的治具或 载具在线数量不足。这是后段最容易被漏查的成因——设备报表看起来正常， 产能却锁死。判别关键在于区分 Standby 与 Down。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> ;
        semi:discriminatorText """堆积批次中 Hold 状态占比高，且 Hold 原因为键合品质。 此时堆积是品质异常的后果而非产能问题，处置方向完全不同—— 应先解决品质判定，加派机台无效。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A4> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.process.wafer_receive> ;
        semi:discriminatorText """回溯前 1~2 周收片量曲线。若出现投料脉冲（如前段集中交付）， 堆积会沿流程逐站传导，键合站只是显现位置而非根源。 特征是上游各站 WIP 也依次偏高。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A5> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:core.state.hold> ;
        semi:discriminatorText "堆积批次长期未流动且 Hold 未解除，属流程管理问题而非产能问题"@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.capillary_wear> ;
        semi:discriminatorText """不良集中于特定机台特定线位，且随该瓷嘴键合次数累积恶化。 换瓷嘴后立即恢复即确认。这是最常见也最容易验证的成因。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.epoxy_bleed> ;
        semi:discriminatorText """目检焊垫可见胶体残留，且不良与特定装片机台关联。 属跨工序传导——键合站是显现位置，责任在装片站， 单纯调键合参数只会掩盖问题。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.pad_contamination> ;
        semi:discriminatorText """全线跨机台同步出现，且追加等离子清洁后显著改善。 若污染源在前段（钝化层残留），需与晶圆厂协同， 判别方法是比对不同前段批号的不良率差异。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A4> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.param.bond_power> ;
        semi:discriminatorText "与线材批号切换时点重合，需重建工艺窗口而非微调"@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A5> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:ap.cause.bond_param_drift> ;
        semi:discriminatorText "同机台所有线位缓慢恶化，查换能器效率与加热台温度校验记录"@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.erp.billing_block_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:erp.cause.credit_limit_exceeded> ;
        semi:discriminatorText """订单带信用冻结标记，客户未清应收+在途订单超授信额度。查客户信用敞口与额度—— 敞口超限是信用管理自动冻结的签名，需信用侧介入，非物流问题。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.erp.billing_block_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:erp.cause.delivery_not_posted> ;
        semi:discriminatorText """订单无信用冻结但交货单 PGI 未过账，货权未转移不能开票。查交货单状态—— 物流未闭环型的特征是"信用正常、卡在发货过账"，与信用冻结的区分在单据状态。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.erp.cost_variance_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:erp.cause.purchase_price_swing> ;
        semi:discriminatorText """价差随用量放大、且与硅片/靶材/化学品行情同步。查采购价格历史(PPV)， 若料价曲线与差异起点重合，即为采购价波动型。这是与标准过时型最关键的区分—— 价格波动是短期的，标准过时是持续单向的。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.erp.cost_variance_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:erp.cause.standard_cost_outdated> ;
        semi:discriminatorText """全线同向差异且持续存在，标准成本上次重估距今过久。查标准成本版本日期， 若差异跨多料号、多期稳定同向，基本可确认标准过时。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.erp.cost_variance_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:erp.cause.overhead_allocation_drift> ;
        semi:discriminatorText """差异集中于单一成本中心，其余成本中心正常。调阅该成本中心的分摊基准(工时/机时) 与实际是否偏离——分摊失真只影响成本对象间分配，不改变总成本，这是判别关键。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.erp.depreciation_error_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:erp.cause.asset_master_error> ;
        semi:discriminatorText """同一资产类下多项资产折旧同向偏差。查该资产类的折旧方法/使用年限/残值主数据—— 全类同向是主数据错误的签名。若累计折旧已超原值，几乎可确认年限或方法设错。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.erp.depreciation_error_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:erp.cause.capitalization_delay> ;
        semi:discriminatorText """仅单项资产异常且与在建工程转固时点相关。查该资产资本化日期与投产日期是否错位—— 转固延迟使折旧起始期错位，特征是"仅这一项、且时点可追"，与全类主数据错误相区分。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.erp.gr_ir_mismatch_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:erp.cause.invoice_not_received> ;
        semi:discriminatorText """挂账项为"已收货未开票"，采购订单已收货但供应商发票未到。查 GR/IR 明细的收货/发票 两侧余额——单边(仅收货)挂账即发票未达型，属时间差，催票流程可解，非差错。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.erp.gr_ir_mismatch_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:erp.cause.po_invoice_discrepancy> ;
        semi:discriminatorText """收货与发票都在但金额/数量不符，系统挂起无法自动清。核对采购订单价、收货数量、 发票金额三者——两侧都有却清不掉，即差异型，需采购与应付协同处理。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.erp.inventory_writedown_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:erp.cause.inventory_obsolescence> ;
        semi:discriminatorText """特定料号周转率单调下滑、库龄拉长，且制程已迭代到新节点。查库龄分布与周转趋势—— 呆滞型的签名是"越积越久、市场已不需要"，是半导体存货减值的首因。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.erp.inventory_writedown_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:erp.cause.purchase_price_swing> ;
        semi:discriminatorText """市价普跌导致 NRV 下降，但料号本身周转正常。与呆滞型的区分：呆滞是这批货卖不动， 市价型是能卖但售价跌破成本。看周转率是否正常即可分流。
"""@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.erp.yield_cost_impact_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:core.anomaly.quality_excursion> ;
        semi:discriminatorText """单位成本升幅与良率降幅同步、且产量同步下降，指向良率损失经成本吸收传导。 这是"良率是财务问题"的接点：查产线良率趋势与单位成本趋势是否同期拐点。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.erp.yield_cost_impact_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:erp.cause.overhead_allocation_drift> ;
        semi:discriminatorText """若良率平稳而单位成本仍升，回到分摊基准失真的排查，而非良率吸收。 良率吸收型的特征是分母(良品数)变小，分摊失真型是分摊规则本身变了。
"""@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.param.exposure_dose> ;
        semi:discriminatorText """全片均匀偏移且方向与剂量变化一致。查 Scanner 光源能量趋势与照度校正记录； 若同机台所有产品同向偏移，基本可确认。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.hotplate_nonuniform> ;
        semi:discriminatorText """片内呈稳定空间梯度（常见单边高/低），且梯度方向与热板温区分布吻合。 调阅热板温度映射图比对；换机台后梯度消失则确认。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.resist_lot_change> ;
        semi:discriminatorText """偏移起始时点与光阻换批时点重合，且跨多台机台同步出现。 这是与设备型成因最关键的区分点——设备型不会跨机台同步。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A4> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.recipe_misload> ;
        semi:discriminatorText "批间跳变且边界清晰，仅特定批次异常。核对配方版本与派工记录即可确认。"@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A5> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.param.exposure_focus> ;
        semi:discriminatorText """CD 偏移伴随侧壁形貌恶化，且呈同心圆或局部区块分布。 单纯剂量问题不会改变侧壁角度，这是两者的判别关键。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A6> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.lens_contamination> ;
        semi:discriminatorText "固定曝光场固定位置重复偏移，换光罩不改善。需停机检查光路。"@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.fab.cmp_scratch_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.pad_end_of_life> ;
        semi:discriminatorText """划伤率随研磨垫累积使用时长上升，且去除率同步下降。 两个趋势同时出现基本可确认；换垫后立即恢复是最终验证。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.fab.cmp_scratch_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.slurry_agglomeration> ;
        semi:discriminatorText """划伤突发而非渐增，且研磨垫寿命尚在中段。查研磨液批号、 过滤器压差与储存时长；换新液后改善则确认。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.cmp_scratch_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.param.cmp_pressure> ;
        semi:discriminatorText "仅在配方变更或压力控制异常后出现，查参数变更记录"@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.pm_overdue> ;
        semi:discriminatorText """先查 PM 计划是否已超期。超期则本次停机应归因于维护/排程依从性， 而不是记成随机设备故障——归因错了改善方向也会错。这是"用计划停机 换非计划停机"这一结构性旋钮的入口。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.reticle_stage_error> ;
        semi:discriminatorText """代表突发型运动机构/伺服故障：报警发生在动作执行阶段、无任何前兆趋势。 "突发无前兆"是它与劣化型的分界，查伺服跟随误差日志即可确认。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.light_source_degradation> ;
        semi:discriminatorText """代表渐变劣化型：停机前已有产出率缓降或处理时间延长的"先慢后停"趋势。 有前兆趋势即指向劣化，无前兆则倾向突发机构故障。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A4> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.env_excursion> ;
        semi:discriminatorText """温湿度/振动/动力介质超限时多台设备同时报警；单台停机基本可排除环境型。 "跨设备同步"是环境型的判别签名。
"""@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.fab.etch_residue_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.chamber_polymer_buildup> ;
        semi:discriminatorText """残留率随该腔体 RF Hours 单调上升，清洗后立即恢复。 这是渐变型特征，与突发型故障的区别在于有明确趋势。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.fab.etch_residue_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.epd_failure> ;
        semi:discriminatorText """终点信号曲线异常（无明显拐点或信噪比低），且残留量在批内随机。 调阅 EPD 波形是最直接的确认手段。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.etch_residue_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.param.etch_time> ;
        semi:discriminatorText """若前层膜厚偏厚（查薄膜工序量测记录），则蚀刻量相对不足， 属"上游膜厚偏移传导"，而非蚀刻本身失效。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.chamber_wall_condition> ;
        semi:discriminatorText """看时点与收敛方向。本项出现在清洗/长待机之后，偏移随加工片数 收敛；腔体聚合物累积出现在连续生产中且随片数发散。方向相反， 一次片间趋势图就能分开。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.target_erosion_profile> ;
        semi:discriminatorText """看径向剖面形状是否改变而非均值是否漂移。侵蚀沟槽演化改的是 形状（如中心厚转为边缘厚），功率或压力偏移改的是整体水平。 只看片均值会把这两类混成同一个"膜厚漂移"。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.target_end_of_life> ;
        semi:discriminatorText """查靶材累计用量是否接近寿命上限，并看缺陷扫描有无同步的颗粒 跃升。均匀性恶化叠加颗粒风险上升是寿命末期签名；仅剖面渐变 而颗粒平稳则仍在可补偿区间。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A4> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.recipe_misload> ;
        semi:discriminatorText """偏移是否在特定批次上突然出现且边界清晰。是则查配方版本与 机台配方履历，不要继续往设备本体查——归因错了改善方向也会错。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.film_thickness_dev_triage%3A5> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.param.chamber_pressure> ;
        semi:discriminatorText """查腔压趋势是否与偏移同步。腔压改的是散射行为，表现偏向剖面 变化；纯粹的速率高低更可能来自功率侧。
"""@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.fab.implant_dose_drift_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.beam_current_drift> ;
        semi:discriminatorText """按注入机台分组比对 Vt 分布，特定机台整体偏移即指向该机台束流系统。 做剂量校验片(Dose Monitor Wafer)测方阻可直接量化偏差量。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.fab.implant_dose_drift_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.recipe_misload> ;
        semi:discriminatorText "单批突变且边界清晰，核对配方与派工记录"@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.implant_dose_drift_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.param.implant_dose> ;
        semi:discriminatorText "参数变更记录中有剂量调整而未做验证，属变更管理漏洞"@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.recipe_misload> ;
        semi:discriminatorText """先查配方与层别是否匹配——这是最快能排除、代价也最低的一项。 配方误用通常表现为整片大幅规律性偏移，且同机台同配方的 其他批次同样异常。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.alignment_mark_damage> ;
        semi:discriminatorText """对位残差异常但曝光成像质量正常。关键判别：换机台重曝仍复现， 且问题跟着前层工艺批次走而非跟着曝光机台走。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.wafer_backside_contamination> ;
        semi:discriminatorText """偏移呈局部化不规则分布，而非全片线性或旋转分量； 同一吸盘上不同晶圆的偏移位置重复出现。常伴随离焦与 CD 异常。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A4> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.lens_heating_drift> ;
        semi:discriminatorText """场内分量随批次内曝光片数递进，停机冷却后自行恢复。 与光路沾污的区别是后者持续存在且伴随对比度下降。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A5> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.env_excursion> ;
        semi:discriminatorText """温湿度或振动记录越限，且同期多台机台、多产品同时异常。 单机台单产品异常基本可排除环境因素。
"""@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.fab.overlay_shift_triage%3A6> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.param.overlay_offset> ;
        semi:discriminatorText """查 run-to-run 补偿量是否被异常更新——补偿模型吃进一个坏点后 可能把正常批次也带偏，此时机台与晶圆都没问题。
"""@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.reticle_haze> ;
        semi:discriminatorText """缺陷在每个曝光场的同一相对位置重复出现——这是最有辨识度的签名。 只要看到逐场规律重复，优先查光罩，其余成因不会产生这种周期性。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.chamber_polymer_buildup> ;
        semi:discriminatorText """缺陷集中于经过特定腔体的批次，且该腔体 RF Hours 接近清洗周期上限。 按机台/腔体交叉比对缺陷率即可锁定。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.target_end_of_life> ;
        semi:discriminatorText "缺陷集中于 PVD 后工序，且靶材累积用量接近寿命上限"@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A4> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.env_excursion> ;
        semi:discriminatorText """多个不相关工序同时缺陷上升，且分布随机无规律。 "跨工序同步"是环境型成因的标志——单一设备问题不会波及无关工序。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.particle_excursion_triage%3A5> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.slurry_agglomeration> ;
        semi:discriminatorText "缺陷为线状划伤而非点状颗粒，且集中于 CMP 后量测点"@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.quality_excursion_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.recipe_misload> ;
        semi:discriminatorText """偏移在特定批次上突然出现且边界清晰——是则查配方版本与机台配方履历， 不要继续往设备本体查。"突变+边界清晰"是配方/派工类的签名。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.fab.quality_excursion_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.beam_current_drift> ;
        semi:discriminatorText """偏移集中在电性参数（Vt/方阻）且按机台分组后特定机台整体偏移， 指向该机台工艺子系统。做校验片可直接量化偏差量。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.quality_excursion_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.chamber_wall_condition> ;
        semi:discriminatorText """偏移出现在清洗/长待机之后且随加工片数收敛——"事件后出现、随片数回稳" 是腔体状态型；连续生产中随片数发散的是累积型，方向相反。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.quality_excursion_triage%3A4> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.env_excursion> ;
        semi:discriminatorText """多个不相关工序/机台同时品质下滑且分布随机无规律。"跨工序同步"是 环境型的标志——单一设备或配方问题不会波及无关工序。
"""@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:cause-assertion:kb.fab.scanner_down_triage%3A1> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.reticle_stage_error> ;
        semi:discriminatorText """报警发生在扫描动作阶段而非光源侧，且常在特定 slit 位置或特定 扫描方向重复。查伺服跟随误差日志即可与光源类区分。
"""@zh ;
        semi:likelihood "high" .

    <urn:pxai:semi:cause-assertion:kb.fab.scanner_down_triage%3A2> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.light_source_degradation> ;
        semi:discriminatorText """停机前已有产出率缓降或曝光时间延长的趋势——"先慢后停"是光源劣化 的签名。伺服类停机是突发的，没有这段前兆。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.scanner_down_triage%3A3> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.pm_overdue> ;
        semi:discriminatorText """查 PM 计划是否已超期。超期则这次停机应归因于排程决策， 而不是记成随机设备故障——归因错了，改善方向也会错。
"""@zh ;
        semi:likelihood "medium" .

    <urn:pxai:semi:cause-assertion:kb.fab.scanner_down_triage%3A4> a semi:PossibleCauseAssertion ;
        semi:assertsCause <urn:pxai:semi:catalog:fab.cause.env_excursion> ;
        semi:discriminatorText "温湿度或振动超限时多台设备同时报警；单台停机基本可排除"@zh ;
        semi:likelihood "low" .

    <urn:pxai:semi:customer-problem:scenario.ap.bonder_down_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现键合机停机，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.ap.delamination_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现界面分层，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.ap.dicing_chipping_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现切割崩边超规，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.ap.die_crack_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现芯粒裂纹，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.ap.ft_yield_drop_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现终测良率下滑，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.ap.missing_ball_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现缺球/连球，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.ap.mold_void_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现塑封空洞，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.ap.wire_bond_wip_bubble> a semi:CustomerProblem ;
        semi:problemText "生产现场出现WIP 堆积，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.ap.wire_nsop_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现金线不粘，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.fab.cd_out_of_spec_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现CD 超规，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.fab.cmp_scratch_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现CMP 划伤，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.fab.etch_residue_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现蚀刻残留，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.fab.film_thickness_dev_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现膜厚偏移/均匀性超规，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.fab.implant_dose_drift_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现注入剂量漂移，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.fab.overlay_shift_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现套刻偏移，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.fab.particle_excursion_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现颗粒突增，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:customer-problem:scenario.fab.scanner_down_triage> a semi:CustomerProblem ;
        semi:problemText "生产现场出现光刻机非计划停机，需要快速定位影响与处置。"@zh .

    <urn:pxai:semi:detection:kb.ap.bonder_down_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.oee> ;
        semi:signalText """可用率跌落。要同时看停机次数与单次时长：频繁短停指向卡线或电极， 一次长停指向轴系。只看总停机时长会把两类混为一谈。
"""@zh .

    <urn:pxai:semi:detection:kb.ap.bonder_down_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.wip> ;
        semi:signalText "键合区队列累积，是停机向下游塑封传导的最早观测量"@zh .

    <urn:pxai:semi:detection:kb.ap.bonder_down_triage%3A3> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.wire_pull_strength> ;
        semi:signalText """拉力同步下降则更可能是瓷嘴或参数问题而非纯停机故障， 可用于把停机型与质量型成因分开
"""@zh .

    <urn:pxai:semi:detection:kb.ap.delamination_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.die_shear_strength> ;
        semi:signalText """剪切强度低于规格下限，且失效模式为界面剥离而非芯粒体破裂。 失效模式比数值本身更有判别力
"""@zh .

    <urn:pxai:semi:detection:kb.ap.delamination_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.void_ratio> ;
        semi:signalText "分层面积占比超允收标准，按界面类型与位置分类统计用于定位成因"@zh .

    <urn:pxai:semi:detection:kb.ap.dicing_chipping_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.chipping_size> ;
        semi:signalText "最大崩边尺寸与 Scribe Line 余量比对，并按刀片使用长度做趋势分析"@zh .

    <urn:pxai:semi:detection:kb.ap.die_crack_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.die_shear_strength> ;
        semi:signalText "剪切强度异常偏低，或剪切失效面出现非预期断裂形态"@zh .

    <urn:pxai:semi:detection:kb.ap.ft_yield_drop_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.ft_yield> ;
        semi:signalText """良率趋势 + Bin 分布 + Site 分布。三者必须一起看： Bin 指向失效机理，Site 指向治具，趋势指向发生时点。
"""@zh .

    <urn:pxai:semi:detection:kb.ap.ft_yield_drop_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.yield> ;
        semi:signalText """与前段 CP 良率联动比对。CP 正常而 FT 下滑则成因在后段； 两者同步下滑则回溯前段。这是划分前后段责任的第一判据。
"""@zh .

    <urn:pxai:semi:detection:kb.ap.missing_ball_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.coplanarity> ;
        semi:signalText """共面性超规。但它是并发观测量而非缺球本身的判据—— 缺球在共面性数据上表现为该接点缺测点，而连球可能仍在规格内。 两者要分开判，把共面性超规直接当缺球会漏判连球。
"""@zh .

    <urn:pxai:semi:detection:kb.ap.missing_ball_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.yield> ;
        semi:signalText """植球站不良率趋势。按印刷版面位置与炉内位置两个维度分别做分布统计， 哪个维度先聚集就指向哪类成因——这是本异常最快的分流手段。
"""@zh .

    <urn:pxai:semi:detection:kb.ap.mold_void_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.void_ratio> ;
        semi:signalText "空洞占比超规，且按模腔位置统计的分布形态用于区分料因与模具因"@zh .

    <urn:pxai:semi:detection:kb.ap.wire_bond_wip_bubble%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.wip> ;
        semi:signalText """按站点分层的 WIP 水位与历史基线对比；同时看上下游站点分布形态， 判断是本站产生还是上游传导。
"""@zh .

    <urn:pxai:semi:detection:kb.ap.wire_bond_wip_bubble%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.oee> ;
        semi:signalText "该站 OEE 与 E10 状态分解，用于区分设备型(Down)与待料型(Standby)"@zh .

    <urn:pxai:semi:detection:kb.ap.wire_bond_wip_bubble%3A3> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.cycle_time> ;
        semi:signalText "该站 CT 贡献占比变化，量化堆积的交期影响"@zh .

    <urn:pxai:semi:detection:kb.ap.wire_nsop_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.wire_pull_strength> ;
        semi:signalText "拉力值下降，且失效模式分布向\"球脱\"偏移（失效模式比数值更有指向性）"@zh .

    <urn:pxai:semi:detection:kb.ap.wire_nsop_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:ap.metric.ball_shear_strength> ;
        semi:signalText "球剪切强度下降指向球焊界面金属间化合物形成不足"@zh .

    <urn:pxai:semi:detection:kb.erp.billing_block_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:erp.metric.credit_exposure> ;
        semi:signalText "客户信用敞口对授信额度的占用率，以及订单的冻结标记类型"@zh .

    <urn:pxai:semi:detection:kb.erp.cost_variance_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:erp.metric.cost_variance_rate> ;
        semi:signalText "按价差/量差/效率差分层看差异率，以及按成本中心的分布形态"@zh .

    <urn:pxai:semi:detection:kb.erp.depreciation_error_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:erp.metric.net_book_value> ;
        semi:signalText "资产净值与累计折旧/原值比例，触发\"累计折旧≤原值\"自检约束"@zh .

    <urn:pxai:semi:detection:kb.erp.gr_ir_mismatch_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:erp.metric.gr_ir_balance> ;
        semi:signalText "GR/IR 科目余额与账龄，按单边挂账/双边差异分层"@zh .

    <urn:pxai:semi:detection:kb.erp.inventory_writedown_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:erp.metric.inventory_turnover> ;
        semi:signalText "按料号的周转率与库龄分布，周转单调下滑是跌价先行信号"@zh .

    <urn:pxai:semi:detection:kb.erp.yield_cost_impact_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.yield> ;
        semi:signalText "产线良率趋势与单位成本趋势对齐比对，找同期拐点"@zh .

    <urn:pxai:semi:detection:kb.erp.yield_cost_impact_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:erp.metric.cost_variance_rate> ;
        semi:signalText "效率差/产量差部分的差异率变化，量化良率对成本的传导"@zh .

    <urn:pxai:semi:detection:kb.fab.cd_out_of_spec_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.cd_uniformity> ;
        semi:signalText "均值偏移量、片内 3σ、以及偏差的空间分布形态（三者需一起看）"@zh .

    <urn:pxai:semi:detection:kb.fab.cmp_scratch_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
        semi:signalText "scratch 类缺陷计数与研磨垫使用时长做相关性分析"@zh .

    <urn:pxai:semi:detection:kb.fab.cmp_scratch_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.film_thickness> ;
        semi:signalText "去除率下降趋势，与划伤率上升同步则指向研磨垫寿命"@zh .

    <urn:pxai:semi:detection:kb.fab.equipment_down_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.oee> ;
        semi:signalText """可用率跌落，且必须区分计划内 PM 与非计划停机——两者混在同一口径里 会让停机改善看起来毫无进展。
"""@zh .

    <urn:pxai:semi:detection:kb.fab.equipment_down_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.wip> ;
        semi:signalText "停机站点队列陡升，是停机向下游传导的最早观测量"@zh .

    <urn:pxai:semi:detection:kb.fab.equipment_down_triage%3A3> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.throughput> ;
        semi:signalText "处理率缓降可作为劣化型停机的前兆信号，早于硬停机"@zh .

    <urn:pxai:semi:detection:kb.fab.etch_residue_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.etch_depth> ;
        semi:signalText "深度不足，且与前层膜厚记录联动比对可区分是蚀刻不足还是膜厚偏厚"@zh .

    <urn:pxai:semi:detection:kb.fab.etch_residue_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
        semi:signalText "残留型缺陷计数上升，缺陷分类结果指向 residue 而非 particle"@zh .

    <urn:pxai:semi:detection:kb.fab.film_thickness_dev_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.film_thickness> ;
        semi:signalText """超出规格上下限，或片内均匀性超标。必须同时看剖面形状—— 只看片均值会漏掉"均值在规格内、边缘已超规"这一类。
"""@zh .

    <urn:pxai:semi:detection:kb.fab.film_thickness_dev_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.sheet_resistance> ;
        semi:signalText """金属层方阻与膜厚反向变动，可与膜厚量测互为交叉确认； 若两者不一致，先怀疑量测本身而不是制程。
"""@zh .

    <urn:pxai:semi:detection:kb.fab.film_thickness_dev_triage%3A3> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
        semi:signalText """颗粒数是否与膜厚偏移同步跃升。同步跃升把根因指向靶材寿命 末期或腔壁残留脱落，而不是纯参数漂移。
"""@zh .

    <urn:pxai:semi:detection:kb.fab.implant_dose_drift_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.wat_vt> ;
        semi:signalText "Vt 均值偏移，按机台分组后差异显著"@zh .

    <urn:pxai:semi:detection:kb.fab.implant_dose_drift_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.sheet_resistance> ;
        semi:signalText """方阻是比 Vt 更早的观测量。若已有注入后方阻抽测，可将检出 从 WAT 提前数十道工序，这是缩短此类异常暴露窗口的关键手段。
"""@zh .

    <urn:pxai:semi:detection:kb.fab.overlay_shift_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.overlay_error> ;
        semi:signalText """直接判定量。务必看偏移的空间分布而非只看单值超规： 全片线性、旋转、场内、局部四种分布分别指向不同根因， 只看超没超规会丢掉最关键的判别信息。
"""@zh .

    <urn:pxai:semi:detection:kb.fab.overlay_shift_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.cd_uniformity> ;
        semi:signalText """CD 与套刻同时异常时更可能是背面沾污引起的离焦， 可用于把平面度类根因与纯对位类根因分开
"""@zh .

    <urn:pxai:semi:detection:kb.fab.overlay_shift_triage%3A3> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.yield> ;
        semi:signalText "套刻超规若漏到后续层，最终以良率损失体现"@zh .

    <urn:pxai:semi:detection:kb.fab.particle_excursion_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
        semi:signalText """计数跃升 + 空间分布形态 + 缺陷分类比例。三者结合才能定位， 单看总数只能确认异常存在，无法指向责任工序。
"""@zh .

    <urn:pxai:semi:detection:kb.fab.quality_excursion_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.yield> ;
        semi:signalText """良率是最终后果但滞后。用作确认异常规模，不用作定位——定位要靠缺陷 分类与电性参数的分布形态。
"""@zh .

    <urn:pxai:semi:detection:kb.fab.quality_excursion_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.defect_density> ;
        semi:signalText "缺陷计数与分类比例变化，是良率下滑前的早期信号"@zh .

    <urn:pxai:semi:detection:kb.fab.quality_excursion_triage%3A3> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:fab.metric.wat_vt> ;
        semi:signalText "电性参数按机台分组后差异显著，指向特定机台的工艺偏移"@zh .

    <urn:pxai:semi:detection:kb.fab.scanner_down_triage%3A1> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.oee> ;
        semi:signalText """可用率跌落，且要区分计划内 PM 与非计划停机。两者混在同一口径里 会让停机改善看起来毫无进展。
"""@zh .

    <urn:pxai:semi:detection:kb.fab.scanner_down_triage%3A2> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.wip> ;
        semi:signalText "光刻区队列长度陡升，是停机向下游传导的最早观测量"@zh .

    <urn:pxai:semi:detection:kb.fab.scanner_down_triage%3A3> a semi:DetectionInstruction ;
        semi:detectsWithMetric <urn:pxai:semi:catalog:core.metric.throughput> ;
        semi:signalText "曝光层产出率缓降可作为光源劣化的前兆信号，早于硬停机"@zh .

    <urn:pxai:semi:pain-point:scenario.ap.bonder_down_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞金线键合、QFN 金线封装主流程并影响equipment_oee、throughput、cycle_time。"@zh .

    <urn:pxai:semi:pain-point:scenario.ap.delamination_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞包装出货并影响yield、scrap_rate。"@zh .

    <urn:pxai:semi:pain-point:scenario.ap.dicing_chipping_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞装片并影响yield、scrap_rate、cost_per_unit。"@zh .

    <urn:pxai:semi:pain-point:scenario.ap.die_crack_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞包装出货并影响yield、scrap_rate。"@zh .

    <urn:pxai:semi:pain-point:scenario.ap.ft_yield_drop_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞包装出货并影响yield、capacity_commit、cost_per_unit。"@zh .

    <urn:pxai:semi:pain-point:scenario.ap.missing_ball_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞包装出货并影响yield、rework_rate。"@zh .

    <urn:pxai:semi:pain-point:scenario.ap.mold_void_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞包装出货并影响yield、scrap_rate。"@zh .

    <urn:pxai:semi:pain-point:scenario.ap.wire_bond_wip_bubble> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞后续生产并影响cycle_time、throughput、capacity_commit、equipment_oee。"@zh .

    <urn:pxai:semi:pain-point:scenario.ap.wire_nsop_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞压模成型并影响yield、rework_rate、throughput。"@zh .

    <urn:pxai:semi:pain-point:scenario.fab.cd_out_of_spec_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞干法蚀刻并影响yield、rework_rate、cycle_time。"@zh .

    <urn:pxai:semi:pain-point:scenario.fab.cmp_scratch_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞CVD 层间介电沉积并影响yield、scrap_rate、cost_per_unit。"@zh .

    <urn:pxai:semi:pain-point:scenario.fab.etch_residue_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞PVD 金属沉积并影响yield、rework_rate。"@zh .

    <urn:pxai:semi:pain-point:scenario.fab.film_thickness_dev_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞金属 CMP、氧化层 CMP并影响yield、rework_rate、scrap_rate、cycle_time。"@zh .

    <urn:pxai:semi:pain-point:scenario.fab.implant_dose_drift_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞晶圆针测并影响yield、scrap_rate、capacity_commit。"@zh .

    <urn:pxai:semi:pain-point:scenario.fab.overlay_shift_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞干法蚀刻并影响yield、rework_rate。"@zh .

    <urn:pxai:semi:pain-point:scenario.fab.particle_excursion_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞CMOS 逻辑主流程（单金属层）并影响yield、scrap_rate、capacity_commit。"@zh .

    <urn:pxai:semi:pain-point:scenario.fab.scanner_down_triage> a semi:PainPoint ;
        semi:painPointText "候选原因分散，可能阻塞曝光、CMOS 逻辑主流程（单金属层）并影响throughput、capacity_commit、cycle_time、equipment_oee。"@zh .

    <urn:pxai:semi:playbook:kb.ap.bonder_down_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "键合机停机排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.bonder_down> ;
        semi:economicImpactText """键合是 QFN 主流程的瓶颈工序之一，停机损失近似等于停机时长 × 瓶颈产出率，且不可通过后续赶工完全回补。可控旋钮有两个： 按计数的电极/瓷嘴预防性更换（把非计划停机换成短时计划停机）， 以及关键备件本地备货水位。轴系类停机的时长方差远大于耗材类， 估算停机影响时应按成因分类而非用单一平均值。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A2>,
            <urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A3>,
            <urn:pxai:semi:action-instruction:kb.ap.bonder_down_triage%3A4> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A3>,
            <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A4>,
            <urn:pxai:semi:cause-assertion:kb.ap.bonder_down_triage%3A5> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.bonder_down_triage%3A1>,
            <urn:pxai:semi:detection:kb.ap.bonder_down_triage%3A2>,
            <urn:pxai:semi:detection:kb.ap.bonder_down_triage%3A3> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.wire_pull_strength>,
            <urn:pxai:semi:catalog:core.metric.oee>,
            <urn:pxai:semi:catalog:core.metric.wip> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.wire_bond> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.clean_efo_electrode>,
            <urn:pxai:semi:catalog:ap.action.hold_lot>,
            <urn:pxai:semi:catalog:ap.action.reallocate_fixture>,
            <urn:pxai:semi:catalog:ap.action.replace_capillary> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:ap.cause.bond_head_servo_fault>,
            <urn:pxai:semi:catalog:ap.cause.capillary_wear>,
            <urn:pxai:semi:catalog:ap.cause.efo_electrode_fouling>,
            <urn:pxai:semi:catalog:ap.cause.fixture_shortage>,
            <urn:pxai:semi:catalog:ap.cause.wire_feed_jam> ;
        semi:legacyId "kb.ap.bonder_down_triage" ;
        semi:symptomText "OEE 可用率跌落；若为卡线类则表现为频繁短停而非一次长停"@zh,
            "打线机报警停机，键合工序在制批次停止流动"@zh,
            "键合区 WIP 累积，下游塑封出现待料"@zh .

    <urn:pxai:semi:playbook:kb.ap.delamination_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "界面分层排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.delamination> ;
        semi:economicImpactText """分层是可靠性失效前兆，漏出至客户端的代价远高于内部拦截： 客户端失效触发退货、批次追溯与信誉损失，量级远超本批报废。 塑封料的时效管理成本极低，属预防远优于处置的典型场景。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.delamination_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.ap.delamination_triage%3A2>,
            <urn:pxai:semi:action-instruction:kb.ap.delamination_triage%3A3> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.delamination_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.ap.delamination_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.ap.delamination_triage%3A3> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.delamination_triage%3A1>,
            <urn:pxai:semi:detection:kb.ap.delamination_triage%3A2> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.die_shear_strength>,
            <urn:pxai:semi:catalog:ap.metric.void_ratio> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.aoi> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.bake_emc>,
            <urn:pxai:semi:catalog:ap.action.hold_lot>,
            <urn:pxai:semi:catalog:ap.action.plasma_clean_rerun> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:ap.cause.emc_moisture>,
            <urn:pxai:semi:catalog:ap.cause.pad_contamination>,
            <urn:pxai:semi:catalog:ap.param.cure_temp> ;
        semi:legacyId "kb.ap.delamination_triage" ;
        semi:symptomText "C-SAM 超声扫描检出塑封料与芯粒、基板或引线框架界面剥离"@zh,
            "严重时后续回流焊出现爆米花效应（popcorn cracking）"@zh,
            "分层面积或位置超出允收标准，常见于芯粒边角与引线框架指部"@zh,
            "可能不伴随任何电性异常——分层是可靠性失效前兆，非即时功能失效"@zh .

    <urn:pxai:semi:playbook:kb.ap.dicing_chipping_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "切割崩边超规排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.dicing_chipping> ;
        semi:economicImpactText """崩边侵入电路区即判废。更重要的是它会转化为下游裂片， 因此换刀周期的决策不能只看崩边直接判废率，还须计入裂片连带损失。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.dicing_chipping_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.ap.dicing_chipping_triage%3A2> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.dicing_chipping_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.ap.dicing_chipping_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.ap.dicing_chipping_triage%3A3> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.dicing_chipping_triage%3A1> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.chipping_size> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.dicing> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.hold_lot>,
            <urn:pxai:semi:catalog:ap.action.replace_blade> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:ap.cause.blade_wear>,
            <urn:pxai:semi:catalog:ap.param.blade_rpm>,
            <urn:pxai:semi:catalog:ap.param.cut_feed_speed> ;
        semi:legacyId "kb.ap.dicing_chipping_triage" ;
        semi:symptomText "严重时伴随芯粒边缘缺口"@zh,
            "崩边尺寸量测超出 Scribe Line 余量"@zh,
            "崩边集中于晶圆特定区域或特定切割方向"@zh .

    <urn:pxai:semi:playbook:kb.ap.die_crack_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "芯粒裂纹排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.die_crack> ;
        semi:economicImpactText """成因工序与检出工序相隔远，圈定范围大是主要成本。改善方向在于 缩短暴露路径：在减薄或切割后增设抽检，把检出前移到成本累积较少的位置。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.die_crack_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.ap.die_crack_triage%3A2> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A3>,
            <urn:pxai:semi:cause-assertion:kb.ap.die_crack_triage%3A4> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.die_crack_triage%3A1> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.die_shear_strength> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.aoi> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.hold_lot>,
            <urn:pxai:semi:catalog:ap.action.replace_blade> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:ap.anomaly.dicing_chipping>,
            <urn:pxai:semi:catalog:ap.cause.grind_wheel_clog>,
            <urn:pxai:semi:catalog:ap.param.die_bond_force>,
            <urn:pxai:semi:catalog:ap.param.grind_feed_rate> ;
        semi:legacyId "kb.ap.die_crack_triage" ;
        semi:symptomText "外观或超声扫描发现芯粒开裂"@zh,
            "终测出现无规律功能失效"@zh,
            "裂纹常起始于芯粒边缘或背面"@zh .

    <urn:pxai:semi:playbook:kb.ap.ft_yield_drop_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "终测良率下滑排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.ft_yield_drop> ;
        semi:economicImpactText """双向损失：真实失效直接减少可交付数量；伪失效则造成良品过杀， 损失被错记为品质问题并误导改善方向。先分清两者是本异常处置的 经济关键，而非急于追查工艺。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.ft_yield_drop_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.ap.ft_yield_drop_triage%3A2>,
            <urn:pxai:semi:action-instruction:kb.ap.ft_yield_drop_triage%3A3> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A3>,
            <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A4>,
            <urn:pxai:semi:cause-assertion:kb.ap.ft_yield_drop_triage%3A5> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.ft_yield_drop_triage%3A1>,
            <urn:pxai:semi:detection:kb.ap.ft_yield_drop_triage%3A2> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.ft_yield>,
            <urn:pxai:semi:catalog:core.metric.yield> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.final_test> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.hold_lot>,
            <urn:pxai:semi:catalog:ap.action.replace_probe_card>,
            <urn:pxai:semi:catalog:ap.action.retest> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:ap.anomaly.delamination>,
            <urn:pxai:semi:catalog:ap.anomaly.die_crack>,
            <urn:pxai:semi:catalog:ap.anomaly.wire_nsop>,
            <urn:pxai:semi:catalog:ap.cause.probe_card_wear>,
            <urn:pxai:semi:catalog:ap.param.test_time> ;
        semi:legacyId "kb.ap.ft_yield_drop_triage" ;
        semi:symptomText "可能伴随特定测试 Site 失效率显著偏高"@zh,
            "失效 Bin 分布出现异常集中"@zh,
            "终测良率跌破管制下限"@zh .

    <urn:pxai:semi:playbook:kb.ap.missing_ball_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "缺球/连球排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.missing_ball> ;
        semi:economicImpactText """与多数后段不良相反，本异常的缺球分支可返工挽回，因此经济关键不在 止损而在分流准确性：把可返工的缺球误判为连球等于多报废， 把连球混进返工流则把不可靠品送出厂。 成因侧的杠杆在印刷条件——它是可调工艺窗口，纠正成本低于换料或 改炉温曲线，这也是把 flux_print_defect 排在首位排除的经济理由。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.missing_ball_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.ap.missing_ball_triage%3A2> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.missing_ball_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.ap.missing_ball_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.ap.missing_ball_triage%3A3> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.missing_ball_triage%3A1>,
            <urn:pxai:semi:detection:kb.ap.missing_ball_triage%3A2> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.coplanarity>,
            <urn:pxai:semi:catalog:core.metric.yield> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.aoi> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.hold_lot>,
            <urn:pxai:semi:catalog:ap.action.reball_rework> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:ap.cause.flux_print_defect>,
            <urn:pxai:semi:catalog:ap.cause.reflow_profile_drift>,
            <urn:pxai:semi:catalog:ap.param.reflow_peak_temp> ;
        semi:legacyId "kb.ap.missing_ball_triage" ;
        semi:symptomText "AOI 检出接点缺球，或相邻锡球桥连"@zh,
            "共面性量测超规，此时须与缺球分开判定"@zh,
            "可能伴随锡球表面起皱（助焊剂活性不足或回流中流失致氧化）"@zh,
            "缺球位置与印刷版面或植球治具孔位呈固定对应"@zh,
            "连球多出现在间距最小的接点区域"@zh .

    <urn:pxai:semi:playbook:kb.ap.mold_void_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "塑封空洞排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.mold_void> ;
        semi:economicImpactText """塑封后空洞不可返工，直接判废，且此时前段与后段大部分成本已投入。 塑封料的时效管理成本远低于一次批量空洞报废，是典型的预防优于处置场景。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.mold_void_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.ap.mold_void_triage%3A2> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A3>,
            <urn:pxai:semi:cause-assertion:kb.ap.mold_void_triage%3A4> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.mold_void_triage%3A1> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.void_ratio> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.aoi> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.bake_emc>,
            <urn:pxai:semi:catalog:ap.action.hold_lot> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:ap.cause.emc_moisture>,
            <urn:pxai:semi:catalog:ap.param.mold_pressure>,
            <urn:pxai:semi:catalog:ap.param.mold_temp>,
            <urn:pxai:semi:catalog:ap.param.transfer_speed> ;
        semi:legacyId "kb.ap.mold_void_triage" ;
        semi:symptomText "X-Ray 抽检发现塑封体内部气泡"@zh,
            "严重时伴随包封不全或金线冲丝"@zh,
            "空洞多集中于特定模腔位置或芯粒边缘"@zh .

    <urn:pxai:semi:playbook:kb.ap.wire_bond_wip_bubble> a semi:DiagnosticPlaybook ;
        rdfs:label "Wire Bond 站点 WIP 堆积排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:core.anomaly.wip_bubble> ;
        semi:economicImpactText """键合站常为后段瓶颈，其堆积同时造成交期延长（前段等待）与 下游稼动损失（塑封饥饿）。按 Little's Law，WIP 上升而产出率不变时 CT 等比恶化。若为治具短缺型，治具投资的回收周期通常远短于产能损失。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.wire_bond_wip_bubble%3A1>,
            <urn:pxai:semi:action-instruction:kb.ap.wire_bond_wip_bubble%3A2>,
            <urn:pxai:semi:action-instruction:kb.ap.wire_bond_wip_bubble%3A3> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A1>,
            <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A2>,
            <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A3>,
            <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A4>,
            <urn:pxai:semi:cause-assertion:kb.ap.wire_bond_wip_bubble%3A5> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.wire_bond_wip_bubble%3A1>,
            <urn:pxai:semi:detection:kb.ap.wire_bond_wip_bubble%3A2>,
            <urn:pxai:semi:detection:kb.ap.wire_bond_wip_bubble%3A3> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:core.metric.cycle_time>,
            <urn:pxai:semi:catalog:core.metric.oee>,
            <urn:pxai:semi:catalog:core.metric.wip> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.wire_bond> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.bond_param_doe>,
            <urn:pxai:semi:catalog:ap.action.hold_lot>,
            <urn:pxai:semi:catalog:ap.action.reallocate_fixture> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:ap.anomaly.bonder_down>,
            <urn:pxai:semi:catalog:ap.anomaly.wire_nsop>,
            <urn:pxai:semi:catalog:ap.cause.fixture_shortage>,
            <urn:pxai:semi:catalog:ap.process.wafer_receive>,
            <urn:pxai:semi:catalog:core.state.hold> ;
        semi:legacyId "kb.ap.wire_bond_wip_bubble" ;
        semi:symptomText "下游塑封站出现断料饥饿"@zh,
            "该站 CT 贡献占比上升，X-Factor 恶化"@zh,
            "键合站在制量显著高于正常水位，队列批次数持续增长"@zh .

    <urn:pxai:semi:playbook:kb.ap.wire_nsop_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "金线不粘 NSOP 排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> ;
        semi:economicImpactText """塑封前检出可重新键合挽回，损失限于键合工时；塑封后暴露则整颗判废， 且可能在终测才发现（表现为开路）。molding 是本异常的经济分界点。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A2>,
            <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A3>,
            <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A4>,
            <urn:pxai:semi:action-instruction:kb.ap.wire_nsop_triage%3A5> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A3>,
            <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A4>,
            <urn:pxai:semi:cause-assertion:kb.ap.wire_nsop_triage%3A5> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.ap.wire_nsop_triage%3A1>,
            <urn:pxai:semi:detection:kb.ap.wire_nsop_triage%3A2> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:ap.metric.ball_shear_strength>,
            <urn:pxai:semi:catalog:ap.metric.wire_pull_strength> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:ap.process.wire_bond> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:ap.action.adjust_dispense>,
            <urn:pxai:semi:catalog:ap.action.bond_param_doe>,
            <urn:pxai:semi:catalog:ap.action.hold_lot>,
            <urn:pxai:semi:catalog:ap.action.plasma_clean_rerun>,
            <urn:pxai:semi:catalog:ap.action.replace_capillary> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:ap.cause.bond_param_drift>,
            <urn:pxai:semi:catalog:ap.cause.capillary_wear>,
            <urn:pxai:semi:catalog:ap.cause.epoxy_bleed>,
            <urn:pxai:semi:catalog:ap.cause.pad_contamination>,
            <urn:pxai:semi:catalog:ap.param.bond_power> ;
        semi:legacyId "kb.ap.wire_nsop_triage" ;
        semi:symptomText "拉力测试值偏低，失效模式为球脱而非线断"@zh,
            "机台不粘报警频次上升"@zh,
            "目检可见焊球未完全接合或有位移"@zh .

    <urn:pxai:semi:playbook:kb.erp.billing_block_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "开票冻结/信用超限排查与释放"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:erp.anomaly.billing_block> ;
        semi:economicImpactText """开票受阻推迟收入确认与回款，直接拉长 DSO、占用营运资金。信用冻结型若无条件放行会累积 坏账风险，交货未过账型则是物流与开票流程脱节。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.erp.billing_block_triage%3A1> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.erp.billing_block_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.erp.billing_block_triage%3A2> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.erp.billing_block_triage%3A1> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:erp.metric.credit_exposure> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:erp.action.credit_review_release> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:erp.cause.credit_limit_exceeded>,
            <urn:pxai:semi:catalog:erp.cause.delivery_not_posted> ;
        semi:legacyId "kb.erp.billing_block_triage" ;
        semi:symptomText "或交货尚未过账（PGI 未做）"@zh,
            "订单带信用冻结或开票冻结标记"@zh,
            "销售订单无法开票放行"@zh .

    <urn:pxai:semi:playbook:kb.erp.cost_variance_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "成本差异超标排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:erp.anomaly.cost_variance_excursion> ;
        semi:economicImpactText """差异越晚识别，错误的标准成本沉淀进期末存货估值的金额越大，且会误导定价与产品盈利分析。 价差量差型影响当期毛利，分摊失真型则在成本对象间交叉补贴、扭曲单品盈利判断。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.erp.cost_variance_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.erp.cost_variance_triage%3A2>,
            <urn:pxai:semi:action-instruction:kb.erp.cost_variance_triage%3A3> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.erp.cost_variance_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.erp.cost_variance_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.erp.cost_variance_triage%3A3> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.erp.cost_variance_triage%3A1> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:erp.metric.cost_variance_rate> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:erp.action.recalc_allocation_rate>,
            <urn:pxai:semi:catalog:erp.action.revalue_standard_cost>,
            <urn:pxai:semi:catalog:erp.action.variance_analysis> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:erp.cause.overhead_allocation_drift>,
            <urn:pxai:semi:catalog:erp.cause.purchase_price_swing>,
            <urn:pxai:semi:catalog:erp.cause.standard_cost_outdated> ;
        semi:legacyId "kb.erp.cost_variance_triage" ;
        semi:symptomText "实际成本对标准成本差异率超出管控界限"@zh,
            "差异集中于料成本、制造费用或效率某一类"@zh,
            "或差异分布在特定成本中心而非全线"@zh .

    <urn:pxai:semi:playbook:kb.erp.depreciation_error_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "折旧计提异常排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:erp.anomaly.depreciation_error> ;
        semi:economicImpactText """折旧错误直接影响当期费用与资产账面价值。累计折旧超原值会触发 SHACL 自检回滚， 是资产主数据错误的强信号——半导体设备原值高，年限设错的期间费用偏差可观。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.erp.depreciation_error_triage%3A1> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.erp.depreciation_error_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.erp.depreciation_error_triage%3A2> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.erp.depreciation_error_triage%3A1> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:erp.metric.net_book_value> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:erp.action.correct_asset_master> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:erp.cause.asset_master_error>,
            <urn:pxai:semi:catalog:erp.cause.capitalization_delay> ;
        semi:legacyId "kb.erp.depreciation_error_triage" ;
        semi:symptomText "偏差集中于某资产类或某单项资产"@zh,
            "或累计折旧逼近/超过资产原值（净值将破残值线）"@zh,
            "折旧计提金额偏离预期"@zh .

    <urn:pxai:semi:playbook:kb.erp.gr_ir_mismatch_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "GR/IR 暂估对账失败排查与清理"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:erp.anomaly.gr_ir_mismatch> ;
        semi:economicImpactText """GR/IR 未清直接卡住月结，是期末结账最常见的对账阻塞点。长期挂账还会虚增或虚减应付、 扭曲负债准确性，掩盖采购与应付流程的断点。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.erp.gr_ir_mismatch_triage%3A1> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.erp.gr_ir_mismatch_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.erp.gr_ir_mismatch_triage%3A2> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.erp.gr_ir_mismatch_triage%3A1> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:erp.metric.gr_ir_balance> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:erp.action.clear_gr_ir> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:erp.cause.invoice_not_received>,
            <urn:pxai:semi:catalog:erp.cause.po_invoice_discrepancy> ;
        semi:legacyId "kb.erp.gr_ir_mismatch_triage" ;
        semi:symptomText "存在已收货未开票或已开票未收货的挂账项"@zh,
            "或价格/数量差异导致自动清账失败"@zh,
            "月结时 GR/IR 暂估科目余额无法清零"@zh .

    <urn:pxai:semi:playbook:kb.erp.inventory_writedown_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "存货跌价识别与计提"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:erp.anomaly.inventory_writedown> ;
        semi:economicImpactText """半导体存货受制程迭代快速减值，呆滞识别越晚跌价缺口越大。计提直接冲减当期毛利， 且大额跌价往往暴露前端投料计划与需求脱节的更深问题。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.erp.inventory_writedown_triage%3A1> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.erp.inventory_writedown_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.erp.inventory_writedown_triage%3A2> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.erp.inventory_writedown_triage%3A1> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:erp.metric.inventory_turnover> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:erp.action.provision_writedown> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:erp.cause.inventory_obsolescence>,
            <urn:pxai:semi:catalog:erp.cause.purchase_price_swing> ;
        semi:legacyId "kb.erp.inventory_writedown_triage" ;
        semi:symptomText "存货可变现净值（NRV）低于账面成本"@zh,
            "或伴随产线大额报废冲减"@zh,
            "特定料号积压、周转率持续下滑"@zh .

    <urn:pxai:semi:playbook:kb.erp.yield_cost_impact_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "良率下降致单位成本上升排查（制造→财务跨域）"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:erp.anomaly.yield_cost_impact> ;
        semi:economicImpactText """良率每降一档，固定制造费用摊到更少良品上，单位成本非线性上升。这是连接产线质量与 财务毛利的关键链路——纯从财务侧看只见成本升，须回溯到产线良率才能根治。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.erp.yield_cost_impact_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.erp.yield_cost_impact_triage%3A2> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.erp.yield_cost_impact_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.erp.yield_cost_impact_triage%3A2> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.erp.yield_cost_impact_triage%3A1>,
            <urn:pxai:semi:detection:kb.erp.yield_cost_impact_triage%3A2> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:core.metric.yield>,
            <urn:pxai:semi:catalog:erp.metric.cost_variance_rate> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:erp.action.revalue_standard_cost>,
            <urn:pxai:semi:catalog:erp.action.variance_analysis> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:core.anomaly.quality_excursion>,
            <urn:pxai:semi:catalog:erp.cause.overhead_allocation_drift> ;
        semi:legacyId "kb.erp.yield_cost_impact_triage" ;
        semi:symptomText "升幅与产线良率降幅同步"@zh,
            "单位成本上升但料价与工时标准未变"@zh,
            "良品产量下降、固定制造费用摊薄不足"@zh .

    <urn:pxai:semi:playbook:kb.fab.cd_out_of_spec_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "CD 超规排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.cd_out_of_spec> ;
        semi:economicImpactText """蚀刻前检出可重工挽回，损失约等于一次光刻的产能占用（含瓶颈机台工时）； 蚀刻后检出则整批面临判废，前段累计投入沉没。检出时点决定损失量级。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A2>,
            <urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A3>,
            <urn:pxai:semi:action-instruction:kb.fab.cd_out_of_spec_triage%3A4> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A3>,
            <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A4>,
            <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A5>,
            <urn:pxai:semi:cause-assertion:kb.fab.cd_out_of_spec_triage%3A6> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.cd_out_of_spec_triage%3A1> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:fab.metric.cd_uniformity> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.cd_measure> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.expand_sampling>,
            <urn:pxai:semi:catalog:fab.action.hold_lot>,
            <urn:pxai:semi:catalog:fab.action.photo_rework>,
            <urn:pxai:semi:catalog:fab.action.recipe_adjust> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.hotplate_nonuniform>,
            <urn:pxai:semi:catalog:fab.cause.lens_contamination>,
            <urn:pxai:semi:catalog:fab.cause.recipe_misload>,
            <urn:pxai:semi:catalog:fab.cause.resist_lot_change>,
            <urn:pxai:semi:catalog:fab.param.exposure_dose>,
            <urn:pxai:semi:catalog:fab.param.exposure_focus> ;
        semi:legacyId "kb.fab.cd_out_of_spec_triage" ;
        semi:symptomText "CD-SEM 量测值偏离目标超出管制界限"@zh,
            "或均值整体偏移而分布宽度正常（偏移型）"@zh,
            "片内 3σ 恶化但均值仍在中心（均匀性型）"@zh .

    <urn:pxai:semi:playbook:kb.fab.cmp_scratch_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "CMP 划伤排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.cmp_scratch> ;
        semi:economicImpactText """金属层划伤致短路通常不可挽回。研磨垫换用周期是良率与耗材成本的 直接权衡点，也是这类异常最可控的经营旋钮。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.cmp_scratch_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.fab.cmp_scratch_triage%3A2> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.cmp_scratch_triage%3A1>,
