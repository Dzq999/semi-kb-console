    <urn:pxai:semi:catalog:ap.anomaly.wire_nsop> semi:blocks <urn:pxai:semi:catalog:ap.process.molding> ;
        semi:detectedAt <urn:pxai:semi:catalog:ap.process.wire_bond> ;
        semi:mayCause <urn:pxai:semi:catalog:ap.anomaly.ft_yield_drop> ;
        semi:measuredByMetric <urn:pxai:semi:catalog:ap.metric.ball_shear_strength>,
            <urn:pxai:semi:catalog:ap.metric.wire_pull_strength> ;
        semi:mitigatedBy <urn:pxai:semi:catalog:ap.action.adjust_dispense>,
            <urn:pxai:semi:catalog:ap.action.bond_param_doe>,
            <urn:pxai:semi:catalog:ap.action.hold_lot>,
            <urn:pxai:semi:catalog:ap.action.plasma_clean_rerun>,
            <urn:pxai:semi:catalog:ap.action.replace_capillary> .

    <urn:pxai:semi:catalog:fab.anomaly.film_thickness_dev> skos:broader <urn:pxai:semi:catalog:core.anomaly.quality_excursion> ;
        semi:analogousTo <urn:pxai:semi:external:ext.coating.coat_weight_deviation> ;
        semi:blocks <urn:pxai:semi:catalog:fab.process.cmp_metal>,
            <urn:pxai:semi:catalog:fab.process.cmp_oxide> ;
        semi:detectedAt <urn:pxai:semi:catalog:fab.process.cvd_ild>,
            <urn:pxai:semi:catalog:fab.process.pvd_metal> ;
        semi:measuredByMetric <urn:pxai:semi:catalog:fab.metric.film_thickness>,
            <urn:pxai:semi:catalog:fab.metric.sheet_resistance> ;
        semi:mitigatedBy <urn:pxai:semi:catalog:fab.action.chamber_season>,
            <urn:pxai:semi:catalog:fab.action.hold_lot>,
            <urn:pxai:semi:catalog:fab.action.recipe_adjust>,
            <urn:pxai:semi:catalog:fab.action.replace_consumable> .
}

