        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.scanner_down_triage%3A1>,
            <urn:pxai:semi:detection:kb.fab.scanner_down_triage%3A2>,
            <urn:pxai:semi:detection:kb.fab.scanner_down_triage%3A3> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:core.metric.oee>,
