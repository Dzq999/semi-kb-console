            "缺陷密度较基线突然跃升数倍"@zh .

    <urn:pxai:semi:playbook:kb.fab.quality_excursion_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "品质异常突变通用排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:core.anomaly.quality_excursion> ;
        semi:economicImpactText """损失主要由发现速度决定而非偏移本身严重度：检出前已连续加工的片数决定 波及面，累计加工成本随暴露延迟沉没。真正的旋钮是量测抽样频次（把检出 提前）而不是事后处置速度。电性/介电类偏移还有一层延迟——要到 WAT/CP 才充分暴露，届时受影响批次已流过多道工序。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.quality_excursion_triage%3A1>,
