            <urn:pxai:semi:cause-assertion:kb.fab.cmp_scratch_triage%3A3> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.cmp_scratch_triage%3A1>,
            <urn:pxai:semi:detection:kb.fab.cmp_scratch_triage%3A2> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:fab.metric.defect_density>,
            <urn:pxai:semi:catalog:fab.metric.film_thickness> ;
        semi:hasDetectionProcess <urn:pxai:semi:catalog:fab.process.defect_scan> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.hold_lot>,
            <urn:pxai:semi:catalog:fab.action.replace_consumable> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.pad_end_of_life>,
            <urn:pxai:semi:catalog:fab.cause.slurry_agglomeration>,
            <urn:pxai:semi:catalog:fab.param.cmp_pressure> ;
        semi:legacyId "kb.fab.cmp_scratch_triage" ;
        semi:symptomText "划伤多呈弧形或直线，方向与研磨运动一致"@zh,
            "缺陷分类中线状划伤计数上升"@zh,
            "金属层划伤在电测阶段表现为短路"@zh .

    <urn:pxai:semi:playbook:kb.fab.equipment_down_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "设备非计划停机通用排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:core.anomaly.equipment_down> ;
        semi:economicImpactText """停机损失近似等于停机时长 × 该站产出率；瓶颈站不可通过后续赶工回补， 非瓶颈站在有缓冲时可部分吸收。两个可控旋钮：PM 依从性（用计划停机换 非计划停机，决定"是否发生"）与关键备件本地备货水位（用资金占用换 MTTR， 决定"停多久"）。若修复方案已明确却仍在等，瓶颈在备件调运或工程师到场， 不要继续往设备本体查。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.equipment_down_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.fab.equipment_down_triage%3A2>,
            <urn:pxai:semi:action-instruction:kb.fab.equipment_down_triage%3A3> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A3>,
            <urn:pxai:semi:cause-assertion:kb.fab.equipment_down_triage%3A4> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.equipment_down_triage%3A1>,
            <urn:pxai:semi:detection:kb.fab.equipment_down_triage%3A2>,
            <urn:pxai:semi:detection:kb.fab.equipment_down_triage%3A3> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:core.metric.oee>,
            <urn:pxai:semi:catalog:core.metric.throughput>,
            <urn:pxai:semi:catalog:core.metric.wip> ;
        semi:hasDiagnosticAction <urn:pxai:semi:catalog:fab.action.dispatch_field_service>,
            <urn:pxai:semi:catalog:fab.action.hold_lot>,
            <urn:pxai:semi:catalog:fab.action.skip_ahead> ;
        semi:hasPossibleCause <urn:pxai:semi:catalog:fab.cause.env_excursion>,
            <urn:pxai:semi:catalog:fab.cause.light_source_degradation>,
            <urn:pxai:semi:catalog:fab.cause.pm_overdue>,
            <urn:pxai:semi:catalog:fab.cause.reticle_stage_error> ;
        semi:legacyId "kb.fab.equipment_down_triage" ;
        semi:symptomText "OEE 可用率跌落；若停机点为瓶颈站，主流程 CT 同步拉长"@zh,
            "机台状态跳转为非计划停机(Down)，在机批次冻结在当前站点无法继续流动"@zh,
            "该站点 WIP 在数小时内累积，下游逐步出现供料饥饿"@zh .

    <urn:pxai:semi:playbook:kb.fab.etch_residue_triage> a semi:DiagnosticPlaybook ;
        rdfs:label "蚀刻残留排查与处置"@zh ;
        semi:diagnosesAnomaly <urn:pxai:semi:catalog:fab.anomaly.etch_residue> ;
        semi:economicImpactText """残留若被后续金属层覆盖固化则完全不可挽回，且在 WAT 才暴露为短路， 届时前段投入已全部沉没。此处的拦截价值远高于处置成本。
"""@zh ;
        semi:hasActionInstruction <urn:pxai:semi:action-instruction:kb.fab.etch_residue_triage%3A1>,
            <urn:pxai:semi:action-instruction:kb.fab.etch_residue_triage%3A2>,
            <urn:pxai:semi:action-instruction:kb.fab.etch_residue_triage%3A3> ;
        semi:hasCauseAssertion <urn:pxai:semi:cause-assertion:kb.fab.etch_residue_triage%3A1>,
            <urn:pxai:semi:cause-assertion:kb.fab.etch_residue_triage%3A2>,
            <urn:pxai:semi:cause-assertion:kb.fab.etch_residue_triage%3A3> ;
        semi:hasDetectionInstruction <urn:pxai:semi:detection:kb.fab.etch_residue_triage%3A1>,
            <urn:pxai:semi:detection:kb.fab.etch_residue_triage%3A2> ;
        semi:hasDetectionMetric <urn:pxai:semi:catalog:fab.metric.defect_density>,
