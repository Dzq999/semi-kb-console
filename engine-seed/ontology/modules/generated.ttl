semi:CustomerReturnEightDInvestigation a owl:Class ;
    rdfs:label "客户退货八D调查"@zh ;
    rdfs:subClassOf semi:DiagnosticPlaybook .

semi:FacilityDigitalTwin a owl:Class ;
