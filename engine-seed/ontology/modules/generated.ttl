semi:ProvenanceQualityReview a owl:Class ;
    rdfs:label "来源质量审查"@zh ;
    rdfs:subClassOf semi:ValidationAssertion .

semi:SECSGEMEquipmentTelemetryEvidence a owl:Class ;
