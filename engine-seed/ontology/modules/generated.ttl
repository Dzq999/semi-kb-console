semi:BuildingManagementSystem a owl:Class ;
    rdfs:label "楼宇管理系统"@zh ;
    rdfs:subClassOf semi:InformationEntity .

semi:CausalModelingForRootCauseAnalysis a owl:Class ;
    rdfs:label "根因分析因果建模"@zh ;
    rdfs:subClassOf semi:Capability .

semi:ConstraintViolationValidationResult a owl:Class ;
