    rdfs:subClassOf semi:Evidence .

semi:SensorDrivenFaultDetection a owl:Class ;
    rdfs:label "传感器驱动故障检测"@zh ;
    rdfs:subClassOf semi:Capability .

semi:SensorDrivenRealTimeEquipmentMonitoring a owl:Class ;
