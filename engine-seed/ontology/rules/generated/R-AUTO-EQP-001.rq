PREFIX px: <urn:pxai:semi:> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> CONSTRUCT { ?anomaly px:correlatesMaintenanceLogEvidence ?maintenanceEvidence . } WHERE { ?anomaly rdf:type px:EquipmentDowntimeAnomaly ; px:affectsEquipment ?equipment ; px:hasEvidence ?telemetryEvidence . ?telemetryEvidence rdf:type px:SECSGEMEquipmentTelemetryEvidence . ?maintenanceEvent rdf:type px:CorrectiveMaintenanceEvent ; px:affectsEquipment ?equipment ; px:hasEvidence ?maintenanceEvidence . ?maintenanceEvidence rdf:type px:MaintenanceLogCorrelationEvidence . }
