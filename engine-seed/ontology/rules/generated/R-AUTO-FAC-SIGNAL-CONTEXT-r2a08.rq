PREFIX px: <urn:pxai:semi:> CONSTRUCT { ?twin px:hasEvidence ?bundle . ?bundle px:aboutEntity ?twin . ?bundle a px:FacilityOperationalEvidenceBundle_r2a08 } WHERE { ?mapping a px:FacilitySignalAssetMappingRecord_r2a08 . ?mapping px:mapsFacilitySignalToZone_r2a08 ?zone . ?mapping px:mapsFacilitySignalToAsset_r2a08 ?asset . ?twin a px:FacilityDigitalTwin . BIND(IRI(CONCAT(STR(?twin), "/evidence-bundle/", ENCODE_FOR_URI(STR(?mapping)))) AS ?bundle) }
