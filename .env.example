SEMI_KB_CONSOLE_DATA=D:\AI_Coding\semi-kb-console\data
# Optional override for the console-owned engine directory.
# SEMI_KB_ENGINE_ROOT=D:\AI_Coding\semi-kb-console\data\engine
# Leave DATABASE_URL unset to use PostgreSQL when SEMI_KB_DB_PASSWORD exists,
# or the local data/console.db SQLite fallback when it does not.
# DATABASE_URL=sqlite:///D:/AI_Coding/semi-kb-console/data/console.db
# PostgreSQL production example (password must be URL encoded):
# DATABASE_URL=postgresql+psycopg://semi_kb_console:change-me@127.0.0.1:5432/semi_kb_console
# LANGGRAPH_DATABASE_URL=postgresql://semi_kb_console:change-me@127.0.0.1:5432/semi_kb_console
# Recommended: isolate the LangGraph checkpoint tables in a dedicated database to
# contain corruption blast radius. Set only the *name* here (credentials/host/port
# are reused from the main connection below, so the password is never duplicated).
# The target database must already exist and be owned by SEMI_KB_DB_USER.
# LANGGRAPH_DB_NAME=semi_kb_ckpt
# Alternatively keep the password in the Windows user environment and use:
# SEMI_KB_DB_USER=semi_kb_console
# SEMI_KB_DB_HOST=127.0.0.1
# SEMI_KB_DB_PORT=5432
# SEMI_KB_DB_NAME=semi_kb_console
ORCHESTRATOR_ENGINE=langgraph
AUTO_RESUME_RUNS=true
# Fallback for older run configurations; new tasks configure this in the UI.
GRAPH_REPAIR_ATTEMPTS=3
# Article quality-gate retries; UI can override this per article schedule (0-3).
ARTICLE_REPAIR_ATTEMPTS=3
WORKER_HEARTBEAT_SECONDS=15
# DeepSeek 官方 API（OpenAI 兼容）。API Key 放在环境变量里（名字由 LLM_API_KEY_ENV 指定），不要写进本文件。
LLM_BASE_URL=https://api.deepseek.com/v1
MODEL_CATALOG_URL=https://api.deepseek.com/v1/models
LLM_API_STYLE=openai
LLM_API_KEY_ENV=DS_API_KEY
# DeepSeek 单次输出上限 8192（超过会返回 400）
LLM_MAX_TOKENS=8192
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_ACCOUNT_NAME=墨言yyy
MAX_AGENT_COUNT=10
MAX_PROVIDER_CONCURRENCY=5
RESEARCH_RESULT_LIMIT=6
EVIDENCE_CHARS_PER_PAGE=6000
SEMI_KB_TIMEZONE=Asia/Shanghai
FRONTEND_ORIGIN=http://127.0.0.1:5173
